  "linux_64_meta_yaml": {
    "about": {
      "description": "Stakpak is the open source DevOps agent that helps you with securing, deploying, and maintaining production ready infrastructure and only pings when it needs a human.\nGenerate infrastructure code, debug Kubernetes, configure CI/CD, automate deployments, without giving an LLM the keys to production.",
      "dev_url": "https://github.com/stakpak/agent",
      "doc_url": "https://stakpak.gitbook.io/",
      "home": "https://stakpak.dev/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Stakpak – Ship your code, on autopilot."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cd cli",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins --features=jemalloc",
          "cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml"
        ],
        "env": {
          "AR_x86_64_pc_windows_msvc": "llvm-lib",
          "AWS_LC_SYS_CMAKE_BUILDER": "0",
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "CC_x86_64_pc_windows_msvc": "clang-cl",
          "CXX_x86_64_pc_windows_msvc": "clang-cl"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
