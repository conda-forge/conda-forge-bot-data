  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.8.74\"\n\npackage:\n  name: mbari-pbp\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/m/mbari-pbp/mbari_pbp-${{ version }}.tar.gz\n  sha256: 856bdccf50f2aa5ffe747b5f8b5cf54f4b806a53eb6c6324d88f64c87793c597\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - pbp = pbp.main_cli:main\n      - pbp-hmb-gen = pbp.hmb_gen.main_hmb_generator:main\n      - pbp-cloud = pbp.cloud.main_cloud:main\n      - pbp-hmb-plot = pbp.hmb_plot.main_plot:main\n      - pbp-meta-gen = pbp.meta_gen.main_meta_generator:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - poetry-core\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - lifewatch-pypam >=0.3.2,<0.3.3\n    - boto3 >=1.35.0,<2.0.0\n    - google-cloud-storage 2.18.0.*\n    - dataclasses-json 0.6.*\n    - python-dateutil 2.8.2.*\n    - pyyaml 6.0.*\n    - progressbar2 3.53.1.*\n    - marshmallow 3.20.2.*\n    - pysoundfile 0.12.1.*\n    - h5netcdf 1.3.0.*\n    - pvlib-python >=0.11.0,<0.12.0\n    - pyarrow 15.0.0.*\n    - loguru >=0.7.2,<0.8.0\n    - awscli >=1.34.0,<2.0.0\n    - isodate >=0.7.2,<0.8.0\n\ntests:\n  - python:\n      imports:\n        - pbp\n      # Both dataclasses-json and pyyaml are poorly pinnied to extact version,\n      # and dataclasses-json == 0.6 doesn't exist in conda-forge.\n      # This is an \"end of the stack\" package and disabeling pip-check should not be an issue.\n      pip_check: false\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - pbp --help\n      - pbp-hmb-gen --help\n      - pbp-cloud --help\n      - pbp-hmb-plot --help\n      - pbp-meta-gen --help\n\nabout:\n  summary: PyPAM based Processing\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://docs.mbari.org/pbp/\n  repository: https://github.com/mbari-org/pbp/\n  documentation: https://docs.mbari.org/pbp/\n\nextra:\n  recipe-maintainers:\n    - ocefpaf\n",
