  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: rpm-tools\n  version: \"6.1.0\"\n  major_minor: ${{ (version | split('.'))[:2] | join('.') }}\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: http://ftp.rpm.org/releases/rpm-${{ major_minor }}.x/rpm-${{ version }}.tar.bz2\n  sha256: f520810d27c74bf1c5d8b8885845c61e0c845f62d33e68b02e020633a8b62fe3\n  patches:\n    - 0001-Remove-fhardened-from-compiler-flags.patch\n    # rpm only builds a stable-ABI extension module, so it needs the Python\n    # Development.Module component rather than the full Development component\n    # (which implies Development.Embed and therefore libpython). Since CPython\n    # 3.15 conda-forge ships libpython separately and no longer pulls it in via\n    # python, so the unpatched configure step fails. Not yet submitted upstream.\n    - 0002-Only-require-the-Python-Development.Module-component.patch\n\nbuild:\n  number: 0\n  skip:\n    - win or osx\n    # The Python bindings are a stable-ABI extension module (rpm compiles _rpm\n    # with Py_LIMITED_API), so one build against the oldest supported Python\n    # serves every later version and the per-Python matrix is unnecessary.\n    - is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    - mkdir build-dir\n    - cd build-dir\n    - cmake .. $CMAKE_ARGS -DWITH_SELINUX=OFF -DWITH_DBUS=OFF -DWITH_AUDIT=OFF\n    - cmake --build . --target install -- -j$CPU_COUNT\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib(\"c\") }}\n    - make\n    - cmake\n    - pkg-config\n    - gettext\n    - scdoc\n    - if: osx\n      then: llvm-openmp\n    - if: linux\n      then: libgomp\n  host:\n    - if: linux\n      then:\n        - python\n        - if: is_abi3\n          then: python-abi3\n        - elfutils\n    - libarchive\n    - if: linux\n      then: libcap\n    - libsqlite\n    - lua\n    - popt\n    - readline\n    - zstd\n    - liblzma-devel\n    - bzip2\n    - libiconv\n    - file\n    - zlib\n    - rpm-sequoia\n    - libacl\n  run:\n    - if: linux\n      then:\n        - python\n        - ${{ pin_compatible('elfutils') }}\n    - ${{ pin_compatible('file') }}\n\ntests:\n  - python:\n      imports:\n        - rpm\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      script:\n        - abi3audit $SP_DIR/rpm/_rpm.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      requirements:\n        run:\n          - abi3audit\n  - script:\n      - rpm --help\n\nabout:\n  license: GPL-2.0-or-later OR LGPL-2.0-or-later\n  license_file: COPYING\n  summary: The RPM Package Manager\n  description: |\n    The RPM Package Manager (RPM) is a powerful package management system capable of:\n\n    * building computer software from source into easily distributable packages\n    * installing, updating and uninstalling packaged software\n    * querying detailed information about the packaged software, whether installed or not\n    * verifying integrity of packaged software and resulting software installation\n\n  homepage: https://rpm.org/index.html\n  repository: https://github.com/rpm-software-management/rpm/\n  documentation: https://rpm.org/documentation.html\n\nextra:\n  recipe-maintainers:\n    - chrisburr\n",
