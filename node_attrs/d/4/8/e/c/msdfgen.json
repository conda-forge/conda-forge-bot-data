  "linux_64_meta_yaml": {
    "about": {
      "description": "This is a utility for generating signed distance fields from vector shapes\nand font glyphs, which serve as a texture representation that can be used\nin real-time graphics to efficiently reproduce said shapes. Although it can\nalso be used to generate conventional signed distance fields best known\nfrom this Valve paper and perpendicular distance fields, its primary\npurpose is to generate multi-channel distance fields, using a method I have\ndeveloped. Unlike monochrome distance fields, they have the ability to\nreproduce sharp corners almost perfectly by utilizing all three color\nchannels.",
      "dev_url": "https://github.com/Chlumsky/msdfgen",
      "home": "https://github.com/Chlumsky/msdfgen",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE.txt",
      "summary": "Multi-channel signed distance field generator"
    },
    "build": {
      "number": "1",
      "run_exports": {
        "weak": [
          "msdfgen"
        ]
      }
    },
    "extra": {
