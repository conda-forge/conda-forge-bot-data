  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: log4cxx\n  version: \"1.8.0\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: http://archive.apache.org/dist/logging/${{ name }}/${{ version }}/apache-${{ name }}-${{ version }}.tar.gz\n  sha256: 6a2e40dfa6b81a9a814ef2083d181b254f88324efff678368e5e61188a58fd3d\n\nbuild:\n  number: 0\n\nrequirements:\n  run_exports:\n    # no ABI lab data, soname is changing with each release\n    - ${{ pin_subpackage(\"log4cxx\", upper_bound=\"x.x.x\") }}\n  build:\n    - if: unix\n      then: gnuconfig\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - make\n    - if: linux\n      then: zip\n    - if: win\n      then:\n        - m2-sed\n        - m2-zip\n        - m2-gzip\n  host:\n    - expat\n    - apr\n    - libiconv\n    - fmt\n    - if: linux\n      then: libxcrypt\n  run:\n    - expat\n    - apr\n    - libaprutil\n    - libapr\n\ntests:\n  - package_contents:\n      include:\n        - log4cxx/appender.h\n        - log4cxx/logmanager.h\n        - log4cxx/log4cxx.h\n      lib:\n        - log4cxx\n\nabout:\n  homepage: https://logging.apache.org/log4cxx\n  license: Apache-2.0\n  license_file: LICENSE\n  summary: A logging framework for C++ patterned after Apache log4j.\n  description: |\n    Apache log4cxx is a logging framework for C++ patterned after Apache log4j,\n    which uses Apache Portable Runtime for most platform-specific code and should be\n    usable on any platform supported by APR. Apache log4cxx is licensed under the\n    Apache License, an open source license certified by the Open Source Initiative.\n  documentation: https://logging.apache.org/log4cxx\n\nextra:\n  recipe-maintainers:\n    - traversaro\n    - wolfv\n    - seanyen\n    - brianv0\n    - mwittgen\n",
