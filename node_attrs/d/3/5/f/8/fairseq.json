  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.12.3\"\n\npackage:\n  name: fairseq\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/pytorch/fairseq/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: f9e97dc0ff6a9f5c4f29fcf297c2fa4d16a2ca7f6dbd180286855e31e1cb3183\n  patches:\n    # The upstream repository is archived. Remove if packaging a maintained\n    # fork or release that supports MSVC and avoids privileged symlink creation.\n    # https://github.com/facebookresearch/fairseq/issues/5620\n    - patches/0001-support-windows-builds.patch\n\nbuild:\n  number: 20\n  skip:\n    # fairseq still does not support Python 3.11.\n    # https://github.com/facebookresearch/fairseq/pull/5359/files\n    - match(python, \">=3.11\")\n  script:\n    - if: win\n      then: call \"%RECIPE_DIR%\\\\build.bat\"\n    - if: unix\n      then: bash \"${RECIPE_DIR}/build.sh\"\n  python:\n    entry_points:\n      - fairseq-eval-lm = fairseq_cli.eval_lm:cli_main\n      - fairseq-generate = fairseq_cli.generate:cli_main\n      - fairseq-hydra-train = fairseq_cli.hydra_train:cli_main\n      - fairseq-interactive = fairseq_cli.interactive:cli_main\n      - fairseq-preprocess = fairseq_cli.preprocess:cli_main\n      - fairseq-score = fairseq_cli.score:cli_main\n      - fairseq-train = fairseq_cli.train:cli_main\n      - fairseq-validate = fairseq_cli.validate:cli_main\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - cython\n        - numpy\n        # Build the CPU-only extensions against CPU PyTorch. Keep the runtime\n        # requirement flavor-neutral so users can still install CUDA PyTorch.\n        - pytorch ${{ pytorch }}.* *cpu*\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"cxx\") }}\n  host:\n    - python\n    - pip\n    - numpy\n    - cython\n    - setuptools\n    # Required to build the C++ extensions.\n    - pytorch ${{ pytorch }}.* *cpu*\n  run:\n    - python\n    - hydra-core >=1.0.7\n    - omegaconf\n    - numpy >=1.22\n    - regex\n    - sacrebleu >=1.4.12\n    - tqdm\n    - bitarray\n\ntests:\n  - requirements:\n      run:\n        - pytorch ${{ pytorch }}.* *cpu*\n    script:\n      # Preserve the established import-only coverage. Upstream's legacy\n      # package metadata declares requirements this recipe does not use.\n      - python -c \"import fairseq\"\n      - python -c \"import fairseq.benchmark\"\n      - fairseq-eval-lm --help\n      - fairseq-generate --help\n      - fairseq-interactive --help\n      - fairseq-preprocess --help\n      - fairseq-score --help\n      - fairseq-train --help\n      - fairseq-validate --help\n\nabout:\n  homepage: https://github.com/pytorch/fairseq\n  repository: https://github.com/pytorch/fairseq\n  summary: Facebook AI Research Sequence-to-Sequence Toolkit\n  license: MIT\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - mxr-conda\n    - rluria14\n    - oblute\n    - ndmaxar\n    - sdvillal\n    - jeongseok-meta\n",
