  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.15.1\"\n\npackage:\n  name: typst\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/typst/typst/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: c07909e01a2a6941e52c9b616e48c209c755eed416d62bcf5583c37a4aca01a3\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: linux\n        then:\n          - export OPENSSL_DIR=$PREFIX\n      - cd crates/typst-cli\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .\n        else:\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path .\n      - cargo-bundle-licenses --format yaml --output ../../THIRDPARTY.yml\n      - if: unix\n        then:\n          - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n          - $PREFIX/bin/typst completions zsh > $PREFIX/share/zsh/site-functions/_typst\n          - $PREFIX/bin/typst completions bash > $PREFIX/share/bash-completion/completions/typst\n          - $PREFIX/bin/typst completions fish > $PREFIX/share/fish/vendor_completions.d/typst.fish\n          - mkdir -p $PREFIX/etc/conda/env_vars.d\n          - 'echo {\\\"TYPST_PACKAGE_PATH\\\": \\\"$PREFIX/share/typst/packages\\\", \\\"TYPST_FONT_PATHS\\\": \\\"$PREFIX/fonts\\\"} > $PREFIX/etc/conda/env_vars.d/typst.json'\n        else:\n          - mkdir %PREFIX%\\etc\\conda\\env_vars.d\n          - 'set \"FWD_PREFIX=%PREFIX:\\=/%\"'\n          - 'echo {\"TYPST_PACKAGE_PATH\": \"%FWD_PREFIX%/share/typst/packages\", \"TYPST_FONT_PATHS\": \"%FWD_PREFIX%/fonts\"} > %PREFIX%\\etc\\conda\\env_vars.d\\typst.json'\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n  host:\n    - if: linux\n      then: openssl\n\ntests:\n  - package_contents:\n      bin:\n        - typst\n      files:\n        - etc/conda/env_vars.d/typst.json\n        - if: unix\n          then:\n            - share/bash-completion/completions/typst\n            - share/fish/vendor_completions.d/typst.fish\n            - share/zsh/site-functions/_typst\n      strict: true\n  - script:\n      - typst --version\n      - typst info\n      - if: unix\n        then:\n          - typst info 2>&1 | grep TYPST_FONT_PATHS | grep $CONDA_PREFIX/fonts\n          - typst info 2>&1 | grep TYPST_PACKAGE_PATH | grep $CONDA_PREFIX/share/typst/packages\n        else:\n          - 'set \"FWD_CONDA_PREFIX=%CONDA_PREFIX:\\=/%\"'\n          - 'typst info 2>&1 | findstr TYPST_FONT_PATHS | findstr \"%FWD_CONDA_PREFIX%/fonts\"'\n          - 'typst info 2>&1 | findstr TYPST_PACKAGE_PATH | findstr \"%FWD_CONDA_PREFIX%/share/typst/packages\"'\n  - requirements:\n      run:\n        - font-otf-fontawesome\n    script:\n      - typst fonts\n      - if: unix\n        then:\n          - typst fonts | grep \"Font Awesome\"\n        else:\n          - typst fonts | findstr \"Font Awesome\"\nabout:\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - NOTICE\n    - THIRDPARTY.yml\n  summary: A markup-based typesetting system that is powerful and easy to learn.\n  homepage: https://typst.app\n  repository: https://github.com/typst/typst\n  documentation: https://typst.app/docs\n\nextra:\n  recipe-maintainers:\n    - AdrianFreundQC\n    - freundTech\n    - pavelzw\n",
