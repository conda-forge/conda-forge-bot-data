  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: robocrys\n  version: \"0.2.13\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/robocrys-${{ version }}.tar.gz\n  sha256: 8c52770d37d9e241e1f73ef6a9ad93e3070b1d0fa252aa8377f15bd0485d5719\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv\n  python:\n    entry_points:\n      - robocrys = robocrys.cli:main\n\nrequirements:\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - setuptools\n  run:\n    - ruamel.yaml\n    - inflect\n    - matminer >=0.10.0\n    - monty\n    - networkx\n    - numpy\n    - pubchempy\n    - pybtex\n    - pymatgen >=2024.1.26\n    - python >=${{ python_min }}\n    - scipy >=1.17.0\n    - spglib >=2.5.0\n    - mp-api\n\ntests:\n  - python:\n      imports:\n        - robocrys\n        - robocrys.condense\n      pip_check: false\n      python_version:\n        - ${{ python_min }}\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - robocrys --help\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: Automatic generation of crystal structure descriptions.\n  description: |\n    Robocrystallographer is a tool to generate text descriptions of\n    crystal structures. Similar to how a real-life crystallographer\n    would analyse a structure, robocrystallographer looks at the\n    symmetry, local environment, and extended connectivity when\n    generating a description. The package includes utilities for\n    identifying molecule names, component orientations, heterostructure\n    information, and more...\n  homepage: https://github.com/hackingmaterials/robocrystallographer\n  repository: https://github.com/hackingmaterials/robocrystallographer\n  documentation: https://hackingmaterials.lbl.gov/robocrystallographer/\n\nextra:\n  recipe-maintainers:\n    - jan-janssen\n",
