  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: rocksdb\n  version: \"11.8.1\"\n  build_number: 1\n\npackage:\n  name: rocksdb\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/facebook/rocksdb/archive/v${{ version }}.tar.gz\n  sha256: 618d9726a7cb1cf4ce034f4cdca49de98aa64867dda06b91371a791ae8921aff\n  target_directory: src\n  patches:\n    - remove-unreachable-returns.patch\n\nbuild:\n  number: ${{ build_number }}\n  string: h${{ hash }}_${{ build_number }}_${{ rocksdb_build_ext }}\n  script:\n    file: ${{ \"build.bat\" if win else \"build.sh\" }}\n\nrequirements:\n  build:\n    - ${{ compiler(\"cxx\") }}\n    - ${{ stdlib(\"c\") }}\n    - cmake >=3.5.1,<4\n    - ninja >=1.10,<2\n  host:\n    - gflags\n    - if: rocksdb_build_ext == \"jemalloc\"\n      then: jemalloc\n    - lz4-c\n    - snappy\n    - zstd\n    - bzip2\n    - zlib\n  run_exports:\n    # Symbols are removed from one minor release to the next.\n    # https://abi-laboratory.pro/index.php?view=timeline&l=rocksdb\n    - ${{ pin_subpackage(name, upper_bound='x.x') }}\n\ntests:\n  - script:\n      - if: unix\n        then: test -f ${PREFIX}/lib/librocksdb.a\n      - if: unix\n        then: test -f ${PREFIX}/lib/librocksdb${SHLIB_EXT}\n      - if: unix\n        then: test -f ${PREFIX}/include/rocksdb/db.h\n      - if: win\n        then: if not exist %LIBRARY_PREFIX%\\lib\\rocksdb.lib exit 1\n      - if: win\n        then: if not exist %LIBRARY_PREFIX%\\lib\\rocksdb-shared.lib exit 1\n      - if: win\n        then: if not exist %LIBRARY_PREFIX%\\include\\rocksdb\\db.h exit 1\n\nabout:\n  license: Apache-2.0\n  license_file: src/LICENSE.Apache\n  summary: A library that provides an embeddable, persistent key-value store for fast storage.\n  homepage: https://rocksdb.org\n  repository: https://github.com/facebook/rocksdb\n  documentation: https://rocksdb.org/docs\n\nextra:\n  recipe-maintainers:\n    - jeongseok-meta\n    - benhuff\n    - oblute\n    - rluria14\n    - sodre\n",
