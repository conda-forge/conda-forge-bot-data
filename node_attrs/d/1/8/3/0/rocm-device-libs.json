  "raw_meta_yaml": "context:\n  version: \"7.0.2\"\n  llvm_major_version: \"20\"\n\npackage:\n  name: rocm-device-libs\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ROCm/llvm-project/archive/refs/tags/rocm-${{ version }}.zip\n  sha256: f6ef7f7b0cbf904c8ee223ec84326e0ae4ea88fb11bb2d0f9ece9f9620844b2a\n  patches:\n    - patches/0001-fix-install-path.patch\n\nbuild:\n  number: 1\n  skip: not linux\n  script: build\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    # Workaround for https://github.com/ROCm/llvm-project/commit/a18cc4c7cb51f94182b6018c7c73acde1b8ebddb\n    - cmake <4\n    - make\n  host:\n    - rocm-core ${{ version }}.*\n    # There exists rocm-cmake versions that do not depend on rocm-core, so also constrain\n    # rocm-cmake to the same ROCm release to keep toolchain compatibility.\n    - rocm-cmake ${{ version }}.*\n    - zlib\n    - clangdev ${{ llvm_major_version }}.*\n    - llvmdev ${{ llvm_major_version }}.*\n    - llvm\n\ntests:\n  - requirements:\n      run:\n        - clangdev ${{ llvm_major_version }}.*\n        - llvmdev ${{ llvm_major_version }}.*\n        - lld ${{ llvm_major_version }}.*\n        - compiler-rt ${{ llvm_major_version }}.*\n        - clang-tools ${{ llvm_major_version }}.*\n    files:\n      recipe:\n        - test/hip_smoke_test.hip\n    script:\n      # Check files are in the expected location (the one expected by clang)\n      - test -f ${PREFIX}/lib/clang/${{ llvm_major_version }}/lib/amdgcn/bitcode/hip.bc\n      # Check files are in the location expected by hipcc\n      - test -f ${PREFIX}/amdgcn/bitcode/hip.bc\n      # Test that clang can find the bitcode files out of the box\n      - clang -x hip -nogpuinc -c test/hip_smoke_test.hip -o hip_smoke_test.o\n\nabout:\n  homepage: https://github.com/ROCm/ROCm-Device-Libs\n  license: NCSA\n  license_file: amd/device-libs/LICENSE.TXT\n  summary: ROCm Device libraries\n\nextra:\n  recipe-maintainers:\n    - isuruf\n    - zklaus\n    - conda-forge/rocm-core\n",
