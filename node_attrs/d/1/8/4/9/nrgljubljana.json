  "linux_64_meta_yaml": {
    "about": {
      "description": "NRG Ljubljana is a framework for numerical renormalization group calculations\nfor quantum impurity problems. This recipe builds the C++ runtime and the\nstandalone tools from conda-packaged dependencies.\n\nThe nrginit scripts are installed as part of the package. Using them\nrequires Mathematica at runtime.\n",
      "dev_url": "https://github.com/rokzitko/nrgljubljana",
      "doc_url": "http://auger.ijs.si/nrgljubljana/site/",
      "home": "https://github.com/rokzitko/nrgljubljana",
      "license": "GPL-3.0-or-later",
      "license_file": "COPYING",
      "summary": "Numerical renormalization group framework for quantum impurity problems"
    },
    "build": {
      "ignore_run_exports_from": [
        "fmt"
      ],
      "number": "1"
    },
    "extra": {
      "recipe-maintainers": [
        "rokzitko"
      ]
    },
    "package": {
      "name": "nrgljubljana",
      "version": "2026.06.1"
    },
    "requirements": {
      "build": [
        "c_compiler_stub",
        "cxx_compiler_stub",
        "c_stdlib_stub",
        "cmake >=3.25",
        "ninja"
      ],
      "host": [
        "blas-devel * *blis",
        "eigen",
        "fmt",
        "gmp",
        "gsl",
        "hdf5",
        "highfive",
        "libboost-devel",
        "libboost-mpi",
        "llvm-openmp",
        "mpich",
        "range-v3",
        "blas-devel * *mkl",
        "blas-devel * *openblas"
      ],
      "run": [
        "gmp",
        "gsl",
        "hdf5",
        "libboost-mpi",
        "llvm-openmp",
        "blas-devel * *blis",
        "libblas * *blis",
        "blis",
        "liblapack",
        "mpich",
        "blas-devel * *mkl",
        "libblas * *mkl",
        "mkl",
        "blas-devel * *openblas",
        "libblas * *openblas",
        "libopenblas"
      ]
    },
    "schema_version": 0,
    "source": {
      "sha256": "00457de5ac001c6df78e1dc8cdb246eb536736be67aa130e8ce04314871112c0",
      "url": "https://github.com/rokzitko/nrgljubljana/archive/refs/tags/2026.06.1.tar.gz"
    },
    "test": {
      "commands": [
        "test -x \"${PREFIX}/bin/nrg\"",
        "test -x \"${PREFIX}/bin/adapt\"",
        "test -x \"${PREFIX}/bin/instantiate\"",
        "test -x \"${PREFIX}/nrginit/nrginit\"",
        "test -f \"${PREFIX}/nrginit/nrginit.m\"",
        "test -z \"$(ldd \"${PREFIX}/bin/nrg\" | grep 'not found')\"",
        "test -f \"${PREFIX}/lib/libnrgljubljana_c.so\"",
        "test -f \"${PREFIX}/lib/cmake/nrgljubljana/nrgljubljana-config.cmake\"",
        "test -f \"${PREFIX}/etc/conda/activate.d/nrgljubljana.sh\"",
        "test -f \"${PREFIX}/etc/conda/deactivate.d/nrgljubljana.sh\"",
        "grep -q 'CONDA_PREFIX}/nrginit' \"${PREFIX}/etc/conda/activate.d/nrgljubljana.sh\""
      ]
    }
  },
