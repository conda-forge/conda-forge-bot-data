  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: libblasfeo\n  version: \"0.1.4.3\"\n  build: 0\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/giaf/blasfeo/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 92e33e00be7d2a814ecc982b23bfb86a50b71a168abb9009766801fb957e9046\n  patches:\n    - win-clang-prefetch-cast.patch\n    - fix_version_to_0_1_4_3.patch\n\nbuild:\n  number: >-\n    ${{ build + (\n        100 if (microarch_level | default(1)) in [1, \"1\"]\n        else 300 if (microarch_level | default(1)) in [3, \"3\"]\n        else 400 if (microarch_level | default(1)) in [4, \"4\"]\n        else 0\n        if x86_64 else 0\n    ) }}\n\n  # Selects build.sh on Unix and build.bat on Windows.\n  script:\n    file: build\n    env:\n      # See https://github.com/giaf/blasfeo?tab=readme-ov-file#supported-computer-architectures\n      # and https://clang.llvm.org/docs/UsersManual.html#x86.\n      #\n      # X64_INTEL_CORE is the TARGET setting more similar to nocona,\n      # so we use that for microarch_level == 1.\n      # microarch_level == 3 has AVX and AVX2, so it maps to X64_INTEL_HASWELL.\n      # microarch_level == 4 has AVX512F, so it maps to X64_INTEL_SKYLAKE_X.\n      #\n      # Modern arm processors (e.g. X Elite) have cache sizes more similar\n      # to Apple's M1, so arm64 uses ARMV8A_APPLE_M1.\n      # On Linux aarch64, typical targets are embedded systems like\n      # Raspberry Pi, so we use ARMV8A_ARM_CORTEX_A76.\n      BLASFEO_TARGET: >-\n        ${{\n          \"X64_INTEL_CORE\" if x86_64 and (microarch_level | default(1)) in [1, \"1\"]\n          else \"X64_INTEL_HASWELL\" if x86_64 and (microarch_level | default(1)) in [3, \"3\"]\n          else \"X64_INTEL_SKYLAKE_X\" if x86_64 and (microarch_level | default(1)) in [4, \"4\"]\n          else \"ARMV8A_APPLE_M1\" if arm64\n          else \"ARMV8A_ARM_CORTEX_A76\" if aarch64\n          else \"GENERIC\"\n        }}\n\nrequirements:\n  build:\n    # Note that x86_64-microarch-level doesn't support win,\n    # but we can still specify microarch_level for win builds.\n    # This package only sets the -march flags, but since the build process\n    # is custom anyway, we don't care on win.\n    - if: unix and x86_64\n      then: x86_64-microarch-level ==${{ microarch_level | default(\"1\") }}\n\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - pkg-config\n    - ninja\n\n    - if: win\n      then: clang\n\n  run:\n    - if: x86_64\n      then: _x86_64-microarch-level >=${{ microarch_level | default(\"1\") }}\n\n  run_exports:\n    - ${{ pin_subpackage(name, upper_bound=\"x.x.x\") }}\n\ntests:\n  - package_contents:\n      include:\n        - blasfeo.h\n      lib:\n        - blasfeo\n\n  - script:\n      - cmake-package-check blasfeo --targets blasfeo\n    requirements:\n      run:\n        - cmake-package-check\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n\n  - script:\n      - if: linux\n        then: nm -s $PREFIX/lib/libblasfeo.so | grep \"U \"\n\nabout:\n  homepage: https://github.com/giaf/blasfeo\n  repository: https://github.com/giaf/blasfeo\n  license: BSD-2-Clause\n  license_file: LICENSE.txt\n  summary: Basic linear algebra subroutines for embedded optimization\n\nextra:\n  feedstock-name: blasfeo\n  recipe-maintainers:\n    - RSchwan\n    - traversaro\n",
