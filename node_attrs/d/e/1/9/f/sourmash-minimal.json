  "raw_meta_yaml": "context:\n  version: 4.9.4\n  python_check_max: \"3.14\"\n\npackage:\n  name: sourmash-minimal\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/s/sourmash/sourmash-${{ version }}.tar.gz\n  sha256: 28889d11041e398831875c7d17a367e3e5937b095d006752e45c7f2302f4626d\n\nbuild:\n  number: 2\n  skip: not is_python_min\n  python:\n    version_independent: true\n    entry_points:\n      - sourmash = sourmash.__main__:main\n  dynamic_linking:\n    missing_dso_allowlist:\n      - if: osx\n        then: /usr/lib/libresolv.9.dylib\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: ${{ \"fat\" if not linux and (aarch64 or ppc64le) else \"thin\" }}\n    content:\n      - if: unix\n        then:\n          # Unix recipe\n          - set -ex\n          - set -o xtrace -o nounset -o pipefail -o errexit\n          - if: ppc64le\n            then:\n              # From https://conda-forge.zulipchat.com/#narrow/channel/457337-general/topic/ppc64le.20issues/near/576500347\n              # disable -fno-plt, which causes problems with GCC on PPC\n              - export CFLAGS=\"$(echo $CFLAGS | sed 's/-fno-plt //g')\"\n              - export CXXFLAGS=\"$(echo $CXXFLAGS | sed 's/-fno-plt //g')\"\n              # From https://github.com/conda-forge/rattler-build-feedstock/blob/504fd2e977d6597d2c83332a3e7f0fce023b1d25/recipe/recipe.yaml#L38-L39\n              # Rust 1.90 uses lld by default and has issue linking to conda libraries\n              # compiled with newer gcc\n              - set +u\n              - export RUSTFLAGS=\"$RUSTFLAGS -C link-arg=-fuse-ld=bfd\"\n              - set -u\n      # Run the maturin build via pip which works for direct and cross-compiled builds.\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n      - cd src/core\n      - cargo-bundle-licenses --format yaml --output ${{ SRC_DIR }}/THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }} >=1.85.0\n    - maturin\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - liblzma-devel\n\n    # cross-compilation dependencies\n    - if: build_platform != target_platform\n      then:\n        - python ${{ python_min }}.*\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - cffi\n\n    - if: unix\n      then:\n        - libclang\n        - clangdev\n\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - maturin\n    - toml\n    - cffi\n\n  run:\n    - python >=${{ python_min }}\n    - screed >=1.1.3\n    - cffi >=1.17.1\n    - deprecation >=2.0.6\n    - cachetools >=4,<6\n    - numpy\n    - matplotlib-base\n    - scipy\n    - bitstring >=3.1.9,<5\n\ntests:\n  - python:\n      imports:\n        - sourmash\n      python_version:\n        - ${{ python_min }}.*\n        - ${{ python_check_max }}.*\n      pip_check: true\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - sourmash --help\n      - sourmash info\n\nabout:\n  summary: Compute and compare MinHash signatures for DNA data sets.\n  license: BSD-3-Clause\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/sourmash-bio/sourmash\n  repository: https://github.com/sourmash-bio/sourmash\n  documentation: https://sourmash.bio/\n\nextra:\n  recipe-maintainers:\n    - luizirber\n    - ctb\n    - bluegenes\n",
