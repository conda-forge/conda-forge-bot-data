  "linux_64_meta_yaml": {
    "about": {
      "description": "SciCommander allows running shell commands in a scientifically more\nreproducible and efficient way without invoking a full pipeline tool. The\nmain features includes skipping already available outputs, and generating\nan HTML audit report or reproducing shell script for any output produced by\ncommands ran through SciCommander. SciCommander can also be combined with\npipeline tools to provide additional provenance on the file level.",
      "dev_url": "https://github.com/samuell/scicommander",
      "doc_url": "https://pkg.go.dev/github.com/samuell/scicommander",
      "home": "https://github.com/samuell/scicommander",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Run shell commands in a scientifically reproducible and robust way."
    },
    "build": {
      "number": "0",
      "script": [
        "go-licenses save ./cmd/sci --save_path library_licenses",
        "go build -v -trimpath -o $PREFIX/bin/sci -ldflags=\"-s -w\" ./cmd/sci"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "samuell"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "scicommander",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses"
          ],
          "host": [],
          "run": [
            "graphviz"
          ]
        },
        "tests": [
          {
            "script": "sci help"
          },
          {
            "package_contents": {
              "bin": [
                "sci"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.6.2"
      }
    ],
