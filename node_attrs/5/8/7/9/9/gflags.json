  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.3.0\"\n\npackage:\n  name: gflags\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/gflags/gflags/archive/v${{ version }}.tar.gz\n  sha256: f619a51371f41c0ad6837b2a98af9d4643b3371015d873887f7e8d3237320b2f\n\nbuild:\n  number: 0\n\nrequirements:\n  build:\n    - cmake\n    - make\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n  run_exports:\n    - ${{ pin_subpackage('gflags', upper_bound='x.x') }}\n\ntests:\n  - script:\n      - if: osx\n        then: test -f ${PREFIX}/lib/libgflags.dylib\n      - if: osx\n        then: test -f ${PREFIX}/lib/libgflags_nothreads.dylib\n      - if: linux\n        then: test -f ${PREFIX}/lib/libgflags.so\n      - if: linux\n        then: test -f ${PREFIX}/lib/libgflags_nothreads.so\n      - if: unix\n        then: \n          - test ! -f ${PREFIX}/lib/libgflags.a\n          - test ! -f ${PREFIX}/lib/libgflags_nothreads.a\n        else:\n          - if not exist %PREFIX%\\\\Library\\\\bin\\\\gflags.dll exit 1\n          - if not exist %PREFIX%\\\\Library\\\\lib\\\\gflags.lib exit 1\n          - if exist %PREFIX%\\\\Library\\\\lib\\\\gflags_static.lib exit 1\n\nabout:\n  license: BSD-3-Clause\n  license_file: COPYING.txt\n  summary: A C++ library that implements commandline flags processing.\n  homepage: https://github.com/gflags/gflags\n\nextra:\n  recipe-maintainers:\n    - jakirkham\n    - wesm\n    - xhochy\n",
