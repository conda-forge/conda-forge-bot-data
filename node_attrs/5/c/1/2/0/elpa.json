  "raw_meta_yaml": "{% set name = \"elpa\" %}\n{% set version = \"2026.02.002\" %}\n{% set build = 0 %}\n\n{% if mpi == \"nompi\" %}\n  {% set build = build + 100 %}\n  {% set elpa_suffix = \"_onenode\" %}\n  {% set mpi_prefix = \"nompi\" %}\n{% else %}\n  {% set elpa_suffix = \"\" %}\n  {% set mpi_prefix = \"mpi_\" + mpi %}\n{% endif %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://elpa.mpcdf.mpg.de/software/tarball-archive/Releases/{{ version }}/{{ name }}-{{ version }}.tar.gz\n  sha256: 02e3c59fec53cd8eb66a4cc15fa4fbf190cf9654227223fb8ad55713e9427932\n  patches:\n    - check_thread_affinity.patch\n    - includedir-suffix.patch\n    - pkgconf.patch\n\nbuild:\n  number: {{ build }}\n  skip: true  # [win]\n  string: {{ mpi_prefix }}_h{{ PKG_HASH }}_{{ build }}\n  run_exports:\n    - {{ pin_subpackage(\"elpa\", max_pin=\"x.x.x\") }}\n\nrequirements:\n  build:\n    - {{ compiler(\"c\") }}\n    - {{ stdlib(\"c\") }}\n    - {{ compiler(\"cxx\") }}\n    - {{ compiler(\"fortran\") }}\n    - {{ mpi }}  # [mpi != \"nompi\"]\n    - gnuconfig  # [unix]\n    - make\n    - perl\n    - pkg-config\n  host:\n    - {{ mpi }}  # [mpi != \"nompi\"]\n    - _openmp_mutex\n    - libblas\n    - liblapack\n    - \"libopenblas * *openmp*\"\n    - scalapack  # [mpi != \"nompi\"]\n  run:\n    - {{ mpi }}  # [mpi != \"nompi\"]\n    - _openmp_mutex\n    - libblas\n    - liblapack\n    - \"libopenblas * *openmp*\"\n    - scalapack  # [mpi != \"nompi\"]\n\ntest:\n  requires:\n    - {{ mpi }}  # [mpi != \"nompi\"]\n    - pkg-config\n  commands:\n    # Library presence\n    - test -f \"${PREFIX}/lib/lib{{ name }}{{ elpa_suffix }}${SHLIB_EXT}\"\n    - test -f \"${PREFIX}/lib/lib{{ name }}{{ elpa_suffix }}_openmp${SHLIB_EXT}\"\n    # pkg-config checks\n    - pkg-config --exists {{ name }}{{ elpa_suffix }}  # [build_platform == target_platform]\n    - pkg-config --exists {{ name }}{{ elpa_suffix }}_openmp  # [build_platform == target_platform]\n    # Binary execution checks\n    - {{ name }}2_print_kernels{{ elpa_suffix }}  # [build_platform == target_platform]\n    - {{ name }}2_print_kernels{{ elpa_suffix }}_openmp  # [build_platform == target_platform]\n\nabout:\n  home: https://elpa.mpcdf.mpg.de/\n  doc_url: https://elpa.mpcdf.mpg.de/documentation/\n  dev_url: https://gitlab.mpcdf.mpg.de/elpa/elpa\n  license: LGPL-3.0-only\n  license_file:\n    - LICENSE\n    - COPYING/COPYING\n    - COPYING/gpl.txt\n    - COPYING/lgpl.txt\n  summary: Eigenvalue Solvers for Petaflop-Applications\n  description: |\n    The computation of selected or all eigenvalues and eigenvectors of a symmetric\n    (Hermitian) matrix has high relevance for various scientific disciplines.\n    For the calculation of a significant part of the eigensystem typically direct\n    eigensolvers are used. For large problems, the eigensystem calculations with\n    existing solvers can become the computational bottleneck.\n\nextra:\n  recipe-maintainers:\n    - jan-janssen\n    - awvwgk\n    - yuzie007\n    - mkrack\n",
