  "raw_meta_yaml": "{% set name = \"libcuest\" %}\n{% set version = \"0.1.1.1\" %}\n{% set cuda_compiler_version = cuda_compiler_version | default(\"None\") %}\n{% set abiversion = version.split('.')[0] %}\n{% set majorminorpatch = '.'.join(version.split('.')[:3]) %}\n{% set platform = \"linux-x86_64\" %}  # [linux64]\n{% set platform = \"linux-sbsa\" %}  # [aarch64]\n{% set target_name = \"x86_64-linux\" %}  # [linux64]\n{% set target_name = \"sbsa-linux\" %}  # [aarch64]\n{% set extension = \"tar.xz\" %}  # [not win]\n\npackage:\n  name: {{ name|lower }}-split\n  version: {{ version }}\n\nsource:\n  url: https://developer.download.nvidia.com/compute/cuest/redist/{{ name }}/{{ platform }}/{{ name }}-{{ platform }}-{{ version }}_cuda12-archive.{{ extension }}  # [(cuda_compiler_version or \"\").startswith(\"12\")]\n  url: https://developer.download.nvidia.com/compute/cuest/redist/{{ name }}/{{ platform }}/{{ name }}-{{ platform }}-{{ version }}_cuda13-archive.{{ extension }}  # [(cuda_compiler_version or \"\").startswith(\"13\")]\n  sha256: 25e4b38ab3996c4c8ac5cbe372fce050eaa3a9cea1efd120165d78e735967c5b  # [linux64 and (cuda_compiler_version or \"\").startswith(\"12\")]]\n  sha256: 0a4dbaab73bf78d1a4a11ce0bc9f503fc70b0c24559c0e46d782f0fc688599ba  # [linux64 and (cuda_compiler_version or \"\").startswith(\"13\")]]\n  sha256: 8514f370bae8ada4d2d9b4ab461ad9fe0b61533b5b2a65c35a3ff97f9a919d50  # [linux and aarch64 and (cuda_compiler_version or \"\").startswith(\"12\")]]\n  sha256: a67893e5176d6cc840326af1f0d938d803ca7d353bde0d1e1c503f4050750360  # [linux and aarch64 and (cuda_compiler_version or \"\").startswith(\"13\")]]\n\nbuild:\n  number: 1\n  skip: true  # [not (linux64 or aarch64) or cuda_compiler_version in (\"None\", \"\")]\n\nrequirements:\n  build:\n    - cf-nvidia-tools 1.*  # [linux]\n\noutputs:\n  - name: libcuest\n    build:\n      # Ignore run_exports on cuda-version which we need to add to avoid hash collision as we have multiple CTK support\n      ignore_run_exports:\n        - cuda-version\n      # cuda-version will take care of constraining versions for the following\n      # and thus we should ignore the run exports from them which are more strict\n      ignore_run_exports_from:\n        - libcublas-dev\n        - libcusolver-dev\n        - libcusparse-dev\n        - libnvjitlink-dev\n    files:\n      - lib/libcuest*.so.*\n    requirements:\n      build:\n        - {{ compiler(\"c\") }}\n        - {{ compiler(\"cxx\") }}\n        - {{ stdlib(\"c\") }}\n        - {{ compiler('cuda') }}\n      host:\n        - libcublas-dev\n        - libcusolver-dev\n        - libcusparse-dev\n        - libnvjitlink-dev\n        - cuda-version {{ cuda_compiler_version }}\n      run:\n        - libcublas\n        - libcusolver\n        - libcusparse\n        - libnvjitlink\n        - {{ pin_compatible('cuda-version', max_pin='x', min_pin='x') }}\n    test:\n      commands:\n        - test -f $PREFIX/lib/libcuest.so.{{ majorminorpatch }}\n        - test -L $PREFIX/lib/libcuest.so.{{ abiversion }}\n\n  - name: libcuest-dev\n    build:\n      ignore_run_exports:\n        - cuda-version\n      # Export libcuest for a consuming feedstock that needs libcuest-dev in their host: section\n      # For this lib, the breaking changes occur at the minor version (until major version reaches 1)\n      run_exports:\n        - {{ pin_subpackage(\"libcuest\", max_pin=\"x.x\") }}\n    files:\n      - lib/libcuest*.so\n      - include/\n    requirements:\n      build:\n        - {{ compiler(\"c\") }}\n        - {{ compiler(\"cxx\") }}\n        - {{ stdlib(\"c\") }}\n        - {{ compiler('cuda') }}\n      host:\n        - cuda-version {{ cuda_compiler_version }}\n        - {{ pin_subpackage(\"libcuest\", exact=True) }}\n      run:\n        - {{ pin_compatible(\"cuda-version\", min_pin=\"x\", max_pin=\"x\") }}\n        - {{ pin_subpackage(\"libcuest\", exact=True) }}\n    test:\n      commands:\n        - test -L $PREFIX/lib/libcuest.so\n        - test -f $PREFIX/include/cuest.h\n        - test -d $PREFIX/include/cuest\n\n  - name: libcuest-static\n    build:\n      ignore_run_exports:\n        - cuda-version\n    files:\n      - lib/libcuest_static.a\n    requirements:\n      build:\n        - {{ compiler(\"c\") }}\n        - {{ compiler(\"cxx\") }}\n        - {{ stdlib(\"c\") }}\n        - {{ compiler('cuda') }}\n      host:\n        - cuda-version {{ cuda_compiler_version }}\n        - {{ pin_subpackage(\"libcuest-dev\", exact=True) }}\n      run:\n        - {{ pin_compatible(\"cuda-version\", min_pin=\"x\", max_pin=\"x\") }}\n        - {{ pin_subpackage(\"libcuest-dev\", exact=True) }}\n    test:\n      commands:\n        - test -f $PREFIX/lib/libcuest_static.a\n\nabout:\n  home: https://developer.nvidia.com/cuest\n  license: LicenseRef-NVIDIA-End-User-License-Agreement\n  license_file: LICENSE\n  license_url: https://docs.nvidia.com/cuda/cuest/latest/license.html\n  summary: cuEST - GPU-powered electronic structure theory\n  description: |\n    Fast, GPU-powered components for electronic structure theory\n  doc_url: https://docs.nvidia.com/cuda/cuest/\n\nextra:\n  feedstock-name: libcuest\n  recipe-maintainers:\n    - conda-forge/cuda\n",
