  "raw_meta_yaml": "context:\n  version: \"0.8.0\"\n\npackage:\n  name: crysfml\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/c/crysfml/crysfml-${{ version }}.tar.gz\n  sha256: a4b01a64dc6053fe1d5ca2d2ff0fbf19da8ef59025fc0d83feb5c803f29976a4\n\nbuild:\n  number: 0\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  skip: match(python, \"<3.11\")\n\nrequirements:\n  build:\n    - if: unix\n      then:\n        - make\n        - ${{ stdlib(\"c\") }}\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ compiler('fortran') }}\n        - cmake\n    - if: win\n      then:\n        - ninja\n        - ${{ stdlib(\"m2w64_c\") }}\n        - ${{ compiler(\"m2w64_c\") }}\n        - ${{ compiler(\"m2w64_fortran\") }}\n        - cmake\n    - if: build_platform != host_platform\n      then:\n        - python\n        - cross-python_${{ host_platform }}\n  host:\n    - python\n    - scikit-build-core >=0.11\n    - versioningit\n    - pip\n  run:\n    - python\n    - numpy\n\ntests:\n  - python:\n      imports:\n        - crysfml\n      pip_check: true\n\nabout:\n  summary: Python access to the CrysFML2008 crystallographic Fortran library\n  license: LGPL-3.0-or-later\n  license_file:\n    - LICENSE\n    - repo/CFML/LICENSE\n  homepage: https://pypi.org/project/crysfml/\n\nextra:\n  recipe-maintainers:\n    - MridulS\n",
