  "raw_meta_yaml": "context:\n  version: \"0.10.3\"\n\npackage:\n  name: dra\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/devmatteini/dra/archive/refs/tags/${{ version }}.tar.gz\n  sha256: f37abf2c8bb2ed19789e6ec98ef8e03120be2312f29964911b2227439ce08b0e\n\nbuild:\n  number: 0\n  script:\n    env:\n      AWS_LC_SYS_CMAKE_BUILDER: ${{ \"1\" if win else \"0\" }} # force CMake builder for `aws-lc-sys` native C/C++ code on Windows\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - let bin = ($prefix)/bin/dra\n          - ^$bin completion bash | save ($prefix)/share/bash-completion/completions/dra\n          - ^$bin completion fish | save ($prefix)/share/fish/vendor_completions.d/dra.fish\n          - ^$bin completion zsh  | save ($prefix)/share/zsh/site-functions/_dra\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nushell\n    - if: win\n      then: cmake\n\ntests:\n  - script:\n      - dra --help\n      - dra --version\n  - package_contents:\n      bin:\n        - dra\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/dra\n            - share/fish/vendor_completions.d/dra.fish\n            - share/zsh/site-functions/_dra\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/dra\n            - Library/share/fish/vendor_completions.d/dra.fish\n            - Library/share/zsh/site-functions/_dra\n      strict: true\n\nabout:\n  homepage: https://github.com/devmatteini/dra\n  summary: Download and install release assets from GitHub\n  description: |\n    dra eases downloading and installing release assets from GitHub:\n    no authentication needed for public repositories, built-in generation\n    of patterns to select an asset to download, automatic selection based\n    on your operating system and architecture, and support for downloading\n    and installing assets in the most common formats.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/devmatteini/dra\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
