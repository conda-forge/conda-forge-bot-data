  "linux_64_meta_yaml": {
    "about": {
      "description": "dra eases downloading and installing release assets from GitHub:\nno authentication needed for public repositories, built-in generation\nof patterns to select an asset to download, automatic selection based\non your operating system and architecture, and support for downloading\nand installing assets in the most common formats.",
      "dev_url": "https://github.com/devmatteini/dra",
      "home": "https://github.com/devmatteini/dra",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Download and install release assets from GitHub"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "cargo auditable install --path=. --root=($prefix) --no-track --locked --bins",
          "cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml",
          "mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions",
          "let bin = ($prefix)/bin/dra",
          "^$bin completion bash | save ($prefix)/share/bash-completion/completions/dra",
          "^$bin completion fish | save ($prefix)/share/fish/vendor_completions.d/dra.fish",
          "^$bin completion zsh  | save ($prefix)/share/zsh/site-functions/_dra"
        ],
        "env": {
          "AWS_LC_SYS_CMAKE_BUILDER": "0",
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        },
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "dra",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "nushell"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "dra --help",
              "dra --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "dra"
              ],
              "files": [
                "share/bash-completion/completions/dra",
                "share/fish/vendor_completions.d/dra.fish",
                "share/zsh/site-functions/_dra"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.10.3"
      }
    ],
    "package": {
      "name": "dra",
      "version": "0.10.3"
    },
    "requirements": {
      "build": [
