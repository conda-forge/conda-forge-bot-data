  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.3.2\"\n\npackage:\n  name: pgqueuer\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pgqueuer/pgqueuer-${{ version }}.tar.gz\n  sha256: 11f4c67d9dfc343c02d8bb2e362733a0d44272f6c7e846630fe198f688fa3ed1\n\nbuild:\n  number: 0\n  noarch: python\n  python:\n    # declare the CLI here so conda generates working launchers at install\n    # time; the pip generated pgq.exe hardcodes the build prefix and fails\n    # on Windows\n    entry_points:\n      - pgq = pgqueuer.__main__:main\n  script:\n    env:\n      SETUPTOOLS_SCM_PRETEND_VERSION: ${{ version }}\n    content: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools >=64\n    - setuptools-scm >=8\n    - wheel\n  run:\n    - python >=${{ python_min }}\n    - anyio >=4.0\n    - croniter >=5.0.1\n    - pydantic >=2.0.0\n    - pydantic-settings >=2.6.1\n    - tabulate >=0.9.0\n    - typer >=0.15.1\n    # uvloop is a unix only dependency; the virtual packages let the solver\n    # pick the right noarch variant per platform (see noarch_platforms in\n    # conda-forge.yml)\n    - if: unix\n      then:\n        - __unix\n        - uvloop >=0.22.0\n      else:\n        - __win\n\ntests:\n  - python:\n      imports:\n        - pgqueuer\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      env:\n        # pgqueuer renders --help via rich (Unicode box drawing); force UTF-8\n        # so it works on the default Windows console codepage\n        PYTHONUTF8: \"1\"\n      content:\n        - python -m pgqueuer --help\n        - pgq --help\n\nabout:\n  homepage: https://github.com/janbjorge/pgqueuer\n  repository: https://github.com/janbjorge/pgqueuer\n  documentation: https://github.com/janbjorge/pgqueuer/wiki\n  summary: Pgqueuer is a Python library leveraging PostgreSQL for efficient job queuing\n  license: MIT\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
