  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: tesseract\n  version: \"5.5.3\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/tesseract-ocr/${{ name }}/archive/${{ version }}.tar.gz\n    sha256: 9218e62793116d42a9f6d14cd9348518b27f382096eea3d0f2d1a24616bb5884\n    target_directory: tesseract\n  - url: https://github.com/tesseract-ocr/tessdata_fast/archive/4.1.0.tar.gz\n    sha256: d0e3bb6f3b4e75748680524a1d116f2bfb145618f8ceed55b279d15098a530f9\n    target_directory: tessdata_fast\n\nbuild:\n  number: 0\n  skip: win and vc<14\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('cxx') }}\n    - pkg-config\n    - if: not win\n      then:\n        - autoconf\n        - automake\n        - libtool\n        - make\n    - if: win\n      then:\n        - cmake\n        - ninja\n  host:\n    - giflib\n    - libarchive\n    - libcurl\n    - libjpeg-turbo\n    - leptonica\n    - libpng\n    - libtiff\n    - libwebp\n    - openjpeg\n    - liblzma-devel\n    - zlib\n    - if: osx\n      then:\n        - llvm-openmp\n  run_exports:\n    - ${{ pin_subpackage(name, upper_bound='x.x.x') }}\n\ntests:\n  - files:\n      recipe:\n        - eurotext.tif\n    script:\n      - tesseract --help\n      - tesseract --list-langs\n      - tesseract eurotext.tif outputbase\n      - tesseract --version\n      - if: osx\n        then:\n          - tesseract --version 2>&1 | grep -q 'Found OpenMP'\n      - if: win\n        then:\n          - tesseract --version 2>&1 | findstr /C:\"Found libarchive\" >nul\n        else:\n          - tesseract --version 2>&1 | grep -q 'Found libarchive'\n\nabout:\n  license: Apache-2.0\n  license_file: tesseract/LICENSE\n  summary: An optical character recognition (OCR) engine\n  description: |\n    Tesseract is an OCR engine with support for unicode and the ability\n    to recognize more than 100 languages out of the box. It can be\n    trained to recognize other languages.\n  homepage: https://github.com/tesseract-ocr/tesseract\n  repository: https://github.com/tesseract-ocr/tesseract\n  documentation: https://github.com/tesseract-ocr/tesseract\n\nextra:\n  recipe-maintainers:\n    - mxr-conda\n    - CurtLH\n    - carlodri\n    - oblute\n    - izahn\n",
