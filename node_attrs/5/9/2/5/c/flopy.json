  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: flopy\n  version: \"3.11.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/${{ name[0] }}/${{ name }}/flopy-${{ version }}.tar.gz\n  sha256: b68006f33956b2c86f263084fddf3e5d39b7e57021a600b48350c5ebafe1fac8\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - get-modflow = flopy.utils.get_modflow:cli_main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - hatch-fancy-pypi-readme\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - numpy >=1.20.3,<3.0\n    - matplotlib-base >=1.4.0\n    - pandas >=2.0.0\n  extras:\n    codegen:\n      - boltons >=1.0\n      - Jinja2 >=3.0\n      - modflow-devtools >=1.7.0,!=1.9.0,<2\n      - tomli\n      - tomli-w\n\n    optional:\n      - affine\n      - descartes\n      - fiona\n      - geojson\n      - geopandas\n      - GitPython\n      - h5py\n      - imageio\n      - netcdf4\n      - pooch\n      - pymetis\n      - pyproj\n      - pyshp\n      - pyvista\n      - rasterio\n      - rasterstats\n      - scikit-learn\n      - scipy\n      - shapely >=2.0\n      - vtk >=9.4.0\n      - xmipy\n\ntests:\n  - python:\n      imports:\n        - flopy\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - get-modflow --help\n\nabout:\n  summary: FloPy is a Python package to create, run, and post-process MODFLOW-based models\n  license: CC0-1.0\n  license_file: LICENSE.md\n  homepage: https://github.com/modflowpy/flopy\n\nextra:\n  recipe-maintainers:\n    - kwilcox\n    - ocefpaf\n    - jdhughes-dev\n    - mwtoews\n",
