  "raw_meta_yaml": "context:\n  version: \"3.11.6\"\n\npackage:\n  name: dart-sdk\n  version: ${{ version }}\n\nsource:\n  - if: linux and x86_64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-linux-x64-release.zip\n      sha256: ea0ff2396ea5af402ba3598a9139a0f4b1b3471d9d7e834882d1559622760add\n  - if: linux and aarch64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-linux-arm64-release.zip\n      sha256: 3c1299f468eba0fd77cf9b82d7e768382c1e980837b60ca774a2ceb4f9d7db4b\n  - if: win and x86_64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-windows-x64-release.zip\n      sha256: cb080649faa30708c934890c60fcb065077bcc53c762383dc32666efe92bc276\n  - if: osx and x86_64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-macos-x64-release.zip\n      sha256: 81c726df7c196a5b481a51cec04c6c102c51c8e14c796f85759beeecced8721c\n  - if: osx and arm64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-macos-arm64-release.zip\n      sha256: d3d888758f313af0cba74dcca157d2841772c96e0d47c64dd52bd54dcf11af76\n\nbuild:\n  number: 0\n  skip:\n    - ppc64le\n  dynamic_linking:\n    binary_relocation: false\n    missing_dso_allowlist:\n      # normal linux stuff that would go away if we had libgcc-ng in the run deps\n      - \"*/ld-linux.so.2\"\n      - \"*/lib64/ld-linux-x86-64.so.2\"\n      - \"*/libpthread.so.0\"\n      - \"*/libdl.so.2\"\n      - \"*/libm.so.6\"\n      - \"*/libc.so.6\"\n\ntests:\n  - package_contents:\n      bin:\n        - if: win\n          then: dart.exe\n  - script:\n      - dart --help\n\nabout:\n  homepage: https://dart.dev/\n  license: BSD-3-Clause\n  license_file: LICENSE\n  summary: a client-optimized language for developing fast apps on any platform\n  repository: https://github.com/dart-lang/sdk\n  documentation: https://dart.dev/\n\nextra:\n  recipe-maintainers:\n    - msarahan\n    - munechika-koyo\n",
