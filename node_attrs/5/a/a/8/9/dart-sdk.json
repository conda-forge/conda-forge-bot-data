  "raw_meta_yaml": "context:\n  version: \"3.13.0\"\n\npackage:\n  name: dart-sdk\n  version: ${{ version }}\n\nsource:\n  - if: linux and x86_64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-linux-x64-release.zip\n      sha256: 87902573facd8acacac7ee1fe73fa8d0668e06065016068e2ed6c5c99c6b1ee0\n  - if: linux and aarch64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-linux-arm64-release.zip\n      sha256: 20141a0653327939bb20c4b87b231226beba1128d8a9aedbb30cb5af1a2790d4\n  - if: win and x86_64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-windows-x64-release.zip\n      sha256: 8480a527e621e9b06f1121cb4f56204e5c2b07851021cbe63965399de4d7f407\n  - if: osx and x86_64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-macos-x64-release.zip\n      sha256: 6f75f0d6bc10c00457fb5b8861b26eadc5d883cfd11aa26a8c4f6353af370f47\n  - if: osx and arm64\n    then:\n      url: https://storage.googleapis.com/dart-archive/channels/stable/release/${{ version }}/sdk/dartsdk-macos-arm64-release.zip\n      sha256: 1812d602aed0a9cf7281c93f514a1e1aecf60dc345c4337dba4ff28fa8d398ca\n\nbuild:\n  number: 0\n  skip:\n    - ppc64le\n  dynamic_linking:\n    binary_relocation: false\n    missing_dso_allowlist:\n      # normal linux stuff that would go away if we had libgcc-ng in the run deps\n      - \"*/ld-linux.so.2\"\n      - \"*/lib64/ld-linux-x86-64.so.2\"\n      - \"*/libpthread.so.0\"\n      - \"*/libdl.so.2\"\n      - \"*/libm.so.6\"\n      - \"*/libc.so.6\"\n\ntests:\n  - package_contents:\n      bin:\n        - if: win\n          then: dart.exe\n  - script:\n      - dart --help\n\nabout:\n  homepage: https://dart.dev/\n  license: BSD-3-Clause\n  license_file: LICENSE\n  summary: a client-optimized language for developing fast apps on any platform\n  repository: https://github.com/dart-lang/sdk\n  documentation: https://dart.dev/\n\nextra:\n  recipe-maintainers:\n    - msarahan\n    - munechika-koyo\n",
