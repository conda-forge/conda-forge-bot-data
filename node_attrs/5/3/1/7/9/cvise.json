    "about": {
      "description": "C-Vise is a super-parallel Python port of C-Reduce. The port is fully compatible to C-Reduce and\nuses the same efficient LLVM-based C/C++ reduction tool named `clang_delta`.",
      "dev_url": "https://github.com/marxin/cvise",
      "home": "https://github.com/marxin/cvise",
      "license": "NCSA AND BSD-3-Clause",
      "license_family": "NCSA AND BSD-3-Clause",
      "license_file": "COPYING",
      "summary": "Super-parallel Python port of C-Reduce"
    },
    "build": {
      "number": "0",
      "script": [
        "cmake -S . -B build -G Ninja ${CMAKE_ARGS}",
        "cmake --build build",
        "cmake --install build"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "user202729"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "cvise",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "cxx_compiler_stub",
            "c_stdlib_stub",
            "cmake",
            "flex",
            "ninja"
          ],
          "host": [
            "python",
            "llvmdev 20.*",
            "clangdev 20.*"
          ],
          "run": [
            "python",
            "chardet",
            "pebble",
            "psutil",
            "libclang-cpp20.1",
            "clang-format",
            "unifdef"
          ]
        },
        "tests": [
          {
            "requirements": {
              "run": [
                "clang 20.*"
              ]
            },
            "script": [
              "printf '%s\\n' 'static int nextHi = 1;' 'static int junk(void) { return 0; }' 'int main(void) { return nextHi + junk(); }' > test.c",
              "printf '%s\\n' '#!/bin/sh' 'set -eu' 'clang -c test.c >/dev/null 2>&1 && grep -q nextHi test.c' > interesting.sh",
              "chmod +x interesting.sh",
              "cvise ./interesting.sh test.c",
              "grep -q nextHi test.c",
              "test \"$(wc -c < test.c)\" -lt 80",
              "cvise-delta --help"
            ]
          }
        ],
        "version": "2.12.0"
      },
