  "linux_64_meta_yaml": {
    "about": {
      "description": "Your new coding bestie, now available in your favourite terminal.\nYour tools, your code, and your workflows, wired into your LLM of choice.",
      "dev_url": "https://github.com/charmbracelet/crush",
      "doc_url": "https://pkg.go.dev/github.com/charmbracelet/crush",
      "home": "https://github.com/charmbracelet/crush",
      "license": "FSL-1.1-MIT AND MIT",
      "license_family": "FSL-1.1-MIT AND MIT",
      "license_file": "src/LICENSE.md",
      "summary": "The glamourous AI coding agent for your favourite terminal 💘"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src",
        "go-licenses save . --save_path ../library_licenses --ignore github.com/golang/freetype --ignore github.com/segmentio/asm --ignore github.com/alecthomas/chroma",
        "set -x",
        "go build -v -o $PREFIX/bin/crush -ldflags=\"-s -w -X=github.com/charmbracelet/crush/internal/version.Version=${{ version }}\"",
        "mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d",
        "$PREFIX/bin/crush completion zsh > $PREFIX/share/zsh/site-functions/_crush",
        "$PREFIX/bin/crush completion bash > $PREFIX/share/bash-completion/completions/crush",
        "$PREFIX/bin/crush completion fish > $PREFIX/share/fish/vendor_completions.d/crush.fish"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "crush",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "crush --help",
              "crush --version",
              "crush --version | grep \"crush version ${{ version | replace('.', '\\\\.') }}\""
            ]
          },
          {
            "package_contents": {
              "bin": [
                "crush"
              ],
              "files": [
                "share/bash-completion/completions/crush",
                "share/fish/vendor_completions.d/crush.fish",
                "share/zsh/site-functions/_crush"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.88.0"
      }
    ],
    "package": {
      "name": "crush",
      "version": "0.88.0"
    },
