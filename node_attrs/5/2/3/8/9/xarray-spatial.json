  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  python_min: \"3.12\"\n  version: \"0.10.18\"\n\npackage:\n  name: xarray-spatial\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/x/xarray-spatial/xarray_spatial-${{ version }}.tar.gz\n  sha256: a3db9c28b7ab3cc17ab67caeb0facb4cc6a2a5d74990757b1127ee5ab3a55514\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - xrspatial = xrspatial.__main__:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - python-build\n    - param\n    - pyct\n    - setuptools >=54.1.2\n    - setuptools-scm\n    - vcs_versioning\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - numba >=0.59\n    - scipy >=1.11.2\n    - xarray >=2025.11\n    - numpy >=1.26,<2.5\n    - pandas >=2.2\n    - urllib3 >=2.7\n    # Not in the metadata, but necessary to run the entry-point.\n    - pyct\n\ntests:\n  - python:\n      imports:\n        - xrspatial\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pip\n        - dask\n        - pyarrow\n    script:\n      - xrspatial --help\n\nabout:\n  summary: xarray-based spatial analysis tools\n  license: MIT\n  license_file: LICENSE.txt\n  homepage: https://github.com/xarray-contrib/xarray-spatial\n\nextra:\n  recipe-maintainers:\n    - brendancol\n    - giancastro\n    - ianthomas23\n    - ocefpaf\n    - thuydotm\n",
