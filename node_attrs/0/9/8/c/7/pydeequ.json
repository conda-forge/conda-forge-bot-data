      "description": "PyDeequ is a Python API for Deequ, a library built on top of Apache\nSpark for defining \"unit tests for data\", which measure data\nquality in large datasets. PyDeequ is written to support usage of\nDeequ in Python.",
      "doc_url": "https://pydeequ.readthedocs.io/",
      "home": "https://github.com/awslabs/python-deequ",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "PyDeequ - Unit Tests for Data"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv"
    },
    "extra": {
      "recipe-maintainers": [
        "thewchan"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "pydeequ",
        "requirements": {
          "build": [],
          "host": [
            "pip",
            "poetry-core >=1.0.0",
            "python 3.10.*"
          ],
          "run": [
            "numpy >=1.14.1",
            "pandas >=0.23.0",
            "python >=3.10"
          ]
        },
        "tests": [
          {
            "requirements": {
              "run": [
                "pip",
                "pyspark >=2.4.7,<=3.5",
