  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: libcrcpp\n  version: \"1.2.3.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/d-bahr/CRCpp/archive/refs/tags/release-${{ version }}.tar.gz\n  sha256: 67889781c0137d52b571e083030a3d79bb2ac2ce8c6964ecb1e5bc58d72e2d72\n\nbuild:\n  number: 0\n  script:\n    - if: unix\n      then:\n        - cmake -G Ninja -S . -B build ${CMAKE_ARGS} -DCMAKE_INSTALL_PREFIX=\"${PREFIX}\" -DCMAKE_INSTALL_INCLUDE_DIR=include -DBUILD_TEST=OFF\n        - cmake --install build\n    - if: win\n      then:\n        - cmake -G Ninja -S . -B build %CMAKE_ARGS% -DCMAKE_INSTALL_PREFIX=\"%LIBRARY_PREFIX%\" -DCMAKE_INSTALL_INCLUDE_DIR=include -DBUILD_TEST=OFF\n        - cmake --install build\n\nrequirements:\n  build:\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n  # Header-only: the package ships no compiled artifacts, so it needs no\n  # C/C++ runtime at run time. (noarch: generic used to suppress these.)\n  ignore_run_exports:\n    by_name:\n      - libgcc\n      - libstdcxx\n\ntests:\n  # Layout check. Runs everywhere, including cross-compiled targets, and is\n  # what guards the %PREFIX% vs %PREFIX%\\Library regression this recipe fixes.\n  - package_contents:\n      include:\n        - CRC.h\n      files:\n        exists:\n          - ${{ \"Library/\" if win }}share/cmake/crcpp/CRCppConfig.cmake\n          - ${{ \"Library/\" if win }}share/pkgconfig/CRCpp.pc\n\n  # The remaining tests compile and run a binary, so they only work when the\n  # target is executable on the builder. macOS cannot run arm64 binaries on an\n  # x86_64 runner (EBADARCH), so cross-compiled targets are skipped.\n  - if: unix and target_platform == build_platform\n    then:\n      - script:\n          - cmake -G Ninja -S . -B build ${CMAKE_ARGS} -DCMAKE_INSTALL_INCLUDE_DIR=include -DBUILD_TEST=ON\n          - cmake --build build\n          - ctest --test-dir build --output-on-failure\n          # $LDFLAGS carries -Wl,-rpath,$PREFIX/lib; without it the binary\n          # cannot locate libstdc++.so.6 when run under emulation.\n          - ${CXX} ${CXXFLAGS} ${LDFLAGS} -std=c++11 -I\"${PREFIX}/include\" test.cpp -o crcpp-test\n          - ./crcpp-test\n        files:\n          source:\n            - CMakeLists.txt\n            - cmake/\n            - inc/\n            - test/\n          recipe:\n            - test.cpp\n        requirements:\n          build:\n            - ${{ compiler('cxx') }}\n            - ${{ stdlib('c') }}\n            - cmake\n            - ninja\n          # The test binary links a C++ runtime even though the package\n          # itself ships none. On cross-compiled targets (aarch64, ppc64le)\n          # the test runs under emulation, so the runtime must be present in\n          # the test's run env -- the build env holds the wrong architecture.\n          run:\n            - if: linux\n              then: libstdcxx\n            - if: osx\n              then: libcxx\n  - if: win and target_platform == build_platform\n    then:\n      - script:\n          - cmake -G Ninja -S . -B build %CMAKE_ARGS% -DCMAKE_INSTALL_INCLUDE_DIR=include -DBUILD_TEST=ON\n          - cmake --build build\n          - ctest --test-dir build --output-on-failure\n          - '%CXX% /std:c++14 /I\"%LIBRARY_PREFIX%\\include\" test.cpp /Fe:crcpp-test.exe'\n          - crcpp-test.exe\n        files:\n          source:\n            - CMakeLists.txt\n            - cmake/\n            - inc/\n            - test/\n          recipe:\n            - test.cpp\n        requirements:\n          build:\n            - ${{ compiler('cxx') }}\n            - ${{ stdlib('c') }}\n            - cmake\n            - ninja\n\nabout:\n  homepage: https://github.com/d-bahr/CRCpp\n  repository: https://github.com/d-bahr/CRCpp\n  summary: Header-only C++ library for CRC calculations\n  license: BSD-3-Clause\n  license_file: LICENSE\n\nextra:\n  feedstock-name: crcpp\n  recipe-maintainers:\n    - swahtz\n",
