  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: PyGEL3D\n  version: \"0.8.2\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/janba/GEL/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 050c61cf4382f3c1b8dec6d207a83ef28d5c912e4ef5628112a3a8b8ef6f2517\n  patches:\n    # Remove once upstream no longer forces universal2 and its own deployment target.\n    - patches/0001-respect-conda-osx-settings.patch\n\nbuild:\n  number: 0\n  script:\n    - if: unix\n      then: cmake ${CMAKE_ARGS} -S . -B build -G Ninja -DUse_GLGraphics=OFF -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release\n    - if: win\n      then: cmake %CMAKE_ARGS% -S . -B build -G Ninja -DUse_GLGraphics=OFF -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release\n    - if: linux\n      then:\n        - cmake --build build --config Release --parallel 1\n        - export PYGEL_NATIVE_LIB=\"${SRC_DIR}/build/libPyGEL.so\"\n    - if: osx\n      then:\n        - cmake --build build --config Release --parallel ${CPU_COUNT}\n        - export PYGEL_NATIVE_LIB=\"${SRC_DIR}/build/libPyGEL.dylib\"\n    - if: win\n      then:\n        - cmake --build build --config Release --parallel %CPU_COUNT%\n        - set \"PYGEL_NATIVE_LIB=%SRC_DIR%\\build\\PyGEL.dll\"\n    - python -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"cxx\") }}\n    - ${{ stdlib(\"c\") }}\n    - cmake >=3.25\n    - ninja\n  host:\n    - python\n    - pip\n    - setuptools >=77\n    - wheel\n  run:\n    - python\n    - numpy\n    - plotly >=5.24.1,<6\n    - scipy\n\ntests:\n  - python:\n      imports:\n        - pygel3d\n        - pygel3d.hmesh\n  - script:\n      - pip check\n      - python run_test.py\n    files:\n      recipe:\n        - run_test.py\n    requirements:\n      run:\n        - pip\n        - python\n\nabout:\n  homepage: https://github.com/janba/GEL\n  summary: Python bindings for GEL polygonal mesh geometry processing\n  license: MIT\n  license_file: LICENSE.md\n\nextra:\n  recipe-maintainers:\n    - jeongseok-meta\n",
