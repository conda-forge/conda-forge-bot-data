-where-complete.patch\n    - patches/0022-s-write_ops-define-ChildWriteOp-before-WriteOp-so-vector-ChildWriteOp-is-complete.patch\n    - patches/0023-storage-backup_block-replace-boost-filesystem-change_extension-removed-in-boost-1.87.patch\n    - patches/0024-pcre-drop-ERROR_CONDITION_ATOMIC_ASSERTION_EXPECTED-removed-in-pcre2-10.45.patch\n    - patches/0025-mozjs-gate-wrapper-comparison-operators-ElementType-behind-DefineComparisonOps-for-MSVC-14.4x.patch  # [win]\n    - patches/0026-mozjs-constrain-ProtectedData-for-C-20-MSVC-14.4x.patch  # [win]\n    - patches/0027-resharding_util-split-deeply-nested-pipeline-literals-to-avoid-MSVC-C1060.patch  # [win]\n    - patches/0028-SConstruct-use-conda-activated-msvc-env.patch  # [win]\nbuild:\n  number: 0\n  detect_binary_files_with_prefix: false\n  # MongoDB distributes ppc64le only for Enterprise Edition\n  skip: True  # [ppc64le]\n  missing_dso_whitelist:   # [osx]\n    - /usr/lib/libresolv.9.dylib  # [osx]\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ stdlib(\"c\") }}\n    - {{ compiler('cxx') }}\n    - python 3.10.*\n    - ninja\n    - cheetah3\n    - packaging\n    - regex\n    - requirements-parser\n    - setuptools\n    - pymongo >=3.9\n    - psutil\n    - pyyaml >=3.0\n  host:\n    - libboost-devel\n    - icu\n    # Windows build uses WinHTTP\n    - libcurl  # [not win]\n    # MacOS uses 'Secure Transport'\n    # Windows uses 'SChannel'\n    - openssl  # [linux]\n    - pcre2\n    - snappy\n    - yaml-cpp\n    - zlib\n    - zstd\n\ntest:\n  commands:\n    - mongod --version\n    - mongos --version\n    - mongod --help\n    - mongos --help\n\nabout:\n  home: https://www.mongodb.com/\n  license: SSPL-1.0\n  license_family: OTHER\n  license_file:\n    - LICENSE-Community.txt\n     # fmt can be unvendored after upgrading to >=4.3.3\n     # xref: https://github.com/mongodb/mongo/commit/eacfb9c5\n    - src/third_party/fmt/dist/LICENSE.rst\n     # Part of boost, but requires code changes to unvendor the dep or\n     # packaging asio as a separate package\n    - src/third_party/asio-master/asio/LICENSE_1_0.txt\n    # abseil is statically linked from the vendored copy (no longer unvendored)\n    - src/third_party/abseil-cpp/dist/LICENSE\n     # Can be unvendored, needs to be packaged\n    - {{ RECIPE_DIR }}/libstemmer_COPYING\n     # IMO, this one is okay, it isn't used anywhere but mongodb\n    - src/third_party/wiredtiger/LICENSE\n     # Can be packaged\n    - src/third_party/IntelRDFPMathLib20U1/eula.txt\n     # This one is a discontinued project\n    - src/third_party/libmongocrypt/dist/kms-message/COPYING\n    - src/third_party/libmongocrypt/dist/kms-message/THIRD_PARTY_NOTICES\n     # Can be packaged, but build system doesn't have --system flag for it\n    - src/third_party/s2/LICENSE-2.0.txt\n     # A consolidated version for all 3rd party with SHAs and license names\n     # (Not all of them are statically linked)\n    - README.third_party.md\n  summary: A next-gen database that lets you do things you could never do before\n  description: |\n    MongoDB is a general-purpose, document-based, distributed database built\n    for modern application developers and for the cloud era. This package\n    provides the community edition `mongod` server and `mongos` router.\n  doc_url: https://docs.mongodb.org/manual/\n  dev_url: https://github.com/mongodb/mongo\n\nextra:\n  recipe-maintainers:\n    - nehaljwani\n    - h-vetinari\n",
