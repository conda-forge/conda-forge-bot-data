  "linux_64_meta_yaml": {
    "about": {
      "description": "This program provides a SUSY spectrum in the NMSSM, or the MSSM including\nflavour violation and with or without R-parity consistent with input\nStandard Model fermion mass/mixings and electroweak/strong coupling data.\nThe R-parity violating mode can calculate neutrino masses and mixings to\n1 loop.\nSOFTSUSY can be used in conjunction with other programs for many different\nparticle physics calculations.\nSOFTSUSY now has a mode with 3 loop RGEs and some 2-loop threshold\ncorrection and 2-loop SUSY QCD corrections to gluino and squark pole masses.\nSOFTSUSY now computes decay branching ratios for the MSSM and NMSSM.\nIt also ships with (and links to) Himalaya-1.0 for three-loop corrections\nto mh0.",
      "dev_url": "https://github.com/BAllanach/softsusy",
      "doc_url": "https://softsusy.hepforge.org/html/",
      "home": "https://softsusy.hepforge.org/",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "README.md",
      "summary": "Calculates supersymmetric particle spectra"
    },
