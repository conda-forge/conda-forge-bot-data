  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.7.0\"\n\npackage:\n  name: asimov\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/a/asimov/asimov-${{ version }}.tar.gz\n  sha256: ed396529214e0db9665b63cf51445bbfa49c52d5e438f6387bc419431a3c5c85\n\nbuild:\n  number: 0\n  noarch: python\n  python:\n    entry_points:\n      - asimov = asimov.olivaw:olivaw\n      - locutus = asimov.locutus:cli\n      - olivaw = asimov.olivaw:olivaw\n  script: ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - setuptools\n    - setuptools_scm\n  run:\n    - click\n    - flask\n    - git\n    - gitpython\n    - liquidpy\n    - networkx\n    - numpy\n    - otter-report >=0.3.3\n    - pillow >=10.2.0\n    - pydantic >=2.0.0\n    - python >=${{ python_min }}\n    - python-gitlab\n    - python-htcondor\n    - pytz\n    - pyyaml\n    - requests\n    - setuptools <82.0.0a0\n    - tinydb\n\ntests:\n  - python:\n      imports:\n        - asimov\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - git\n    script:\n      - locutus --help\n      - asimov --help\n      - olivaw --help\n\nabout:\n  summary: Parameter Estimation automator for gravitational wave analyses.\n  description: |\n    Asimov is a python package designed to make organising and monitoring data analysis jobs easier.\n  homepage: https://asimov.docs.ligo.org/asimov/\n  repository: https://git.ligo.org/asimov/asimov.git\n  documentation: https://asimov.docs.ligo.org/asimov/\n  license: ISC\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - ColmTalbot\n    - duncanmmacleod\n    - transientlunatic\n",
