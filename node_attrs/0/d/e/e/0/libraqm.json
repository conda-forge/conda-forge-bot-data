  "raw_meta_yaml": "context:\n  version: \"0.10.5\"\n\npackage:\n  name: libraqm\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/HOST-Oman/libraqm/releases/download/v${{ version }}/raqm-${{ version }}.tar.xz\n  sha256: 563053e724892a7b037913110ea2daef50ad575d4fa9f7c368ae1e4515f5e856\n  patches:\n    - patches/0001-undef-NDEBUG-for-tests.patch\n\nbuild:\n  number: 0\n  script: build\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - meson\n    - ninja\n    - pkg-config\n  host:\n    - freetype\n    - fribidi\n    - harfbuzz\n    # needed for harfbuzz pkg-config metadata\n    - glib\n    - if: win\n      then:\n        # needed for freetype pkg-config metadata\n        - zlib\n    # for running tests, see\n    # https://github.com/HOST-Oman/libraqm/blob/v0.10.5/tests/meson.build#L1\n    - python *\n  run_exports:\n    - ${{ pin_subpackage(\"libraqm\", upper_bound=\"x.x\") }}\n  ignore_run_exports:\n    from_package:\n      - glib\n      - zlib\n      - python\n\ntests:\n  - package_contents:\n      include:\n        - raqm.h\n      lib:\n        - if: unix\n          then: raqm\n      files:\n        # soversion breaks `lib:` pattern\n        - if: win\n          then:\n            - Library\\bin\\raqm-0.dll\n            - Library\\lib\\raqm.lib\n\nabout:\n  homepage: https://github.com/HOST-Oman/libraqm\n  summary: 'A library for complex text layout'\n  license: MIT\n  license_file: COPYING\n  repository: https://github.com/HOST-Oman/libraqm\n\nextra:\n  recipe-maintainers:\n    - h-vetinari\n",
