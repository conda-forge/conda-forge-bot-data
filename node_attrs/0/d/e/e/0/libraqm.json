  "raw_meta_yaml": "context:\n  version: \"0.11.0\"\n\nrecipe:\n  name: libraqm\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/HOST-Oman/libraqm/releases/download/v${{ version }}/raqm-${{ version }}.tar.xz\n  sha256: 3d0add115f7d4a9410d3377462ed3c05e86342193ef984183e4380e3787b2d4c\n  patches:\n    - patches/0001-undef-NDEBUG-for-tests.patch\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: libraqm\n    build:\n      script:\n        file: build\n    requirements:\n      build:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('c') }}\n        - meson\n        - ninja\n        - pkg-config\n      host:\n        - freetype\n        - fribidi\n        - libharfbuzz-devel\n        # for running tests, see\n        # https://github.com/HOST-Oman/libraqm/blob/v0.10.5/tests/meson.build#L1\n        - python *\n      run_exports:\n        - ${{ pin_subpackage(\"libraqm\", upper_bound=\"x.x\") }}\n      ignore_run_exports:\n        from_package:\n          - python\n    tests:\n      - package_contents:\n          include:\n            - raqm.h\n          lib:\n            - if: unix\n              then: raqm\n          files:\n            # soversion breaks `lib:` pattern\n            - if: win\n              then:\n                - Library\\bin\\raqm-0.dll\n                - Library\\lib\\raqm.lib\n\n  - package:\n      name: libraqm-devel\n    requirements:\n      host:\n        - ${{ pin_subpackage(\"libraqm\", exact=True) }}\n      run:\n        - ${{ pin_subpackage(\"libraqm\", exact=True) }}\n        - libharfbuzz-devel\n      run_exports:\n        - ${{ pin_subpackage(\"libraqm\", upper_bound=\"x.x\") }}\n    tests:\n      - requirements:\n          run:\n            - pkg-config\n        script:\n          - pkg-config --print-errors --exact-version \"${{ version }}\" raqm\n\nabout:\n  homepage: https://github.com/HOST-Oman/libraqm\n  summary: 'A library for complex text layout'\n  license: MIT\n  license_file: COPYING\n  repository: https://github.com/HOST-Oman/libraqm\n\nextra:\n  recipe-maintainers:\n    - h-vetinari\n",
