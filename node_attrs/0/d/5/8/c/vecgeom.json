  "raw_meta_yaml": "context:\n  version: \"2.0.0\"\n\npackage:\n  name: vecgeom\n  version: ${{ version }}\n\nsource:\n  url: https://gitlab.cern.ch/VecGeom/VecGeom/-/archive/v${{ version }}/VecGeom-v${{ version }}.tar.gz\n  sha256: 509d26ffd95d517094d2fe97712a0a54ac0300bd943de3ae626bf4abeb1b6424\n\nbuild:\n  script:\n    - cmake -S . -B build -G Ninja -DCUDA=OFF -DBACKEND=Vc -DBENCHMARK=OFF -DVECGEOM_VECTOR=sse2 -DBUILTIN_VECCORE=OFF -DBUILD_TESTING=ON -DBUILD_DOC=OFF -DVECGEOM_GDML=OFF ${CMAKE_ARGS}\n    - cmake build -LH\n    - cmake --build build --parallel ${CPU_COUNT}\n    # Test binaries are built for the target; only run them on native builds.\n    - if: build_platform == target_platform\n      then:\n        - if: osx\n          then: ctest --test-dir build --output-on-failure --verbose -E \"create_geometry|AssemblyTest|TestGeoManager\"\n          else: ctest --test-dir build --output-on-failure --verbose\n    - cmake --install build\n  number: 0\n  skip:\n    - win\n\nrequirements:\n  build:\n    - ${{ compiler(\"cxx\") }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - ninja\n  host:\n    - veccore\n  run_exports:\n    - ${{ pin_subpackage(\"vecgeom\", upper_bound=\"x.x\") }}\ntests:\n  - package_contents:\n      lib:\n        - vecgeom\n      include:\n        - VecGeom/*\n      files:\n        - lib/cmake?VecGeom/*\n      strict: true\n\nabout:\n  homepage: https://gitlab.cern.ch/VecGeom/VecGeom\n  summary: 'A geometry modeller library with hit-detection features - VecGeom'\n  description: |\n    VecGeom is a geometry modeller library with hit-detection features as needed by particle detector simulation at the LHC and beyond.\n    It was incubated by a Geant-R&D initiative and the motivation to combine the code of Geant4 and ROOT/TGeo into a single, better\n    maintainable piece of software within the EU-AIDA program.\n  license: Apache-2.0\n  license_file: LICENSE.txt\n  repository: https://gitlab.cern.ch/VecGeom/VecGeom\n\nextra:\n  recipe-maintainers:\n    - utk4r-sh\n    - GiacomoXT\n    - vvsagar\n    - AlexanderHeidelbach\n",
