    "about": {
      "description": "VecGeom is a geometry modeller library with hit-detection features as needed by particle detector simulation at the LHC and beyond.\nIt was incubated by a Geant-R&D initiative and the motivation to combine the code of Geant4 and ROOT/TGeo into a single, better\nmaintainable piece of software within the EU-AIDA program.",
      "dev_url": "https://gitlab.cern.ch/VecGeom/VecGeom",
      "home": "https://gitlab.cern.ch/VecGeom/VecGeom",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE.txt",
      "summary": "A geometry modeller library with hit-detection features - VecGeom"
    },
    "build": {
      "number": "0",
      "run_exports": {
        "weak": [
          "vecgeom"
        ]
      },
      "script": [
        "cmake -S . -B build -G Ninja -DCUDA=OFF -DBACKEND=Vc -DBENCHMARK=OFF -DVECGEOM_VECTOR=sse2 -DBUILTIN_VECCORE=OFF -DBUILD_TESTING=ON -DBUILD_DOC=OFF -DVECGEOM_GDML=OFF ${CMAKE_ARGS}",
        "cmake build -LH",
        "cmake --build build --parallel ${CPU_COUNT}",
        "ctest --test-dir build --output-on-failure --verbose",
        "cmake --install build"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "utk4r-sh",
        "GiacomoXT",
        "vvsagar",
        "AlexanderHeidelbach"
      ]
    },
