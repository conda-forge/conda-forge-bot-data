  "linux_64_meta_yaml": {
    "about": {
      "description": "LeanCTX is a local context engineering layer for AI coding agents. It\nprovides repository access, command execution, context compression,\npersistent memory, access controls, and context usage reporting.",
      "dev_url": "https://github.com/yvgude/lean-ctx",
      "doc_url": "https://leanctx.com/docs/getting-started",
      "home": "https://leanctx.com/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Context engineering layer for AI coding agents"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cd rust",
          "export CARGO_FEATURE_UNPREFIXED_MALLOC_ON_SUPPORTED_PLATFORMS=1",
          "export JEMALLOC_OVERRIDE=\"${PREFIX}/lib/libjemalloc${SHLIB_EXT}\"",
          "cargo auditable install --locked --no-track --bins --root \"${LIBRARY_PREFIX:-${PREFIX}}\" --path .",
          "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml"
        ],
        "env": {
          "LIBSQLITE3_SYS_USE_PKG_CONFIG": "1",
          "ZSTD_SYS_USE_PKG_CONFIG": "1"
        },
        "interpreter": "brush"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "baszalmstra"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "lean-ctx",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "brush",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "pkg-config"
          ],
          "host": [
            "sqlite",
            "zstd",
            "jemalloc"
          ],
          "run": [
            "onnxruntime-cpp"
          ]
        },
        "tests": [
          {
            "script": [
              "lean-ctx --help",
              "lean-ctx --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "lean-ctx"
              ],
              "strict": true
            }
          }
        ],
        "version": "3.9.18"
      }
    ],
