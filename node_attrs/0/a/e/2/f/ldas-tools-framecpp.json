  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: ldas-tools-framecpp\n  version: 4.1.0\n  # dependency versions\n  ldas_tools_al_version: 2.10.0\n  ldas_tools_cmake_version: 1.5.0\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://software.igwn.org/sources/source/${{ name }}-${{ version }}.tar.gz\n  sha256: 8bfd356ccfbca9edc3e927a8750611e06b7f5650d216f12bcc7b3b24d8918901\n  patches:\n    - if: osx\n      then: largeframetest-timeout.patch\n    # Backport patch for https://git.ligo.org/computing/ldastools/LDAS_Tools/-/work_items/363\n    - test-fixtures_required.patch\n\nbuild:\n  dynamic_linking:\n    overdepending_behavior: error\n  number: 0\n  skip:\n    - win\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('cxx') }}\n    - cmake >=3.12,<4.0.0a0\n    - make\n    - pkg-config\n  host:\n    - libboost-devel\n    - gmock\n    - gtest\n    - ldas-tools-al >=${{ ldas_tools_al_version }}\n    - ldas-tools-cmake >=${{ ldas_tools_cmake_version }}\n    - openssl\n    - zlib\n    - zstd\n  run_exports:\n    - ${{ pin_subpackage(\"ldas-tools-framecpp\", upper_bound=\"x.x\") }}\n  ignore_run_exports:\n    by_name:\n      - gtest\n\ntests:\n  - requirements:\n      run:\n        - pkg-config\n    script:\n      - set -x\n      - framecpp_sample --channel-adc-type int_2u\n      - if: build_platform == target_platform\n        then:\n          - framecpp_checksum --verbose --checksum-file --checksum-frame --checksum-structure Z-ilwd_test_frame-600000000-1.gwf\n          - framecpp_compressor --compression-level 9 --output compressed.gwf Z-ilwd_test_frame-600000000-1.gwf\n          - framecpp_dump_channel --channel Z0:RAMPED_INT_2U_1 Z-ilwd_test_frame-600000000-1.gwf\n          - framecpp_dump_objects --silent Z-ilwd_test_frame-600000000-1.gwf\n          - framecpp_dump_toc Z-ilwd_test_frame-600000000-1.gwf\n          - framecpp_fix_metadata --output fixed.gwf Z-ilwd_test_frame-600000000-1.gwf\n          - framecpp_fracfg --channels Z0:RAMPED_INT_2U_1 --output fracfg.gwf Z-ilwd_test_frame-600000000-1.gwf\n          - framecpp_dump_toc fracfg.gwf\n          - framecpp_transform --help\n          - framecpp_verify --verbose 1 Z-ilwd_test_frame-600000000-1.gwf\n      # pkg-config version checks\n      - pkg-config --print-errors --exact-version ${{ version }} framecpp\n      - pkg-config --print-errors --exact-version ${{ version }} framecpp_common\n      - pkg-config --print-errors --exact-version ${{ version }} framecppc\n      - pkg-config --print-errors --exact-version ${{ version }} framecppu\n\nabout:\n  summary: LDAS tools libframecpp toolkit runtime files\n  description: |\n    This provides the runtime libraries for the framecpp library.\n  homepage: https://wiki.ligo.org/Computing/LDASTools\n  repository: https://git.ligo.org/ldastools/LDAS_Tools.git\n  documentation: https://computing.docs.ligo.org/ldastools/LDAS_Tools/ldas-tools-framecpp/\n  license: GPL-2.0-or-later\n  license_file: COPYING\n\nextra:\n  recipe-maintainers:\n    - duncanmmacleod\n    - emaros\n",
