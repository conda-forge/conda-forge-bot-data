  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: pydap\n  version: \"3.5.11\"\n  python_min: \"3.12\"\n\nrecipe:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/pydap-${{ version }}.tar.gz\n  sha256: ec4929d6b91618a34534fc872ab3879042b934c511fc4c6181efea9114b9521a\n\nbuild:\n  number: 0\n  noarch: python\n\noutputs:\n  - package:\n      name: pydap\n    build:\n      noarch: python\n      script: python -m pip install . -vv --no-deps --no-build-isolation\n    requirements:\n      host:\n        - python >=${{ python_min }}\n        - setuptools >=64\n        - setuptools-scm >=8\n        - pip\n      run:\n        - python >=${{ python_min }}\n        - numpy\n        - requests\n        - requests-cache\n        - scipy\n        - webob >=1.8.10\n        - beautifulsoup4\n        - lxml\n        # optional, server, but required to pass the import test\n        - docopt-ng\n        - jinja2\n    tests:\n      - python:\n          imports:\n            - pydap\n          pip_check: true\n          python_version: =${{ python_min }}\n      - requirements:\n          run:\n            - python =${{ python_min }}\n            - if: not win\n              then: gunicorn\n            - if: not win\n              then: pastedeploy\n            - pip\n        script:\n          - if: not win\n            then: pydap -h\n  - package:\n      name: pydap-server\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python >=${{ python_min }}\n        - setuptools >=64\n        - setuptools-scm >=8\n        - pip\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage(\"pydap\", exact=True) }}\n        - beautifulsoup4\n        - docopt-ng\n        - gunicorn\n        - jinja2\n        - lxml\n        - PasteDeploy\n        - Webob\n    tests:\n      - python:\n          imports:\n            - pydap\n          pip_check: true\n          python_version: =${{ python_min }}\n      - requirements:\n          run:\n            - python =${{ python_min }}\n            - if: not win\n              then: gunicorn\n            - if: not win\n              then: pastedeploy\n            - pip\n        script:\n          - if: not win\n            then: pydap -h\n\nabout:\n  summary: A pure python implementation of the Data Access Protocol.\n  license: MIT\n  license_file: LICENSE\n  homepage: https://pydap.github.io/pydap/intro.html\n\nextra:\n  recipe-maintainers:\n    - ocefpaf\n    - Mikejmnez\n",
