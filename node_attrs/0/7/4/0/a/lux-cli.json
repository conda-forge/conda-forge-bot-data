      "dev_url": "https://github.com/lumen-oss/lux",
      "home": "https://lux.lumen-labs.org/",
      "license": "LGPL-3.0-or-later",
      "license_family": "LGPL-3.0-or-later",
      "license_file": "LICENSE",
      "summary": "A luxurious package manager for Lua"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cd lux-cli",
          "export OPENSSL_NO_VENDOR=1",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins",
          "mkdir -p \"$PREFIX\"/share/man/man1 \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions",
          "cargo run --locked --package=xtask -- dist-completions",
          "cargo run --locked --package=xtask -- dist-man",
          "cp ../target/dist/lx.bash \"$PREFIX\"/share/bash-completion/completions/lx",
          "cp ../target/dist/lx.fish \"$PREFIX\"/share/fish/vendor_completions.d/lx.fish",
          "cp ../target/dist/_lx     \"$PREFIX\"/share/zsh/site-functions/_lx",
          "cp ../target/dist/lx.1    \"$PREFIX\"/share/man/man1/",
          "cp ../target/dist/lux*.1  \"$PREFIX\"/share/man/man1/",
          "cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
