  "raw_meta_yaml": "context:\n  version: \"0.39.9\"\n\npackage:\n  name: lux-cli\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/lumen-oss/lux/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 62f3c3bceca2ce3cc78ad6fb414c8373a22cd9d8477e7090d8f9ec8e6c8c45bb\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - cd lux-cli\n      - if: osx\n        # instruct Apple's `ld64` linker to drop unused OpenSSL symbols and to add correct `@rpath` for xtask\n        then: export RUSTFLAGS=\"${RUSTFLAGS} -C link-arg=-Wl,-dead_strip_dylibs -C link-arg=-Wl,-rpath,${PREFIX}/lib\"\n      - if: unix\n        then:\n          - export OPENSSL_NO_VENDOR=1 # force linking to host's (conda-forge's) OpenSSL libs\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n          # generate shell completions and manpage\n          - mkdir -p \"$PREFIX\"/share/man/man1 \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n          - cargo run --locked --package=xtask -- dist-completions\n          - cargo run --locked --package=xtask -- dist-man\n          - cp ../target/dist/lx.bash \"$PREFIX\"/share/bash-completion/completions/lx\n          - cp ../target/dist/lx.fish \"$PREFIX\"/share/fish/vendor_completions.d/lx.fish\n          - cp ../target/dist/_lx     \"$PREFIX\"/share/zsh/site-functions/_lx\n          - cp ../target/dist/lx.1    \"$PREFIX\"/share/man/man1/\n          - cp ../target/dist/lux*.1  \"$PREFIX\"/share/man/man1/\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins --no-default-features --features=vendored\n          # generate shell completions and manpage\n          - if not exist \"%LIBRARY_PREFIX%\"\\share\\man\\man1 mkdir \"%LIBRARY_PREFIX%\"\\share\\man\\man1\n          - if not exist \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n          - if not exist \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n          - if not exist \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n          - cargo run --locked --package=xtask -- dist-completions\n          - cargo run --locked --package=xtask -- dist-man\n          - copy ..\\target\\dist\\lx.bash \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\lx\n          - copy ..\\target\\dist\\lx.fish \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\lx.fish\n          - copy ..\\target\\dist\\_lx     \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_lx\n          - copy ..\\target\\dist\\lx.1    \"%LIBRARY_PREFIX%\"\\share\\man\\man1\\\n          - copy ..\\target\\dist\\lux*.1  \"%LIBRARY_PREFIX%\"\\share\\man\\man1\\\n      - cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - cmake\n    - make\n    - perl\n    - pkg-config\n  host:\n  - if: unix\n    then:\n     - gpgme\n     - libgit2\n     - libgpg-error\n     - openssl\n\ntests:\n  - script:\n      - lx --help\n      - lx --version\n  - package_contents:\n      bin:\n        - lx\n      files:\n        - if: unix\n          then:\n            - share/man/man1/lx.1\n            - share/man/man1/lux*.1\n            - share/bash-completion/completions/lx\n            - share/fish/vendor_completions.d/lx.fish\n            - share/zsh/site-functions/_lx\n        - if: win\n          then:\n            - Library/share/man/man1/lx.1\n            - Library/share/man/man1/lux*.1\n            - Library/share/bash-completion/completions/lx\n            - Library/share/fish/vendor_completions.d/lx.fish\n            - Library/share/zsh/site-functions/_lx\n      strict: true\n\nabout:\n  summary: A luxurious package manager for Lua\n  description: |\n    Lux is a modern package manager for Lua. It manages dependencies, build steps,\n    lockfiles, Lua versions, and existing LuaRocks projects through a single CLI.\n  license: LGPL-3.0-or-later\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://lux.lumen-labs.org\n  repository: https://github.com/lumen-oss/lux\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
