  "raw_meta_yaml": "context:\n  version: \"0.43.1\"\n\npackage:\n  name: lux-cli\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/lumen-oss/lux/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 495bb927167f7c3aa346217d9d6139b9652e2020343293db228720341b8a0383\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - cd lux-cli\n      - if: osx\n        # instruct Apple's `ld64` linker to drop unused OpenSSL symbols and to add correct `@rpath` for xtask\n        then: export RUSTFLAGS=\"${RUSTFLAGS} -C link-arg=-Wl,-dead_strip_dylibs -C link-arg=-Wl,-rpath,${PREFIX}/lib\"\n      - if: unix\n        then:\n          - export OPENSSL_NO_VENDOR=1 # force linking to host's (conda-forge's) OpenSSL libs\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n          # generate shell completions and manpage\n          - if: build_platform == host_platform\n            then:\n              - mkdir -p \"$PREFIX\"/share/man/man1 \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n              - '\"$PREFIX\"/bin/lx util man  --target-dir=\"$PREFIX\"/share/man/man1'\n              - '\"$PREFIX\"/bin/lx util completion bash > \"$PREFIX\"/share/bash-completion/completions/lx'\n              - '\"$PREFIX\"/bin/lx util completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/lx.fish'\n              - '\"$PREFIX\"/bin/lx util completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_lx'\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins --no-default-features --features=vendored\n          # generate shell completions and manpage\n          - if: build_platform == host_platform\n            then:\n              - if not exist \"%LIBRARY_PREFIX%\"\\share\\man\\man1 mkdir \"%LIBRARY_PREFIX%\"\\share\\man\\man1\n              - if not exist \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n              - if not exist \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n              - if not exist \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n              - '\"%LIBRARY_BIN%\"\\lx.exe util man  --target-dir=\"%LIBRARY_PREFIX%\"\\share\\man\\man1'\n              - '\"%LIBRARY_BIN%\"\\lx.exe util completion bash > \"%LIBRARY_PREFIX%\\share\\bash-completion\\completions\\lx\"'\n              - '\"%LIBRARY_BIN%\"\\lx.exe util completion fish > \"%LIBRARY_PREFIX%\\share\\fish\\vendor_completions.d\\lx.fish\"'\n              - '\"%LIBRARY_BIN%\"\\lx.exe util completion zsh  > \"%LIBRARY_PREFIX%\\share\\zsh\\site-functions\\_lx\"'\n      - cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - cmake\n    - make\n    - perl\n    - pkg-config\n  host:\n    - if: unix\n      then:\n        - gpgme\n        - libgit2\n        - libgpg-error\n        - openssl\n\ntests:\n  - script:\n      - lx --help\n      - lx --version\n  - package_contents:\n      bin:\n        - lx\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/man/man1/lx.1\n            - share/man/man1/lux*.1\n            - share/bash-completion/completions/lx\n            - share/fish/vendor_completions.d/lx.fish\n            - share/zsh/site-functions/_lx\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/man/man1/lx.1\n            - Library/share/man/man1/lux*.1\n            - Library/share/bash-completion/completions/lx\n            - Library/share/fish/vendor_completions.d/lx.fish\n            - Library/share/zsh/site-functions/_lx\n      strict: true\n\nabout:\n  summary: A luxurious package manager for Lua\n  description: |\n    Lux is a modern package manager for Lua. It manages dependencies, build steps,\n    lockfiles, Lua versions, and existing LuaRocks projects through a single CLI.\n  license: LGPL-3.0-or-later\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://lux.lumen-labs.org\n  repository: https://github.com/lumen-oss/lux\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
