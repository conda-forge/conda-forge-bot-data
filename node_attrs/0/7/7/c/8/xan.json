      "dev_url": "https://github.com/medialab/xan",
      "doc_url": "https://github.com/medialab/xan",
      "home": "https://github.com/medialab/xan",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE-MIT",
      "summary": "The CSV magician"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml",
          "mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions",
          "$PREFIX/bin/xan completions zsh > $PREFIX/share/zsh/site-functions/_xan",
          "$PREFIX/bin/xan completions bash > $PREFIX/share/bash-completion/completions/xan"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "Yomguithereal",
        "apcamargo",
        "rvalieris"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "xan",
        "requirements": {
          "build": [
            "rust_compiler_stub",
            "c_stdlib_stub",
            "c_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
