  "linux_64_meta_yaml": {
    "about": {
      "description": "rustypot is a Rust library with Python bindings from Pollen Robotics\nfor communicating with Robotis Dynamixel and Feetech serial-bus servo\nmotors. It implements the wire protocols and per-model registers\nneeded to read and write motor state (position, speed, torque, etc.)\nand is used to control the motors in Pollen's Reachy robots.\n\nThe `rustypot` output provides the Python bindings; the `rustypot-cli`\noutput ships the `scan` command line tool to discover motors connected\nto a serial port.",
      "dev_url": "https://github.com/pollen-robotics/rustypot",
      "home": "https://crates.io/crates/rustypot",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Rust/Python library to communicate with Dynamixel and Feetech motors"
    },
    "build": {
      "number": "0",
      "script": [
        "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml",
        "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
      ]
    },
    "extra": {
