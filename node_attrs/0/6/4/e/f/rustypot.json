  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.5.0\"\n\nrecipe:\n  name: rustypot\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/r/rustypot/rustypot-${{ version }}.tar.gz\n  sha256: 8e2a49c6d5562c8e5fb05b032a48f11afcf20fd244d42c956294d3b4bbdd6c91\n\nbuild:\n  number: 0\n\noutputs:\n  # Python bindings (maturin/PyO3), published on PyPI as \"rustypot\".\n  - package:\n      name: rustypot\n    build:\n      script:\n        - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    requirements:\n      build:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('c') }}\n        - ${{ compiler('rust') }}\n        - cargo-bundle-licenses\n      host:\n        - python\n        - pip\n        - maturin >=1.8,<2.0a0\n      run:\n        - python\n    tests:\n      - python:\n          imports:\n            - rustypot\n          pip_check: true\n\n  # The \"scan\" CLI (cargo bin target) to discover Dynamixel/Feetech motors on a serial port.\n  - package:\n      name: rustypot-cli\n    build:\n      script:\n        - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n        # --no-track skips the .crates.toml/.crates2.json bookkeeping files in $PREFIX.\n        - cargo auditable install --locked --no-track --bin scan --root ${{ PREFIX }} --path .\n    requirements:\n      build:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('c') }}\n        - ${{ compiler('rust') }}\n        - cargo-auditable\n        - cargo-bundle-licenses\n    tests:\n      - package_contents:\n          bin:\n            - scan\n      - script:\n          - scan --help\n\nabout:\n  summary: Rust/Python library to communicate with Dynamixel and Feetech motors\n  description: |\n    rustypot is a Rust library with Python bindings from Pollen Robotics\n    for communicating with Robotis Dynamixel and Feetech serial-bus servo\n    motors. It implements the wire protocols and per-model registers\n    needed to read and write motor state (position, speed, torque, etc.)\n    and is used to control the motors in Pollen's Reachy robots.\n\n    The `rustypot` output provides the Python bindings; the `rustypot-cli`\n    output ships the `scan` command line tool to discover motors connected\n    to a serial port.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://crates.io/crates/rustypot\n  repository: https://github.com/pollen-robotics/rustypot\n\nextra:\n  feedstock-name: rustypot\n  recipe-maintainers:\n    - ruben-arts\n",
