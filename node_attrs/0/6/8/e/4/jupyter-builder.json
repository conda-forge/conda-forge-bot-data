  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.2.2\"\n  nodejs_min: \"22\"\n  python_check_max: \"3.14\"\n  cov_fail_under: \"61\"\n  pytest_k: not watch\n\nrecipe:\n  name: jupyter-builder-split\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/j/jupyter-builder/jupyter_builder-${{ version }}.tar.gz\n  sha256: b6cea88f58e44b2c5eba96f28d2e0d16fd453d3ca6dc9c4492ff8a1f2e97f601\n\nbuild:\n  number: 0\n  noarch: python\n\noutputs:\n  - package:\n      name: jupyter-builder\n    build:\n      noarch: python\n      script:\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n      python:\n        entry_points:\n          - jupyter-builder = jupyter_builder.main:main\n          - jlpm = jupyter_builder.jlpm:main\n    requirements:\n      host:\n        - hatch-nodejs-version >=0.3.2\n        - hatchling >=1.21.1\n        - pip\n        - python ${{ python_min }}.*\n      run:\n        - jupyter_core\n        - python >=${{ python_min }}\n        - tomli\n        - traitlets\n      run_constraints:\n        - nodejs >=${{ nodejs_min }}\n    tests:\n      - python:\n          imports: jupyter_builder\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n      - script:\n          - jupyter-builder --help\n\n  - package:\n      name: jupyter-builder-with-nodejs\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"jupyter-builder\", exact=True) }}\n        - nodejs ${{ nodejs_min }}.*\n    tests:\n      - script:\n          - jlpm --help\n      - requirements:\n          run:\n            - copier >=9.3,<10\n            - coverage\n            - jinja2-time\n            - mypy\n            - nodejs ${{ nodejs_min }}.*\n            - pytest >=7.0\n            - pytest-html\n            - python ${{ python_min }}.*\n        files:\n          source:\n            - tests/\n            - pyproject.toml\n            - package.json\n            - yarn.lock\n            - .yarnrc.yml\n            - tsconfig.json\n            - src/\n        script:\n          - coverage run --source=jupyter_builder --branch -m pytest -vv --tb=long --color=yes -k \"${{ pytest_k }}\"\n          - coverage report --show-missing --skip-covered --fail-under=${{ cov_fail_under }}\n          - mypy -p jupyter_builder --exclude \"debug_log_file_mixin\\.py\"\n      # see: https://github.com/conda-forge/jupyterlab-feedstock/issues/466\n      # - downstream: jupyterlab\n      # - downstream: notebook\n    about:\n      summary: JupyterLab build tools (with nodejs)\n\nabout:\n  summary: JupyterLab build tools\n  license: BSD-3-Clause AND MIT AND ISC\n  license_file:\n    - LICENSE\n    - THIRD_PARTY_LICENSES/\n  homepage: https://pypi.org/project/jupyter-builder\n  repository: https://github.com/jupyterlab/jupyter-builder\n\nextra:\n  feedstock-name: jupyter-builder\n  recipe-maintainers:\n    - darshan808\n    - krassowski\n    - bollwyvl\n",
