  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.0.8\"\n  nodejs_min: \"22\"\n  python_check_max: \"3.14\"\n\nrecipe:\n  name: jupyter-builder-split\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/j/jupyter-builder/jupyter_builder-${{ version }}.tar.gz\n  sha256: 0192128efc379fc34a9a3de3de7118759aca6f6571a58556c1fa1518d1db2917\n\nbuild:\n  number: 1\n  noarch: python\n\noutputs:\n  - package:\n      name: jupyter-builder\n    build:\n      noarch: python\n      script:\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n      python:\n        entry_points:\n          - jupyter-builder = jupyter_builder.main:main\n          - jlpm = jupyter_builder.jlpm:main\n    requirements:\n      host:\n        - hatch-nodejs-version >=0.3.2\n        - hatchling >=1.21.1\n        - pip\n        - python ${{ python_min }}.*\n      run:\n        - jupyter_core\n        - python >=${{ python_min }}\n        - requests\n        - tomli\n        - traitlets\n      run_constraints:\n        - nodejs >=${{ nodejs_min }}\n    tests:\n      - python:\n          imports: jupyter_builder\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n      - script:\n          - jupyter-builder --help\n\n  - package:\n      name: jupyter-builder-with-nodejs\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"jupyter-builder\", exact=True) }}\n        - nodejs ${{ nodejs_min }}.*\n    tests:\n      - script:\n          - jlpm --help\n    about:\n      summary: JupyterLab build tools (with nodejs)\n\nabout:\n  summary: JupyterLab build tools\n  license: BSD-3-Clause AND MIT AND ISC\n  license_file:\n    - LICENSE\n    - THIRD_PARTY_LICENSES/\n  homepage: https://pypi.org/project/jupyter-builder\n  repository: https://github.com/jupyterlab/jupyter-builder\n\nextra:\n  feedstock-name: jupyter-builder\n  recipe-maintainers:\n    - darshan808\n    - krassowski\n    - bollwyvl\n",
