    "about": {
      "description": "agentsor-file validates local CSV and Parquet files against declared\nschemas, freshness rules, and row or byte limits. Its optional reporting\ncommand sends a content-free result envelope for missed-run monitoring.",
      "dev_url": "https://github.com/linkoinsight/agentsor-file",
      "doc_url": "https://agentsor.ai/file-contracts/guides/validate-parquet-schema-cron",
      "home": "https://agentsor.ai/file-contracts",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Validate local CSV and Parquet schemas and monitor scheduled outputs"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "linkoinsight"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "agentsor-file",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "pip",
            "setuptools >=77"
          ],
          "run": [
            "python >=3.11",
            "pyarrow >=16",
            "__unix"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "parquet_guard",
                "parquet_guard.file_cli"
              ],
              "python_version": [
                "3.11.*",
                "*"
              ]
            }
          },
          {
            "files": {
              "source": [
                "tests/",
                "examples/"
              ]
            },
            "requirements": {
              "run": [
                "python 3.11.*",
                "pytest >=8,<10",
                "jsonschema >=4.23,<5"
              ]
            },
            "script": [
              "agentsor-file --help",
              "parquet-guard --help",
              "agentsor-file schema",
              "pytest -q tests"
            ]
          }
        ],
        "version": "0.2.3"
      }
    ],
