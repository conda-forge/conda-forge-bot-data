    "about": {
      "description": "pacparser is a library to parse proxy auto-config (PAC) files. Proxy\nauto-config files are a vastly used proxy configuration method these\ndays. Web browsers can use a PAC file to determine which proxy server\nto use or whether to go direct for a given URL. The package also ships\nthe pactester command line tool to test PAC files. The bundled\nQuickJS-ng JavaScript engine (MIT) is statically linked into the\nlibrary with its symbols hidden.",
      "dev_url": "https://github.com/manugarg/pacparser",
      "doc_url": "https://pacparser.manugarg.com/",
      "home": "https://pacparser.manugarg.com/",
      "license": "LGPL-3.0-or-later AND MIT",
      "license_family": "LGPL-3.0-or-later AND MIT",
      "license_file": "COPYING",
      "summary": "Library to parse proxy auto-config (PAC) files"
