  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: git-sizer\n  version: 1.5.0\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/github/${{ name }}/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 07a5ac5f30401a17d164a6be8d52d3d474ee9c3fb7f60fd83a617af9f7e902bb\n  target_directory: src\n\nbuild:\n  number: 3\n  script:\n    - cd src\n    - if: unix\n      then: go build -ldflags \"-s -w -X main.ReleaseVersion=${{ version }}\" -v -o \"$PREFIX/bin/git-sizer\"\n    - if: win\n      then: go build -ldflags \"-s -w -X main.ReleaseVersion=${{ version }}\" -v -o \"%LIBRARY_BIN%\\git-sizer.exe\"\n    - go-licenses save . --save_path ../library_licenses\n\nrequirements:\n  build:\n    - ${{ compiler('go-nocgo') }}\n    - go-licenses\n\ntests:\n  - package_contents:\n      bin:\n        - git-sizer\n  - requirements:\n      run:\n        - if: not riscv64 and not (win and arm64)\n          then: git\n    script:\n      - git-sizer --version\n      - if: not riscv64 and not (win and arm64)\n        then:\n          - git init .\n          - git-sizer -v\n\nabout:\n  homepage: https://github.com/github/git-sizer\n  repository: https://github.com/github/git-sizer\n  license: MIT\n  license_family: MIT\n  license_file:\n    - src/LICENSE.md\n    - library_licenses/\n  summary: Compute various size metrics for a Git repository, flagging those that might cause problems\n\nextra:\n  recipe-maintainers:\n    - dbast\n",
