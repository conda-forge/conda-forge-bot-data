  "meta_yaml": {
    "about": {
      "description": "Provides R bindings to y-crdt, a Rust implementation of the Yjs CRDT\n(Conflict-free Replicated Data Type) framework.",
      "dev_url": "https://github.com/y-crdt/yr",
      "home": "https://github.com/y-crdt/yr",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Y-CRDT Bindings to R"
    },
    "build": {
      "number": "0",
      "script": {
        "content": "@rem R on conda-forge Windows is built with Rtools (MinGW), so Rust\n@rem must target the GNU ABI. tools/config.R / Makevars.win.in honor\n@rem CARGO_BUILD_TARGET (paired with rust-std-x86_64-pc-windows-gnu).\nset \"CARGO_BUILD_TARGET=x86_64-pc-windows-gnu\"\n\n@rem Point Rust at R's import library (libR) rem build links\n@rem raw-dylib crates (windows-targets, parking_lot_core) need\n@rem dlltool; conda-forge binutils ships it target-prefixed only\nset \"RUSTFLAGS=-L native=%PREFIX%/lib/R/bin/x64 -l R -C dlltool=x86_64-w64-mingw32-dlltool.exe\"\n\n\"%R%\" CMD INSTALL --build .\nif %ERRORLEVEL% neq 0 exit 1\n\n@rem Bundle third party licenses from statically linked crates\ncd src\\rust\ncargo-bundle-licenses --format yaml --output \"%SRC_DIR%\\THIRDPARTY.yml\"\nif %ERRORLEVEL% neq 0 exit 1\n",
        "env": {
          "DISABLE_AUTOBREW": "1",
          "EXTENDR_SKIP_BUILD_WRAPPERS": "1",
          "NOT_CRAN": "1"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "AntoinePrv"
      ]
    },
