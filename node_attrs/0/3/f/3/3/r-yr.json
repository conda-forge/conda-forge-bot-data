  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.2.0\"\n\npackage:\n  name: r-yr\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/y-crdt/yr/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: cef74adf4b6cb4e0a04f9c4a2dc73b40fd0f99c6655e9ae4e15ad90acc5a5866\n\nbuild:\n  number: 0\n  dynamic_linking:\n    rpaths:\n      - lib/R/lib/\n      - lib/\n  script:\n    env:\n      NOT_CRAN: \"1\"\n      DISABLE_AUTOBREW: \"1\"\n      EXTENDR_SKIP_BUILD_WRAPPERS: \"1\"\n    content:\n      - if: unix\n        then:\n          - |\n            # Make libR findable for Cargo and R wrapper scripts\n            export RUSTFLAGS=\"-C link-arg=-L${PREFIX}/lib/R/lib ${RUSTFLAGS}\"\n            export LD_LIBRARY_PATH=\"${PREFIX}/lib/R/lib:${LD_LIBRARY_PATH:-}\"\n            export DYLD_LIBRARY_PATH=\"${PREFIX}/lib/R/lib:${DYLD_LIBRARY_PATH:-}\"\n\n            ${R} CMD INSTALL --build . ${R_ARGS}\n\n            # Bundle third party licenses from statically linked crates\n            cd src/rust\n            cargo-bundle-licenses --format yaml --output \"${SRC_DIR}/THIRDPARTY.yml\"\n      - if: win\n        then:\n          - |\n            @rem R on conda-forge Windows is built with Rtools (MinGW), so Rust\n            @rem must target the GNU ABI. tools/config.R / Makevars.win.in honor\n            @rem CARGO_BUILD_TARGET (paired with rust-std-x86_64-pc-windows-gnu).\n            set \"CARGO_BUILD_TARGET=x86_64-pc-windows-gnu\"\n\n            @rem Point Rust at R's import library (libR) rem build links\n            @rem raw-dylib crates (windows-targets, parking_lot_core) need\n            @rem dlltool; conda-forge binutils ships it target-prefixed only\n            set \"RUSTFLAGS=-L native=%PREFIX%/lib/R/bin/x64 -l R -C dlltool=x86_64-w64-mingw32-dlltool.exe\"\n\n            \"%R%\" CMD INSTALL --build .\n            if %ERRORLEVEL% neq 0 exit 1\n\n            @rem Bundle third party licenses from statically linked crates\n            cd src\\rust\n            cargo-bundle-licenses --format yaml --output \"%SRC_DIR%\\THIRDPARTY.yml\"\n            if %ERRORLEVEL% neq 0 exit 1\n\nrequirements:\n  build:\n    - if: unix\n      then:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n      else:\n        # Provides the MinGW toolchain matching conda-forge's Rtools-built R.\n        - gcc\n        - rust-std-x86_64-pc-windows-gnu\n    - ${{ compiler('rust') }}\n    - if: build_platform != target_platform\n      then:\n        - cross-r-base ${{ r_base }}.*\n    - cargo-bundle-licenses\n    - if: unix\n      then:\n        - autoconf\n        - automake\n        - pkg-config\n        - make\n      else:\n        - m2-autoconf\n        - m2-automake-wrapper\n        - m2-coreutils\n        - m2-filesystem\n        - m2-grep\n        - m2-make\n        - m2-pkg-config\n        - m2-sed\n        - m2-zip\n  host:\n    - r-base\n  run:\n    - r-base\n\ntests:\n  - r:\n      libraries:\n        - yr\n  - script:\n      - Rscript -e 'yr::Doc$new()'\n\nabout:\n  homepage: https://github.com/y-crdt/yr\n  summary: Y-CRDT Bindings to R\n  description: |\n    Provides R bindings to y-crdt, a Rust implementation of the Yjs CRDT\n    (Conflict-free Replicated Data Type) framework.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/y-crdt/yr\n\nextra:\n  recipe-maintainers:\n    - AntoinePrv\n",
