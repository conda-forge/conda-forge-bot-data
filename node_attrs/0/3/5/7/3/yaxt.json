  "raw_meta_yaml": "{% set name = \"yaxt\" %}\n{% set version = \"0.11.5.1\" %}\n{% set build = 3 %}\n\npackage:\n  name: {{ name }}\n  version: {{ version }}\n\nsource:\n  url: https://gitlab.dkrz.de/dkrz-sw/{{ name }}/-/archive/v{{ version }}/{{ name }}-v{{ version }}.tar.gz\n  sha256: 0bc97acd6cfd8e893318e59daa57e9063cf79644311fc71cdd00597cb89bcc29\n\nbuild:\n  skip: true  # [win]\n  number: {{ build }}\n\n  # add build string so packages can depend on mpi/idxtype variants explicitly:\n  # `yaxt * mpi_mpich_*` for mpich\n  # `yaxt * mpi_openmpi_*` for openmpi\n  # `yaxt * mpi_*` for any mpi\n  # `yaxt * *_idxtype_long_*` for the 64-bit Xt_int build (see idxtype below)\n\n  {% set mpi = mpi or \"mpich\" %}\n  {% set mpi_prefix = \"mpi_\" + mpi %}\n  # yaxt's Xt_int index type defaults to a 32-bit int unless configured with\n  # --with-idxtype=long (64-bit). Some consumers (e.g. LFRic, whose halo-index\n  # type is 64-bit) need the 64-bit build; changing the *default* build's ABI\n  # would break existing consumers pinned to today's (32-bit) `yaxt`, so this\n  # is a second, additive, opt-in variant instead -- same pattern as `mpi`.\n  {% set idxtype = idxtype or \"int\" %}\n  {% set idxtype_suffix = \"\" if idxtype == \"int\" else \"_idxtype_\" + idxtype %}\n  string: {{ mpi_prefix }}{{ idxtype_suffix }}_h{{ PKG_HASH }}_{{ build }}\n  run_exports:\n    - {{ pin_subpackage(name, max_pin='x.x') }}\n    - {{ name }} * {{ mpi_prefix }}{{ idxtype_suffix }}_*\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ compiler('fortran') }}\n    - {{ stdlib('c') }}\n    - autoconf\n    - automake\n    - libtool\n    - make\n    - pkg-config\n    # openmpi's mpicc/mpifort wrappers are compiled binaries for the target\n    # arch; when cross-compiling (e.g. osx-64 -> osx-arm64) they can't run on\n    # the build machine, so we need a build-arch copy of openmpi too (mpich's\n    # wrappers are portable shell scripts and don't need this). Same pattern\n    # as conda-forge/libpnetcdf-feedstock.\n    - {{ mpi }}  # [mpi == \"openmpi\" and build_platform != target_platform]\n  host:\n    - llvm-openmp  # [osx]\n    - libgomp      # [linux]\n    - {{ mpi }}\n  run:\n    - {{ mpi }}\n\ntest:\n  requires:\n    - {{ compiler('c') }}\n  files:\n    - test_idxtype.c\n  commands:\n    - test -f ${PREFIX}/lib/libyaxt.so  # [linux]\n    - test -f ${PREFIX}/lib/libyaxt.dylib  # [osx]\n    - test -f ${PREFIX}/lib/libyaxt_c.so  # [linux]\n    - test -f ${PREFIX}/lib/libyaxt_c.dylib  # [osx]\n    - test -f ${PREFIX}/include/yaxt.h\n    - test -f ${PREFIX}/include/yaxt.mod\n    # autoconf silently ignores an unknown --with-idxtype, so verify the\n    # installed Xt_int actually has the width this build's string promises.\n    # Skipped when cross-compiling (osx_arm64, built from osx_64): the\n    # compiled test binary targets the host arch, not the build machine's,\n    # so it can't be executed here.\n    - ${PREFIX}/bin/mpicc -I${PREFIX}/include -L${PREFIX}/lib -Wl,-rpath,${PREFIX}/lib -DXT_EXPECTED_TYPE={{ idxtype }} test_idxtype.c -o test_idxtype -lyaxt  # [build_platform == target_platform]\n    - ./test_idxtype  # [build_platform == target_platform]\n\nabout:\n  home: https://gitlab.dkrz.de/dkrz-sw/yaxt\n  summary: Yet Another eXchange Tool (yaxt) for coupling of Earth system model components.\n  description: |\n    Yet Another eXchange Tool (yaxt) is a lightweight software library for coupling of Earth system model components\n    which provides automated data redistributions in distributed memory applications.\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: LICENSE\n  doc_url: https://dkrz-sw.gitlab-pages.dkrz.de/yaxt/index.html\n  dev_url: https://gitlab.dkrz.de/dkrz-sw/yaxt\n\nextra:\n  recipe-maintainers:\n    - jhkennedy\n    - ckhroulev\n    - aaschwanden\n    - larsbuntemeyer\n    - ickc\n",
  "req": {
    "__set__": true,
