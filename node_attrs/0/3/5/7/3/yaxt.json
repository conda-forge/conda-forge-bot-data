  "raw_meta_yaml": "{% set name = \"yaxt\" %}\n{% set version = \"0.11.5.1\" %}\n{% set build = 1 %}\n\npackage:\n  name: {{ name }}\n  version: {{ version }}\n\nsource:\n  url: https://gitlab.dkrz.de/dkrz-sw/{{ name }}/-/archive/v{{ version }}/{{ name }}-v{{ version }}.tar.gz\n  sha256: 0bc97acd6cfd8e893318e59daa57e9063cf79644311fc71cdd00597cb89bcc29\n\nbuild:\n  skip: true  # [win]\n  number: {{ build }}\n\n  # add build string so packages can depend on mpi variants explicitly:\n  # `yaxt * mpi_mpich_*` for mpich\n  # `yaxt * mpi_openmpi_*` for openmpi\n  # `yaxt * mpi_*` for any mpi\n\n  {% set mpi = mpi or \"mpich\" %}\n  {% set mpi_prefix = \"mpi_\" + mpi %}\n  string: {{ mpi_prefix }}_h{{ PKG_HASH }}_{{ build }}\n  run_exports:\n    - {{ pin_subpackage(name, max_pin='x.x') }}\n    - {{ name }} * {{ mpi_prefix }}_*\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ compiler('fortran') }}\n    - {{ stdlib('c') }}\n    - autoconf\n    - automake\n    - libtool\n    - make\n    - pkg-config\n  host:\n    - llvm-openmp  # [osx]\n    - libgomp      # [linux]\n    - {{ mpi }}\n  run:\n    - {{ mpi }}\n\ntest:\n  commands:\n    - test -f ${PREFIX}/lib/libyaxt.so  # [linux]\n    - test -f ${PREFIX}/lib/libyaxt.dylib  # [osx]\n    - test -f ${PREFIX}/lib/libyaxt_c.so  # [linux]\n    - test -f ${PREFIX}/lib/libyaxt_c.dylib  # [osx]\n    - test -f ${PREFIX}/include/yaxt.h\n    - test -f ${PREFIX}/include/yaxt.mod\n\nabout:\n  home: https://gitlab.dkrz.de/dkrz-sw/yaxt\n  summary: Yet Another eXchange Tool (yaxt) for coupling of Earth system model components.\n  description: |\n    Yet Another eXchange Tool (yaxt) is a lightweight software library for coupling of Earth system model components\n    which provides automated data redistributions in distributed memory applications.\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: LICENSE\n  doc_url: https://dkrz-sw.gitlab-pages.dkrz.de/yaxt/index.html\n  dev_url: https://gitlab.dkrz.de/dkrz-sw/yaxt\