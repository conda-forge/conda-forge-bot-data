  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"5.1.10\"\n  build_number: 1\n\nrecipe:\n  name: pyami-core\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pyami-core/pyami_core-${{ version }}.tar.gz\n  sha256: 6563f57f111059875115cf64bee8c2a737f6c4a87a247a52f9a13c037eee868b\n  patches:\n    - patches/0001-guard-module-level-entrypoint.patch\n\nbuild:\n  number: ${{ build_number }}\n\noutputs:\n  - package:\n      name: pyami-core\n      version: ${{ version }}\n    build:\n      noarch: python\n      script:\n        # upstream's pyproject.toml unconditionally declares an `ami` console\n        # script; strip it here so this library-only output doesn't clobber\n        # the `ami` command shipped by the pyami-core-cli output.\n        - ${{ PYTHON }} -m pip install . -vv\n        - ${{ PYTHON }} -c \"import glob, os, sysconfig; [os.remove(f) for f in glob.glob(os.path.join(sysconfig.get_path('scripts'), 'ami*'))]\"\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling\n      run:\n        - python >=${{ python_min }}\n        - lxml\n    tests:\n      - python:\n          imports:\n            - pyAMI\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: pyami-core-cli\n      version: ${{ version }}\n    build:\n      noarch: python\n      script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n      python:\n        entry_points:\n          - ami=pyAMI.app:main\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling\n      run:\n        - python >=${{ python_min }}\n        - pyami-core\n    tests:\n      - script:\n          - ami --help\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n\n\nabout:\n  summary: Python ATLAS Metadata Interface (pyAMI)\n  homepage: https://atlas-ami.cern.ch/\n  repository: https://github.com/ami-team/pyAMI-core\n  documentation: https://atlas-ami.cern.ch/docs/pyAMI/\n  license: LGPL-3.0-or-later\n  license_file: LICENSE.md\n\nextra:\n  feedstock-name: pyami-core\n  recipe-maintainers:\n    - kratsg\n",
