  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.0.3\"\n\npackage:\n  name: tree-sitter-verilog\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/tree-sitter/tree-sitter-verilog/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 2b985c74fa7d0035db7415908935cf1ba7eea3d928ccebfa1d89541d5b6fa7b4\n\nbuild:\n  number: 0\n  # abi3 packages build once at python_min and ship one artifact per platform.\n  skip: is_abi3 and not is_python_min\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    version_independent: ${{ is_abi3 }}\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n  host:\n    - if: is_abi3\n      then: python-abi3\n    - python\n    - pip\n    - setuptools >=42\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - tree_sitter_verilog\n      # Verify the abi3 wheel works on the build-time Python AND the latest.\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/tree_sitter_verilog/_binding.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%/tree_sitter_verilog/_binding.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://github.com/tree-sitter/tree-sitter-verilog\n  summary: SystemVerilog grammar for tree-sitter\n  license: MIT\n  license_file: LICENSE\n  repository: https://github.com/tree-sitter/tree-sitter-verilog\n\nextra:\n  recipe-maintainers:\n    - killua156\n    - mgorny\n",
