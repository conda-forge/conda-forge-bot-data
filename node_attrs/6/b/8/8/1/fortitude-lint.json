  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.8.0\"\n\npackage:\n  name: fortitude-lint\n  version: \"${{ version }}\"\n\nsource:\n  url: https://github.com/PlasmaFAIR/fortitude/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 54a9a12f0b0f85f1448c75d4204b9eb5d2c3ef2095abb364716cd884b65e553b\n\nbuild:\n  number: 0\n  script:\n    env:\n      JEMALLOC_SYS_WITH_LG_PAGE: ${{ '16' if aarch64 else '' }}\n      PYTHONIOENCODING: utf-8\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: linux\n        then:\n          - export CFLAGS=\"${CFLAGS} -D_GNU_SOURCE -D_BSD_SOURCE\"\n      - if: win\n        then:\n          - set \"CARGO_HOME=%SYSTEMDRIVE%\\cgh\"\n          - if not exist \"%CARGO_HOME%\" mkdir \"%CARGO_HOME%\"\n          - set \"CARGO_TARGET_DIR=%SYSTEMDRIVE%\\ctd\"\n          - if not exist \"%CARGO_TARGET_DIR%\" mkdir \"%CARGO_TARGET_DIR%\"\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path crates/fortitude\n        else:\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path crates/fortitude\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n\ntests:\n  - script: fortitude --help\n  - package_contents:\n      bin:\n        - fortitude\n\nabout:\n  homepage: https://github.com/PlasmaFAIR/fortitude\n  summary: A Fortran linter, written in Rust and installable with Python.\n  description: |\n    A Fortran linter, written in Rust and installable with Python\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://fortitude.readthedocs.io/en/stable/\n  repository: https://github.com/PlasmaFAIR/fortitude\n\nextra:\n  recipe-maintainers:\n    - andrewdnolan\n    - xylar\n",
