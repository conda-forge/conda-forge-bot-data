  "raw_meta_yaml": "context:\n  version: \"1.1.0\"\n\npackage:\n  name: magika-cli\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/google/magika/archive/refs/tags/cli/v${{ version }}.tar.gz\n  sha256: 87fd85f33d2c644d657de024b83cdc36bbdcf4a2961be5e93fe74e081477076c\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n      # Dynamically link against conda-forge's onnxruntime instead of letting\n      # the `ort` crate download prebuilt binaries from the network.\n      ORT_PREFER_DYNAMIC_LINK: \"1\"\n    content:\n      - if: linux\n        then:\n          - export OPENSSL_DIR=\"${PREFIX}\"\n      - if: unix\n        then:\n          # The library embeds the model via `include_bytes!(\"model.onnx\")`,\n          # where `rust/lib/src/model.onnx` is a symlink chain pointing at\n          # `assets/models/standard_v3_3/model.onnx`. Verify the symlink still\n          # resolves to that expected file (guards against upstream bumping the\n          # model directory), then replace it with the real file so the build\n          # reads real bytes (the symlink does not survive extraction on\n          # Windows).\n          - test rust/lib/src/model.onnx -ef assets/models/standard_v3_3/model.onnx\n          - rm -f rust/lib/src/model.onnx\n          - cp assets/models/standard_v3_3/model.onnx rust/lib/src/model.onnx\n          - export ORT_LIB_LOCATION=\"${PREFIX}/lib\"\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path rust/cli\n          - cd rust/cli && cargo-bundle-licenses --format yaml --output ${{ SRC_DIR }}/THIRDPARTY.yml\n        else:\n          # `rust\\lib\\src\\model.onnx` is a dangling symlink on Windows; remove\n          # it and copy the real model file over it.\n          - if not exist assets\\models\\standard_v3_3\\model.onnx exit 1\n          - del /F /Q rust\\lib\\src\\model.onnx\n          - copy /Y assets\\models\\standard_v3_3\\model.onnx rust\\lib\\src\\model.onnx\n          - if errorlevel 1 exit 1\n          # conda-forge ships the import library as `onnxruntime_conda.lib`, but\n          # the `ort` crate links against `onnxruntime`. Provide an alias in a\n          # build-only directory so it does not get packaged into the output.\n          - mkdir ort-lib\n          - copy /Y %LIBRARY_PREFIX%\\lib\\onnxruntime_conda.lib ort-lib\\onnxruntime.lib\n          - if errorlevel 1 exit 1\n          - set \"ORT_LIB_LOCATION=%SRC_DIR%\\ort-lib\"\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path rust/cli\n          - if errorlevel 1 exit 1\n          - cd rust/cli && cargo-bundle-licenses --format yaml --output %SRC_DIR%/THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n  host:\n    - onnxruntime-cpp\n    - if: linux\n      then:\n        - openssl\n\ntests:\n  - script:\n      - magika --version\n      - magika --help\n  - package_contents:\n      bin:\n        - magika\n      strict: true\n\nabout:\n  homepage: https://github.com/google/magika\n  summary: Determines file content types using AI\n  description: |\n    Magika is a tool that detects content types of files using deep learning.\n    This package provides the `magika` command-line interface implemented in\n    Rust on top of the `magika` library crate.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://securityresearch.google/magika/\n  repository: https://github.com/google/magika\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
