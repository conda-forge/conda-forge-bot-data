  "linux_64_meta_yaml": {
    "about": {
      "description": "Magika is a tool that detects content types of files using deep learning.\nThis package provides the `magika` command-line interface implemented in\nRust on top of the `magika` library crate.",
      "dev_url": "https://github.com/google/magika",
      "doc_url": "https://securityresearch.google/magika/",
      "home": "https://github.com/google/magika",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Determines file content types using AI"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "export OPENSSL_DIR=\"${PREFIX}\"",
          "test rust/lib/src/model.onnx -ef assets/models/standard_v3_3/model.onnx",
          "rm -f rust/lib/src/model.onnx",
          "cp assets/models/standard_v3_3/model.onnx rust/lib/src/model.onnx",
          "export ORT_LIB_LOCATION=\"${PREFIX}/lib\"",
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path rust/cli",
          "cd rust/cli && cargo-bundle-licenses --format yaml --output ${{ SRC_DIR }}/THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "ORT_PREFER_DYNAMIC_LINK": "1"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "magika-cli",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "cxx_compiler_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable"
          ],
          "host": [
            "onnxruntime-cpp",
            "openssl"
          ],
          "run": []
        },
        "tests": [
          {
            "script": [
              "magika --version",
              "magika --help"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "magika"
              ],
              "strict": true
            }
          }
        ],
        "version": "1.1.0"
      }
    ],
