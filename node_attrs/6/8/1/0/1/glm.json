  "raw_meta_yaml": "{% set name = \"GLM\" %}\n{% set version = \"1.0.3\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://github.com/g-truc/glm/archive/refs/tags/{{ version }}.tar.gz\n  sha256: 6775e47231a446fd086d660ecc18bcd076531cfedd912fbd66e576b118607001\n\n  patches:\n    # Upstream enables warnings-as-errors in its tests, which breaks as\n    # compilers add diagnostics. Remove once this can be disabled separately.\n    - patches/disable_warnings_as_errors.patch\n\nbuild:\n  number: 0\n  skip: true  # [win and vc<14]\n  run_exports:\n    - {{ pin_subpackage(\"glm\", max_pin=\"x.x\") }}\n\nrequirements:\n  build:\n    - {{ stdlib(\"c\") }}\n    - {{ compiler('cxx') }}\n    - cmake\n    - make  # [unix]\n\ntest:\n  files:\n    - test/CMakeLists.txt\n    - test/main.cpp\n  commands:\n    - test -r \"${PREFIX}/include/glm\"  # [unix]\n    - if not exist %LIBRARY_INC%\\glm exit 1  # [win]\n    - test -f \"${PREFIX}/lib/libglm.so\"  # [linux]\n    - test -f \"${PREFIX}/lib/libglm.dylib\"  # [osx]\n    - test ! -f \"${PREFIX}/lib/libglm.a\"  # [unix]\n    - if not exist %LIBRARY_BIN%\\glm.dll exit 1  # [win]\n    - cmake-package-check glm --targets glm::glm glm::glm-header-only\n    - cmake -S test -B test-build -G Ninja\n    - cmake --build test-build\n    - test-build/glm-test  # [unix]\n    - test-build\\glm-test.exe  # [win]\n  requires:\n    - cmake\n    - cmake-package-check\n    - ninja\n    - {{ compiler('c') }}\n    - {{ compiler('cxx') }}\n\nabout:\n  home: https://glm.g-truc.net\n  license: MIT\n  license_family: MIT\n  license_file: manual.md\n  summary: OpenGL Mathematics\n  dev_url: https://github.com/g-truc/glm\n\nextra:\n  recipe-maintainers:\n    - traversaro\n",
