  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.25\"\n\npackage:\n  name: proj-data\n  version: ${{ version }}\n\nsource:\n  url: http://download.osgeo.org/proj/proj-data-${{ version }}.tar.gz\n  sha256: 16d65cb5d25b7d8492dbde4d39cafcc8c42f3e55e6715bac4d87519d6d08f4c8\n  target_directory: data\n\nbuild:\n  number: 1\n  noarch: generic\n\nrequirements:\n  run:\n    - if: unix\n      then: __unix\n    - if: win\n      then: __win\n    - proj >=7.0.0\n\ntests:\n  - script:\n      - if: unix\n        then: test -f $PREFIX/share/proj/ca_nrc_ntv1_can.tif\n      - if: win\n        then: if not exist %LIBRARY_PREFIX%\\\\share\\\\proj\\\\ca_nrc_ntv1_can.tif exit 1\n      - echo -111 50 | cs2cs +proj=latlong +ellps=clrk66 +nadgrids=ca_nrc_ntv1_can.tif +to +proj=latlong +ellps=GRS80 +datum=NAD83\n      - echo -105 40 | cs2cs +init=epsg:4326 +to +init=epsg:2975\n\nabout:\n  license: CC0-1.0 OR CC-BY-4.0 OR CC-BY-SA-4.0 OR BSD-2-Clause OR etalab-2.0 OR OGL-Canada-2.0 OR DL-DE-BY-2.0\n  # Each data source has a *README.txt file with the license info, that is\n  # copied with the datum files. The following CSV file is a summary.\n  license_file: data/copyright_and_licenses.csv\n  summary: Data for Cartographic Projections and Coordinate Transformations Library\n  homepage: https://github.com/OSGeo/proj-data\n  repository: https://github.com/OSGeo/proj-data\n  documentation: https://github.com/OSGeo/PROJ-data/blob/master/README.DATA\n\nextra:\n  recipe-maintainers:\n    - mwtoews\n    - hobu\n    - ocefpaf\n    - snowman2\n    - xylar\n",
