  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  python_min: \"3.11\"\n  version: \"10.0.0\"\n\npackage:\n  name: mathics3-frontend-cli\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/m/mathicsscript/mathicsscript-${{ version }}.tar.gz\n  sha256: aeacd508ccf78a1c06007d815209f29c81422ac4861f24f502c6aa69f7622f4f\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - mathicsscript = mathicsscript.__main__:main\n      - fake_psviewer.py = mathicsscript.fake_psviewer:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools\n    - pyyaml\n    - click\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - mathics3-scanner >=10.0.0\n    - mathics3 >=10.0.0\n    - click >=8.0.0\n    - colorama\n    - columnize\n    - networkx\n    - prompt_toolkit >=3.0.18\n    - pygments >=2.9.0\n    - mathics3-pygments >=10.0.0\n    - term-background >=1.0.5\n\ntests:\n  - python:\n      imports:\n        - mathicsscript\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - mathicsscript --help\n      - fake_psviewer.py --help\n\nabout:\n  summary: Command-line interface to Mathics3\n  license: GPL-3.0-only\n  license_file: COPYING.txt\n  homepage: https://mathics.org/\n\nextra:\n  recipe-maintainers:\n    - mmatera\n    - rocky\n",
