    "about": {
      "description": "onionpipe forwards ports on the local host to Tor onion addresses as a\nTor onion service, and vice versa: forwarding onion services to the local\nhost.\n\nWhat can you do with onionpipe? Export a local service without a public IP\naddress, NAT traversal or DNS registration. Access a local service from\nanywhere, from behind any firewall, with end-to-end encrypted authenticated\ntransport, and no third party in the middle.",
      "dev_url": "https://github.com/cmars/onionpipe",
      "doc_url": "https://pkg.go.dev/github.com/cmars/onionpipe",
      "home": "https://github.com/cmars/onionpipe",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "src/LICENSE",
      "summary": "Onion addresses for anything"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src",
        "go-licenses save . --save_path ../library_licenses",
        "go build -v -o ${PREFIX}/bin/onionpipe -ldflags=\"-s -w\""
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
