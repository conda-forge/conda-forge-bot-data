  "raw_meta_yaml": "{% set name = \"titiler\" %}\n{% set version = \"2.0.5\" %}\n{% set python_min = \"3.11\" %}\n\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}-core/{{ name }}_core-{{ version }}.tar.gz\n    sha256: 68dc573e85890c7a21617defd554650a8a27edbec59b23758a861ccc397e46f9\n    folder: titiler_core\n  - url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}-xarray/{{ name }}_xarray-{{ version }}.tar.gz\n    sha256: 3184ef97d3644aa02b34f86b9e940eb133c42b44a0abb75c85e906e9602e51d9\n    folder: titiler_xarray\n  - url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}-extensions/{{ name }}_extensions-{{ version }}.tar.gz\n    sha256: 3e0c0baafeebeb8d79c28e5d74116bd90c578b06fce0699de5433acdfde1ffa2\n    folder: titiler_extensions\n  - url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}-mosaic/{{ name }}_mosaic-{{ version }}.tar.gz\n    sha256: cbed8daa83f31552d058657a97862a62d0f7d0592564312d6bd02b23e6f9d18a\n    folder: titiler_mosaic\n  - url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}-application/{{ name }}_application-{{ version }}.tar.gz\n    sha256: d100507a888c7d920fb794bb117188684ff4d8181ac4aa5be011aa60a0f34f6c\n    folder: titiler_application\n\nbuild:\n  number: 0\n  noarch: python\n\noutputs:\n  - name: titiler-core\n    version: {{ version }}\n    build:\n      noarch: python\n      script: |\n        cd titiler_core\n        python -m pip install . -vv --no-deps --no-build-isolation --ignore-installed --no-index\n    requirements:\n      host:\n        - hatchling\n        - pip\n        - python {{ python_min }}\n      run:\n        - fastapi >=0.136.1\n        - geojson-pydantic >=1.1.2,<3.0\n        - jinja2 >=2.11.2,<4.0.0\n        - numpy\n        - pydantic ~=2.0\n        - rasterio\n        - rio-tiler >=9.0,<10.0\n        - morecantile\n        - simplejson\n        - python >={{ python_min }}\n    test:\n      imports:\n        - titiler\n        - titiler.core\n      commands:\n        - pip check\n      requires:\n        - pip\n        - python {{ python_min }}\n\n  - name: titiler-xarray\n    version: {{ version }}\n    build:\n      noarch: python\n      script: |\n        cd titiler_xarray\n        python -m pip install . -vv --no-deps --no-build-isolation --ignore-installed --no-index\n    requirements:\n      host:\n        - hatchling\n        - pip\n        - python {{ python_min }}\n      run:\n        - titiler-core\n        - xarray\n        - rioxarray\n        - obstore\n        - zarr >=3.1,<4.0\n        - starlette-cramjam >=0.4,<1.0\n        - pydantic-settings ~=2.0\n        - python >={{ python_min }}\n      run_constrained:\n        - titiler-core ={{ version }}\n    test:\n      imports:\n        - titiler\n        - titiler.xarray\n      commands:\n        - pip check\n      requires:\n        - pip\n        - python {{ python_min }}\n\n  - name: titiler-extensions\n    version: {{ version }}\n    build:\n      noarch: python\n      script: |\n        cd titiler_extensions\n        python -m pip install . -vv --no-deps --no-build-isolation --ignore-installed --no-index\n    requirements:\n      host:\n        - hatchling\n        - pip\n        - python {{ python_min }}\n      run:\n        - titiler-core\n        - python >={{ python_min }}\n      run_constrained:\n        - titiler-core ={{ version }}\n    test:\n      imports:\n        - titiler\n        - titiler.extensions\n      commands:\n        - pip check\n      requires:\n        - pip\n        - python {{ python_min }}\n\n  - name: titiler-mosaic\n    version: {{ version }}\n    build:\n      noarch: python\n      script: |\n        cd titiler_mosaic\n        python -m pip install . -vv --no-deps --no-build-isolation --ignore-installed --no-index\n    requirements:\n      host:\n        - hatchling\n        - pip\n        - python {{ python_min }}\n      run:\n        - titiler-core\n        # TODO Package this on conda-forge\n        # This is an extra dependency on PyPi\n        # Should we add it here or add yet another output titiler-mosaic-json?\n        # - cogeo-mosaic\n        - python >={{ python_min }}\n      run_constrained:\n        - titiler-core ={{ version }}\n    test:\n      imports:\n        - titiler\n        - titiler.mosaic\n      commands:\n        - pip check\n      requires:\n        - pip\n        - python {{ python_min }}\n\n  - name: titiler-application\n    version: {{ version }}\n    build:\n      noarch: python\n      script: |\n        cd titiler_application\n        python -m pip install . -vv --no-deps --no-build-isolation --ignore-installed --no-index\n    requirements:\n      host:\n        - hatchling\n        - pip\n        - python {{ python_min }}\n      run:\n        - titiler-core\n        - titiler-xarray\n        - titiler-extensions\n        - titiler-mosaic\n        - starlette-cramjam\n        - pydantic-settings ~=2.0\n        - starlette-cramjam >=0.4,<1.0\n        - python >={{ python_min }}\n        # titiler-application depends on titiler-core[telemetry] extra\n        - opentelemetry-api\n        - opentelemetry-sdk\n        - opentelemetry-instrumentation-fastapi\n        - opentelemetry-instrumentation-logging\n        - opentelemetry-exporter-otlp\n        # titiler-application depends on titiler-extensions[cogeo,stac]\n        - rio-stac >=0.12,<0.13\n        - rio-cogeo >=7.0,<8.0\n        # titiler-application depends on titiler-mosaic[mosaicjson]\n        - cogeo-mosaic >=9.0,<10.0\n      run_constrained:\n        - titiler-core ={{ version }}\n        - titiler-xarray ={{ version }}\n        - titiler-extensions ={{ version }}\n        - titiler-mosaic ={{ version }}\n    test:\n      imports:\n        - titiler\n        - titiler.application\n      commands:\n        - pip check\n      requires:\n        - pip\n        - python {{ python_min }}\n\nabout:\n  home: https://github.com/developmentseed/titiler\n  summary: A modern dynamic tile server built on top of FastAPI and Rasterio/GDAL.\n  license: MIT\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - martinRenou\n    - tylere\n    - rsignell-usgs\n",
