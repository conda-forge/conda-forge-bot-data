  "raw_meta_yaml": "{% set version = \"26.5.5\" %}\n{% set name = \"ecl\" %}\n\npackage:\n  name: {{ name }}\n  version: {{ version }}\n\nsource:\n  url: https://common-lisp.net/project/ecl/static/files/release/{{ name }}-{{ version }}.tgz\n  sha256: a01a5bcda8c5b73e59dda3494fd13e5fec5db6aa1dad782c3cc3bb57f1633435\n  patches:\n    # from https://github.com/sagemath/sage/blob/master/build/pkgs/ecl/patches/write_error.patch\n    - write_error.patch\n    - fix-prefix.patch\n    # Backport of https://gitlab.com/embeddable-common-lisp/ecl/-/commit/59de50b52380132d44bfa05f573544cba0a8c65f\n    # so that (require :<module>) finds third-party modules (e.g. maxima.fas)\n    # in the directories listed in ECL_SIDE_MODULES_PATH (see build.sh).\n    # Remove with the next upstream release, which includes this file.\n    - side-modules.patch\n\nbuild:\n  number: 1\n  ignore_run_exports:\n    # libatomic_ops in host is only needed for its headers at build time\n    # (--enable-libatomic=system); ecl does not link against it, so its\n    # run_export would add a spurious runtime dependency.\n    - libatomic_ops  # [unix]\n\nrequirements:\n  build:\n    - gnuconfig  # [unix]\n    - {{ compiler('c') }}\n    - {{ stdlib('c') }}\n    - libtool  # [unix]\n    - make  # [unix]\n    - texinfo  # [unix]\n    - sed  # [unix]\n    - cmake  # [win]\n    # We (typically) need a compatible version of ecl when cross-compiling ecl.\n    # On a major upgrade, this cannot be satisfied. When this fails, we merge\n    # the PR that builds the native ecl and then restart the CI once the native\n    # versions are uploaded.\n    - ecl 26.*  # [build_platform != target_platform]\n  host:\n    - gmp\n    - readline  # [unix]\n    - bdw-gc  # [unix]\n    - libatomic_ops  # [unix]\n    - libffi  # [unix]\n  run:\n    - gmp\n    - readline  # [unix]\n    - {{ pin_compatible('bdw-gc') }}  # [unix]\n\ntest:\n  commands:\n    - if not exist %PREFIX%\\{{ name }}.exe exit 1  # [win]\n    - if not exist %PREFIX%\\{{ name }}\\{{ name }}.h exit 1  # [win]\n    - if not exist %PREFIX%\\{{ name }}.lib exit 1  # [win]\n    - test -f ${PREFIX}/include/{{ name }}/{{ name }}.h  # [unix]\n    - test -f ${PREFIX}/lib/lib{{ name }}.dylib  # [osx]\n    - test -f ${PREFIX}/lib/lib{{ name }}.so     # [linux]\n    - ecl --eval \"(assert (member :boehm-gc *features*))\" --eval \"(assert (member :dffi *features*))\" --eval \"(quit)\"  # [unix]\n    # verify that the side-modules search path baked in at build time (see\n    # side-modules.patch) survived conda's prefix relocation\n    - ecl --eval \"(assert (equal si::*build-time-side-module-pathnames* (list (parse-namestring \\\"$PREFIX/lib/ecl-{{ version }}/\\\"))))\" --eval \"(quit)\"  # [unix]\n    # verify that (require :<module>) finds modules via ECL_SIDE_MODULES_PATH\n    - echo '(provide \"SIDE-MODULES-TEST\")' > side-modules-test.lsp  # [unix]\n    - ECL_SIDE_MODULES_PATH=$PWD ecl --eval \"(require :side-modules-test)\" --eval \"(assert (member \\\"SIDE-MODULES-TEST\\\" *modules* :test (function string=)))\" --eval \"(quit)\"  # [unix]\n    - ecl --version\n\nabout:\n  home: https://common-lisp.net/project/ecl\n  license: GPL-2.0-or-later\n  license_file: COPYING\n  summary: ECL (Embeddable Common-Lisp) is an interpreter of the Common-Lisp language.\n  doc_url: https://common-lisp.net/project/ecl/static/ecldoc/\n  dev_url: https://gitlab.com/embeddable-common-lisp/ecl\n\nextra:\n  recipe-maintainers:\n    - cxzhong\n    - isuruf\n    - embray\n    - saraedum\n",
