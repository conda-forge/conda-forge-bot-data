    "about": {
      "description": "This program provides the HTTP API described by the WebDriver protocol to\ncommunicate with Gecko browsers, such as Firefox. It translates calls into\nthe Marionette remote protocol by acting as a proxy between the local- and\nremote ends.",
      "dev_url": "https://github.com/mozilla/geckodriver",
      "doc_url": "https://firefox-source-docs.mozilla.org/testing/geckodriver/geckodriver",
      "home": "https://crates.io/crates/geckodriver",
      "license": "MPL-2.0",
      "license_family": "MPL-2.0",
      "license_file": "THIRDPARTY.yml",
      "summary": "geckodriver is a proxy for using W3C WebDriver-compatible clients to\ninteract with Gecko-based browsers."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "export RUSTFLAGS=\"-C link-arg=-Wl,-rpath-link,${PREFIX}/lib -L${PREFIX}/lib\"",
          "cargo auditable install --no-track --bins --locked --profile=release --path=. --root \"${{ PREFIX }}\"",
          "cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "bollwyvl"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "geckodriver",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "cxx_compiler_stub",
            "rust_compiler_stub",
            "c_stdlib_stub",
            "cargo-bundle-licenses",
            "cargo-auditable"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "files": {
              "recipe": [
                "test_selenium.py"
              ]
            },
            "requirements": {
              "run": [
                "firefox >=115",
                "python >=3.10",
                "selenium",
                "pytest"
              ]
            },
            "script": {
              "content": [
                "geckodriver --version",
                "geckodriver --help",
                "geckodriver --version | ${{ grep }} \"${{ version | replace('.', '\\\\.') }}\"",
                "pytest test_selenium.py"
              ],
