  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.2.4\"\n\nrecipe:\n  name: hdbpp-es-split\n  version: ${{ version }}\n\nsource:\n  url: https://gitlab.com/tango-controls/hdbpp/hdbpp-es/-/archive/${{ version }}/hdbpp-es-${{ version }}.tar.gz\n  sha256: 7e14cd7005480768f6ba6ba4918b9853a2d7697b4cdebed2d6d1afb8fb1bd792\n\nbuild:\n  number: 1\n  skip:\n    - win\n\noutputs:\n  - staging:\n      name: hdbpp-es-build\n    requirements:\n      build:\n        - cmake\n        - ninja\n        - if: unix\n          then:\n            - pkg-config\n        - ${{ stdlib('c') }}\n        - ${{ compiler('cxx') }}\n      host:\n        - cppzmq\n        - cpptango\n        - omniorb-libs\n        - libhdbpp >=2.1.0\n    build:\n      script:\n        file: build\n\n  - package:\n      name: hdbpp-es\n    inherit: hdbpp-es-build\n    build:\n      files:\n        - if: unix\n          then:\n            - bin/hdb++es-srv\n    tests:\n      - script:\n          - hdb++es-srv --help 2>&1 | grep -i usage\n\n  - package:\n      name: hdbpp-es-dbg\n    inherit:\n      from: hdbpp-es-build\n      run_exports: false\n    build:\n      skip:\n        - not linux\n      dynamic_linking:\n        # Prevent dbg file to be modified\n        # Will raise CRC mismatch otherwise!\n        binary_relocation: false\n      files:\n        - lib/debug/hdb++es-srv.dbg\n    requirements:\n      run:\n        - ${{ pin_subpackage('hdbpp-es', exact=True) }}\n    tests:\n      - package_contents:\n          files:\n            - lib/debug/hdb++es-srv.dbg\n\nabout:\n  homepage: https://www.tango-controls.org\n  license: GPL-3.0-or-later\n  license_file: LICENSE\n  summary: Tango device server for the HDB++ Event Subscriber\n  repository: https://gitlab.com/tango-controls/hdbpp/hdbpp-es\n  documentation: https://tango-controls.readthedocs.io/en/latest/Explanation/archiving/hdbpp.html\n\nextra:\n  feedstock-name: hdbpp-es\n  recipe-maintainers:\n    - beenje\n",
