    "about": {
      "description": "cryoswath is a python package containing processing pipelines, a tool\nlibrary, and some pre-assembled data to retrieve and study CryoSat-2\ndata.\nAdaptability lies at its core. The user can access many options simply\nby passing arguments to functions; everything else can be customized\nchanging the concerned function or adding a new one.\n",
      "doc_url": "https://cryoswath.readthedocs.io/",
      "home": "https://github.com/j-haacker/cryoswath",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE.txt",
      "summary": "Swath processing toolbox for CryoSat-2"
    },
    "build": {
      "entry_points": [
        "cryoswath-init = cryoswath.misc:init_project_cli",
        "cryoswath-download-rgi = cryoswath.misc:download_rgi_cli",
        "cryoswath-update-keyring = cryoswath.misc:update_keyring_cli",
        "cryoswath-update-netrc = cryoswath.misc:update_netrc_cli",
        "cryoswath-update-tracks = cryoswath.misc:update_track_database_cli",
        "cryoswath = cryoswath.misc:cryoswath_cli"
      ],
      "noarch": "python",
      "number": "0",
      "script": "PYTHON -m pip install . -vv --no-deps --no-build-isolation"
    },
