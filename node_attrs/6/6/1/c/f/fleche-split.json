  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  name: fleche\n  version: \"0.22.0\"\n  python_min: \"3.11\"\n\nrecipe:\n  name: ${{ name }}-split\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name }}-${{ version }}.tar.gz\n  sha256: 1bfe23a1a8fbdf90f5e65ef25c2387a574dc5b9b5d16f940889eabc2389335fd\n\nbuild:\n  number: 0\n\noutputs:\n  # Minimal install: the actual built package with core runtime deps only.\n  - package:\n      name: fleche-base\n    build:\n      noarch: python\n      script:\n        - python -m pip install . -vv --no-deps --no-build-isolation\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - setuptools >=64.0\n        - setuptools-scm >=8\n        - pip\n      run:\n        - python >=${{ python_min }},<3.15\n        - numpy\n        - pandas >=2.2,<4\n        - pyiron_snippets\n        - filelock\n    tests:\n      - python:\n          imports:\n            - fleche\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - '*'\n\n  # Full install: metapackage pulling fleche-base plus all optional runtime deps.\n  - package:\n      name: fleche\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - python >=${{ python_min }},<3.15\n        - ${{ pin_subpackage(\"fleche-base\", exact=True) }}\n        - cloudpickle\n        - dill\n        - sqlalchemy\n        - bagofholding ==0.1.12\n    tests:\n      - python:\n          imports:\n            - fleche\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - '*'\n      - files:\n          source:\n            - tests/\n        script:\n          - pytest -m smoke\n        requirements:\n          run:\n            - pytest\n            - hypothesis\n            - cloudpickle\n            - dill\n            - sqlalchemy\n            - bagofholding ==0.1.12\n\nabout:\n  homepage: https://github.com/pmrv/fleche\n  documentation: https://fleche.readthedocs.io/\n  repository: https://github.com/pmrv/fleche\n  summary: A persistent caching solution for arbitrary Python functions\n  license: BSD-3-Clause\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - pmrv\n",
