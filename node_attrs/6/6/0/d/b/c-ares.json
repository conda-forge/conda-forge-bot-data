  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.34.8\"\n\nrecipe:\n  name: c-ares\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/c-ares/c-ares/releases/download/v${{ version }}/c-ares-${{ version }}.tar.gz\n  sha256: c222b6d681096f9444d2c4863d2c1174019e27cacca0a4a5c114d36dd7d7bf78\n\nbuild:\n  number: 1\n\noutputs:\n  - package:\n      name: c-ares\n    build:\n      script: build_output\n    requirements:\n      build:\n        - ${{ compiler(\"c\") }}\n        - ${{ stdlib(\"c\") }}\n        - if: win\n          then: cmake\n        # cmake on unix depends on c-ares. This breaks the cycle.\n        - if: unix\n          then: cmake-no-system\n        - if: unix\n          then: ninja\n      run_constraints:\n        - c-ares-static <0a0\n      run_exports:\n        - ${{ pin_subpackage(\"c-ares\", upper_bound=\"x\") }}\n    tests:\n      - package_contents:\n          include:\n            - ares.h\n          lib:\n            - cares\n          files:\n            not_exists:\n              - if: unix\n                then: lib/libcares.a\n              - if: unix\n                then: lib/libcares_static.a\n              - if: win\n                then: Library/lib/cares_static.lib\n  - package:\n      name: c-ares-static\n    build:\n      script: build_output\n    requirements:\n      build:\n        - ${{ compiler(\"c\") }}\n        - ${{ stdlib(\"c\") }}\n        - if: win\n          then: cmake\n        # cmake on unix depends on c-ares. This breaks the cycle.\n        - if: unix\n          then: cmake-no-system\n        - if: unix\n          then: ninja\n      run_constraints:\n        - c-ares <0a0\n    tests:\n      - package_contents:\n          include:\n            - ares.h\n          files:\n            exists:\n              - if: unix\n                then: lib/libcares.a\n              - if: win\n                then: Library/lib/cares.lib\n            not_exists:\n              - if: linux\n                then: lib/libcares.so*\n              - if: osx\n                then: lib/libcares*.dylib\n              - if: win\n                then: Library/bin/cares.dll\n\nabout:\n  license: MIT\n  license_file: LICENSE.md\n  summary: This is c-ares, an asynchronous resolver library\n  homepage: https://c-ares.haxx.se/\n\nextra:\n  recipe-maintainers:\n    - ocefpaf\n    - wesm\n    - xhochy\n",
