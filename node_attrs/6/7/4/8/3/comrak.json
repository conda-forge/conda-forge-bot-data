  "raw_meta_yaml": "context:\n  version: \"0.55.0\"\n\npackage:\n  name: comrak\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/kivikakk/comrak/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: f68631135861de41f3ba83c84d7a239b679400c65babe1081abd4d22a78ef392\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n        else:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n\ntests:\n  - script:\n      - comrak --help\n      - comrak --version\n  - package_contents:\n      bin:\n        - comrak\n      strict: true\n\nabout:\n  summary: A 100% CommonMark-compatible GitHub Flavored Markdown parser and renderer\n  description: |\n    Comrak is a CommonMark and GitHub Flavored Markdown compatible parser and\n    renderer, written in Rust. It converts Markdown to HTML, XML and CommonMark,\n    with various optional features like syntax highlighting, source position attributes,\n    header ID prefixes and many more thanks to a flexible extension system.\n  license: BSD-2-Clause\n  license_file:\n    - COPYING\n    - THIRDPARTY.yml\n  homepage: https://comrak.ee/\n  repository: https://github.com/kivikakk/comrak\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
