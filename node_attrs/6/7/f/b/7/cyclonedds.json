  "raw_meta_yaml": "context:\n  version: 11.0.1\n\npackage:\n  name: cyclonedds\n  version: \"${{ version }}\"\n\nsource:\n  url: \"https://github.com/eclipse-cyclonedds/cyclonedds/archive/${{ version }}.tar.gz\"\n  sha256: c25d46075ad6b5cee564bda9e5f49509e9a6dbb1a8b858e708eb360d335cf973\n\nbuild:\n  number: 2\n  script:\n    - if: win\n      then: |\n        cmake -G \"Ninja\" ^\n            -DCMAKE_BUILD_TYPE=Release ^\n            -DCMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP=True ^\n            -DCMAKE_INSTALL_PREFIX=%LIBRARY_PREFIX% ^\n            -DENABLE_ICEORYX=ON ^\n            %SRC_DIR%\n        cmake --build . --config Release --target install\n      else: |\n        cmake -G \"Ninja\" \\\n            -DCMAKE_BUILD_TYPE=Release \\\n            -DCMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP=True \\\n            -DCMAKE_INSTALL_PREFIX=$PREFIX \\\n            -DENABLE_ICEORYX=ON \\\n            $SRC_DIR\n        cmake --build . --config Release --target install\n\nrequirements:\n  build:\n    - \"${{ compiler('cxx') }}\"\n    - \"${{ compiler('c') }}\"\n    - \"${{ stdlib('c') }}\"\n    - cmake\n    - maven\n    - openjdk\n    - ninja\n  host:\n    - openssl\n    - iceoryx\n  run_exports:\n    - \"${{ pin_subpackage('cyclonedds', upper_bound='x.x') }}\"\n\n\ntests:\n  - package_contents:\n      lib:\n        - ddsc\n      include:\n        - ddsc/dds.h\n\nabout:\n  homepage: https://github.com/eclipse-cyclonedds/cyclonedds\n  license: EPL-2.0\n  license_file: LICENSE\n  summary: Eclipse Cyclone DDS\n  description: |\n    Eclipse Cyclone DDS is a very performant and robust open-source implementation of the OMG DDS specification.\n    Cyclone DDS is developed completely in the open as an Eclipse IoT project (see eclipse-cyclone-dds)\n    with a growing list of adopters (if you're one of them, please add your logo).\n    It is a tier-1 middleware for the Robot Operating System ROS 2.\n  documentation: https://projects.eclipse.org/projects/iot.cyclonedds\n  repository: https://github.com/eclipse-cyclonedds/cyclonedds\n\nextra:\n  recipe-maintainers:\n    - seanyen\n    - phreed\n    - Tobias-Fischer\n    - nmarticorena\n",
