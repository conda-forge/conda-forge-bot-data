  "raw_meta_yaml": "context:\n  pypi_name: planktonclas\n  name: planktonclas-base\n  version: \"0.2.3\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ pypi_name[0] }}/${{ pypi_name }}/${{ pypi_name }}-${{ version }}.tar.gz\n  sha256: b36c4eb09bf9e2256ac27464f999415a2b8912c03622e5d6ea9cbd6ead99fb33\n\nbuild:\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  number: 0\n  skip:\n    - win\n    - osx\n    - match(python, \"<3.10\")\n    - match(python, \">=3.13\")\n  python:\n    entry_points:\n      - planktonclas = planktonclas.cli:main\n\nrequirements:\n  host:\n    - python\n    - pip\n    - setuptools\n  run:\n    - python\n    - numpy >=1.26.0,<2.2.0\n    - pyyaml >=6.0\n    - requests >=2.27.1\n    - tqdm >=4.64.0\n    - pandas >=2.0.0\n    - pillow >=10.0\n    - if: cuda_compiler_version == \"None\"\n      then:\n        - tensorflow >=2.19.0,<2.20.0 cpu_*\n      else:\n        - tensorflow >=2.19.0,<2.20.0 cuda128*\n    - protobuf >=3.20.0\n    - py-opencv >=4.5.0\n    - albumentations\n    - matplotlib-base >=3.9\n    - seaborn-base >=0.12.0\n    - scikit-learn >=1.0.0\n\ntests:\n  - if: cuda_compiler_version == \"none\"\n    then:\n      python:\n        imports:\n          - planktonclas\n        pip_check: false\n\nabout:\n  homepage: https://github.com/lifewatch/planktonclas\n  summary: Phytoplankton image classification — slim variant (no DEEPaaS REST API)\n  description: |\n    planktonclas-base provides the inference and training paths of the\n    planktonclas package without the DEEPaaS REST-API runtime layer\n    (deepaas, flaat, aiohttp-apispec are not yet packaged for conda-forge).\n\n    For the full package including the REST API: pip install planktonclas\n  license: Apache-2.0\n  license_file: LICENSE\n  documentation: https://planktonclas.readthedocs.io/en/latest/\n  repository: https://github.com/lifewatch/planktonclas\n\nextra:\n  recipe-maintainers:\n    - annefou\n    - j34ni\n",
