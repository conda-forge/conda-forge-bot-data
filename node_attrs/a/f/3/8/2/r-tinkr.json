  "linux_64_meta_yaml": {
    "about": {
      "description": "Parsing '(R)Markdown' files with numerous regular expressions can be\nfraught with peril, but it does not have to be this way.\nConverting '(R)Markdown' files to 'XML' using the 'commonmark' package\nallows in-memory editing via of 'markdown' elements via 'XPath' through\nthe extensible 'R6' class called 'yarn'.\nThese modified 'XML' representations can be written to '(R)Markdown'\ndocuments via an 'xslt' stylesheet which implements an extended version of\n'GitHub'-flavoured 'markdown' so that you can tinker to your hearts content.",
      "dev_url": "https://github.com/ropensci/tinkr",
      "doc_url": "https://docs.ropensci.org/tinkr/",
      "home": "https://docs.ropensci.org/tinkr/",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "${{ PREFIX }}/lib/R/share/licenses/GPL-3",
      "summary": "Cast '(R)Markdown' Files to 'XML' and Back Again"
    },
