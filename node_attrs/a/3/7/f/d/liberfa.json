  "linux_64_meta_yaml": {
    "about": {
      "description": "ERFA (Essential Routines for Fundamental Astronomy) is a C library containing key algorithms for\nastronomy, and is based on the [SOFA library](http://www.iausofa.org/) published by the International\nAstronomical Union (IAU).\n\nERFA is intended to replicate the functionality of SOFA (aside from possible\nbugfixes in ERFA that have not yet been included in SOFA), but is licensed\nunder a three-clause BSD license to enable its compatibility with a wide\nrange of open source licenses.",
      "home": "https://github.com/liberfa/erfa",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE",
      "summary": "Essential Routines for Fundamental Astronomy"
    },
    "build": {
      "number": "0",
      "run_exports": {
        "weak": [
          "liberfa"
        ]
      },
      "script": "meson setup build ${MESON_ARGS}\nmeson compile -C build -j ${CPU_COUNT}\nif [[ \"${CONDA_BUILD_CROSS_COMPILATION:-}\" != \"1\" || \"${CROSSCOMPILING_EMULATOR}\" != \"\" ]]; then\n  meson test -C build --print-errorlogs\nfi\nmeson install -C build\n"
    },
    "extra": {
      "recipe-maintainers": [
        "eunos-1128"
      ]
    },
    "outputs": [
      {
        "build": {
