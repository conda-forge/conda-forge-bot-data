  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.0.1\"\n\npackage:\n  name: liberfa\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/liberfa/erfa/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: d5469fbd0b212b3c7270c1da15c9bd82f37da9218fc89627f98283d27b416cbf\n\nbuild:\n  number: 0\n  skip:\n    # Not supported upstream\n    - win\n  script: |\n    meson setup build ${MESON_ARGS}\n    meson compile -C build -j ${CPU_COUNT}\n    if [[ \"${CONDA_BUILD_CROSS_COMPILATION:-}\" != \"1\" || \"${CROSSCOMPILING_EMULATOR}\" != \"\" ]]; then\n      meson test -C build --print-errorlogs\n    fi\n    meson install -C build\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - meson\n    - ninja\n  run_exports:\n    - ${{ pin_subpackage(\"liberfa\", upper_bound=\"x\") }}\n\ntests:\n  - package_contents:\n      include:\n        - erfa.h\n        - erfam.h\n        - erfaextra.h\n        - erfadatextra.h\n      lib:\n        - erfa\n      files:\n        - lib/pkgconfig/erfa.pc\n\n  - script:\n      - pkg-config --modversion erfa\n    requirements:\n      run:\n        - pkg-config\n\nabout:\n  homepage: https://github.com/liberfa/erfa\n  license: BSD-3-Clause\n  license_file: LICENSE\n  summary: Essential Routines for Fundamental Astronomy\n  description: |\n    ERFA (Essential Routines for Fundamental Astronomy) is a C library containing key algorithms for\n    astronomy, and is based on the [SOFA library](http://www.iausofa.org/) published by the International\n    Astronomical Union (IAU).\n    \n    ERFA is intended to replicate the functionality of SOFA (aside from possible\n    bugfixes in ERFA that have not yet been included in SOFA), but is licensed\n    under a three-clause BSD license to enable its compatibility with a wide\n    range of open source licenses.\n\nextra:\n  recipe-maintainers:\n    - eunos-1128\n",
