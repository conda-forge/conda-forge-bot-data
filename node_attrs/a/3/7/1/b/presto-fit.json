  "raw_meta_yaml": "context:\n  version: \"0.9.0\"\n  python_min: \"3.12\"\n\npackage:\n  # conda-forge name; the importable module and CLI are still `presto`.\n  name: presto-fit\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/cole-group/presto/archive/${{ version }}.tar.gz\n  sha256: 22c4c91a3835c56a71c35966f751abb276f8e87e4c175f3a55bb7c2880fb6c45\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    env:\n      # hatch-vcs cannot infer the version from the .git-less archive.\n      SETUPTOOLS_SCM_PRETEND_VERSION: ${{ version }}\n    content: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling\n    - hatch-vcs\n  run:\n    - python >=${{ python_min }}\n    - pytorch >=2.8.0\n    - ambertools\n    - cachetools\n    # older datasets import the removed pyarrow.PyExtensionType (gone in pyarrow >=16).\n    - datasets >=4.8\n    - descent >=0.6.0\n    - h5py\n    - loguru\n    - mdtraj\n    - openff-forcefields >=2026.01.0\n    - openff-interchange >=0.4.11\n    - openff-toolkit >=0.17.0\n    - openff-units\n    - openmm >=8.5.0\n    - openmm-ml >=1.6\n    - pydantic >=2\n    - pydantic-settings\n    - pydantic-units\n    - pyyaml\n    - rdkit >=2024.03.6\n    - rich >=14.3.1,<15\n    - seaborn\n    - smee-base >=0.17.0\n    - smirnoff-plugins >=0.0.4\n    - tensorboardx\n\ntests:\n  - python:\n      imports:\n        - presto\n      # ambertools bundles sub-packages (packmol-memgen, proprep, ndfes, fetkutils,\n      # edgembar) whose pip metadata pins numpy <2 and requires pdb2pqr/netcdf4.\n      # Those pins are unsatisfiable here, and pip check cannot ignore single packages.\n      pip_check: false\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      - presto --help\n\nabout:\n  homepage: https://github.com/cole-group/presto\n  summary: 'Fast parameterisation of bespoke MM force fields using MLPs.'\n  description: |\n    Train bespoke SMIRNOFF force fields quickly using a machine learning potential (MLP).\n    All valence parameters (bonds, angles, proper torsions, and improper torsions) are trained\n    to MLP energies sampled using molecular dynamics.\n  license: MIT\n  license_file:\n    - LICENSE\n    - presto/models/EGRET_1_LICENSE\n  documentation: https://cole-group.github.io/presto/latest/\n  repository: https://github.com/cole-group/presto/\n\nextra:\n  recipe-maintainers:\n    - fjclark\n",
