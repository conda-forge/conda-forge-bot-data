      "doc_url": "https://cole-group.github.io/presto/latest/",
      "home": "https://github.com/cole-group/presto",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Fast parameterisation of bespoke MM force fields using MLPs."
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": {
