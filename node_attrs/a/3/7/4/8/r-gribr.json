  "raw_meta_yaml": "context:\n  version: \"1.2.7\"\n\npackage:\n  name: r-gribr\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/nawendt/gribr/archive/v${{ version }}.tar.gz\n  sha256: 6fa045cb7a0422c193c799f3462af876116b3e29320df65c2e40bcf78f7ebb1a\n\nbuild:\n  number: 4\n  dynamic_linking:\n    rpaths:\n      - lib/R/lib/\n      - lib/\n    missing_dso_allowlist:\n      - if: win\n        then:\n          - \"*/R.dll\"\n          - \"*/Rblas.dll\"\n          - \"*/Rlapack.dll\"\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - cross-r-base ${{ r_base }}.*\n        - r-base\n        - r-proj4\n    - if: not win\n      then:\n        - ${{ compiler('c') }}\n        - ${{ stdlib(\"c\") }}\n        - autoconf\n        - automake\n        - pkg-config\n        - make\n    - if: win\n      then:\n        - ${{ compiler('m2w64_c') }}\n        - ${{ stdlib(\"m2w64_c\") }}\n        - m2-filesystem\n        - m2-sed\n        - m2-grep\n        - m2-autoconf\n        - m2-automake-wrapper\n        - m2-pkg-config\n        - m2-make\n        - m2-coreutils\n        - m2-zip\n        - m2-tar\n        - m2-gzip\n  host:\n    - r-base\n    - r-proj4\n    - eccodes >=2.19.0\n  run:\n    - r-base\n    - r-proj4\n    - eccodes >=2.19.0\n\ntests:\n  - if: build_platform == target_platform\n    then:\n      - script:\n          - Rscript -e \"library('gribr')\"\n\nabout:\n  homepage: http://github.com/nawendt/gribr\n  repository: https://github.com/nawendt/gribr\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: LICENSE\n  summary: R interface for GRIB files using ECMWF ecCodes.\n  description: |\n    Easily read GRIB data into native R data types.\n\nextra:\n  recipe-maintainers:\n    - conda-forge/r\n    - nawendt\n",
  "req": {
    "__set__": true,
    "elements": [
      "autoconf",
