    "about": {
      "description": "fluidtop is a terminal-based performance monitor for Apple Silicon Macs\n(M1/M2/M3/M4). It reports CPU, GPU, Apple Neural Engine, memory and power\nusage in real time, with a focus on AI/ML workloads. It is an enhanced\nalternative to asitop.\n\nMost metrics come from macOS' powermetrics, so fluidtop should be run with\nsudo to get full readings.",
      "dev_url": "https://github.com/FluidInference/fluidtop",
      "doc_url": "https://github.com/FluidInference/fluidtop#readme",
      "home": "https://github.com/FluidInference/fluidtop",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Real-time hardware performance monitoring for Apple Silicon with AI workload focus"
    },
    "build": {
      "number": "0",
      "script": "python -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
