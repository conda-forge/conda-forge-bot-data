      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Fit interpretable models. Explain blackbox machine learning."
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "cd ./python/interpret-core/ && ${{ PYTHON }} -m pip install . -vv"
    },
    "extra": {
      "recipe-maintainers": [
        "paulbkoch",
        "interpret-ml",
        "mgorny"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "interpret-core",
        "requirements": {
          "build": [
            "nodejs 22.*"
          ],
          "host": [
            "python 3.10.*",
            "pip",
            "setuptools"
          ],
          "run": [
            "python >=3.10",
            "libebm 0.7.8.*",
            "numpy >=1.25",
            "pandas >=0.24",
            "scikit-learn >=1.6.0",
            "joblib >=0.11"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "interpret"
              ],
              "python_version": [
                "3.10",
                "*"
              ]
            }
          },
          {
            "files": {
              "source": [
                "python/interpret-core/tests/**"
              ]
            },
            "requirements": {
              "run": [
                "python 3.10.*",
                "pip",
                "psutil >=5.6.2",
                "ipython >=5.5.0",
                "plotly >=3.8.1",
                "salib >=1.3.3",
                "shap >=0.28.5",
                "ipywidgets >=7.4.2",
                "scikit-learn >=1.6.0",
                "dash >=2.0.0",
                "dash_cytoscape >=0.1.1",
                "flask >=1.0.4",
                "gevent >=1.3.6",
                "requests >=2.19.0",
                "scipy >=0.18.1",
                "pytest >=4.3.0",
                "pytest-xdist >=1.29",
                "nbconvert >=5.4.1",
                "nbformat >=4.4.0",
                "selenium >=3.141.0",
                "pytest-cov >=2.6.1"
              ]
            },
            "script": [
              "pip list",
              "python -m pytest -vv -n auto --junitxml=junit/test-results.xml --cov=interpret --cov-report=xml --cov-report=html python/interpret-core/tests --ignore=python/interpret-core/tests/glassbox/test_aplr.py"
            ]
          }
        ],
        "version": "0.7.8"
      }
    ],
