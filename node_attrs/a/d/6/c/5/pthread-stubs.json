  "raw_meta_yaml": "{% set xorg_name = \"libpthread-stubs\" %}\n{% set xorg_category = \"xcb\" %}\n{% set name = \"pthread-stubs\" %}\n{% set version = \"0.4\" %}\n{% set sha256 = \"e4d05911a3165d3b18321cc067fdd2f023f06436e391c6a28dff618a78d2e733\" %}\n{% set am_version = \"1.15\" %} # keep synchronized with build.sh\n\npackage:\n  name: {{ name|lower }}\n  version: \"{{ version }}\"\n\nsource:\n  fn: {{ xorg_name }}-{{ version }}.tar.bz2\n  url: https://www.x.org/releases/individual/{{ xorg_category }}/{{ xorg_name }}-{{ version }}.tar.bz2\n  sha256: {{ sha256 }}\n\n# NOTE: this package installs no machine code on Windows. Its configure checks\n# use a build-platform MinGW compiler only to determine the pkg-config flags.\n\nbuild:\n  number: 1004\n  detect_binary_files_with_prefix: true\n  ignore_run_exports_from:\n    - {{ m2w64_c_compiler }}_win-64  # [target_platform == \"win-arm64\"]\n    - {{ m2w64_c_stdlib }}_win-64    # [target_platform == \"win-arm64\"]\n\nrequirements:\n  build:\n    - m2-autoconf                   # [win]\n    - m2-automake{{ am_version }}   # [win]\n    - m2-libtool                    # [win]\n    - pkg-config\n    - gnuconfig                     # [unix]\n    - m2-base                       # [win]\n    - make                          # [unix]\n    - m2-make                       # [win]\n    - {{ compiler('c') }}           # [unix]\n    - {{ stdlib(\"c\") }}             # [unix]\n    - {{ compiler('m2w64_c') }}     # [win and target_platform != \"win-arm64\"]\n    - {{ stdlib(\"m2w64_c\") }}       # [win and target_platform != \"win-arm64\"]\n    # This package only uses the compiler for configure probes. Run those\n    # probes with GCC from the win-64 build platform when targeting win-arm64.\n    - {{ m2w64_c_compiler }}_win-64 {{ m2w64_c_compiler_version }}.*  # [target_platform == \"win-arm64\"]\n    - {{ m2w64_c_stdlib }}_win-64 {{ m2w64_c_stdlib_version }}.*      # [target_platform == \"win-arm64\"]\n  host:\n    - xorg-util-macros\n\ntest:\n  commands:\n    - test -f ${PREFIX}/lib/pkgconfig/pthread-stubs.pc  # [unix]\n    - 'grep -F \"Version: {{ version }}\" ${PREFIX}/lib/pkgconfig/pthread-stubs.pc'  # [unix]\n    - 'if not exist \"%LIBRARY_PREFIX%\\lib\\pkgconfig\\pthread-stubs.pc\" exit /b 1'  # [win]\n    - 'findstr /C:\"Version: {{ version }}\" \"%LIBRARY_PREFIX%\\lib\\pkgconfig\\pthread-stubs.pc\"'  # [win]\n    - 'findstr /C:\"Cflags: -pthread\" \"%LIBRARY_PREFIX%\\lib\\pkgconfig\\pthread-stubs.pc\"'  # [win]\n    - 'findstr /C:\"Libs: -pthread\" \"%LIBRARY_PREFIX%\\lib\\pkgconfig\\pthread-stubs.pc\"'  # [win]\n\nabout:\n  home: https://xcb.freedesktop.org/\n  license: MIT\n  license_family: MIT\n  license_file: COPYING\n  summary: \"Stubs missing from libc for standard pthread functions\"\n\nextra:\n  recipe-maintainers:\n    - ccordoba12\n    - mingwandroid\n    - pkgw\n",
