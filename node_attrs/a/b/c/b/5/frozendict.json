  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"2.4.7\"\n  # verify against a known latest python\n  python_check_max: \"3.14\"\n  # avoid python 3_x absent from:\n  #   https://github.com/Marco-Sulla/python-frozendict/tree/master/src/frozendict/c_src\n  python_no_c_min: \"3.11\"\n\nrecipe:\n  name: frozendict-split\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/f/frozendict/frozendict-${{ version }}.tar.gz\n  sha256: e478fb2a1391a56c8a6e10cc97c4a9002b410ecd1ac28c18d780661762e271bd\n\nbuild:\n  number: 2\n\noutputs:\n  - package:\n      name: frozendict\n    build:\n      skip: not (linux and x86_64 and is_python_min)\n      noarch: python\n      script:\n        env:\n          FROZENDICT_PURE_PY: \"1\"\n          CIBUILDWHEEL: \"0\"\n        content:\n          - python -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n    requirements:\n      host:\n        - pip\n        - python ${{ python_min }}.*\n        - setuptools\n        - wheel\n      run:\n        - python >=${{ python_min }}\n    tests:\n      - python:\n          imports: frozendict\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n      - files:\n          source:\n            - test/\n            - pyproject.toml\n        requirements:\n          run:\n            - pytest\n            - python ${{ python_min }}.*\n        script:\n          - pytest -vv --tb=long --color=yes\n      - files:\n          source:\n            - test/\n            - pyproject.toml\n        requirements:\n          run:\n            - pytest\n            - python ${{ python_check_max }}.*\n        script:\n          - pytest -vv --tb=long --color=yes\n\n  - package:\n      name: frozendict\n    build:\n      skip: match(python, \">=\" ~ python_no_c_min)\n      script:\n        env:\n          FROZENDICT_PURE_PY: \"0\"\n          CIBUILDWHEEL: \"1\"\n        content:\n          - python -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n    requirements:\n      build:\n        - ${{ compiler(\"c\") }}\n        - ${{ stdlib(\"c\") }}\n      host:\n        - pip\n        - python\n        - setuptools\n        - wheel\n      run:\n        - python\n    tests:\n      - python:\n          imports:\n            - frozendict\n            - frozendict._frozendict\n          pip_check: true\n      - package_contents:\n          site_packages:\n            - frozendict/_frozendict.*.${{ \"so\" if unix else \"pyd\" }}\n      - files:\n          source:\n            - test/\n            - pyproject.toml\n        requirements:\n          run:\n            - pytest\n        script:\n          - pytest -vv --tb=long --color=yes\n\nabout:\n  license: LGPL-3.0-only\n  license_file: LICENSE.txt\n  summary: An immutable dictionary\n  homepage: https://pypi.org/project/frozendict\n  repository: https://github.com/Marco-Sulla/python-frozendict\n\nextra:\n  feedstock-name: frozendict\n  recipe-maintainers:\n    - Marco-Sulla\n",
