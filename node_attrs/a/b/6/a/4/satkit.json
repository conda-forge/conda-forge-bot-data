  "linux_64_meta_yaml": {
    "about": {
      "description": "SatKit is a high-performance orbital mechanics library written in\nRust with complete Python bindings via PyO3. It handles coordinate\ntransforms, orbit propagation, time systems, gravity models,\natmospheric density, and JPL ephemerides — everything needed for\nsatellite astrodynamics work.\n\nThe IERS nutation tables and gravity models are compiled in, so the\npackage works with no data files and no network. The JPL DE440\nephemeris (~102 MB) is downloaded on first use, SHA-256 verified;\noffline environments can pre-populate a data directory\n(`satkit.utils.update_datafiles()`, then `SATKIT_DATA`) or point\n`SATKIT_DATA_URL` at a mirror.",
      "dev_url": "https://github.com/ssmichael1/satkit",
      "doc_url": "https://satkit.dev/",
      "home": "https://github.com/ssmichael1/satkit",
      "license": "(MIT OR Apache-2.0) AND CC-BY-4.0",
      "license_family": "(MIT OR Apache-2.0) AND CC-BY-4.0",
      "license_file": "LICENSE-MIT",
      "summary": "Satellite orbital mechanics library (SGP4, JPL ephemerides, frame transforms)"
    },
    "build": {
      "number": "0",
      "script": [
        "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml",
        "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "ssmichael1"
      ]
    },
