  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  python_min: \"3.12\"\n  version: \"0.2.0\"\n\npackage:\n  name: sarkit-processing\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/s/sarkit-processing/sarkit_processing-${{ version }}.tar.gz\n  sha256: f32262aae45eb25d30c165fc7f0b3eea023a8ae5e8cb11b9e359dcaf62d8449d\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - sarkit-processing = sarkit_processing.__main__:main\n      - skp = sarkit_processing.__main__:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pdm-backend\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - lxml >=5.1.0\n    - networkx >=3.4\n    - numba >=0.63.1\n    - numpy >=2.0.0\n    - sarkit >=1.10.0\n    - scipy >=1.15.0\n    - shapely >=2.1.0\n\ntests:\n  - python:\n      imports:\n        - sarkit_processing\n        - sarkit_processing.atmosphere\n        - sarkit_processing.remocomp\n        - sarkit_processing.sicd_alias\n        - sarkit_processing.sicd_area_plane\n        - sarkit_processing.sicd_deskew\n        - sarkit_processing.sicd_pixel_type\n        - sarkit_processing.sicd_scene_to_image\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - sarkit-processing --help\n      - skp --help\n\nabout:\n  summary: Interacting with SAR data in proven, but nonstandard ways in Python.\n  license: MIT\n  license_file: LICENSE\n  homepage: https://pypi.org/project/sarkit-processing/\n  repository: https://github.com/ValkyrieSystems/sarkit-processing\n\nextra:\n  recipe-maintainers:\n    - pressler-vsc\n    - bombaci-vsc\n    - johnstob\n",
