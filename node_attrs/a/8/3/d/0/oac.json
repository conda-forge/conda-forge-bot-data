  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.18.0\"\n\npackage:\n  name: oac\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/dlr-pa/oac/archive/v${{ version }}.tar.gz\n  sha256: 2f3a142d3fca0e0f38aae91340af0789fe4352f5b411e45127034075d8b4b587\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - oac-run = openairclim.__main__:main\n      - oac-gui = openairclim.gui.__main__:main\n      - oac-download-data = openairclim.repository:main\n      - oac-download-zenodo = openairclim.utils.download_zenodo:main\n      - oac-create-artificial-inventories = openairclim.utils.create_artificial_inventories:main\n      - oac-create-time-evolution = openairclim.utils.create_time_evolution:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=61.0\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - ambiance\n    - cf-units\n    - deepmerge\n    - joblib\n    - matplotlib-base\n    - netcdf4\n    - numpy\n    - pandas\n    - pandas <3\n    - pint\n    - platformdirs\n    - pydantic\n    - requests\n    - scipy\n    - toml\n    - xarray\n\ntests:\n  - python:\n      imports:\n        - openairclim\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - oac-run --help\n      - oac-gui --help\n      - oac-download-data --help\n      - oac-download-zenodo --help\n      - oac-create-artificial-inventories --help\n      - oac-create-time-evolution --help\n\nabout:\n  summary: OpenAirClim is a model for simplified evaluation of the approximate chemistry-climate impact of air traffic emissions.\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://github.com/dlr-pa/oac\n\nextra:\n  recipe-maintainers:\n    - ocefpaf\n",
