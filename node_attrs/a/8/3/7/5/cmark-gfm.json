  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: cmark-gfm\n  version: \"0.29.0.gfm.8\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/github/${{ name }}/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 94a145b7bc18cd4e85edce0a65ac71f24cbafe8e4402c3213835517408a10118\n\nbuild:\n  number: 1\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - if: unix\n      then: make\n  run_exports:\n    - ${{ pin_subpackage(\"cmark-gfm\") }}\n\ntests:\n  - script:\n      - cmark-gfm --version\n      - if: win\n        then:\n          - 'if not exist %LIBRARY_BIN%\\cmark-gfm.dll exit 1'\n          - 'if not exist %LIBRARY_BIN%\\cmark-gfm-extensions.dll exit 1'\n          - 'if not exist %LIBRARY_INC%\\cmark-gfm-extension_api.h exit 1'\n      - if: linux\n        then:\n          - test -f $PREFIX/lib/libcmark-gfm.so\n          - test -f $PREFIX/lib/libcmark-gfm-extensions.so\n      - if: osx\n        then:\n          - test -f $PREFIX/lib/libcmark-gfm.dylib\n          - test -f $PREFIX/lib/libcmark-gfm-extensions.dylib\n      - if: unix\n        then:\n          - test -f $PREFIX/include/cmark-gfm-extension_api.h\n\nabout:\n  homepage: https://github.com/github/cmark-gfm\n  license: BSD-2-Clause\n  license_file: COPYING\n  summary: GitHub's Fork of cmark\n  description: |\n    cmark-gfm is an extended version of the C reference implementation of\n    CommonMark, a rationalized version of Markdown syntax with a spec.\n    cmark-gfm adds GitHub Flavored Markdown extensions to the upstream\n    implementation.\n  repository: https://github.com/github/cmark-gfm\n  documentation: https://github.github.com/gfm/\n\nextra:\n  recipe-maintainers:\n    - saraedum\n    - timkpaine\n",
