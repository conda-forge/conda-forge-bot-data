  "raw_meta_yaml": "context:\n  version: \"3.0.0\"\n\npackage:\n  name: artem\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/FineFindus/artem/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: d180ff37691654744891de77d956c83cc334c82e2377d1cfe4b795234753781a\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n      # copy shell completion files and man page\n      - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions ($prefix)/share/man/man1\n      - let out_dir = glob target/*/release/build/artem-*/out | first\n      - cp ($out_dir)/artem.bash ($prefix)/share/bash-completion/completions/artem\n      - cp ($out_dir)/artem.fish ($prefix)/share/fish/vendor_completions.d/artem.fish\n      - cp ($out_dir)/_artem     ($prefix)/share/zsh/site-functions/_artem\n      - cp ($out_dir)/artem.1    ($prefix)/share/man/man1/artem.1\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nushell\n\ntests:\n  - script:\n      - artem --help\n      - artem --version\n  - package_contents:\n      bin:\n        - artem\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/artem\n            - share/fish/vendor_completions.d/artem.fish\n            - share/zsh/site-functions/_artem\n            - share/man/man1/artem.1\n        - if: win\n          then:\n            - Library/share/bash-completion/completions/artem\n            - Library/share/fish/vendor_completions.d/artem.fish\n            - Library/share/zsh/site-functions/_artem\n            - Library/share/man/man1/artem.1\n      strict: true\n\nabout:\n  summary: Convert images from multiple formats (jpg, png, webp, etc.) to ASCII art\n  description: |\n    artem is a small CLI program written in Rust to easily convert images to ASCII art.\n    It supports conversion from multiple image formats (jpg, png, webp, gif and many more)\n    to ASCII art, with truecolor support by default.\n  license: MPL-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/FineFindus/artem\n  repository: https://github.com/FineFindus/artem\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
