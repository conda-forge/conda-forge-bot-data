  "linux_64_meta_yaml": {
    "about": {
      "description": "asciinema lets you easily record terminal sessions, replay\nthem in a terminal as well as in a web browser, and stream\nthem live to viewers.",
      "dev_url": "https://github.com/asciinema/asciinema",
      "doc_url": "https://docs.asciinema.org/",
      "home": "https://asciinema.org/",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "LICENSE",
      "summary": "Terminal session recorder, streamer, and player"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "export ASCIINEMA_GEN_DIR=$SRC_DIR/generated",
          "cargo auditable install --locked --no-track --bins --root $PREFIX --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml",
          "mkdir -p $PREFIX/share/man/man1 $PREFIX/share/bash-completion/completions $PREFIX/share/zsh/site-functions $PREFIX/share/fish/vendor_completions.d",
          "install -m 644 $ASCIINEMA_GEN_DIR/man/*.1 $PREFIX/share/man/man1/",
          "install -m 644 $ASCIINEMA_GEN_DIR/completion/asciinema.bash $PREFIX/share/bash-completion/completions/asciinema",
          "install -m 644 $ASCIINEMA_GEN_DIR/completion/_asciinema $PREFIX/share/zsh/site-functions/_asciinema",
          "install -m 644 $ASCIINEMA_GEN_DIR/completion/asciinema.fish $PREFIX/share/fish/vendor_completions.d/asciinema.fish"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "sodre",
        "ocefpaf"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "asciinema",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "asciinema --version",
              "asciinema --help"
            ]
          },
          {
            "package_contents": {
