  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\n\nschema_version: 1\n\ncontext:\n  version: \"3.2.1\"\n\npackage:\n  name: asciinema\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/asciinema/asciinema/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: e7e49a09c664a76afc5bc25ca09871eb090bfbe68a2ddbc72750d3cb215d36f1\n\nbuild:\n  number: 0\n  # asciinema requires a POSIX terminal and does not support Windows\n  skip: win\n\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      # build.rs generates man pages and shell completions into ASCIINEMA_GEN_DIR\n      - export ASCIINEMA_GEN_DIR=$SRC_DIR/generated\n      - cargo auditable install --locked --no-track --bins --root $PREFIX --path .\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n      - mkdir -p $PREFIX/share/man/man1 $PREFIX/share/bash-completion/completions $PREFIX/share/zsh/site-functions $PREFIX/share/fish/vendor_completions.d\n      - install -m 644 $ASCIINEMA_GEN_DIR/man/*.1 $PREFIX/share/man/man1/\n      - install -m 644 $ASCIINEMA_GEN_DIR/completion/asciinema.bash $PREFIX/share/bash-completion/completions/asciinema\n      - install -m 644 $ASCIINEMA_GEN_DIR/completion/_asciinema $PREFIX/share/zsh/site-functions/_asciinema\n      - install -m 644 $ASCIINEMA_GEN_DIR/completion/asciinema.fish $PREFIX/share/fish/vendor_completions.d/asciinema.fish\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n\ntests:\n  - script:\n      - asciinema --version\n      - asciinema --help\n  - package_contents:\n      bin:\n        - asciinema\n      files:\n        - share/man/man1/asciinema*.1\n        - share/bash-completion/completions/asciinema\n        - share/zsh/site-functions/_asciinema\n        - share/fish/vendor_completions.d/asciinema.fish\n      strict: true\n\nabout:\n  homepage: https://asciinema.org\n  summary: Terminal session recorder, streamer, and player\n  description: |\n    asciinema lets you easily record terminal sessions, replay\n    them in a terminal as well as in a web browser, and stream\n    them live to viewers.\n  license: GPL-3.0-or-later\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://docs.asciinema.org\n  repository: https://github.com/asciinema/asciinema\n\nextra:\n  recipe-maintainers:\n    - sodre\n    - ocefpaf\n",
