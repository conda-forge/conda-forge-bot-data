  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"5.48\"\n\nrecipe:\n  name: file-split\n  version: ${{ version }}\n\nsource:\n  url: http://ftp.astron.com/pub/file/file-${{ version }}.tar.gz\n  sha256: ed14656883b23a364b4057c05595d93252da9bc473d30106519519d0da141283\n\nbuild:\n  number: 1\n  skip: win\n\noutputs:\n  - staging:\n      name: file-build\n    requirements:\n      build:\n        - if: unix\n          then: gnuconfig\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - make\n      host:\n        - if: unix\n          then: zlib\n    build:\n      script: build.sh\n\n  - package:\n      name: libmagic\n    inherit: file-build\n    build:\n      files:\n        - include/magic.h\n        - lib/libmagic.*\n        - share/misc/magic.mgc\n        - lib/pkgconfig/libmagic.pc\n    requirements:\n      run_exports:\n        - ${{ pin_subpackage('libmagic', upper_bound='x') }}\n    tests:\n      - package_contents:\n          strict: true\n          lib:\n            - magic\n          include:\n            - magic.h\n          files:\n            exists:\n              - share/misc/magic.mgc\n              - lib/pkgconfig/libmagic.pc\n    about:\n      summary: Implementation of the file(1) command\n      license: BSD-2-Clause-Darwin\n      license_file: COPYING\n      repository: https://github.com/file/file\n\n  - package:\n      name: file\n    inherit: file-build\n    build:\n      files:\n        - bin/file\n        - share/man/man*/file*\n        - share/man/man*/magic*\n        - share/man/man*/libmagic*\n    requirements:\n      run:\n        - ${{ pin_subpackage('libmagic', exact=True) }}\n    tests:\n      - script:\n          - file -v\n          - file --version\n          - file --help\n    about:\n      summary: Fine Free File Command\n      description: |\n        The file command is \"a file type guesser\", that is, a command-line tool\n        that tells you in words what kind of data a file contains. Unlike most GUI\n        systems, command-line UNIX systems - with this program leading the charge -\n        don't rely on filename extentions to tell you the type of a file, but look\n        at the file's actual contents. This is, of course, more reliable, but\n        requires a bit of I/O.\n      license: BSD-2-Clause-Darwin\n      license_file: COPYING\n      repository: https://github.com/file/file\n\nabout:\n  homepage: http://darwinsys.com/file\n  summary: Fine Free File Command\n  license: BSD-2-Clause-Darwin\n  license_file: COPYING\n  repository: https://github.com/file/file\n\nextra:\n  feedstock-name: file\n  recipe-maintainers:\n    - blmaier\n    - chrisburr\n    - mariusvniekerk\n    - mrakitin\n    - pavelzw\n",
