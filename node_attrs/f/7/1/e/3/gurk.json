  "linux_64_meta_yaml": {
    "about": {
      "description": "gurk is a Signal Messenger client for the terminal, built in Rust as a\ntext-based user interface (TUI) application on top of the unofficial\n`presage` Signal library.",
      "dev_url": "https://github.com/boxdot/gurk-rs",
      "home": "https://github.com/boxdot/gurk-rs",
      "license": "AGPL-3.0-only",
      "license_family": "AGPL-3.0-only",
      "license_file": "LICENSE-AGPL-3.0",
      "summary": "Signal Messenger client for the terminal"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "export OPENSSL_DIR=\"$PREFIX\"",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins",
          "cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "OPENSSL_NO_VENDOR": "1"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "gurk",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "libprotobuf",
            "perl",
            "pkg-config"
          ],
          "host": [
            "openssl"
          ],
          "run": []
        },
        "tests": [
          {
            "script": [
              "gurk --help",
              "gurk --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "gurk"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.10.1"
      }
    ],
