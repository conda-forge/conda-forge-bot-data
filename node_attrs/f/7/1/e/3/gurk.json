  "raw_meta_yaml": "context:\n  version: \"0.10.1\"\n\npackage:\n  name: gurk\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/boxdot/gurk-rs/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: b2154a45b8ab89f48d71451f128f0888e1107745ede943e510885f9026241567\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      OPENSSL_NO_VENDOR: \"1\"\n    content:\n      # NOTE: we force using the host's (conda-forge's) OpenSSL lib dir for the `libsqlite3-sys` dependency unless on macOS where we use the OS' native Security Framework \n      - if: linux\n        then: export OPENSSL_DIR=\"$PREFIX\"\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n      - if: win\n        then:\n          - set \"OPENSSL_DIR=%LIBRARY_PREFIX%\"\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - libprotobuf\n    - perl\n    - pkg-config\n  host:\n    - if: not osx\n      then: openssl\n\ntests:\n  - script:\n      - gurk --help\n      - gurk --version\n  - package_contents:\n      bin:\n        - gurk\n      strict: true\n\nabout:\n  summary: Signal Messenger client for the terminal\n  description: |\n    gurk is a Signal Messenger client for the terminal, built in Rust as a\n    text-based user interface (TUI) application on top of the unofficial\n    `presage` Signal library.\n  license: AGPL-3.0-only\n  license_file:\n    - LICENSE-AGPL-3.0\n    - THIRDPARTY.yml\n  homepage: https://github.com/boxdot/gurk-rs\n  repository: https://github.com/boxdot/gurk-rs\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
