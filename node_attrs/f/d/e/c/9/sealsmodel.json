  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  name: sealsmodel\n  version: \"1.1.0\"\n\npackage:\n  name: \"${{ name|lower }}\"\n  version: \"${{ version }}\"\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name }}-${{ version }}.tar.gz\n  sha256: 8b001e4585257c44ee8be873846ac7eb8d17fdc93e7e254619105d3d2c2d0cb8\n  patches:\n    - 1.1.0-build.patch  # Fix cython build in sealsmodel 1.1.0\n\nbuild:\n  skip:\n    - match(python, \">=3.12\")\n  script: python -m pip install . -vv --no-deps --no-build-isolation\n  number: 2\n\nrequirements:\n  build:\n    - if: build_platform != host_platform\n      then:\n        - python\n        - cross-python_${{ host_platform }}\n        - cython\n        - numpy\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib(\"c\") }}\n  host:\n    - python\n    - setuptools >=74.1\n    - wheel\n    - cython >3.0.0\n    - setuptools_scm >=8.0.0\n    - numpy\n    - pip\n  run:\n    - python\n    - geopandas\n    - google-cloud-storage\n    - hazelbean\n    - matplotlib-base\n    - netcdf4\n    - gdal\n    - pandas\n    - pygeoprocessing\n    - scipy <1.16.0\n    - pytest # until hazelbean's conda-forge config requires it\n    - pytest-cov # until hazelbean's conda-forge config requires it\n    - pytest-benchmark # until hazelbean's conda-forge config requires it\n\ntests:\n  # Uncomment once there are tests to run\n  #- script:\n  #    - pytest\n  #  requirements:\n  #    run:\n  #      - pytest\n  #      - pytest-cov\n  #      - pytest-benchmark\n\n  - python:\n      imports:\n        - seals\n        - seals.seals_cython_functions\n        - hazelbean\n      pip_check: true\n    requirements:\n      run:\n        - pytest\n        - pytest-cov\n        - pytest-benchmark\n\nabout:\n  homepage: https://github.com/jandrewjohnson/seals_dev\n  summary: Land-use change model and downscaler\n  license: L