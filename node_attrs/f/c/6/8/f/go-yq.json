  "linux_64_meta_yaml": {
    "about": {
      "description": "A lightweight and portable command-line YAML, JSON and XML processor.\nyq uses jq like syntax but works with yaml files as well as json, xml,\nproperties, csv and tsv. It doesn't yet support everything jq does - but it\ndoes support the most common operations and functions, and more is being\nadded continuously.",
      "dev_url": "https://github.com/mikefarah/yq",
      "doc_url": "https://mikefarah.gitbook.io/yq/",
      "home": "https://github.com/mikefarah/yq",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "src/LICENSE",
      "summary": "Process YAML documents from the CLI"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src",
        "go-licenses save . --save_path ../library_licenses",
        "go build -ldflags=\"-s -w\" -v -o $PREFIX/bin/yq",
        "./scripts/generate-man-page-md.sh",
        "./scripts/generate-man-page.sh",
        "mkdir -p \"$PREFIX/share/man/man1/\"",
        "install ./yq.1 \"$PREFIX/share/man/man1/yq.1\""
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "chrisburr",
        "xhochy"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "go-yq",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "go-cgo_compiler_stub",
            "make",
            "go-licenses",
            "pandoc"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "yq --help",
              "yq eval --null-input --no-colors '.key = \"cat\"' | grep -E '^key: cat$'"
            ]
          }
        ],
        "version": "4.53.3"
      }
    ],
