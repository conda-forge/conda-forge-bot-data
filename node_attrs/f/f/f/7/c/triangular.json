  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.2.0\"\n  abi3_python: '3.12'\n\npackage:\n  name: triangular\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/t/triangular/triangular-${{ version }}.tar.gz\n  sha256: 1c80c814b04b13fd89c0d25eefa3852f902e0b2cf26731e30b06c21a9de3edd0\n\nbuild:\n  number: 0\n  skip: match(python, \"!=${{ abi3_python }}\")\n  script:\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    version_independent: true\n\nrequirements:\n  build:\n    # NOTE: For cross-compilation, we need the Python interpreter's headers and\n    # stuff (cross-python_*) for the target architecture.\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1.7,<2\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n  host:\n    - python-abi3\n    - python\n    - maturin >=1.7,<2\n    - pip\n  run:\n    - python\n    - numpy >=1.23\n\ntests:\n  - python:\n      python_version:\n        - ${{ abi3_python }}.*\n        - \"*\"\n      imports:\n        - triangular\n        - triangular._triangular\n      pip_check: true\n  - requirements:\n      run:\n        - abi3audit\n    script:\n      - if: unix\n        then: abi3audit $SP_DIR/triangular/_triangular.abi3.so -s -v --assume-minimum-abi3 ${{ abi3_python }}\n        else: abi3audit %SP_DIR%\\triangular\\_triangular.pyd -s -v --assume-minimum-abi3 ${{ abi3_python }}\n\n\nabout:\n  summary: 2-D Delaunay triangulation and convex hull, API-compatible with the triangle library.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/earth-mover/triangular\n  repository: https://github.com/earth-mover/triangular\n\nextra:\n  recipe-maintainers:\n    - martinRenou\n    - samantha-earthmover\n",
