  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: genesis-world\n  version: \"1.3.3\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/Genesis-Embodied-AI/genesis-world/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: b7ef47f0ff694fc93d31b7a195786aff0c6c7790376ee415345543202f5cb914\n  patches:\n    # Remove once upstream metadata no longer conflicts with conda-forge's\n    # moviepy stack and the optional binary helpers can be redistributed.\n    - patches/0001-relax-conda-runtime-metadata.patch\n    # Remove once the restricted IsaacGym helper is no longer shipped or is\n    # made optional upstream without importing it at module load time.\n    - patches/0002-drop-restricted-isaacgym-helper.patch\n\nbuild:\n  number: 0\n  noarch: python\n  python:\n    entry_points:\n      - gs = genesis._main:main\n  script: python -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n    - wheel\n    - cython >=3.0.0\n    - numpy >=1.26.4\n  run:\n    - python >=${{ python_min }},<3.14\n    - av\n    - coacd\n    - dracopy\n    - fast-simplification >=0.1.12\n    - freetype-py\n    - frozendict\n    - igl !=2.6.2\n    - moviepy >=2.0.0\n    - mujoco >=3.2.5\n    - numba\n    - numpy >=1.26.4\n    - openexr-python\n    - pillow >=10,<12\n    - psutil\n    - py-cpuinfo\n    - py-opencv\n    - pycollada\n    - pydantic >=2.11.0\n    - pygel3d\n    - pyglet >=1.5,!=2.1.8\n    - pygltflib >=1.16.0,<1.17\n    - pymeshlab\n    - pyopengl >=3.1.4\n    - pysplashsurf >=0.14,<0.15\n    - pytorch >=2.8\n    - python-tetgen ==0.8.2\n    - quadrants ==1.3.0\n    - rtree\n    - scikit-image\n    - trimesh >=4.8.2\n    - vtk\n    - xacro\n    - z3-solver <4.15.5.0\n\ntests:\n  - script:\n      - python -c \"import genesis; import genesis.vis.batch_renderer\"\n      - pip check\n      - python run_test.py\n      - gs --help\n    files:\n      recipe:\n        - run_test.py\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pip\n\nabout:\n  homepage: https://genesis-embodied-ai.github.io/\n  summary: Universal and generative physics engine for robotics and embodied AI\n  license: Apache-2.0 AND MIT AND OFL-1.1\n  license_file:\n    - LICENSE\n    - LICENSE-vendored-pyrender-urdfpy\n    - LICENSE-vendored-fonts\n  repository: https://github.com/Genesis-Embodied-AI/genesis-world\n  documentation: https://genesis-world.readthedocs.io/\n\nextra:\n  recipe-maintainers:\n    - jeongseok-meta\n",
