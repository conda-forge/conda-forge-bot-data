  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.3.3\"\n\npackage:\n  name: cv2-enumerate-cameras\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/c/cv2-enumerate-cameras/cv2_enumerate_cameras-${{ version }}.tar.gz\n  sha256: cc09429e3fd4a2ea3449bbc0ee12420666aee6705d80a36f2235503d90fff3a2\n\nbuild:\n  number: 1\n  script:\n    - if: win\n      then:\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n        # MSVC leaves mspdbsrv.exe/vctip.exe service processes running after the\n        # compile; they hold handles below the work directory and make\n        # rattler-build's cleanup fail with \"Access is denied\" (os error 5).\n        - taskkill /F /IM mspdbsrv.exe /T 2>nul & taskkill /F /IM vctip.exe /T 2>nul & exit /B 0\n      else:\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - lscam = cv2_enumerate_cameras.__main__:main\n\nrequirements:\n  build:\n    # setup.py builds the _windows_backend.cpp extension (MSMF/DSHOW) on\n    # Windows only; linux and macOS are pure python\n    - if: win\n      then:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('cxx') }}\n  host:\n    - python\n    - setuptools\n    - pip\n  run:\n    - python\n    # the macOS backend imports AVFoundation (PyObjC) at import time\n    - if: osx\n      then: pyobjc-framework-avfoundation\n\ntests:\n  - python:\n      imports:\n        - cv2_enumerate_cameras\n      pip_check: true\n  - requirements:\n      run:\n        - pip\n        - python\n    script:\n      - lscam --help\n\nabout:\n  summary: Enumerate / List / Find / Detect / Search index for opencv VideoCapture.\n  description: |\n    cv2-enumerate-cameras lists the cameras available to OpenCV's\n    VideoCapture without having to open each device. For every camera it\n    reports the capture index together with metadata such as the device\n    name, vendor/product IDs, device path, and capture backend (V4L2 on\n    Linux, MSMF/DSHOW on Windows, AVFoundation on macOS). It also ships\n    the `lscam` command line tool to print the detected cameras.\n  license: MIT\n  license_file: LICENSE\n  homepage: https://github.com/lukehugh/cv2_enumerate_cameras\n  repository: https://github.com/lukehugh/cv2_enumerate_cameras\n\nextra:\n  recipe-maintainers:\n    - ruben-arts\n",
