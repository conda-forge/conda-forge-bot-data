  "linux_64_meta_yaml": {
    "about": {
      "description": "cv2-enumerate-cameras lists the cameras available to OpenCV's\nVideoCapture without having to open each device. For every camera it\nreports the capture index together with metadata such as the device\nname, vendor/product IDs, device path, and capture backend (V4L2 on\nLinux, MSMF/DSHOW on Windows, AVFoundation on macOS). It also ships\nthe `lscam` command line tool to print the detected cameras.",
      "dev_url": "https://github.com/lukehugh/cv2_enumerate_cameras",
      "home": "https://github.com/lukehugh/cv2_enumerate_cameras",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Enumerate / List / Find / Detect / Search index for opencv VideoCapture."
    },
    "build": {
      "number": "1",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "ruben-arts"
      ]
    },
