  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  stubs_version: 2\n  raysect_version: 0.9.1\n  raysect_cap: 0.10.0\n\nrecipe:\n  name: raysect-stubs-split\n  version: ${{ raysect_version }}.${{ stubs_version }}\n\nsource:\n  url: https://github.com/munechika-koyo/raysect-stubs/archive/v${{ raysect_version }}.${{ stubs_version }}.tar.gz\n  sha256: 8fc08f641fd1f79ed14a1be426082d51a1197438702ad71f210d53a5aaba063a\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: raysect-stubs\n    build:\n      noarch: python\n      script:\n        content: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n        env:\n          SETUPTOOLS_SCM_PRETEND_VERSION: ${{ raysect_version }}.${{ stubs_version }}\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling\n        - hatch-vcs\n      run:\n        - python >=${{ python_min }}\n        - numpy\n        - typing-extensions\n      run_constraints:\n        - raysect >=${{ raysect_version }},<${{ raysect_cap }}\n    tests:\n      - python:\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n          pip_check: true\n\n  - package:\n      name: raysect-typed\n    build:\n      noarch: python\n      skip: win\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - raysect ==${{ raysect_version }}\n        - ${{ pin_subpackage('raysect-stubs', exact=True) }}\n        - __unix\n    tests:\n      - python:\n          imports:\n            - raysect\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n      - files:\n          source:\n            - pyproject.toml\n            - .mypyignore\n            - tests/\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n            - pytest\n            - mypy\n        script:\n          - stubtest --allowlist=.mypyignore --ignore-disjoint-bases raysect\n          - pytest -q tests/test_stubs.py\n\nabout:\n  license: BSD-3-Clause\n  license_file: LICENSE\n  summary: Typing Stubs for Raysect\n  description: The type stubs for Raysect.\n  homepage: https://github.com/munechika-koyo/raysect-stubs/\n  repository: https://github.com/munechika-koyo/raysect-stubs/\n  documentation: https://github.com/munechika-koyo/raysect-stubs?tab=readme-ov-file#raysect-stubs\n\nextra:\n  recipe-maintainers:\n    - munechika-koyo\n  feedstock-name: raysect-stubs\n",
