  "raw_meta_yaml": "{% set name = \"sirius\" %}\n{% set version = \"7.11.1\" %}\n\n{% set build = 4 %}\n\n{% set mpi_prefix = \"mpi_\" + mpi %}\n\npackage:\n  name: {{ name|lower }}\n  version: \"{{ version }}\"\n\nsource:\n  url: https://github.com/electronic-structure/SIRIUS/archive/refs/tags/v{{ version }}.tar.gz\n  sha256: ce77dd168b2c3ef4a89cc2d6b163cb00b3d8b9d4b0652bc9de187dc7e0e74d77\n\nbuild:\n  number: {{ build }}\n  string: {{ mpi_prefix }}_h{{ PKG_HASH }}_{{ build }}\n  skip: true  # [win]\n  run_exports:\n    - {{ pin_subpackage(\"sirius\", max_pin=\"x\") }}\n\nrequirements:\n  build:\n    - {{ compiler(\"c\") }}\n    - {{ stdlib(\"c\") }}\n    - {{ compiler(\"cxx\") }}\n    - {{ compiler(\"fortran\") }}\n    - {{ mpi }}\n    - cmake >=3.25\n    - doxygen\n    - ninja >=1.13\n    - pkg-config\n  host:\n    - {{ mpi }}\n    - _openmp_mutex\n    - \"costa * {{ mpi_prefix }}_*\" \n    - fmt\n    - gsl\n    - hdf5\n#   - \"libvdwxc * {{ mpi_prefix }}_*\" \n    - libxc-c\n    - \"openblas * *openmp_*\"\n    - pugixml\n    - scalapack\n    - \"spfft * {{ mpi_prefix }}_*\" \n    - \"spla * {{ mpi_prefix }}_*\" \n    - spglib\n  run:\n    - {{ mpi }}\n    - _openmp_mutex\n    - fmt\n    - gsl\n    - libxc-c\n    - \"openblas * *openmp_*\"\n    - scalapack\n    - \"spfft * {{ mpi_prefix }}_*\" \n    - \"spla * {{ mpi_prefix }}_*\" \n\ntest:\n  commands:\n    - test -f \"${PREFIX}/lib/libsirius${SHLIB_EXT}\"\n    - atom --help\n    - hydrogen --help\n\nabout:\n  home: https://github.com/electronic-structure/SIRIUS\n  license: BSD-2-Clause\n  license_family: BSD\n  license_file: LICENSE\n  summary: Domain specific library for electronic structure calculations\n  description: |\n    SIRIUS is a domain specific library for electronic structure calculations.\n    It implements pseudopotential plane wave (PP-PW) and full potential\n    linearized augmented plane wave (FP-LAPW) methods and is designed for GPU\n    acceleration of popular community codes such as Exciting