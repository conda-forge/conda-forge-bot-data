    "about": {
      "description": "SIRIUS is a domain specific library for electronic structure calculations.\nIt implements pseudopotential plane wave (PP-PW) and full potential\nlinearized augmented plane wave (FP-LAPW) methods and is designed for GPU\nacceleration of popular community codes such as Exciting, Elk and Quantum\nESPRESSO.\n",
      "dev_url": "https://github.com/electronic-structure/SIRIUS",
      "doc_url": "https://electronic-structure.github.io/SIRIUS-doc/",
      "home": "https://github.com/electronic-structure/SIRIUS",
