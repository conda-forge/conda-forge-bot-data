  "raw_meta_yaml": "context:\n  version: \"0.1.0a4\"\n  # 0.1.0a4 -> 0.1.0-alpha.4, the version upstream tags with and reports as\n  # geopolars.__version__\n  upstream_version: ${{ version | replace(\"a\", \"-alpha.\") }}\n  tag: v${{ upstream_version }}\n\npackage:\n  name: geopolars\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/pola-rs/geopolars/archive/refs/tags/${{ tag }}.tar.gz\n  sha256: 00881b27baa449fae7e13bf4d42067d5de5f57872773a152f381a03ef1116425\n  patches:\n    - patches/0001-build-with-maturin-1.x.patch\n\nbuild:\n  number: 0\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      # Never let prost-build fall back to compiling its vendored protobuf with\n      # cmake; ${PROTOC} from libprotobuf is enough. See build.sh for details.\n      PROTOC_NO_VENDOR: \"1\"\n    file: build\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    # Only to satisfy prost-build's build script, see build.sh.\n    - libprotobuf\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1.0,<2\n  host:\n    - python\n    - if: is_abi3\n      then:\n        - python-abi3\n    - pip\n    - maturin >=1.0,<2\n  run:\n    - python\n    - polars >=0.14.19\n    - pyarrow >=4.0\n    - numpy >=1.16.0\n\ntests:\n  - python:\n      imports:\n        - geopolars\n        - geopolars.datasets\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - package_contents:\n      site_packages:\n        - geopolars/__init__.py\n        - geopolars/datasets/naturalearth_lowres.arrow\n        - if: is_abi3\n          then: geopolars/geopolars.${{ 'abi3.so' if unix else 'pyd' }}\n          else: geopolars/geopolars.${{ '*.so' if unix else '*.pyd' }}\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/geopolars/geopolars.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%\\geopolars\\geopolars.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n  - script:\n      - python -c \"import geopolars; assert geopolars.__version__ == '${{ upstream_version }}'\"\n      # Exercise the compiled geo kernels through the Python API.\n      - python test_geopolars.py\n    files:\n      recipe:\n        - test_geopolars.py\n\nabout:\n  homepage: https://github.com/pola-rs/geopolars\n  summary: Geospatial extensions for Polars\n  description: |\n    GeoPolars extends the Polars DataFrame library for use with geospatial\n    data. It uses GeoArrow as the internal memory model, is written in Rust\n    with bindings to Python, and is multithreading capable.\n\n    At this point GeoPolars is a prototype and should not be considered\n    production-ready.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/pola-rs/geopolars\n  documentation: https://docs.rs/geopolars\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
