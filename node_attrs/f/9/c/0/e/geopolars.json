  "linux_64_meta_yaml": {
    "about": {
      "description": "GeoPolars extends the Polars DataFrame library for use with geospatial\ndata. It uses GeoArrow as the internal memory model, is written in Rust\nwith bindings to Python, and is multithreading capable.\n\nAt this point GeoPolars is a prototype and should not be considered\nproduction-ready.",
      "dev_url": "https://github.com/pola-rs/geopolars",
      "doc_url": "https://docs.rs/geopolars",
      "home": "https://github.com/pola-rs/geopolars",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Geospatial extensions for Polars"
    },
    "build": {
      "number": "0",
      "script": {
        "env": {
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "PROTOC_NO_VENDOR": "1"
        },
        "file": "build"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "geopolars",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "libprotobuf"
          ],
          "host": [
            "python",
            "python-abi3",
            "pip",
            "maturin >=1.0,<2"
          ],
          "run": [
            "python",
            "polars >=0.14.19",
            "pyarrow >=4.0",
            "numpy >=1.16.0"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "geopolars",
                "geopolars.datasets"
              ],
              "python_version": [
                "3.11.*",
                "*"
              ]
            }
          },
          {
            "package_contents": {
              "site_packages": [
                "geopolars/__init__.py",
                "geopolars/datasets/naturalearth_lowres.arrow",
                "geopolars/geopolars.abi3.so"
              ]
            }
          },
          {
            "requirements": {
              "run": [
                "abi3audit"
              ]
            },
            "script": "abi3audit $SP_DIR/geopolars/geopolars.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}"
          },
          {
            "files": {
              "recipe": [
                "test_geopolars.py"
              ]
            },
            "script": [
              "python -c \"import geopolars; assert geopolars.__version__ == '${{ upstream_version }}'\"",
              "python test_geopolars.py"
            ]
          }
        ],
        "version": "0.1.0a4"
      }
    ],
