  "raw_meta_yaml": "context:\n  version: \"1.8.0\"\n\npackage:\n  name: tbox\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/tboox/tbox/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 3b919f61055b75fe9cb3796477468f6fe7524801d429e6ac48933ddde9caafbd\n\nbuild:\n  number: 1\n\nrequirements:\n  run_exports:\n    - ${{ pin_subpackage('tbox', upper_bound='x.x') }}\n  build:\n    - if: unix\n      then:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ninja\n    - if: win\n      then:\n        - ${{ compiler('c') }}\n        - autotools_clang_conda\n        - m2-sed\n\ntests:\n  - package_contents:\n      include:\n        - tbox/*\n      lib:\n        - tbox\n  - script:\n      - if: unix\n        then:\n          - grep -q \"TB_CONFIG_MODULE_HAVE_HASH .*1\" \"$PREFIX/include/tbox/tbox.config.h\"\n          - grep -q \"TB_CONFIG_MODULE_HAVE_CHARSET .*1\" \"$PREFIX/include/tbox/tbox.config.h\"\n      - if: win\n        then:\n          - findstr /R /C:\"TB_CONFIG_MODULE_HAVE_HASH .*1\" \"%LIBRARY_INC%\\tbox\\tbox.config.h\"\n          - findstr /R /C:\"TB_CONFIG_MODULE_HAVE_CHARSET .*1\" \"%LIBRARY_INC%\\tbox\\tbox.config.h\"\n\nabout:\n  homepage: https://tboox.top/?lang=0\n  summary: A glib-like multi-platform c library\n  description: |\n    tbox is a glib-like multi-platform c library. \n  license: Apache-2.0\n  license_file: LICENSE.md\n  repository: https://github.com/tboox/tbox\n\nextra:\n  recipe-maintainers:\n    - luadebug\n",
