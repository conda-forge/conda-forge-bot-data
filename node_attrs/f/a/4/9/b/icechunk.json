  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: icechunk\n  version: \"2.1.2\"\n  python_min: \"3.12\"\n  sha256: 762daf1ece116903b25c66555bc07bf9756de26f2e7d0cdbdb6d69530aa35f82\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name|lower }}-${{ version }}.tar.gz\n  sha256: ${{ sha256 }}\n\nbuild:\n  number: 2\n  skip: is_abi3 and not is_python_min\n  script:\n    env:\n      PYTHONUTF8: \"1\"\n      PYTHONIOENCODING: utf-8\n    content:\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - icechunk = icechunk._icechunk_python:cli_entrypoint\n    version_independent: ${{ true if is_abi3 }}\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then: python ${{ python_min }}.*\n    - if: build_platform != target_platform\n      then: cross-python_${{ target_platform }} ${{ python_min }}.*\n    - if: build_platform != target_platform\n      then: crossenv\n    - if: build_platform != target_platform\n      then: maturin >=1.7.0,<2.0\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n  host:\n    - if: is_abi3\n      then: python-abi3\n    - python ${{ python_min }}.*\n    - maturin >=1.7,<2.0\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - if: not aarch64\n      then: zarr >=3.1\n\ntests:\n  - python:\n      imports:\n        - if: not aarch64\n          then: icechunk\n      pip_check: false\n  - requirements:\n      run:\n        - if: not aarch64\n          then: pip\n        - if: is_abi3\n          then: abi3audit\n    script:\n      - if: not aarch64\n        then: pip check\n      - if: unix and is_abi3\n        then: abi3audit $SP_DIR/icechunk/_icechunk_python.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      - if: win and is_abi3\n        then: abi3audit %SP_DIR%/icechunk/_icechunk_python.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  summary: Transactional storage engine for Zarr designed for use on cloud object storage\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/earth-mover/icechunk\n\nextra:\n  recipe-maintainers:\n    - ianhi\n    - li-em\n    - TomNicholas\n    - andersy005\n    - dcherian\n    - jhamman\n    - mpiannucci\n    - paraseba\n    - rabernat\n",
