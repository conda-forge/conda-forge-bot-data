  "raw_meta_yaml": "context:\n  version: \"0.1.0\"\n  python_min: \"3.10\"\n\nrecipe:\n  name: conda-completion-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/conda-incubator/conda-completion/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 47987de34782335d6613fab7dc551debf74c82b8a246c35a4e95113825e3d9e0\n\nbuild:\n  number: 1\n\noutputs:\n  - package:\n      name: conda-completer\n      version: ${{ version }}\n    build:\n      number: 1\n      python:\n         version_independent: true\n      script:\n        env:\n          CARGO_PROFILE_RELEASE_STRIP: symbols\n          CARGO_PROFILE_RELEASE_LTO: fat\n        content:\n          - if: unix\n            then:\n              - ${{ PYTHON }} -m pip install packages/conda-completer -vv --no-deps --no-build-isolation\n            else:\n              - ${{ PYTHON }} -m pip install packages\\conda-completer -vv --no-deps --no-build-isolation\n    requirements:\n      build:\n        - maturin >=1.0,<2.0\n        - ${{ compiler('rust') }}\n        - ${{ stdlib('c') }}\n        - if: build_platform != target_platform\n          then:\n            - python ${{ python_min }}.*\n            - cross-python_${{ target_platform }}\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - maturin >=1.0,<2.0\n      run:\n        - python >=${{ python_min }}\n    tests:\n      - python:\n          imports:\n            - conda_completer\n          pip_check: false\n      - package_contents:\n          files:\n            - python-scripts/_conda_completer*\n\n  - package:\n      name: conda-completion\n      version: ${{ version }}\n    build:\n      number: 1\n      noarch: python\n      script:\n        env:\n          SETUPTOOLS_SCM_PRETEND_VERSION: ${{ version }}\n        content: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    requirements:\n      build:\n        - if: build_platform != target_platform\n          then:\n            - python ${{ python_min }}.*\n            - cross-python_${{ target_platform }}\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling >=1.12.2\n        - hatch-vcs >=0.2.0\n      run:\n        - python >=${{ python_min }}\n        - conda >=25.1\n        - conda-completer ==${{ version }}\n        - platformdirs >=4.0\n        - tomli >=2.0\n        - tomli-w >=1.0\n    tests:\n      - python:\n          imports:\n            - conda_completion\n            - conda_completion.plugin\n          pip_check: false\n          python_version: ${{ python_min }}.*\n\nabout:\n  homepage: https://github.com/conda-incubator/conda-completion\n  repository: https://github.com/conda-incubator/conda-completion\n  documentation: https://conda-incubator.github.io/conda-completion/\n  license: BSD-3-Clause\n  license_file: LICENSE\n  summary: >\n    Fast shell tab completion for conda and all its plugins.\n\nextra:\n  feedstock-name: conda-completion\n  recipe-maintainers:\n    - jezdez\n",
