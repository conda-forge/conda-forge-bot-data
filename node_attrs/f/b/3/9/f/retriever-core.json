  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.0.3\"\n  python_min: \"3.11\"\n\nrecipe:\n  name: retriever-core\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/r/retriever-core/retriever_core-${{ version }}.tar.gz\n  sha256: 1211dd67912a405028494655d791275c69f5f17cf83c32e67a3dca1945e429d7\n\nbuild:\n  number: 0\n  noarch: python\n\noutputs:\n  # The core Retriever package.\n  - package:\n      name: retriever-core\n    build:\n      script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n      python:\n        entry_points:\n          - retriever = retriever.cli:main\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - hatchling\n        - pip\n      run:\n        - python >=${{ python_min }}\n        - packaging >=23\n    tests:\n      - python:\n          imports:\n            - retriever\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n      - script:\n          - retriever --help\n\n  # Metapackages mirroring the upstream extras (pip install \"retriever-core[<extra>]\").\n  - package:\n      name: retriever-core-dora\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage('retriever-core', exact=true) }}\n        - dora-cli >=0.3.12\n        - dora-rs >=0.3.12\n        - psutil\n        - pyarrow\n        - pyyaml\n    tests:\n      - python:\n          imports:\n            - retriever\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: retriever-core-jax\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage('retriever-core', exact=true) }}\n        - flax\n        - jax\n        - jaxlib\n        - optax\n    tests:\n      - python:\n          imports:\n            - retriever\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: retriever-core-mcp\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage('retriever-core', exact=true) }}\n        - mcp >=1.25.0,<2\n    tests:\n      - python:\n          imports:\n            - retriever\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: retriever-core-otel\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage('retriever-core', exact=true) }}\n        - opentelemetry-api\n        - opentelemetry-sdk\n        - uptrace\n    tests:\n      - python:\n          imports:\n            - retriever\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: retriever-core-recording\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage('retriever-core', exact=true) }}\n        - mcap >=1.0.0\n        - numpy\n        - rerun-sdk >=0.21.0,<0.24\n    tests:\n      - python:\n          imports:\n            - retriever\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: retriever-core-vision\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage('retriever-core', exact=true) }}\n        - pillow\n        - pytorch >=2.0.0\n        - transformers\n    tests:\n      - python:\n          imports:\n            - retriever\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: retriever-core-web\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage('retriever-core', exact=true) }}\n        - fastapi\n        - uvicorn-standard\n    tests:\n      - python:\n          imports:\n            - retriever\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\nabout:\n  homepage: https://github.com/openretriever/retriever\n  summary: A Python programming model and runtime for closed-loop robot agents whose perception, planning, and control run at different rates.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRD_PARTY_NOTICES.md\n  documentation: https://retriever.build/\n\nextra:\n  feedstock-name: retriever-core\n  recipe-maintainers:\n    - linfeng-z\n    - tobyxdd\n    - sea-bass\n",
