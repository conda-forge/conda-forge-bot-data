  "raw_meta_yaml": "context:\n  version: \"5.0.1\"\n\npackage:\n  name: salt-terminal\n  version: ${{ version }}\n\nsource:\n  url: https://forge.hekkelman.net/maarten/salt/archive/v${{ version }}.tar.gz\n  sha256: f322e57b164fd5aa7443807b71327d4ac5ca9520118778baaee959aff84ca141\n\nbuild:\n  number: 1\n  # Remove windows in the future when we have windows support\n  skip:\n    - osx\n    - win\n  script: |\n    set -exo pipefail\n    cmake -S . -B build -G Ninja \\\n      ${CMAKE_ARGS} \\\n      -DBUILD_DOCUMENTATION=ON\n    cmake --build build --parallel ${CPU_COUNT}\n    ./build/salt -i --prefix ${PREFIX}\n\n    if [[ \"${target_platform}\" == linux-* ]]; then\n      mkdir -p \"${PREFIX}/Menu\"\n\n      # Prefer the icon/menu metadata produced by upstream's installer when\n      # available; only fall back to the recipe-local asset if it is absent.\n      if [[ ! -f \"${PREFIX}/Menu/salt_menu.json\" ]]; then\n        cp \"${RECIPE_DIR}/menu.json\" \"${PREFIX}/Menu/salt_menu.json\"\n      fi\n\n      if [[ ! -f \"${PREFIX}/Menu/salt.png\" ]]; then\n        upstream_icon=\"\"\n        for search_dir in \"${PREFIX}/share\" \"${PREFIX}/lib\" \"${PREFIX}/libexec\" \"${PREFIX}/usr/share\" \"${PREFIX}/opt\"; do\n          if [[ -d \"${search_dir}\" ]]; then\n            upstream_icon=\"$(find \"${search_dir}\" -type f \\( -iname \"salt*.png\" -o -iname \"icon*.png\" \\) -print -quit 2>/dev/null)\"\n            if [[ -n \"${upstream_icon}\" ]]; then\n              break\n            fi\n          fi\n        done\n\n        if [[ -n \"${upstream_icon}\" ]]; then\n          cp \"${upstream_icon}\" \"${PREFIX}/Menu/salt.png\"\n        fi\n      fi\n    fi\n\nrequirements:\n  build:\n    - ${{ compiler(\"cxx\") }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - ninja\n    - myst-parser\n    - pkg-config\n    - sphinx\n  host:\n    - asio\n    - cryptopp\n    - expat\n    - freetype\n    - glib\n    - gtk4\n    - libcanberra\n    - libgxrio\n    - liblzma-devel\n    - libmcfp\n    - libmgui\n    - libpinch\n    - libzeep >=7.0.0,<8.0.0a0\n    - maartens_resource_compiler\n    - zeem\n    - zlib\n\ntests:\n  - script:\n      - salt --version\n      - salt --help\n  - package_contents:\n      bin:\n        - salt\n      files:\n        - Menu/salt_menu.json\n        - Menu/salt.png\n\nabout:\n  homepage: https://forge.hekkelman.net/maarten/salt\n  documentation: https://forge.hekkelman.net/maarten/salt/src/tag/v${{ version }}/salt-manual.md\n  repository: https://forge.hekkelman.net/maarten/salt\n  license: BSD-2-Clause\n  license_file: LICENSE\n  summary: \"Terminal with built-in SSH\"\n  description: Salt is a terminal emulator with built-in SSH.\n\nextra:\n  recipe-maintainers:\n    - eunos-1128\n",
