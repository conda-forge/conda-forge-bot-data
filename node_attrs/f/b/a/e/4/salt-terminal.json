  "linux_64_meta_yaml": {
    "about": {
      "description": "Salt is a terminal emulator with built-in SSH.",
      "dev_url": "https://forge.hekkelman.net/maarten/salt",
      "doc_url": "https://forge.hekkelman.net/maarten/salt/src/tag/v5.0.1/salt-manual.md",
      "home": "https://forge.hekkelman.net/maarten/salt",
      "license": "BSD-2-Clause",
      "license_family": "BSD-2-Clause",
      "license_file": "LICENSE",
      "summary": "Terminal with built-in SSH"
    },
    "build": {
      "number": "1",
      "script": "set -exo pipefail\ncmake -S . -B build -G Ninja \\\n  ${CMAKE_ARGS} \\\n  -DBUILD_DOCUMENTATION=ON\ncmake --build build --parallel ${CPU_COUNT}\n./build/salt -i --prefix ${PREFIX}\n\nif [[ \"${target_platform}\" == linux-* ]]; then\n  mkdir -p \"${PREFIX}/Menu\"\n\n  # Prefer the icon/menu metadata produced by upstream's installer when\n  # available; only fall back to the recipe-local asset if it is absent.\n  if [[ ! -f \"${PREFIX}/Menu/salt_menu.json\" ]]; then\n    cp \"${RECIPE_DIR}/menu.json\" \"${PREFIX}/Menu/salt_menu.json\"\n  fi\n\n  if [[ ! -f \"${PREFIX}/Menu/salt.png\" ]]; then\n    upstream_icon=\"\"\n    for search_dir in \"${PREFIX}/share\" \"${PREFIX}/lib\" \"${PREFIX}/libexec\" \"${PREFIX}/usr/share\" \"${PREFIX}/opt\"; do\n      if [[ -d \"${search_dir}\" ]]; then\n        upstream_icon=\"$(find \"${search_dir}\" -type f \\( -iname \"salt*.png\" -o -iname \"icon*.png\" \\) -print -quit 2>/dev/null)\"\n        if [[ -n \"${upstream_icon}\" ]]; then\n          break\n        fi\n      fi\n    done\n\n    if [[ -n \"${upstream_icon}\" ]]; then\n      cp \"${upstream_icon}\" \"${PREFIX}/Menu/salt.png\"\n    fi\n  fi\nfi\n"
    },
    "extra": {
      "recipe-maintainers": [
        "eunos-1128"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "salt-terminal",
        "requirements": {
          "build": [
            "cxx_compiler_stub",
            "c_stdlib_stub",
            "cmake",
            "ninja",
            "myst-parser",
            "pkg-config",
            "sphinx"
          ],
          "host": [
            "asio",
            "cryptopp",
            "expat",
            "freetype",
            "glib",
            "gtk4",
            "libcanberra",
            "libgxrio",
            "liblzma-devel",
            "libmcfp",
            "libmgui",
            "libpinch",
            "libzeep >=7.0.0,<8.0.0a0",
            "maartens_resource_compiler",
            "zeem",
            "zlib"
          ],
          "run": []
        },
        "tests": [
          {
            "script": [
              "salt --version",
              "salt --help"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "salt"
              ],
              "files": [
                "Menu/salt_menu.json",
                "Menu/salt.png"
              ]
            }
          }
        ],
        "version": "5.0.1"
      }
    ],
