  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.2.11\"\n\npackage:\n  name: xorq-datafusion\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/x/xorq-datafusion/xorq_datafusion-${{ version }}.tar.gz\n  sha256: 0c7b0a7b91f3cee0ec6f56cfcb84ae4b7a08eaad59fc10df06c8039fdf8366c9\n  patches:\n    # Upstream caps pyarrow at <22 defensively; conda-forge's global pyarrow\n    # pin already constrains the ABI, and pyarrow 22/23/24 are out and\n    # compatible with the arrow-rs 58 bindings xorq-datafusion uses. Drop\n    # the upper bound so users on current pyarrow can install.\n    - patches/0001-drop-pyarrow-upper-bound.patch\n\nbuild:\n  number: 0\n  script:\n    env:\n      # Per conda-forge.org/docs/maintainer/example_recipes/rust/ — STRIP +\n      # fat LTO are the recommended defaults for Rust builds. The abi3\n      # matrix collapse below (skip + version_independent on is_abi3) means\n      # we pay this LTO cost ONCE per platform, not once per Python version,\n      # so the historical \"time out issues\" comment no longer applies — see\n      # conda-forge-expert v8.25.0 ci-troubleshooting.md \"Fat-LTO on Windows\".\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      # Fat LTO only on platforms where the rustc bitcode merge is\n      # empirically stable for this dep graph (datafusion v53 + arrow v58 +\n      # aws-sdk + tokio + heed + ring + ~600 transitive crates):\n      #   linux-64 (12m wall), osx-arm64, win-64 — green in PR #4 first run.\n      # Skipped on:\n      #   linux-aarch64 — qemu-emulated; rustc OOM-killed during bitcode merge.\n      #   osx-64 — rustc ICE (SIGSEGV) on the macOS 13.4 SDK + current LLVM\n      #            combo during fat-LTO bitcode merge.\n      # Cargo.toml's `[profile.release] lto = \"thin\"` is the fallback default.\n      CARGO_PROFILE_RELEASE_LTO: ${{ \"fat\" if target_platform in [\"linux-64\", \"osx-arm64\", \"win-64\"] else \"thin\" }}\n      PYTHONUTF8: \"1\"\n    content:\n      # Multi-line `then: |` so env exports persist into pip install\n      # (per SKILL.md G1: separate `- ` list entries run in independent shells).\n      - if: unix\n        then: |\n          cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n          ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n        else: |\n          cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n          %PYTHON% -m pip install . -vv --no-deps --no-build-isolation\n  # abi3 matrix collapse — canonical conda-forge tree-sitter-pattern.\n  # Cargo.toml declares pyo3 abi3-py38, which is at or below conda-forge-pinning's\n  # python_min default (3.10) — Variant A (is_abi3 and not is_python_min) applies.\n  # Single CPython-stable-ABI wheel works across Python ≥ python_min.\n  # Build once at python_min, ship one artifact per platform.\n  # See reference/abi3-matrix-collapse.md.\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1,<2\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - maturin >=1.7,<2.0\n    - pip\n    - if: is_abi3\n      then: python-abi3\n  run:\n    - python\n    - pyarrow >=18.0.0\n\ntests:\n  - python:\n      imports:\n        - xorq_datafusion\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/xorq_datafusion/_internal.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%\\xorq_datafusion\\_internal.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  summary: xorq Python DataFusion Bindings.\n  homepage: https://github.com/xorq-labs/xorq-datafusion\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - rxm7706\n",
