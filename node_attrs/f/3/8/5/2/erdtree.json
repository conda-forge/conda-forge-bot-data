  "raw_meta_yaml": "context:\n  version: \"3.1.2\"\n\npackage:\n  name: erdtree\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/solidiquis/erdtree/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 1758e7ad8f7be59bc3c6bda8b058097509f9db6f40ad57c4b0b361e3be439297\n\nbuild:\n  number: 4\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - let bin = ($prefix)/bin/erd\n          - ^$bin --completions=bash | save ($prefix)/share/bash-completion/completions/erd\n          - ^$bin --completions=fish | save ($prefix)/share/fish/vendor_completions.d/erd.fish\n          - ^$bin --completions=zsh  | save ($prefix)/share/zsh/site-functions/_erd\n  skip: win\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nushell\n\ntests:\n  - script:\n      - erd --help\n      - erd --version\n  - package_contents:\n      bin:\n        - erd\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/erd\n            - share/fish/vendor_completions.d/erd.fish\n            - share/zsh/site-functions/_erd\n        - if: win\n          then:\n            - Library/share/bash-completion/completions/erd\n            - Library/share/fish/vendor_completions.d/erd.fish\n            - Library/share/zsh/site-functions/_erd\n      strict: true\n\nabout:\n  homepage: https://github.com/solidiquis/erdtree\n  repository: https://github.com/solidiquis/erdtree\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: A modern, cross-platform, multi-threaded, and general purpose filesystem and disk-usage utility.\n  description: |\n    erdtree (erd) is a cross-platform, multi-threaded, and general purpose\n    filesystem and disk usage utility that is aware of .gitignore and hidden file rules.\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
