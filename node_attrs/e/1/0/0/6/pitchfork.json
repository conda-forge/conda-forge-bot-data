  "raw_meta_yaml": "context:\n  version: \"2.22.0\"\n\npackage:\n  name: pitchfork\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/jdx/pitchfork/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 5552b3c6bafabcd0864e3e31b5bde527f934ebb46746d69e55d911a6366bee98\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      # build web UI assets (`ui/dist`)\n      - aube install   --dir=ui\n      - aube run build --dir=ui\n      # build main app\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n          # generate shell completions\n          - if: build_platform == host_platform\n            then:\n              - mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n              - '\"$PREFIX\"/bin/pitchfork completion bash > \"$PREFIX\"/share/bash-completion/completions/pitchfork'\n              - '\"$PREFIX\"/bin/pitchfork completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/pitchfork.fish'\n              - '\"$PREFIX\"/bin/pitchfork completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_pitchfork'\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n          # generate shell completions\n          - if: build_platform == host_platform\n            then:\n              - if not exist \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n              - if not exist \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d   mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n              - if not exist \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions          mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n              - '\"%LIBRARY_BIN%\"\\pitchfork.exe completion bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\pitchfork'\n              - '\"%LIBRARY_BIN%\"\\pitchfork.exe completion fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\pitchfork.fish'\n              - '\"%LIBRARY_BIN%\"\\pitchfork.exe completion zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_pitchfork'\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - aube\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nodejs\n  host:\n    - usage\n\ntests:\n  - script:\n      - pitchfork --help\n      - pitchfork --version\n  - package_contents:\n      bin:\n        - pitchfork\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/pitchfork\n            - share/fish/vendor_completions.d/pitchfork.fish\n            - share/zsh/site-functions/_pitchfork\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/pitchfork\n            - Library/share/fish/vendor_completions.d/pitchfork.fish\n            - Library/share/zsh/site-functions/_pitchfork\n      strict: true\n\nabout:\n  summary: Daemons with DX\n  description: |\n    Pitchfork is a CLI for managing daemons with a focus on developer experience.\n    It can start daemons only once, auto start/stop them via a shell hook when\n    entering/leaving a project directory, perform readiness checks (delay,\n    output regex, HTTP endpoint, TCP port, or custom command), manage\n    dependencies with topological start ordering, watch files to auto-restart\n    daemons, schedule recurring tasks via cron, run lifecycle hooks, enforce\n    resource limits, and expose an interactive TUI as well as a browser-based\n    web UI and an MCP server for AI assistants.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://pitchfork.jdx.dev\n  repository: https://github.com/jdx/pitchfork\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
