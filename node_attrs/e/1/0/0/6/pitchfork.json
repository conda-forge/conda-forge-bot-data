  "linux_64_meta_yaml": {
    "about": {
      "description": "Pitchfork is a CLI for managing daemons with a focus on developer experience.\nIt can start daemons only once, auto start/stop them via a shell hook when\nentering/leaving a project directory, perform readiness checks (delay,\noutput regex, HTTP endpoint, TCP port, or custom command), manage\ndependencies with topological start ordering, watch files to auto-restart\ndaemons, schedule recurring tasks via cron, run lifecycle hooks, enforce\nresource limits, and expose an interactive TUI as well as a browser-based\nweb UI and an MCP server for AI assistants.",
      "dev_url": "https://github.com/jdx/pitchfork",
      "home": "https://pitchfork.jdx.dev/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Daemons with DX"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "aube install   --dir=ui",
          "aube run build --dir=ui",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins",
          "mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions",
          "\"$PREFIX\"/bin/pitchfork completion bash > \"$PREFIX\"/share/bash-completion/completions/pitchfork",
          "\"$PREFIX\"/bin/pitchfork completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/pitchfork.fish",
          "\"$PREFIX\"/bin/pitchfork completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_pitchfork",
          "cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "pitchfork",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "aube",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "nodejs"
          ],
          "host": [
            "usage"
          ],
          "run": []
        },
        "tests": [
          {
            "script": [
              "pitchfork --help",
              "pitchfork --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "pitchfork"
              ],
              "files": [
                "share/bash-completion/completions/pitchfork",
                "share/fish/vendor_completions.d/pitchfork.fish",
                "share/zsh/site-functions/_pitchfork"
              ],
              "strict": true
            }
          }
        ],
        "version": "2.22.0"
      }
    ],
