  "raw_meta_yaml": "context:\n  version: \"0.86.25\"\n\npackage:\n  name: hatchet-cli\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/hatchet-dev/hatchet/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 0b03d7876f15b487e2326297ac279160a3b94fc384b1fcfce33c3b69e99d61ce\n    target_directory: src\n  - url: https://raw.githubusercontent.com/mattn/go-localereader/6bae6c923850ab5e0da9f36f69811ffe17064228/LICENSE\n    sha256: dceede03550621e65ec7b79fcba87cf6dbb9d31132a8ae71a8fe8ceec0af7da3\n    file_name: LICENSE-go-localereader\n\nbuild:\n  number: 0\n  script:\n    - cd src/cmd/hatchet-cli\n    - go-licenses save . --save_path ../../../library_licenses --ignore github.com/mattn/go-localereader\n    - if: unix\n      then: go build -v -o $PREFIX/bin/hatchet -ldflags=\"-s -w\"\n      else: go build -v -o %LIBRARY_BIN%\\hatchet.exe -ldflags=\"-s\"\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script:\n    - hatchet --version\n    - hatchet --help\n  - package_contents:\n      bin:\n        - hatchet\n      strict: true\n\nabout:\n  homepage: https://hatchet.run\n  summary: CLI for the Hatchet workflow orchestration engine\n  description: |\n    Hatchet is an orchestration engine for background tasks, AI agents, and\n    durable workflows. This package provides the hatchet CLI for interacting\n    with Hatchet.\n  license: MIT\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n    - LICENSE-go-localereader\n  documentation: https://docs.hatchet.run/cli\n  repository: https://github.com/hatchet-dev/hatchet\n\nextra:\n  recipe-maintainers:\n    - xhochy\n",
