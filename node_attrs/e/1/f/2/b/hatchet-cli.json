  "raw_meta_yaml": "context:\n  version: \"0.89.0\"\n\npackage:\n  name: hatchet-cli\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/hatchet-dev/hatchet/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 2fd47e6271934e71c8cf75387f4cefe8d3fff8ecc49d7aab52562d931aa9f0c6\n    target_directory: src\n\nbuild:\n  number: 1\n  script:\n    - cd src/cmd/hatchet-cli\n    - go-licenses save . --save_path ../../../library_licenses --ignore github.com/mattn/go-localereader\n    - if: win\n      then: |\n        for /f \"delims=\" %%i in ('dir /s /b %SRC_DIR%\\gopath\\pkg\\mod\\github.com\\mattn\\go-localereader*@v*\\LICENSE') do (\n          mkdir %SRC_DIR%\\library_licenses\\github.com\\mattn\\go-localereader\n          copy \"%%i\" %SRC_DIR%\\library_licenses\\github.com\\mattn\\go-localereader\\LICENSE\n        )\n    - if: unix\n      then: go build -v -o $PREFIX/bin/hatchet -ldflags=\"-s -w\"\n      else: go build -v -o %LIBRARY_BIN%\\hatchet.exe -ldflags=\"-s\"\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script:\n      - hatchet --version\n      - hatchet --help\n  - package_contents:\n      bin:\n        - hatchet\n      strict: true\n\nabout:\n  homepage: https://hatchet.run\n  summary: CLI for the Hatchet workflow orchestration engine\n  description: |\n    Hatchet is an orchestration engine for background tasks, AI agents, and\n    durable workflows. This package provides the hatchet CLI for interacting\n    with Hatchet.\n  license: MIT\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n  documentation: https://docs.hatchet.run/cli\n  repository: https://github.com/hatchet-dev/hatchet\n\nextra:\n  recipe-maintainers:\n    - xhochy\n",
