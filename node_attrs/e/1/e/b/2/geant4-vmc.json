  "raw_meta_yaml": "context:\n  version: \"6.8.0\"\n\npackage:\n  name: geant4-vmc\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/vmc-project/geant4_vmc/archive/refs/tags/v${{ version | replace(\".0\", \"\") | replace(\".\", \"-\") }}.tar.gz\n  sha256: 5fc038ef63739bd7a7bf63e43589af020e37dc2154512619d11a6bed31fbe7b8\n\nbuild:\n  number: 0\n  skip:\n    - win\n  script: build.sh\n\nrequirements:\n  build:\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - make\n  host:\n    - root_base\n    - root_cxx_standard\n    - vmc\n    - geant4\n    - vgm\n    - clhep\n  run_exports:\n    - ${{ pin_subpackage('geant4-vmc', upper_bound='x.x') }}\n\ntests:\n  - package_contents:\n      lib:\n        - geant4vmc\n        - g4root\n      include:\n        - geant4vmc/TG4RunConfiguration.h\n        - g4root/TG4RootDetectorConstruction.h\n      files:\n        - lib/Geant4VMC-${{ version }}/Geant4VMCConfig.cmake\n        - lib/Geant4VMC-${{ version }}/Geant4VMCTargets.cmake\n        - lib/G4Root-${{ version }}/G4RootConfig.cmake\n        - lib/G4Root-${{ version }}/G4RootTargets.cmake\n\nabout:\n  homepage: https://vmc-project.github.io/\n  summary: Geant4 implementation of the Virtual Monte Carlo interface\n  description: |\n    Geant4 VMC provides the Geant4 implementation of the abstract Virtual\n    Monte Carlo (VMC) interface, along with G4Root which links Geant4\n    transport to ROOT TGeo geometry. Allows VMC user code (e.g. ALICE,\n    FairRoot, SHiP simulation frameworks) to run on top of Geant4.\n  license: GPL-3.0-only\n  license_file: LICENSE\n  repository: https://github.com/vmc-project/geant4_vmc\n  documentation: https://vmc-project.github.io/\n\nextra:\n  recipe-maintainers:\n    - olantwin\n",
