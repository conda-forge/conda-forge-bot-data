    "about": {
      "description": "jbig2enc is an open-source encoder for the JBIG2 image format. It can\ngenerate standalone JBIG2 files as well as fragments suitable for\nembedding in PDFs, and supports generic region encoding, symbol\nextraction/classification/text-region coding, refinement coding, and\ncompression of multipage documents. It is built on top of the\nLeptonica image processing library.",
      "dev_url": "https://github.com/agl/jbig2enc",
      "doc_url": "https://github.com/agl/jbig2enc/blob/master/README.md",
      "home": "https://github.com/agl/jbig2enc",
