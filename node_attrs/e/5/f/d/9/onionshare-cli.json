    "about": {
      "description": "OnionShare is an open source tool that lets you securely and anonymously\nshare files, host websites, and chat with friends using the Tor network.\n\nIt works by starting a web server, making it accessible as a Tor onion\nservice, and generating an unguessable web address so others can download\nfiles from you, or upload files to you. It does not require setting up a\nseparate server or using a third party file-sharing service.\n\nThis is the command line interface. The Qt desktop application is not\npackaged yet.",
      "dev_url": "https://github.com/onionshare/onionshare",
      "doc_url": "https://docs.onionshare.org/",
      "home": "https://onionshare.org/",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "LICENSE.txt",
      "summary": "Securely and anonymously share files, host websites, and chat with friends using the Tor network"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "python -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
