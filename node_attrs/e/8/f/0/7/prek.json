  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: prek\n  version: \"0.4.12\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/j178/${{ name }}/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: e2744b62521f1dbf080a04270d41609c45a279ed028c3d083b1ffdcf52de6219\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n      # aws-lc-sys (pulled in via reqwest/rustls) requires clang-cl to assemble\n      # its ARM64 perlasm `.S` files on Windows; MSVC's cl.exe silently drops\n      # them, producing a link error. Harmless no-op on other targets.\n      # https://aws.github.io/aws-lc-rs/requirements/windows.html\n      CC_aarch64_pc_windows_msvc: clang-cl\n      AR_aarch64_pc_windows_msvc: llvm-lib\n    content:\n      - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path crates/prek\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - if: win and arm64\n      then: clang # provides clang-cl, required by aws-lc-sys on win-arm64\n\ntests:\n  - script:\n      - prek --help\n\nabout:\n  homepage: https://prek.j178.dev\n  summary: Better `pre-commit`, re-engineered in Rust\n  repository: https://github.com/j178/prek\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n    - licenses/LICENSE.pre-commit.txt\n    - licenses/LICENSE.identify.txt\n    - crates/prek-pty/LICENSE\n\nextra:\n  recipe-maintainers:\n    - weiji14\n    - ocefpaf\n",
