  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.6.0\"\n  python_min: \"3.12\"\n\nrecipe:\n  name: amorphouspy\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/a/amorphouspy/amorphouspy-${{ version }}.tar.gz\n  sha256: f7cf143aa9e03fc9b9393261c661c2ad45a7d91de003c0232c556217e1e3cba1\n\nbuild:\n  number: 1\n  noarch: python\n\noutputs:\n  - package:\n      name: amorphouspy\n    build:\n      noarch: python\n      script: python -m pip install . -vv --no-deps --no-build-isolation\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling >=1.21\n      run:\n        - python >=${{ python_min }}\n        - ase\n        - numba\n        - pandas\n        - pydantic\n        - lammpsparser\n        - networkx\n        - pymatgen\n        - pymcubes\n        - scipy\n        - lammps ==2024.08.29\n    tests:\n      - python:\n          imports:\n            - amorphouspy\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: amorphouspy-api\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage(\"amorphouspy\", exact=true) }}\n        - executorlib\n        - pysqa\n        - uvicorn\n        - fastapi\n        - mcp >=1.6.0\n        - sqlalchemy\n        - jinja2\n    tests:\n      - python:\n          imports:\n            - amorphouspy_api\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\nabout:\n  homepage: https://github.com/glasagent/amorphouspy\n  summary: Workflows for atomistic modeling of oxide glasses\n  description: |\n    A Python package for atomistic simulations of glasses. amorphouspy provides\n    capabilities from generating initial structural models through running\n    molecular dynamics simulations with LAMMPS, all the way to computing\n    material properties and performing detailed structural analysis.\n  license: Apache-2.0\n  license_file: LICENSE\n  documentation: https://glasagent.github.io/amorphouspy/\n  repository: https://github.com/glasagent/amorphouspy\n\nextra:\n  recipe-maintainers:\n    - ltalirz\n",
