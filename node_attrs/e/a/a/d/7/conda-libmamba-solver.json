  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"26.4.2\"\n\npackage:\n  name: conda-libmamba-solver\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/conda/conda-libmamba-solver/archive/${{ version }}.tar.gz\n  sha256: d69a45db04785a1a48d29d98ee4ce6c19147be4703866a23c6b0da1de12b5378\n  target_directory: src/\n\nbuild:\n  number: 1\n  noarch: python\n  script:\n    env:\n      SETUPTOOLS_SCM_PRETEND_VERSION: ${{ version }}\n    content: ${{ PYTHON }} -m pip install src/ -vv\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling\n    - hatch-vcs\n  run:\n    - python >=${{ python_min }}\n    - libmambapy >=2.0.0\n    - boltons >=23.0.0\n    - msgpack-python >=1.1.1\n    - requests >=2.28.0,<3\n    - zstandard >=0.15\n  run_constraints:\n    # This is technically a `run` dependency (we do import it), but\n    # conda already depends on conda-libmamba-solver, so it creates a\n    # dependency cycle that complicates migrations\n    - conda >=25.9\n\ntests:\n  - python:\n      imports:\n        - conda_libmamba_solver\n      pip_check: false\n      python_version: ${{ python_min }}.*\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n        - conda\n    script:\n      - conda create -c conda-forge -n test --dry-run scipy --solver=libmamba\n      - CONDA_SOLVER=libmamba conda create -c conda-forge -n test --dry-run scipy\n\nabout:\n  license: BSD-3-Clause\n  license_file: src/LICENSE\n  summary: The fast mamba solver, now in conda!\n  homepage: https://github.com/conda/conda-libmamba-solver\n  repository: https://github.com/conda/conda-libmamba-solver\n  documentation: https://conda.github.io/conda-libmamba-solver/\n\nextra:\n  recipe-maintainers:\n    - jaimergp\n    - jezdez\n    - wolfv\n",
