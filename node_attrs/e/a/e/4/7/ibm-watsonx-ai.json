  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\n\nschema_version: 1\n\ncontext:\n  version: \"1.5.14\"\n  # Upstream requires-python is >=3.11,<3.15, so override the global 3.10 floor.\n  python_min: \"3.11\"\n\npackage:\n  name: ibm-watsonx-ai\n  version: ${{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/i/ibm-watsonx-ai/ibm_watsonx_ai-${{ version }}.tar.gz\n    sha256: a756488bd57e87c0fc51be42dcba871143cfe0ac1e805c497c5047e1e4f13e9d\n  # The PyPI sdist ships no license file (upstream packaging bug). Pull it from\n  # the repo, pinned to a commit on the default branch (the repo publishes no tags).\n  - url: https://raw.githubusercontent.com/IBM/watsonx-ai-python-sdk/67d74911f6159d971ef01ebfddb667fdd43b59df/LICENSE\n    sha256: 39d8b78315c231c67575129fed8329eb3624be295a8ba807783297406bd79f5d\n    file_name: LICENSE\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    # Upstream sdist wrongly ships top-level `docs` and `scripts` packages;\n    # drop them so they don't pollute site-packages.\n    - rm -rf $SP_DIR/docs $SP_DIR/scripts\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - python >=${{ python_min }},<3.15\n    - requests\n    - httpx >=0.27,<0.29\n    - urllib3\n    # Upstream pins pandas per Python version (>=0.24.2,<2.4.0 below 3.14;\n    # >=2.3.3 on 3.14). Merged here for the single noarch build; the range is\n    # compatible with both markers.\n    - pandas >=0.24.2,<2.4.0\n    - certifi\n    - lomond\n    - tabulate\n    - packaging\n    - ibm-cos-sdk >=2.12.0,<2.15.0\n    - cachetools\n\ntests:\n  - python:\n      imports:\n        - ibm_watsonx_ai\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  homepage: https://github.com/IBM/watsonx-ai-python-sdk\n  repository: https://github.com/IBM/watsonx-ai-python-sdk\n  documentation: https://ibm.github.io/watsonx-ai-python-sdk\n  summary: IBM watsonx.ai API Client\n  license: BSD-3-Clause\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
