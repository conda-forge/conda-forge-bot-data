  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.8.2\"\n  jupyterlab_min: \"4.6.0\"\n  jupyterlab_max: \"4.7.0\"\n  jupyterlite_core_min: \"0.8.1\"\n  jupyterlite_core_max: \"0.9.0\"\n  python_min_lock: \"3.12\"\n  python_check_max: \"3.14\"\n  # derived\n  js_version: ${{ version | replace(\"a\", \"-alpha.\") | replace(\"b\", \"-beta.\") | replace(\"rc\", \"-rc.\") }}\n\nrecipe:\n  name: jupyterlite-pyodide-kernel-split\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/j/jupyterlite-pyodide-kernel/jupyterlite_pyodide_kernel-${{ version }}.tar.gz\n  sha256: 2fdbe6ec5e024dac08f2bd1b5199e1c0fa770851a1895949586ae1c9d2e85636\n\nbuild:\n  number: 0\n  noarch: python\n\noutputs:\n  - package:\n      name: jupyterlite-pyodide-kernel\n    build:\n      noarch: python\n      script:\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n      python:\n        entry_points:\n          - jupyter-piplite = jupyterlite_pyodide_kernel.app:main\n    requirements:\n      host:\n        - hatchling >=1.4.0\n        - jupyterlab ${{ jupyterlab_min }}.*\n        - pip\n        - python ${{ python_min }}.*\n      run:\n        - jupyterlite-core >=${{ jupyterlite_core_min }}\n        - pkginfo\n        - python >=${{ python_min }}\n    tests:\n      - python:\n          imports: jupyterlite_pyodide_kernel\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n      - requirements:\n          run:\n            - jupyterlab ${{ jupyterlab_min }}.*\n            - jupyterlite-core ${{ jupyterlite_core_min }}.*\n            - python ${{ python_min }}.*\n        script:\n          - jupyter piplite --version\n          - jupyter-piplite --help\n          - jupyter labextension list\n          - jupyter labextension list 2>&1 | python -c \"import re, sys; assert re.search(r'@jupyterlite/pyodide-kernel-extension.*v${{ js_version | replace(\".\", \"\\\\.\") }}.*OK', sys.stdin.read())\"\n          - jupyter lite build\n          - python -c \"from pathlib import Path; assert b'pyodide-kernel-extension' in Path('_output/jupyter-lite.json').read_bytes()\"\n\n  - package:\n      name: jupyterlite-pyodide-kernel-with-lock\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"jupyterlite-pyodide-kernel\", exact=True) }}\n        - pyodide-lock-with-uv >=0.1.3,<0.2.0\n    tests:\n      - python:\n          imports: jupyterlite_pyodide_kernel\n          pip_check: true\n          python_version:\n            - ${{ python_min_lock }}.*\n            - ${{ python_check_max }}.*\n      - files:\n          source:\n            - pyproject.toml\n        requirements:\n          run:\n            - pytest-console-scripts\n            - pytest-cov <7\n            - pytest-html\n            - python ${{ python_min_lock }}.*\n        script:\n          - pytest -k \"not test_validate_config\" --cov-fail-under=93\n    about:\n      summary: Python kernel for JupyterLite powered by Pyodide (with [lock])\n\nabout:\n  summary: Python kernel for JupyterLite powered by Pyodide\n  license: BSD-3-Clause\n  license_file:\n    - LICENSE\n    - jupyterlite_pyodide_kernel/labextension/static/third-party-licenses.json\n  homepage: https://github.com/jupyterlite/pyodide-kernel\n  documentation: https://jupyterlite-pyodide-kernel.rtfd.io\n\nextra:\n  feedstock-name: jupyterlite-pyodide-kernel\n  recipe-maintainers:\n    - agriyakhetarpal\n    - bollwyvl\n    - jtpio\n    - martinRenou\n",
