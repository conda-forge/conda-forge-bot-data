  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: qonnx\n  version: \"0.4.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/qonnx-${{ version }}.tar.gz\n  sha256: 96bdbd15f85119aff65e0d6167c29aec6626040f75f177be38531edd1b978e69\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - qonnx-cleanup = qonnx.util.cleanup:main\n      - qonnx-exec = qonnx.util.exec_qonnx:main\n      - qonnx-to-channels-last = qonnx.util.to_channels_last:main\n      - qonnx-inference-cost = qonnx.util.inference_cost:main\n      - qonnx-convert = qonnx.util.convert:main\n      - qonnx-range-analysis = qonnx.util.range_analysis:main\n      - qonnx-download-model = qonnx.util.test:qonnx_download_model\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=46.1.0\n    - setuptools-scm >=5\n    - wheel\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - attrs >=22.2.0\n    - clize >=5.0.1\n    - bitstring >=3.1.7\n    - numpy >=1.24.1\n    - onnx >=1.13.0,<1.19\n    - onnxruntime >=1.15.0\n    - sigtools >=4.0.1\n    - toposort >=1.7.0\n    - tqdm\n\ntests:\n  - python:\n      imports:\n        - qonnx\n      pip_check: false\n      python_version:\n        - ${{ python_min }}\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - qonnx-cleanup --help\n      - qonnx-exec --help\n      - qonnx-to-channels-last --help\n      - qonnx-inference-cost --help\n      - qonnx-convert --help\n      - qonnx-range-analysis --help\n      - qonnx-download-model --help\n\nabout:\n  summary: Frontend and utilities for QONNX\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://github.com/fastmachinelearning/qonnx\n\nextra:\n  recipe-maintainers:\n    - isuruf\n    - timkpaine\n",
