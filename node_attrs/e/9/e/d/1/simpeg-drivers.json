  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: simpeg-drivers\n  version: \"0.4.0\"\n  python_min: '3.10'\n  python_max: '3.12'\n  module_name: ${{ name|lower|replace(\"-\", \"_\") }}\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/MiraGeoscience/${{ name }}/archive/v${{ version }}.zip\n  sha256: c82f4e31575d0dc5f95b49be0b4e23802ca196310384a007db1a33fe3358b082\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    env:\n      POETRY_DYNAMIC_VERSIONING_BYPASS: ${{ version }}\n    content:\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - poetry-core >=1.8.0\n    - poetry-dynamic-versioning >=1.9, 1.*\n    - setuptools\n    - pip\n  run:\n    - python >=${{ python_min }},<${{ python_max }}\n    # Mira packages\n    - geoapps-utils 0.6.*\n    - geoh5py 0.12.*\n    - grid-apps 0.1.*\n    - mira-simpeg >=0.23.0.2, 0.23.0.*\n    # direct dependencies\n    - dask-core 2025.3.*\n    - discretize 0.11.*\n    - distributed 2025.3.*\n    - numpy 1.26.*\n    - pydantic 2.11.*\n    - pydiso 0.1.*\n    - python-mumps >=0.0.3, 0.0.3.*\n    - rtree 1.2.*\n    - scikit-learn 1.6.*\n    - scipy 1.14.*\n    - tqdm >=4.66.1, 4.66.*\n    - trimesh >=4.1.3, 4.1.*\n    # constrain version for some indirect dependencies from SimPEG\n    - geoana 0.7.*\n    - matplotlib-base >=3.8.4, 3.8.*\n    - pymatsolver 0.3.*\n    - zarr >=2.14.2, 2.14.*\n  run_constraints:\n    - __glibc >=2.17\n    - bokeh 3.6.*\n    - fsspec >=2022.0\n\ntests:\n  - python:\n      python_version: ${{ python_min }}.*\n      imports:\n        - simpeg_drivers\n        - dask\n        - distributed\n        - geoh5py\n        - simpeg\n      pip_check: true\n      \n  - script:\n      - pytest --ignore=tests/version_test.py --ignore=tests/run_tests --ignore=tests/plate_simulation\n    requirements:\n      run:\n        - pytest\n    files:\n      source:\n     