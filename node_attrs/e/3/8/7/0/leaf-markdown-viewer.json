  "linux_64_meta_yaml": {
    "about": {
      "description": "leaf is a terminal Markdown previewer that renders Markdown files in a\nfull-screen TUI with syntax-highlighted code blocks, tables, images and\nlinks. It offers a watch mode that reloads on save, fuzzy and directory\nfile pickers, selectable color themes, an inline mode that renders to\nstdout, and shell completions.",
      "dev_url": "https://github.com/RivoLink/leaf",
      "doc_url": "https://github.com/RivoLink/leaf/blob/main/README.md",
      "home": "https://leaf.rivolink.mg/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Terminal Markdown previewer with a GUI-like experience"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml",
          "mkdir -p $PREFIX/share/bash-completion/completions $PREFIX/share/zsh/site-functions $PREFIX/share/fish/vendor_completions.d",
          "cp completions/leaf.bash $PREFIX/share/bash-completion/completions/leaf",
          "cp completions/leaf.zsh $PREFIX/share/zsh/site-functions/_leaf",
          "cp completions/leaf.fish $PREFIX/share/fish/vendor_completions.d/leaf.fish"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "leaf-markdown-viewer",
        "requirements": {
          "build": [
            "c_stdlib_stub",
