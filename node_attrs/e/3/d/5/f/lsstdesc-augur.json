  "raw_meta_yaml": "{% set version = \"1.2.3\" %}\n{% set python_min = \"3.11\" %}\n\n\npackage:\n  name: \"lsstdesc-augur\"\n  version: \"{{ version }}\"\n\nsource:\n  url: \"https://github.com/LSSTDESC/augur/archive/{{ version }}.tar.gz\"\n  sha256: \"e213040d7e68bdba6fd0d520c4d26d88de59e311a5d3c44cdbf82ded295731fc\"\n\nbuild:\n  noarch: python\n  number: 0\n  script: {{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  host:\n    - python {{ python_min }}\n    - pip\n    - setuptools\n  run:\n    - python >={{ python_min }}\n    - numpy >=2.0\n    - scipy >1.12\n    - astropy-base\n    - firecrown >=1.14  # Primary structural dependency for LSSTDESC Augur\n    - matplotlib-base\n    - jinja2\n    - tjpcov\n    - numdifftools\n    - pyccl >=3.3.1\n    - pyyaml\n    - qp-prob\n    - numpydoc\n    - healpy\n    - click\n\ntest:\n  requires:\n    - python {{ python_min }}\n    - pip\n  imports:\n    - augur\n  commands:\n    - pip check || echo \"Ignoring known firecrown dependency warning\"\n\nabout:\n  home: \"https://github.com/LSSTDESC/augur\"\n  license: MIT\n  license_file: LICENSE\n  summary: \"A DESC forecasting tool wrapping firecrown.\"\n  description: |\n    Augur is a wrapper to firecrown that generates synthetic datasets of \n    arbitrary complexity and calls an inference engine to generate full MCMC \n    or a simple second-order derivative at a fiducial model to generate \n    a Fisher matrix forecast.\n  dev_url: https://github.com/LSSTDESC/augur\n\nextra:\n  recipe-maintainers:\n    - fjaviersanchez\n",
