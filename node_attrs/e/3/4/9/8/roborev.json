  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-parsers/main/schema.json\n\ncontext:\n  version: \"0.61.0\"\n\npackage:\n  name: roborev\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/kenn-io/roborev/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 0222f4984eb72b3391ac1f52c9e8e89853e27651e52ffe3f801ff38b77f9ccd9\n    target_directory: src\n  - url: https://raw.githubusercontent.com/mattn/go-localereader/6bae6c923850ab5e0da9f36f69811ffe17064228/LICENSE\n    sha256: dceede03550621e65ec7b79fcba87cf6dbb9d31132a8ae71a8fe8ceec0af7da3\n    file_name: LICENSE-go-localereader\n\nbuild:\n  number: 0\n  script:\n    - cd src\n    - go-licenses save go.kenn.io/roborev/cmd/roborev --save_path ../library_licenses --ignore github.com/mattn/go-localereader\n    - if: unix\n      then: go build -v -ldflags=\"-s -w -X go.kenn.io/roborev/internal/version.Version=${{ version }}\" -o $PREFIX/bin/roborev ./cmd/roborev\n      else: go build -v -ldflags=\"-s -w -X go.kenn.io/roborev/internal/version.Version=${{ version }}\" -o %LIBRARY_BIN%\\roborev.exe ./cmd/roborev\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script: roborev --help\n  - package_contents:\n      bin:\n        - roborev\n      strict: true\n\nabout:\n  homepage: https://roborev.io\n  summary: Continuous background code review database for AI coding agents\n  description: |\n    roborev runs in the background, reviews every commit as agents write code,\n    and surfaces issues in seconds -- before they compound. Pull code reviews\n    into your agentic loop while context is fresh.\n  license: MIT\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n    - LICENSE-go-localereader\n  repository: https://github.com/kenn-io/roborev\n\nextra:\n  recipe-maintainers:\n    - xhochy\n",
