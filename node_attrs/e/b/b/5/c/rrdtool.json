                "share/rrdtool/**"
              ],
              "include": [
                "rrd.h",
                "rrd_client.h",
                "rrd_format.h"
              ],
              "lib": [
                "librrd"
              ],
              "strict": true
            }
          }
        ],
        "version": "1.10.3"
      }
