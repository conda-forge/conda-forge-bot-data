  "linux_64_meta_yaml": {
    "about": {
      "description": "CNCHASH determines earthquake focal mechanisms from P-wave polarities and optional S/P amplitude ratios using the HASH algorithm (Hardebeck and Shearer, 2002, 2003). All computation runs in a Modern Fortran/OpenMP core (libhashhp); the Python layer handles data, file formats, and the API.",
      "dev_url": "https://github.com/Chuan1937/CNCHASH",
      "doc_url": "https://chuan1937.github.io/CNCHASH/",
      "home": "https://github.com/Chuan1937/CNCHASH",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE",
      "summary": "High-performance HASH earthquake focal-mechanism solver with a Modern Fortran/OpenMP native backend and a clean Python front-end."
    },
    "build": {
      "number": "0",
      "script": [
        "cmake -S . -B build-conda -DCMAKE_BUILD_TYPE=Release -DCNCHASH_BUILD_TESTS=OFF ${CMAKE_ARGS}",
        "cmake --build build-conda -j ${CPU_COUNT}",
        "${PYTHON} -m pip install . --no-deps --no-build-isolation -vv",
        "NATIVE_LIB=build-conda/libhashhp${SHLIB_EXT}\nif [ ! -f ${NATIVE_LIB} ]; then\n  echo \"libhashhp shared library not found in build-conda\" >&2\n  exit 1\nfi\n",
        "mkdir -p ${SP_DIR}/cnchash/lib",
        "cp ${NATIVE_LIB} ${SP_DIR}/cnchash/lib/libhashhp.so"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "Chuan1937"
      ]
    },
