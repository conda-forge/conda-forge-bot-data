  "raw_meta_yaml": "# tag: LTS_MM_YYYY_RefRR --> version: YYYY.MM.refRR\n# The Git tags originally used the format YYYY-MM-DD, which we adopted for this\n# recipe. More recent tags are no longer consistent (eg LTS_07_2022_Ref02). To\n# ensure that the latest version is always installed, we created the version\n# string as a rearrangement of the tag name: LTS_MM_YYYY_RefRR --> YYYY.MM.refRR\n#\n# Releases: https://github.com/Azure/azure-c-shared-utility/tags\n# Discussion: https://github.com/conda-forge/azure-c-shared-utility-feedstock/pull/7#discussion_r1301314533\nschema_version: 1\n\ncontext:\n  name: azure-c-shared-utility\n  version: 2022.07.ref02\n  tag: LTS_07_2022_Ref02\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/Azure/azure-c-shared-utility/archive/${{ tag }}.tar.gz\n    sha256: cb2146878a705af76ab2fb7e941f15474db04326de4c6095c97f925cf442410b\n    patches:\n      # Upstream exports include/azureiot as the public include directory of the\n      # aziotsharedutil target, but nothing ever creates that directory, so\n      # downstream find_package() users fail at CMake's generate step.\n      - patches/0001-export-include-dir-that-exists.patch\n      # CURLOPT_POSTFIELDSIZE is a long option but was passed a bare 0, which\n      # trips libcurl's typecheck macros. The project builds with -Werror, so\n      # this breaks clang-based builds (macOS); gcc and MSVC are unaffected.\n      - patches/0002-curl-postfieldsize-expects-long.patch\n\nbuild:\n  number: 1\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    # project() enables CXX by default and azure_iot_build_rules.cmake runs\n    # CHECK_CXX_COMPILER_FLAG unconditionally, so configure needs a C++\n    # compiler on every platform.\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - if: not win\n      then: make\n    - if: win\n      then: ninja\n    - if: unix\n      then: pkg-config\n  host:\n    # 2022.08.09 is the first backward-incompatible version after\n    # azure-macro-utils-c was renamed to macro-utils-c.\n    # See: https://github.com/conda-forge/azure-macro-utils-c-feedstock/commit/abca76cfa9b6738d76e44fb5428559d4f245808c\n    - azure-macro-utils-c <2020.10.29\n    - if: unix\n      then: libuuid\n    - umock-c\n    - libcurl\n    - curl\n  run:\n    - azure-macro-utils-c <2020.10.29\n    - umock-c\n  run_exports:\n    - ${{ pin_subpackage(name, upper_bound='x.x.x') }}\n\ntests:\n  - script:\n      - if: win\n        then: if not exist %PREFIX%\\Library\\bin\\aziotsharedutil.dll exit 1\n      - if: not win\n        then: test -f \"${PREFIX}/lib/libaziotsharedutil${SHLIB_EXT}\"\n      # The exported target must not advertise include/azureiot, which is never\n      # created; doing so breaks find_package() consumers at CMake's generate\n      # step. See patches/0001-export-include-dir-that-exists.patch\n      - if: win\n        then: findstr /C:\"include/azureiot\" \"%PREFIX%\\Library\\lib\\cmake\\azure_c_shared_utility\\azure_c_shared_utilityTargets.cmake\" && exit 1 || exit 0\n      - if: not win\n        then: '! grep -q \"include/azureiot\" \"${PREFIX}/lib/cmake/azure_c_shared_utility/azure_c_shared_utilityTargets.cmake\"'\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: |\n    Azure C Shared Utility\n\n\n  homepage: https://github.com/Azure/azure-c-shared-utility\n\nextra:\n  recipe-maintainers:\n    - jdblischak\n    - jjerphan\n    - seanyen\n    - xylar\n",
