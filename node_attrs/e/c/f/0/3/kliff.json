  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: kliff\n  version: \"1.0.1\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name }}-${{ version }}.tar.gz\n  sha256: a69be927aa3c22b166e530fcbdfd74b192229d04efc14823deadf3b509d2d560\n\nbuild:\n  number: 1\n  skip: win or match(python, \"<3.5\") or match(python, \">3.12\")\n  script: ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then: python\n    - if: build_platform != target_platform\n      then: cross-python_${{ target_platform }}\n    - if: build_platform != target_platform\n      then: pybind11\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib(\"c\") }}\n  host:\n    - python\n    - pip\n    - setuptools\n    - pybind11\n  run:\n    - python\n    - pip\n    - scipy\n    - pybind11\n    - pytest\n    - kimpy\n    - requests\n    - pyyaml\n    - monty\n    - loguru\n    - numpy <2.0\n    - ase <3.23\n\ntests:\n  - python:\n      imports:\n        - kliff\n      pip_check: true\n\nabout:\n  license: CDDL-1.0\n  license_file: LICENSE\n  summary: KIM-based Learning-Integrated Fitting Framework (KLIFF).\n  description: |\n    KLIFF is an interatomic potential fitting package that can be used to\n    fit physics-motivated (PM) potentials, as well as machine learning\n    potentials such as the neural network (NN) models.\n  homepage: https://github.com/mjwen/kliff\n  repository: https://github.com/mjwen/kliff\n  documentation: https://kliff.readthedocs.io\n\nextra:\n  recipe-maintainers:\n    - jan-janssen\n    - mjwen\n",
