  "raw_meta_yaml": "{% set name = \"lumen\" %}\n{% set version = \"1.3.0\" %}\n{% set python_min = \"3.11\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}/{{ name }}-{{ version }}.tar.gz\n  sha256: 2cc2fadbe413b2e7bedc49354cc7a74477f274f9193379840d4424df1ed6b78c\n\nbuild:\n  number: 0\n  noarch: python\n\noutputs:\n  - name: {{ name|lower }}\n    build:\n      noarch: python\n      entry_points:\n        - lumen = lumen.command.ai:main\n        - lumen-ai = lumen.command.ai:main\n        - lumen-spec = lumen.command:main\n    script: build_lumen.sh\n\n    requirements:\n      host:\n        - python {{ python_min }}\n        - pip\n        - hatchling\n        - hatch-vcs\n      run:\n        - bokeh\n        - chardet\n        - duckdb >=1.2.0\n        - griffe\n        - holoviews >=1.17.0\n        - hvplot\n        - instructor >=1.14.3\n        - intake <2\n        - jinja2 >3.0\n        - lxml\n        - markitdown\n        - nbformat\n        - numpy\n        - packaging\n        - pandas\n        - panel >=1.7.5\n        - panel-graphic-walker >=0.6.4\n        - panel-material-ui >=0.8.1\n        - panel-splitjs >=0.3.2\n        - param >=2.2.1\n        - pyarrow\n        - pydantic >=2.8.0\n        - pydantic-extra-types\n        - python >={{ python_min }}\n        - pyyaml\n        - semchunk\n        - sqlglot\n        - sqlglotrs\n        - tabulate\n        - tiktoken\n        - vl-convert-python\n\n    test:\n      imports:\n        - lumen\n      requires:\n        - pip\n        - python {{ python_min }}\n      commands:\n        #- pip check\n        - lumen --help\n\n    about:\n      home: https://github.com/holoviz/lumen\n      summary: Illuminate your data.\n      description: |\n        Lumen is a fully open-source and extensible agent based framework\n        for chatting with data, text-to-SQL and for retrieval augmented\n        generation (RAG). It implements a declarative specfication for\n        expressing data pipelines, visualizations and dashboards.\n      license: BSD-3-Clause\n      license_file: LICENSE\n      doc_url: https://lumen.holoviz.org/\n      dev_url: https://github.com/holoviz/lumen\n\n  - name: {{ name|lower }}-ai-local\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - python >={{ python_min }}\n        - {{ pin_subpackage('lumen', exact=True) }}\n        - huggingface_hub\n        - hf-xet\n    test:\n      imports:\n        - lumen\n      requires:\n        - pip\n        - python {{ python_min }}\n    about:\n      home: https://github.com/holoviz/lumen\n      summary: 'Lumen with huggingface_hub for local AI models'\n      license: BSD-3-Clause\n      license_family: BSD\n\n  - name: {{ name|lower }}-ai-openai\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - python >={{ python_min }}\n        - {{ pin_subpackage('lumen', exact=True) }}\n        - openai\n    test:\n      imports:\n        - lumen\n      requires:\n        - pip\n        - python {{ python_min }}\n    about:\n      home: https://github.com/holoviz/lumen\n      summary: 'Lumen with OpenAI support'\n      license: BSD-3-Clause\n      license_family: BSD\n\n  - name: {{ name|lower }}-ai-mistralai\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - python >={{ python_min }}\n        - {{ pin_subpackage('lumen', exact=True) }}\n        - mistralai\n    test:\n      imports:\n        - lumen\n      requires:\n        - pip\n        - python {{ python_min }}\n    about:\n      home: https://github.com/holoviz/lumen\n      summary: 'Lumen with MistralAI support'\n      license: BSD-3-Clause\n      license_family: BSD\n\n  - name: {{ name|lower }}-ai-bedrock\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - python >={{ python_min }}\n        - {{ pin_subpackage('lumen', exact=True) }}\n        - boto3 >=1.42.23\n    test:\n      imports:\n        - lumen\n      requires:\n        - pip\n        - python {{ python_min }}\n    about:\n      home: https://github.com/holoviz/lumen\n      summary: 'Lumen with AWS Bedrock support'\n      license: BSD-3-Clause\n      license_family: BSD\n\n  - name: {{ name|lower }}-ai-anthropic\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - python >={{ python_min }}\n        - {{ pin_subpackage('lumen', exact=True) }}\n        - anthropic\n    test:\n      imports:\n        - lumen\n      requires:\n        - pip\n        - python {{ python_min }}\n    about:\n      home: https://github.com/holoviz/lumen\n      summary: 'Lumen with Anthropic support'\n      license: BSD-3-Clause\n      license_family: BSD\n\n  - name: {{ name|lower }}-ai-transformers\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - python >={{ python_min }}\n        - {{ pin_subpackage('lumen-ai-local', exact=True) }}\n        - sentence-transformers >=2.7.0\n        - transformers >=4.51.0\n    test:\n      imports:\n        - lumen\n      requires:\n        - pip\n        - python {{ python_min }}\n    about:\n      home: https://github.com/holoviz/lumen\n      summary: 'Lumen with transformer-based embeddings support'\n      license: BSD-3-Clause\n      license_family: BSD\n\n  - name: {{ name|lower }}-ai-llama\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - python >={{ python_min }}\n        - {{ pin_subpackage('lumen-ai-local', exact=True) }}\n        - llama-cpp-python >=0.3.15\n    test:\n      imports:\n        - lumen\n      requires:\n        - pip\n        - python {{ python_min }}\n    about:\n      home: https://github.com/holoviz/lumen\n      summary: 'Lumen with llama.cpp support for local models'\n      license: BSD-3-Clause\n      license_family: BSD\n\n  - name: {{ name|lower }}-ai-google\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - python >={{ python_min }}\n        - {{ pin_subpackage('lumen', exact=True) }}\n        - google-genai >=1.56.0\n        - jsonref\n    test:\n      imports:\n        - lumen\n      requires:\n        - pip\n        - python {{ python_min }}\n    about:\n      home: https://github.com/holoviz/lumen\n      summary: 'Lumen with Google Gemini support'\n      license: BSD-3-Clause\n      license_family: BSD\n\n  - name: {{ name|lower }}-ai-litellm\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - python >={{ python_min }}\n        - {{ pin_subpackage('lumen', exact=True) }}\n        - litellm\n    test:\n      imports:\n        - lumen\n      requires:\n        - pip\n        - python {{ python_min }}\n    about:\n      home: https://github.com/holoviz/lumen\n      summary: 'Lumen with LiteLLM support'\n      license: BSD-3-Clause\n      license_family: BSD\n\n  - name: {{ name|lower }}-ai-ollama\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - python >={{ python_min }}\n        - {{ pin_subpackage('lumen', exact=True) }}\n        - ollama-python\n    test:\n      imports:\n        - lumen\n      requires:\n        - pip\n        - python {{ python_min }}\n    about:\n      home: https://github.com/holoviz/lumen\n      summary: 'Lumen with Ollama support'\n      license: BSD-3-Clause\n      license_family: BSD\n\nabout:\n  home: https://github.com/holoviz/lumen\n  summary: Illuminate your data.\n  description: |\n    Lumen is a fully open-source and extensible agent based framework\n    for chatting with data, text-to-SQL and for retrieval augmented\n    generation (RAG). It implements a declarative specfication for\n    expressing data pipelines, visualizations and dashboards.\n  license: BSD-3-Clause\n  license_file: LICENSE\n  doc_url: https://lumen.holoviz.org/\n  dev_url: https://github.com/holoviz/lumen\n\nextra:\n  recipe-maintainers:\n    - ahuang11\n    - hoxbro\n    - philippjfr\n",
