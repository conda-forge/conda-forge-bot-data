  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  python_min: \"3.11\"\n  version: \"26.7.0\"\n\npackage:\n  name: scippneutron_algorithms\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/s/scippneutron_algorithms/scippneutron_algorithms-${{ version }}.tar.gz\n  sha256: c11dc515e00b307cef09202b9b3981fc2935da3f9b4d5a8d8d49fae49948d347\n\nbuild:\n  number: 1\n  skip: not is_python_min\n  python:\n    version_independent: true\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    - cd rust && cargo-bundle-licenses --format yaml --output ../THIRDPARTY.yml\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1,<2\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n  host:\n    - python ${{ python_min }}.*\n    - python-abi3 ${{ python_min }}.*\n    - maturin >=1.13,<2.0\n    - pip\n  run:\n    - python\n    - numpy >=2\n    - scipp >=25.11.0\n    - scipy >=1.7.0\n\ntests:\n  - python:\n      imports:\n        - scippneutron_algorithms\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\n  - requirements:\n      run:\n        - abi3audit\n    script:\n      - if: unix\n        then: abi3audit $SP_DIR/scippneutron_algorithms/_scippneutron_algorithms_lib.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n        else: abi3audit %SP_DIR%/scippneutron_algorithms/_scippneutron_algorithms_lib.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  summary: Optimized and compiled algorithms for ScippNeutron\n  license: BSD-3-Clause\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/scipp/scippneutron-algorithms\n  repository: https://github.com/scipp/scippneutron-algorithms\n\nextra:\n  recipe-maintainers:\n    - jl-wynen\n    - conda-forge/scipp\n",
