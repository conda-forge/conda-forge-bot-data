  "linux_64_meta_yaml": {
    "about": {
      "description": "dora-rs is a low-latency, composable, distributed dataflow framework\nfor AI-based robotic applications. The `dora` CLI is the user-facing\ncommand for managing dataflows, the coordinator and the daemons that\nrun nodes.",
      "dev_url": "https://github.com/dora-rs/dora",
      "doc_url": "https://dora-rs.ai/",
      "home": "https://github.com/dora-rs/dora",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Command-line tool for the dora-rs dataflow framework"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path binaries/cli",
          "mkdir -p $PREFIX/share/bash-completion/completions $PREFIX/share/zsh/site-functions $PREFIX/share/fish/vendor_completions.d",
          "$PREFIX/bin/dora completion bash > $PREFIX/share/bash-completion/completions/dora",
          "$PREFIX/bin/dora completion zsh  > $PREFIX/share/zsh/site-functions/_dora",
          "$PREFIX/bin/dora completion fish > $PREFIX/share/fish/vendor_completions.d/dora.fish",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "thin",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "OPENSSL_NO_VENDOR": "1"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "baszalmstra"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "dora-cli",
        "requirements": {
          "build": [
