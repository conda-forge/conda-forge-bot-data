  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.7.8\"\n\npackage:\n  name: vlmrun\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/v/vlmrun/vlmrun-${{ version }}.tar.gz\n  sha256: e7a63fbef2999c4cd02607dd1465ad2c61b656e269f444e04a3f582ec9629585\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - vlmrun = vlmrun.cli.cli:app\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=40.1.0\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - cachetools\n    - ipython\n    - loguru\n    - openai >=1.0.0\n    - opencv >=4.8.0\n    - pandas\n    - pillow >=10.2.0\n    - pydantic <3,>=2.5\n    - requests\n    - rich\n    - tabulate\n    - tenacity\n    - tqdm\n    - typer >=0.9.0\n    - vlmrun-hub >=0.1.28\n\ntests:\n  - python:\n      imports:\n        - vlmrun\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  homepage: https://docs.vlm.run\n  license: Apache-2.0\n  license_file: LICENSE\n  summary: Official Python SDK for VLM Run\n  repository: https://github.com/vlm-run/vlmrun-python-sdk\n  documentation: https://docs.vlm.run\n  description: |\n    The official Python SDK for VLM Run, the platform for extracting\n    structured data from visual inputs (images, documents, and video).\n    The SDK provides a typed client for the VLM Run API together with a\n    `vlmrun` command-line interface, schema definitions from vlmrun-hub,\n    and helpers for predictions, fine-tuning, files, datasets, and agents.\n\nextra:\n  recipe-maintainers:\n    - rxm7706\n    - pb01ka\n",
