  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: 0.5.0\n\npackage:\n  name: mlx-audio\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/m/mlx-audio/mlx_audio-${{ version }}.tar.gz\n  sha256: d5aba4b99c006acd735408189d127eaf6ed53be0cad789e2eb51aa57f4f6bf13\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - mlx_audio.convert = mlx_audio.convert:main\n      - mlx_audio.stt.generate = mlx_audio.stt.generate:main\n      - mlx_audio.tts.generate = mlx_audio.tts.generate:main\n      - mlx_audio.server = mlx_audio.server:main\n      - mlx_audio.sts.generate = mlx_audio.sts.generate:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=61.0\n    - wheel\n    - poetry-core\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - huggingface_hub >=1.0\n    - miniaudio >=1.61\n    - mlx >=0.31.1\n    - numpy >=1.26.4\n    - scipy >=1.10.0\n    - python-sounddevice >=0.5.3\n    - tqdm >=4.67.1\n    - transformers >=5.14.0\ntests:\n  - python:\n      imports:\n        - mlx_audio\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - '*'\n  - requirements:\n      run:\n        - pip\n        - python\n    script:\n      - mlx_audio.convert --help\n      - mlx_audio.stt.generate --help\n      - mlx_audio.tts.generate --help\n      # This needs a uvicorn extra\n      # - mlx_audio.server --help\n      - mlx_audio.sts.generate --help\n\nabout:\n  summary: MLX-Audio is a package for inference of text-to-speech (TTS) and speech-to-speech (STS) models locally on your Mac using MLX\n  license: MIT\n  license_file: LICENSE\n  homepage: https://github.com/Blaizzy/mlx-audio\n\nextra:\n  recipe-maintainers:\n    - xhochy\n",
