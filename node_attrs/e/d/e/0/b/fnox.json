  "raw_meta_yaml": "context:\n  version: \"1.27.1\"\n\npackage:\n  name: fnox\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/jdx/fnox/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 17fbd495ad626ecd2bc7eb85a632d5e6875a49a6effa7a7aa6fafb9359ae7640\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      # NOTE: we have to set LIBCLANG_PATH for bindgen to find libclang (used by aws-lc-rs)\n      # cf. https://github.com/conda-forge/clangdev-feedstock/issues/373 & https://github.com/rust-lang/rust-bindgen/issues/918\n      - if: unix\n        then:\n          - export LIBCLANG_PATH=\"$BUILD_PREFIX\"/lib\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n          # generate shell completions\n          - mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n          - '\"$PREFIX\"/bin/fnox completion bash > \"$PREFIX\"/share/bash-completion/completions/fnox'\n          - '\"$PREFIX\"/bin/fnox completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/fnox.fish'\n          - '\"$PREFIX\"/bin/fnox completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_fnox'\n      - if: win\n        then:\n          # bindgen expects libclang.dll; conda-forge only provides versioned DLLs on Windows\n          - powershell -Command \"cp (gci $env:BUILD_PREFIX\\Library\\bin\\libclang-*.dll)[0] $env:BUILD_PREFIX\\Library\\bin\\libclang.dll\"\n          - set \"LIBCLANG_PATH=%BUILD_PREFIX%\\Library\\bin\"\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n          # generate shell completions\n          - if not exist \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n          - if not exist \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d   mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n          - if not exist \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions          mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n          - '\"%LIBRARY_BIN%\"\\fnox.exe completion bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\fnox'\n          - '\"%LIBRARY_BIN%\"\\fnox.exe completion fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\fnox.fish'\n          - '\"%LIBRARY_BIN%\"\\fnox.exe completion zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_fnox'\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - clang\n    - cmake\n    - libclang\n    - make\n    - ninja\n    - perl\n    - pkg-config\n  host:\n    - if: linux\n      then: libudev\n    - usage\n\ntests:\n  - script:\n      - fnox --help\n      - fnox --version\n  - package_contents:\n      bin:\n        - fnox\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/fnox\n            - share/fish/vendor_completions.d/fnox.fish\n            - share/zsh/site-functions/_fnox\n        - if: win\n          then:\n            - Library/share/bash-completion/completions/fnox\n            - Library/share/fish/vendor_completions.d/fnox.fish\n            - Library/share/zsh/site-functions/_fnox\n      strict: true\n\nabout:\n  summary: Fort Knox for your secrets — flexible secret management with encryption and cloud providers\n  description: |\n    fnox is a flexible secret management tool that supports storing secrets with\n    encryption (age, AWS KMS, Azure KMS, GCP KMS) or remotely in cloud providers\n    (AWS Secrets Manager, AWS Parameter Store, Azure Key Vault, GCP Secret Manager,\n    1Password, Bitwarden, HashiCorp Vault, and more). It provides a unified\n    interface to work with secrets across development, CI, and production,\n    and supports shell integration to auto-load secrets on directory change.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://fnox.jdx.dev\n  repository: https://github.com/jdx/fnox\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
