  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  name: ocrmypdf\n  version: \"17.7.1\"\n  python_min: \"3.11\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/ocrmypdf-${{ version }}.tar.gz\n  sha256: d61184b84e3001ebe7c5acb265041bd8591f924b8616bbefc746a5bdafab3eca\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - ocrmypdf = ocrmypdf.__main__:run\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }},<4\n    - deprecation >=2.1.0\n    - img2pdf >=0.5\n    - packaging >=20\n    - pdfminer.six >=20220319\n    #- pi-heif # Note conda package is pillow-heif\n    - pillow-heif # Note conda package pdfminer-six is returning version 0.0.0\n    - pikepdf >=10\n    - pypdfium2 >=5.0.0\n    - pillow >=10.0.1\n    - pydantic >=2.12.5\n    - pluggy >=1\n    - rich >=13\n    - uharfbuzz >=0.53.2\n    - pdfminer-six >=20220319 # Note conda package pdfminer-six is returning version 0.0.0\n\ntests:\n  - python:\n      imports:\n        - ocrmypdf\n        - ocrmypdf._exec\n      pip_check: false\n      #│ │ ocrmypdf 16.11.1 requires pi-heif, which is not installed. # Note conda package is pillow-heif\n      #│ │ ocrmypdf 16.11.1 has requirement pdfminer-six>=20220319, but you have pdfminer-six 0.0.0. # Note conda package pdfminer-six is returning version 0.0.0\n      python_version: ${{ python_min }}.*\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - ocrmypdf --help\n\nabout:\n  summary: OCRmyPDF adds an OCR text layer to scanned PDF files, allowing them to be searched\n  license: MPL-2.0\n  license_file: LICENSE\n  repository: https://github.com/ocrmypdf/OCRmyPDF\n  homepage: https://github.com/jbarlow83/OCRmyPDF\n\nextra:\n  recipe-maintainers:\n    - izahn\n    - carlodri\n    - rxm7706\n",
