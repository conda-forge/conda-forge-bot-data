  "linux_64_meta_yaml": {
    "about": {
      "dev_url": "https://github.com/ocrmypdf/OCRmyPDF",
      "home": "https://github.com/jbarlow83/OCRmyPDF",
      "license": "MPL-2.0",
      "license_family": "MPL-2.0",
      "license_file": "LICENSE",
      "summary": "OCRmyPDF adds an OCR text layer to scanned PDF files, allowing them to be searched"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "izahn",
        "carlodri",
        "rxm7706"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "ocrmypdf",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "hatchling",
            "pip"
          ],
          "run": [
            "python >=3.11,<4",
            "deprecation >=2.1.0",
            "fpdf2 >=2.8.0",
            "img2pdf >=0.5",
            "packaging >=20",
            "pdfminer-six >=20260107",
            "pillow-heif",
            "pngquant",
            "pikepdf >=10",
            "pypdfium2 >=5.0.0",
            "pillow >=10.0.1",
            "pydantic >=2.12.5",
            "pluggy >=1",
            "rich >=13",
            "tesseract",
            "uharfbuzz >=0.53.2"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "ocrmypdf",
                "ocrmypdf._exec"
              ],
              "pip_check": false,
              "python_version": [
                "3.11.*",
                "*"
              ]
            }
          },
          {
            "files": {
              "source": [
                "tests/resources/linn.pdf",
                "tests/resources/graph_ocred.pdf"
              ]
            },
            "script": [
              "ocrmypdf --help",
              "ocrmypdf --version",
              "ocrmypdf --mode force --output-type pdf tests/resources/linn.pdf /tmp/ocr_output.pdf",
              "test -s /tmp/ocr_output.pdf",
              "ocrmypdf --mode skip --optimize 3 --output-type pdf tests/resources/graph_ocred.pdf /tmp/opt_output.pdf",
              "test -s /tmp/opt_output.pdf"
            ]
          }
        ],
        "version": "17.11.0"
      }
    ],
