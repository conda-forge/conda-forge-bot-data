  "raw_meta_yaml": "context:\n  version: \"9.0.1\"\n\npackage:\n  name: rqbit\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ikatson/rqbit/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 62a42c56259b737eea6580b63061589dc9940b145c40991cfff83470aa783291\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - cd crates/rqbit\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n          # generate shell completions\n          - mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n          - '\"$PREFIX\"/bin/rqbit completions bash > \"$PREFIX/share/bash-completion/completions/rqbit\"'\n          - '\"$PREFIX\"/bin/rqbit completions fish > \"$PREFIX/share/fish/vendor_completions.d/rqbit.fish\"'\n          - '\"$PREFIX\"/bin/rqbit completions zsh  > \"$PREFIX/share/zsh/site-functions/_rqbit\"'\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n          # generate shell completions\n          - mkdir \"%LIBRARY_PREFIX%\\share\\bash-completion\\completions\"\n          - mkdir \"%LIBRARY_PREFIX%\\share\\fish\\vendor_completions.d\"\n          - mkdir \"%LIBRARY_PREFIX%\\share\\zsh\\site-functions\"\n          - '\"%LIBRARY_BIN%\"\\rqbit.exe completions bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\rqbit'\n          - '\"%LIBRARY_BIN%\"\\rqbit.exe completions fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\rqbit.fish'\n          - '\"%LIBRARY_BIN%\"\\rqbit.exe completions zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_rqbit'\n      - cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml\n      # bundle licenses from webui assets\n      - cd ../../crates/librqbit/webui\n      - pnpm install --ignore-scripts && pnpm-licenses generate-disclaimer --prod --output-file=../../../THIRDPARTY-webui.txt\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - cmake\n    - nodejs\n    - pkg-config\n    - pnpm\n    - pnpm-licenses\n  host:\n    - if: linux\n      then: openssl\n\ntests:\n  - script:\n      - rqbit --help\n      - rqbit --version\n  - package_contents:\n      bin:\n        - rqbit\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/rqbit\n            - share/fish/vendor_completions.d/rqbit.fish\n            - share/zsh/site-functions/_rqbit\n        - if: win\n          then:\n            - Library/share/bash-completion/completions/rqbit\n            - Library/share/fish/vendor_completions.d/rqbit.fish\n            - Library/share/zsh/site-functions/_rqbit\n      strict: true\n\nabout:\n  summary: A bittorrent client with a CLI, server mode, and Web UI\n  description: |\n    rqbit is a bittorrent client written in Rust. It offers a command-line interface\n    for downloading, sharing, and managing torrents, plus an HTTP API and Web UI.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n    - THIRDPARTY-webui.txt\n  homepage: https://github.com/ikatson/rqbit\n  repository: https://github.com/ikatson/rqbit\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
