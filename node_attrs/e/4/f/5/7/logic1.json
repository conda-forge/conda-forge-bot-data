  "linux_64_meta_yaml": {
    "about": {
      "description": "First-order logic recursively builds terms from variables and a specified set of function symbols with specified arities, which includes constant symbols with arity zero. Next, atomic formulas are built from terms and a specified set of relation symbols with specified arities. Finally, first-order formulas are recursively built from atomic formulas and a fixed set of logical operators.\n\nLogic1 focuses on interpreted first-order logic, where the above-mentioned function and relation symbols have implicit semantics, which is not explicitly expressed via axioms within the logical framework. Typical applications include algebraic decision procedures and, more generally, quantifier elimination procedures, e.g., over the real numbers.",
      "dev_url": "https://github.com/logic1-eu/logic1",
      "doc_url": "https://docs.logic1.eu/",
      "home": "https://docs.logic1.eu/",
      "license": "GPL-2.0-or-later",
      "license_family": "GPL-2.0-or-later",
      "license_file": "LICENSE",
      "summary": "Interpreted first-order logic in Python"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "export CFLAGS=\"${CFLAGS} -I${SP_DIR}/gmpy2\"",
          "python -m pip install . -vv --no-deps --no-build-isolation"
        ],
        "env": {
          "SETUPTOOLS_SCM_PRETEND_VERSION": "0.3.0"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "lorenzleutgeb",
        "thomas-sturm"
      ]
    },
