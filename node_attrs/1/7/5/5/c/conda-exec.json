      "license_file": "LICENSE",
      "summary": "Ephemeral package execution for conda"
    },
    "build": {
      "entry_points": [
        "ce = conda_exec.main:main"
      ],
      "noarch": "python",
      "number": "0",
      "script": "PYTHON -m pip install . -vv --no-deps --no-build-isolation"
    },
