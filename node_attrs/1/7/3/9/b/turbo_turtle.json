  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: turbo_turtle\n  version: \"1.2.13\"\n  python_min: \"3.10\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/lanl-aea/turbo-turtle/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 2bbb5e74fc9a95d961ab7d5bce496fd60e9436dddff58ee3110c4123d5388653\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    env:\n      SETUPTOOLS_SCM_PRETEND_VERSION: ${{ version }}\n    content:\n      - if: unix\n        then: scons install --prefix=${PREFIX}\n      - if: win\n        then: scons install --prefix=%PREFIX%\n  python:\n    entry_points:\n      - turbo-turtle = turbo_turtle._main:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - python-build\n    - python-gmsh >=4\n    - pip\n    - pytest\n    - lazy_loader >=0.4\n    - matplotlib-base >=3\n    - numpy\n    - scons >=4.6\n    - setuptools >=77\n    - setuptools_scm >=8\n    - sphinx >=7.1\n    - sphinx-argparse\n    - sphinx-book-theme\n    - sphinx-copybutton >=0.5.1\n    - sphinx-design\n    - sphinxcontrib-bibtex\n    - waves >=0.13\n  run:\n    - python >=${{ python_min }}\n    - lazy_loader >=0.4\n    - matplotlib-base >=3\n    - numpy\n    - scons >=4.6\n    - waves >=0.13\n\ntests:\n  - python:\n      imports:\n        - turbo_turtle\n      pip_check: false\n      python_version: ${{ python_min }}.*\n  - script:\n      - if: unix\n        then:\n          - working_directory=$PWD\n          - cd $SP_DIR/$PKG_NAME\n          - pytest --basetemp ${working_directory}/pytest-temp -vvv -n 4 --ignore=_abaqus_python -m \"not require_third_party\"\n      - if: win\n        then:\n          - set working_directory=%CD%\n          - cd %SP_DIR%\\%PKG_NAME%\n          - pytest --basetemp %working_directory%\\pytest-temp -vvv -n 4 --ignore=_abaqus_python -m \"not require_third_party\"\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pip\n        - pytest\n        - pytest-xdist\n        - python-gmsh >=4\n\nabout:\n  license: BSD-3-Clause\n  license_file: LICENSE.txt\n  summary: Solid body modeling tools for 2D sketched, 2D axisymmetric, and 3D revolved models\n  description: |\n    Turbo-Turtle (LANL code O4765) is a solid body modeling tools for 2D sketched, 2D axisymmetric, and 3D revolved\n    models.\n  homepage: https://github.com/lanl-aea/turbo-turtle\n  repository: https://github.com/lanl-aea/turbo-turtle\n  documentation: https://lanl-aea.github.io/turbo-turtle/index.html\n\nextra:\n  recipe-maintainers:\n    - kbrindley\n    - tprobertslanl\n",
