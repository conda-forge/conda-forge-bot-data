  "raw_meta_yaml": "context:\n  version: \"22.1.1\"\n\npackage:\n  name: cargo-update\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/nabijaczleweli/cargo-update/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 570d009f6ddd83d54ea478b63f369e08617feddb7119a9cb1d5c6a050d213c28\n\nbuild:\n  number: 1\n  script:\n    env:\n      AWS_LC_SYS_CMAKE_BUILDER: ${{ \"1\" if win else \"0\" }} # force CMake builder for `aws-lc-sys` native C/C++ code on Windows\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      OPENSSL_NO_VENDOR: \"1\" # force linking to host's (conda-forge's) OpenSSL libs (on Unix)\n      # instruct `cc` crate to use clang-cl natively to compile build-time tools intended to be run on the host when cross-compiling from `win_64`\n      AR_x86_64_pc_windows_msvc: llvm-lib\n      CC_x86_64_pc_windows_msvc: clang-cl\n      CXX_x86_64_pc_windows_msvc: clang-cl\n    content:\n      # NOTE: we cannot use `--locked` in `cargo install` since the upstream project has no `Cargo.lock` committed\n      - if: unix\n        then:\n          - export OPENSSL_DIR=\"$PREFIX\" # force the correct OpenSSL libs dir to avoid pkg-config preferring the host's homebrew OpenSSL libs (on `osx_arm64` builders)\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --bins\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --bins\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - if: win\n      then: cmake\n  host:\n    - if: unix\n      then:\n        - libgit2\n        - openssl\n        - pkg-config\n  run:\n    - if: linux\n      then: libsecret\n\ntests:\n  - script:\n      - cargo-install-update --help\n      - cargo-install-update --version\n      - cargo-install-update-config --help\n      - cargo-install-update-config --version\n  - package_contents:\n      bin:\n        - cargo-install-update\n        - cargo-install-update-config\n      strict: true\n\nabout:\n  summary: A cargo subcommand for checking and applying updates to installed executables\n  description: |\n    cargo-update provides the `cargo install-update` subcommand for cargo,\n    allowing you to check for and apply updates to all installed cargo binaries.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/nabijaczleweli/cargo-update\n  documentation: https://github.com/nabijaczleweli/cargo-update/tree/master/man\n  repository: https://github.com/nabijaczleweli/cargo-update\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
