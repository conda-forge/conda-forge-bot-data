  "linux_64_meta_yaml": {
    "about": {
      "description": "cargo-update provides the `cargo install-update` subcommand for cargo,\nallowing you to check for and apply updates to all installed cargo binaries.",
      "dev_url": "https://github.com/nabijaczleweli/cargo-update",
      "doc_url": "https://github.com/nabijaczleweli/cargo-update/tree/master/man",
      "home": "https://github.com/nabijaczleweli/cargo-update",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "A cargo subcommand for checking and applying updates to installed executables"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "export OPENSSL_DIR=\"$PREFIX\"",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --bins",
          "cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml"
        ],
        "env": {
          "AR_x86_64_pc_windows_msvc": "llvm-lib",
          "AWS_LC_SYS_CMAKE_BUILDER": "0",
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "CC_x86_64_pc_windows_msvc": "clang-cl",
          "CXX_x86_64_pc_windows_msvc": "clang-cl",
          "OPENSSL_NO_VENDOR": "1"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "cargo-update",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [
            "libgit2",
            "openssl",
            "pkg-config"
          ],
          "run": [
            "libsecret"
          ]
        },
        "tests": [
          {
            "script": [
              "cargo-install-update --help",
              "cargo-install-update --version",
              "cargo-install-update-config --help",
              "cargo-install-update-config --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "cargo-install-update",
                "cargo-install-update-config"
              ],
              "strict": true
            }
          }
        ],
        "version": "22.1.1"
      }
    ],
