  "raw_meta_yaml": "context:\n  version: \"1.2.1\"\n\nrecipe:\n  name: xrayphysics-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/kylechampley/XrayPhysics/archive/refs/tags/v${{ version }}.zip\n  sha256: D03AC5512413099694F7C0E4D47C516EFBBCF570C23490871142B9388EDDE4D6\n  patches: \n    # This patch is not upstream. What is does is overwrite the default search\n    # directory for the leapct shared library. This is necessary because Conda \n    # on Windows installs shared .dlls to PYTHON_INSTALL_PREFIX/Library/bin. \n    # This specific directory is unique to Conda Python installations, i.e. \n    # without the patch, dll lookup fails and the library is unable to function.\n    - 01-patch-dll-path.patch\n  \nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: libxrayphysics\n    build:\n      script:\n        - if: win\n          then:\n            - set \"CXXFLAGS=%CXXFLAGS% -DWIN32 -DPROJECTOR_EXPORTS\"\n            - cmake -S %SRC_DIR% -B build -GNinja %CMAKE_ARGS%\n            - cmake --build build\n            - cmake --install build\n          else:\n            - cmake $SRC_DIR -B build -GNinja $CMAKE_ARGS\n            - cmake --build build\n            - cmake --install build\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib(\"c\") }}\n        - cmake >3.9,<4.0\n        - ninja\n      host:\n        - if: osx\n          then: llvm-openmp\n        - if: linux\n          then: libgomp\n        - if: win\n          then: vcomp14\n      run_exports:\n        - ${{ pin_subpackage(\"libxrayphysics\", upper_bound=\"x.x.x\") }}\n    tests:\n      - if: unix\n        then:\n          script:\n            - test -f ${PREFIX}/lib/libxrayphysics${SHLIB_EXT}\n        else:\n          script:\n            - if not exist %LIBRARY_PREFIX%\\lib\\xrayphysics.lib exit 1\n            - if not exist %LIBRARY_PREFIX%\\bin\\libxrayphysics.dll exit 1\n\n  - package:\n      name: xrayphysics\n    build:\n      noarch: python\n      script:\n        - if: win\n          then: copy \"%SRC_DIR%\\src\\xrayphysics.py\" \"%SP_DIR%\\\"\n          else: cp \"$SRC_DIR/src/xrayphysics.py\" \"$SP_DIR/\"\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - numpy\n        - ${{ pin_subpackage(\"libxrayphysics\", exact=True) }}\n    tests:\n      - script: python -c \"from xrayphysics import xrayPhysics; p = xrayPhysics(); p.about()\"\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n\nabout:\n  homepage: https://github.com/kylechampley/XrayPhysics\n  summary: X-ray cross sections and x-ray source spectra modeling for Python\n  description: C/C++ library and Python bindings for x-ray cross sections, x-ray source spectra modeling, multi-material beam hardening correction, and dual energy decomposition algorithms.\n  license: MIT\n  license_file: LICENSE\n  documentation: https://xrayphysics.readthedocs.io/en/latest/\n  repository: https://github.com/kylechampley/XrayPhysics\n\nextra:\n  feedstock-name: xrayphysics\n  recipe-maintainers:\n    - alashworth\n",
