  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.5.5\"\n\npackage:\n  name: reachy-mini-motor-controller\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/r/reachy-mini-motor-controller/reachy_mini_motor_controller-${{ version }}.tar.gz\n  sha256: 29959d4e0a5fb0c8a49ee3d9883debe841efebb7d670f47821172fc724524846\n\nbuild:\n  number: 0\n  script:\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - pip\n    - maturin >=1.8,<2.0a0\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - reachy_mini_motor_controller\n      pip_check: true\n\nabout:\n  # Upstream ships no license metadata or file; assumed Apache-2.0 to match the Reachy stack.\n  license: Apache-2.0\n  license_file: THIRDPARTY.yml\n  summary: Motor controller bindings for the Reachy Mini robot\n  description: |\n    Python bindings, implemented in Rust with PyO3/maturin, for low-level\n    communication with the serial-bus servo motors of the Reachy Mini\n    robot by Pollen Robotics. It is used by the reachy-mini SDK and daemon\n    to drive the robot's motors.\n  # The GitHub repository (pollen-robotics/reachy_mini_motor_controller) is private;\n  # only the PyPI project page is publicly accessible.\n  homepage: https://huggingface.co/reachy-mini\n  repository: https://github.com/pollen-robotics/reachy-mini-motor-controller\n\nextra:\n  recipe-maintainers:\n    - ruben-arts\n",
