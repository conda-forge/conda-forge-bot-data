  "raw_meta_yaml": "context:\n  version: \"0.24.1\"\n  # NOTE: The `qemu-sandbox` feature makes Cubic pass the `-sandbox on` flag to the `qemu-system-*` executable, which in turn enables the Seccomp mode 2 system call filter (cf. https://www.qemu.org/docs/master/system/qemu-manpage.html) that is a Linux-only technology. Usually, `qemu-system-*` Linux distribution packages (incl. Debian, Fedora, openSUSE, Ubuntu) are built with sandbox support, so we enable the feature for Linux.\n  extra_features: ${{ \"qemu-sandbox\" if linux else \"\" }}\n\npackage:\n  name: cubic\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/cubic-vm/cubic/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 708418cfa4fb9b03e4aea28ef582277fa87bdc519f4e1e9e6468bf0e893c5a5c\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins --features=${{ extra_features }}\n          # generate shell completions\n          - mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n          - 'XDG_RUNTIME_DIR=/tmp/runtime \"$PREFIX\"/bin/cubic completions bash > \"$PREFIX\"/share/bash-completion/completions/cubic'\n          - 'XDG_RUNTIME_DIR=/tmp/runtime \"$PREFIX\"/bin/cubic completions fish > \"$PREFIX\"/share/fish/vendor_completions.d/cubic.fish'\n          - 'XDG_RUNTIME_DIR=/tmp/runtime \"$PREFIX\"/bin/cubic completions zsh  > \"$PREFIX\"/share/zsh/site-functions/_cubic'\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins --features=${{ extra_features }}\n          # generate shell completions\n          - mkdir \"%LIBRARY_PREFIX%\\share\\bash-completion\\completions\"\n          - mkdir \"%LIBRARY_PREFIX%\\share\\fish\\vendor_completions.d\"\n          - mkdir \"%LIBRARY_PREFIX%\\share\\zsh\\site-functions\"\n          - '\"%LIBRARY_BIN%\"\\cubic.exe completions bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\cubic'\n          - '\"%LIBRARY_BIN%\"\\cubic.exe completions fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\cubic.fish'\n          - '\"%LIBRARY_BIN%\"\\cubic.exe completions zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_cubic'\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - if: win\n      then: nasm\n\ntests:\n  - script:\n      - cubic --help\n      - cubic --version\n  - package_contents:\n      bin:\n        - cubic\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/cubic\n            - share/fish/vendor_completions.d/cubic.fish\n            - share/zsh/site-functions/_cubic\n        - if: win\n          then:\n            - Library/share/bash-completion/completions/cubic\n            - Library/share/fish/vendor_completions.d/cubic.fish\n            - Library/share/zsh/site-functions/_cubic\n      strict: true\n\nabout:\n  summary: A lightweight command line manager for virtual machines\n  description: |\n    Cubic is a lightweight command line manager for virtual machines. It has a\n    simple, daemonless and rootless design. All Cubic virtual machines run isolated\n    in the user context. Cubic is built on top of QEMU, KVM and cloud-init.\n  license: MIT OR Apache-2.0\n  license_file:\n    - LICENSE-APACHE\n    - LICENSE-MIT\n    - THIRDPARTY.yml\n  homepage: https://cubic-vm.org\n  repository: https://github.com/cubic-vm/cubic\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
