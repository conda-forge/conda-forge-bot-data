  "linux_64_meta_yaml": {
    "about": {
      "description": "Cubic is a lightweight command line manager for virtual machines. It has a\nsimple, daemonless and rootless design. All Cubic virtual machines run isolated\nin the user context. Cubic is built on top of QEMU, KVM and cloud-init.",
      "dev_url": "https://github.com/cubic-vm/cubic",
      "home": "https://cubic-vm.org/",
      "license": "MIT OR Apache-2.0",
      "license_family": "MIT OR Apache-2.0",
      "license_file": "LICENSE-APACHE",
      "summary": "A lightweight command line manager for virtual machines"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "cargo auditable install --path=. --root=($prefix) --no-track --locked --bins",
          "cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml",
          "mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions",
          "let bin = ($prefix)/bin/cubic",
          "$env.XDG_RUNTIME_DIR = $env.XDG_RUNTIME_DIR? | default ($env.HOME)/.cache",
          "^$bin completions bash | save ($prefix)/share/bash-completion/completions/cubic",
          "^$bin completions fish | save ($prefix)/share/fish/vendor_completions.d/cubic.fish",
          "^$bin completions zsh  | save ($prefix)/share/zsh/site-functions/_cubic"
        ],
        "env": {
          "AWS_LC_SYS_CMAKE_BUILDER": "0",
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        },
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "cubic",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "nushell"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "cubic --help",
              "cubic --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "cubic"
              ],
              "files": [
                "share/bash-completion/completions/cubic",
                "share/fish/vendor_completions.d/cubic.fish",
                "share/zsh/site-functions/_cubic"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.25.0"
      }
    ],
    "package": {
