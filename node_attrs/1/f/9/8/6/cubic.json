  "raw_meta_yaml": "context:\n  version: \"0.25.0\"\n\npackage:\n  name: cubic\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/cubic-vm/cubic/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: b1aa0d2ec689a37e2399928fedeb053d3fca1efd052f6d765a13949535af05ad\n\nbuild:\n  number: 0\n  script:\n    env:\n      AWS_LC_SYS_CMAKE_BUILDER: ${{ 1 if win else 0 }} # force CMake builder for `aws-lc-sys` native C/C++ code on Windows\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - let bin = ($prefix)/bin/cubic\n          # `XDG_RUNTIME_DIR` must be set (to a writable directory) when running `cubic` on Linux (setting `UID` would require `/run/user/<UID>` being *writable* which it is not in containerized builds)\n          - if: linux\n            then: $env.XDG_RUNTIME_DIR = $env.XDG_RUNTIME_DIR? | default ($env.HOME)/.cache\n          - ^$bin completions bash | save ($prefix)/share/bash-completion/completions/cubic\n          - ^$bin completions fish | save ($prefix)/share/fish/vendor_completions.d/cubic.fish\n          - ^$bin completions zsh  | save ($prefix)/share/zsh/site-functions/_cubic\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nushell\n    - if: win\n      then:\n        - cmake\n        - nasm\n\ntests:\n  - script:\n      - cubic --help\n      - cubic --version\n  - package_contents:\n      bin:\n        - cubic\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/cubic\n            - share/fish/vendor_completions.d/cubic.fish\n            - share/zsh/site-functions/_cubic\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/cubic\n            - Library/share/fish/vendor_completions.d/cubic.fish\n            - Library/share/zsh/site-functions/_cubic\n      strict: true\n\nabout:\n  summary: A lightweight command line manager for virtual machines\n  description: |\n    Cubic is a lightweight command line manager for virtual machines. It has a\n    simple, daemonless and rootless design. All Cubic virtual machines run isolated\n    in the user context. Cubic is built on top of QEMU, KVM and cloud-init.\n  license: MIT OR Apache-2.0\n  license_file:\n    - LICENSE-APACHE\n    - LICENSE-MIT\n    - THIRDPARTY.yml\n  homepage: https://cubic-vm.org\n  repository: https://github.com/cubic-vm/cubic\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
