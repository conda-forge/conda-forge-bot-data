  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.23.0\"\n  python_check_max: \"3.14\"\n  # #20: parses random markdown file\n  unlink_tests: core/test_plot_type_stability.py core/test_docs_quote_the_real_warning.py\n  # #18: these do weird bash things\n  k_scripts: (shell_guard_matches_the_python_validator or freshness_workflow_imports_resolve or fetch_script_bundles_every_asset_the_runtime_needs)\n  # #18: this seems kinda vibe-broken\n  k_pieplot: (pieplot or pie_schema)\n  # #19: double encoding?\n  k_embedding: survives_html_embedding\n  # #20: not sure\n  k_20: (a_log_axis_answers_its_limits_and_its_ticks_in_different_spaces or no_new_module_stashes_maidr_state_on_an_axes)\n  pytest_k: not (${{ k_scripts }} or ${{ k_pieplot }} or ${{ k_embedding }} or ${{ k_20 }})\n\nrecipe:\n  name: py-maidr-split\n  version: ${{ version }}\n\nsource:\n  - target_directory: dist\n    url: https://pypi.org/packages/source/m/maidr/maidr-${{ version }}.tar.gz\n    sha256: 9f5d61c7cc6f840fc6e2b513d05a9a2ab846e2b7314fed9247e7e7070fe8208c\n  - target_directory: src\n    url: https://github.com/xability/py-maidr/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 41cd276b9f13c8cbcad18d026052eaa7a3d714bd3d3b1d572d2907a5141c238b\n\nbuild:\n  number: 0\n  noarch: python\n\noutputs:\n  - package:\n      name: py-maidr\n    build:\n      number: 0\n      noarch: python\n      script:\n        - cd dist\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n    requirements:\n      host:\n        - hatchling\n        - pip\n        - python ${{ python_min }}.*\n      run:\n        - htmltools >=0.5\n        - lxml >=5.1.0\n        - mplfinance >=0.12.10b0\n        - numpy >=1.26\n        - python >=${{ python_min }}\n        - wrapt >=1.16.0,<2\n        - seaborn-base >=0.13\n        - matplotlib-base >=3.8\n        - scipy >=1.11\n      run_constraints:\n        - statsmodels >=0.14.4\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n\n  - package:\n      name: py-maidr-with-altair\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n        - altair >=5.0\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: Multimodal Access and Interactive Data Representations (with [altair])\n\n  - package:\n      name: py-maidr-with-jupyter\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n        - ipykernel >=6.0.0\n        - jupyter >=1.0.0,<2\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: Multimodal Access and Interactive Data Representations (with [jupyter])\n\n  - package:\n      name: py-maidr-with-plotly\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n        - plotly >=5.0\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: Multimodal Access and Interactive Data Representations (with [plotly])\n\n  - package:\n      name: py-maidr-with-shiny\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n        - shiny >=1.0\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: Multimodal Access and Interactive Data Representations (with [shiny])\n\n  - package:\n      name: py-maidr-with-streamlit\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n        - streamlit >=1.30\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: Multimodal Access and Interactive Data Representations (with [streamlit])\n\n  - package:\n      name: py-maidr-with-visualization\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n        - flask >=3.0.0\n        - seaborn-base\n        - statsmodels\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      summary: Multimodal Access and Interactive Data Representations (with [visualization])\n\n  - package:\n      name: py-maidr-with-all\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"py-maidr-with-altair\", exact=True) }}\n        - ${{ pin_subpackage(\"py-maidr-with-jupyter\", exact=True) }}\n        - ${{ pin_subpackage(\"py-maidr-with-plotly\", exact=True) }}\n        - ${{ pin_subpackage(\"py-maidr-with-shiny\", exact=True) }}\n        - ${{ pin_subpackage(\"py-maidr-with-streamlit\", exact=True) }}\n        - ${{ pin_subpackage(\"py-maidr-with-visualization\", exact=True) }}\n        - ${{ pin_subpackage(\"py-maidr\", exact=True) }}\n    tests:\n      - python:\n          imports: maidr\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n      - files:\n          source:\n            - src/tests/\n            - src/pyproject.toml\n        requirements:\n          run:\n            - cssselect >=1.2\n            - pytest >=7.3.2,<8\n            - pytest-cov\n            - pytest-mock >=3.12.0,<4\n            - python ${{ python_min }}.*\n        script:\n          - cd src\n          - python -c \"import os; [os.unlink(f'tests/{p}') for p in '''${{ unlink_tests }}'''.split()]\"\n          - coverage run --source maidr --branch -m pytest -vvv --tb=long --color=yes -k \"${{ pytest_k }}\"\n          - coverage report --show-missing --skip-covered --fail-under=71\n    about:\n      summary: Multimodal Access and Interactive Data Representations (with all [extras])\n\nabout:\n  homepage: https://pypi.org/project/maidr\n  summary: Multimodal Access and Interactive Data Representations\n  license: GPL-3.0-or-later\n  license_file:\n    - dist/LICENSE\n    # TODO: js licenses?\n  repository: https://github.com/xability/py-maidr\n  documentation: https://py.maidr.ai\n\nextra:\n  feedstock-name: py-maidr\n  recipe-maintainers:\n    - bollwyvl\n",
