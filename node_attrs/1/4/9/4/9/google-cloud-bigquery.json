  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: google-cloud-bigquery\n  version: \"3.45.0\"\n\nrecipe:\n  name: ${{ name|lower }}-split\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name|replace('-', '_') }}-${{ version }}.tar.gz\n  sha256: 5a799856825f47743ce561802cbd01b4d5c70062b36a942cfef5146017ecf0a4\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: ${{ name }}\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - setuptools\n      run:\n        - python >=${{ python_min }}\n        - ${{ pin_subpackage('google-cloud-bigquery-core', exact=True) }}\n        # from the bqstorage extra\n        - google-cloud-bigquery-storage >=2.29.0,<3.0.0\n        # tightest of upstream's floors (python >=3.14)\n        - grpcio >=1.75.1,<2.0.0\n        - pyarrow >=4.0.0\n        # from the pandas extra\n        - pandas >=1.3.0\n        - pandas-gbq >=0.26.1\n        - db-dtypes >=1.0.4,<2.0.0\n        # from the ipywidgets extra\n        - ipywidgets >=7.7.1\n        - ipykernel >=6.2.0\n        # from the geopandas extra\n        - geopandas >=0.9.0,<2.0.0\n        - shapely >=1.8.4,<3.0.0\n        # from the ipython extra\n        - ipython >=7.23.1\n        - bigquery-magics >=0.6.0\n        # from the matplotlib extra\n        - matplotlib-base >=3.10.3\n        # from the tqdm extra\n        - tqdm >=4.23.4,<5.0.0\n        # from the opentelemetry extra\n        - opentelemetry-api >=1.1.0\n        - opentelemetry-sdk >=1.1.0\n        - opentelemetry-instrumentation >=0.20b0\n        # from the bigquery-v2 extra\n        - proto-plus >=1.26.1,<2.0.0\n        - protobuf >=6.33.5,<8.0.0\n    tests:\n      - python:\n          imports:\n            - google.api_core\n            - google.cloud.bigquery\n            - google.cloud.bigquery.client\n            - google.cloud.bigquery.dataset\n            - google.cloud.bigquery.encryption_configuration\n            - google.cloud.bigquery.enums\n            - google.cloud.bigquery.external_config\n            - google.cloud.bigquery.job\n            - google.cloud.bigquery.magics\n            - google.cloud.bigquery.model\n            - google.cloud.bigquery.query\n            - google.cloud.bigquery.retry\n            - google.cloud.bigquery.routine\n            - google.cloud.bigquery.schema\n            - google.cloud.bigquery.table\n            - google.cloud.bigquery_v2\n            - google.cloud.bigquery_v2.types\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n          pip_check: true\n\n  - package:\n      name: ${{ name }}-core\n    build:\n      noarch: python\n      script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - setuptools\n      run:\n        - python >=${{ python_min }}\n        - google-api-core-grpc >=2.28.0,<3.0.0\n        # conda-forge package includes google-auth[pyopenssl] extra\n        - google-auth >=2.14.1,<3.0.0\n        - google-cloud-core >=2.4.1,<3.0.0\n        - google-resumable-media >=2.0.0,<3.0.0\n        - packaging >=24.2.0\n        - python-dateutil >=2.8.2,<3.0.0\n        - requests >=2.21.0,<3.0.0\n    tests:\n      - python:\n          imports:\n            - google.api_core\n            - google.cloud.bigquery\n            - google.cloud.bigquery.client\n            - google.cloud.bigquery.dataset\n            - google.cloud.bigquery.encryption_configuration\n            - google.cloud.bigquery.enums\n            - google.cloud.bigquery.external_config\n            - google.cloud.bigquery.job\n            - google.cloud.bigquery.model\n            - google.cloud.bigquery.query\n            - google.cloud.bigquery.retry\n            - google.cloud.bigquery.routine\n            - google.cloud.bigquery.schema\n            - google.cloud.bigquery.table\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n          pip_check: true\n\nabout:\n  homepage: https://github.com/googleapis/google-cloud-python/tree/main/packages/google-cloud-bigquery\n  license: Apache-2.0\n  license_file: LICENSE\n  summary: BigQuery API client library\n  documentation: https://googleapis.dev/python/bigquery/latest/index.html\n  repository: https://github.com/googleapis/google-cloud-python/tree/main/packages/google-cloud-bigquery\n\nextra:\n  recipe-maintainers:\n    - chalmerlowe\n    - xylar\n    - parthea\n    - tswast\n",
