  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.12.0\"\n  python_min: \"3.10\"\n\npackage:\n  name: chainlit\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/Chainlit/chainlit/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 4ffd1d0daf66d518300748deb730d3674115c8b432f0f40ba3d5a41db3951187\n\nbuild:\n  number: 1\n  noarch: python\n  script:\n    - cd backend\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - chainlit = chainlit.cli:cli\n\nrequirements:\n  build:\n    - pnpm\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - httpx >=0.23.0\n    - literalai 0.1.201.*\n    - dataclasses-json >=0.6.7,<0.7.0\n    - fastapi >=0.116.1,<0.117\n    - starlette >=0.47.2\n    - uvicorn >=0.35.0\n    - python-socketio >=5.11.0,<6.0.0\n    - aiofiles >=23.1.0,<25.0.0\n    - syncer >=2.0.3,<3.0.0\n    - asyncer >=0.0.8,<0.0.9\n    - mcp >=1.11.0,<2\n    - nest-asyncio >=1.6.0,<2.0.0\n    - click >=8.1.3,<9.0.0\n    - tomli >=2.0.1,<3.0.0\n    - pydantic >=2.7.2,<3\n    - python-dotenv >=1.0.0,<2.0.0\n    - watchfiles >=1.1.1,<2\n    - filetype >=1.2.0,<2.0.0\n    - lazify >=0.4.0,<0.5.0\n    - packaging >=23.1\n    - python-multipart >=0.0.30,<1.0.0\n    - pyjwt >=2.8.0,<3.0.0\n\ntests:\n  - python:\n      imports:\n        - chainlit\n      pip_check: true\n      python_version:\n        - ${{ python_min }}\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - chainlit --help\n\nabout:\n  homepage: https://chainlit.io/\n  summary: Build Conversational AI.\n  license: Apache-2.0\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - timkpaine\n",
