    "about": {
      "description": "Python bindings for ihist, which computes histograms of 8-bit and\n16-bit integer image data using cache-conscious algorithms with\noptional multi-threading via oneTBB. Only 64-bit platforms are\nsupported.\n",
      "dev_url": "https://github.com/marktsuchida/ihist",
      "home": "https://github.com/marktsuchida/ihist",
      "license": "MIT AND BSD-3-Clause",
      "license_file": [
        "LICENSE.txt",
        "nanobind-LICENSE"
      ],
      "summary": "Fast integer image histograms"
    },
    "build": {
      "number": "2",
      "script": [
        "PYTHON -m pip install . -vv --no-build-isolation --no-deps"
      ]
    },
