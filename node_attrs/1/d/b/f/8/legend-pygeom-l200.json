  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: legend-pygeom-l200\n  version: \"0.10.0\"\n  python_min: \"3.11\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/legend_pygeom_l200-${{ version }}.tar.gz\n  sha256: 072b33246c1781e4e08c76e986b8c6e9bd81e052c93e97253301b18c1c284bfc\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n  python:\n    entry_points:\n      - legend-pygeom-l200 = pygeoml200.cli:dump_gdml_cli\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=77\n    - setuptools-scm >=7\n    - pip\n  run:\n    - jsonschema\n    - python >=${{ python_min }}\n    - dbetto\n    - legend-pygeom-hpges >=0.9.0\n    - legend-pygeom-optics >=0.17.2\n    - legend-pygeom-tools >=0.5.0\n    - numpy\n    - pint\n    - pyg4ometry >=1.3.4\n    - pylegendmeta >=v1.3.1\n    - pyyaml\n    - scipy\ntests:\n  - python:\n      imports:\n        - l200geom\n        - pygeoml200\n      pip_check: true\n      python_version: ${{ python_min }}\n  - requirements:\n      run:\n        - git\n    script:\n      - legend-pygeom-l200 --public-geom test.gdml\n\nabout:\n  summary: Geometry model of the LEGEND-200 experimental setup\n  license: GPL-3.0-only\n  license_file: LICENSE\n  homepage: https://github.com/legend-exp/legend-pygeom-l200\n  repository: https://github.com/legend-exp/legend-pygeom-l200\n  documentation: https://legend-pygeom-l200.readthedocs.io\n\nextra:\n  recipe-maintainers:\n    - gipert\n    - ManuelHu\n",
