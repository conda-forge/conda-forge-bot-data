  "linux_64_meta_yaml": {
    "about": {
      "description": "Gas Town is a workspace manager that lets you coordinate multiple AI coding\nagents (Claude Code, GitHub Copilot, Codex, Gemini, and others) working on\ndifferent tasks. Instead of losing context when agents restart, Gas Town\npersists work state in git-backed hooks, enabling reliable multi-agent\nworkflows.",
      "dev_url": "https://github.com/gastownhall/gastown",
      "doc_url": "https://github.com/gastownhall/gastown/tree/main/docs",
      "home": "https://github.com/gastownhall/gastown",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Multi-agent orchestration system for Claude Code, GitHub Copilot, and other AI agents with persistent work tracking"
    },
    "build": {
      "number": "2",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "let build_time = date now | format date \"%Y-%m-%dT%H:%M:%SZ\"",
          "let short_commit_hash = (http get https://api.github.com/repos/gastownhall/gastown/commits/v${{ version }}).sha | str substring 0..6",
          "go build -o=($prefix)/bin/ -v -ldflags=$'-s -w -X github.com/steveyegge/gastown/internal/cmd.Build=conda-forge -X github.com/steveyegge/gastown/internal/cmd.BuildTime=($build_time) -X github.com/steveyegge/gastown/internal/cmd.BuiltProperly=1 -X github.com/steveyegge/gastown/internal/cmd.Commit=($short_commit_hash) -X github.com/steveyegge/gastown/internal/cmd.Version=${{ version }}' -trimpath ./cmd/gt",
          "go build -o=($prefix)/bin/ -v -ldflags=$'-s -w -X github.com/steveyegge/gastown/internal/cmd.Build=conda-forge -X github.com/steveyegge/gastown/internal/cmd.BuildTime=($build_time) -X github.com/steveyegge/gastown/internal/cmd.BuiltProperly=1 -X github.com/steveyegge/gastown/internal/cmd.Commit=($short_commit_hash) -X github.com/steveyegge/gastown/internal/cmd.Version=${{ version }}' -trimpath ./cmd/gt-proxy-server",
          "go build -o=($prefix)/bin/ -v -ldflags=$'-s -w -X github.com/steveyegge/gastown/internal/cmd.Build=conda-forge -X github.com/steveyegge/gastown/internal/cmd.BuildTime=($build_time) -X github.com/steveyegge/gastown/internal/cmd.BuiltProperly=1 -X github.com/steveyegge/gastown/internal/cmd.Commit=($short_commit_hash) -X github.com/steveyegge/gastown/internal/cmd.Version=${{ version }}' -trimpath ./cmd/gt-proxy-client",
          "go-licenses save ./cmd/gt ./cmd/gt-proxy-client ./cmd/gt-proxy-server --save_path=library_licenses --ignore=github.com/mattn/go-localereader",
          "cp --recursive library_licenses_2/* library_licenses/",
          "rm --recursive library_licenses_2",
          "mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions",
          "let bin = ($prefix)/bin/gt",
          "^$bin completion bash | save ($prefix)/share/bash-completion/completions/gt",
          "^$bin completion fish | save ($prefix)/share/fish/vendor_completions.d/gt.fish",
          "^$bin completion zsh  | save ($prefix)/share/zsh/site-functions/_gt"
        ],
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "gastown",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses",
            "nushell"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": {
              "content": [
                "gt --help",
                "gt --version",
                "gt-proxy-server --help",
                "gt-proxy-client --help"
              ],
              "env": {
                "GT_REAL_BIN": "bin/gt"
              }
            }
          },
          {
            "package_contents": {
              "bin": [
                "gt",
                "gt-proxy-server",
                "gt-proxy-client"
              ],
              "files": [
                "share/bash-completion/completions/gt",
                "share/fish/vendor_completions.d/gt.fish",
                "share/zsh/site-functions/_gt"
              ],
              "strict": true
            }
          }
        ],
        "version": "1.2.1"
      }
    ],
    "package": {
