  "raw_meta_yaml": "context:\n  version: \"1.2.1\"\n\npackage:\n  name: gastown\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/gastownhall/gastown/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: f5c5efcdc1ecc40f2b8efb95a5826f88ba6196137bc2e919d60a39b42cf446ba\n  # Windows-only dep `go-localereader` (MIT-licensed) misses standard license file layout, so we have to manually add the license file\n  - url: https://raw.githubusercontent.com/mattn/go-localereader/master/LICENSE\n    sha256: dceede03550621e65ec7b79fcba87cf6dbb9d31132a8ae71a8fe8ceec0af7da3\n    target_directory: library_licenses_2/github.com/mattn/go-localereader\n\nbuild:\n  number: 2\n  script:\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      # upstream ref: https://github.com/gastownhall/gastown/blob/main/Makefile\n      # NOTE: we must use the old `steveyegge/gastown` GitHub owner-repo specifier for variables set via LDFLAGS since the code still references it and doesn't recognize `gastownhall/gastown`\n      - let build_time = date now | format date \"%Y-%m-%dT%H:%M:%SZ\"\n      - let short_commit_hash = (http get https://api.github.com/repos/gastownhall/gastown/commits/v${{ version }}).sha | str substring 0..6\n      - go build\n        -o=($prefix)/bin/\n        -v\n        -ldflags=$'-s -w -X github.com/steveyegge/gastown/internal/cmd.Build=conda-forge -X github.com/steveyegge/gastown/internal/cmd.BuildTime=($build_time) -X github.com/steveyegge/gastown/internal/cmd.BuiltProperly=1 -X github.com/steveyegge/gastown/internal/cmd.Commit=($short_commit_hash) -X github.com/steveyegge/gastown/internal/cmd.Version=${{ version }}'\n        -trimpath\n        ./cmd/gt\n      - go build\n        -o=($prefix)/bin/\n        -v\n        -ldflags=$'-s -w -X github.com/steveyegge/gastown/internal/cmd.Build=conda-forge -X github.com/steveyegge/gastown/internal/cmd.BuildTime=($build_time) -X github.com/steveyegge/gastown/internal/cmd.BuiltProperly=1 -X github.com/steveyegge/gastown/internal/cmd.Commit=($short_commit_hash) -X github.com/steveyegge/gastown/internal/cmd.Version=${{ version }}'\n        -trimpath\n        ./cmd/gt-proxy-server\n      - if: unix\n        then:\n          - go build\n            -o=($prefix)/bin/\n            -v\n            -ldflags=$'-s -w -X github.com/steveyegge/gastown/internal/cmd.Build=conda-forge -X github.com/steveyegge/gastown/internal/cmd.BuildTime=($build_time) -X github.com/steveyegge/gastown/internal/cmd.BuiltProperly=1 -X github.com/steveyegge/gastown/internal/cmd.Commit=($short_commit_hash) -X github.com/steveyegge/gastown/internal/cmd.Version=${{ version }}'\n            -trimpath\n            ./cmd/gt-proxy-client\n      - go-licenses save ./cmd/gt ./cmd/gt-proxy-client ./cmd/gt-proxy-server\n        --save_path=library_licenses\n        --ignore=github.com/mattn/go-localereader\n      # merge library license files\n      - cp --recursive library_licenses_2/* library_licenses/\n      - rm --recursive library_licenses_2\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - let bin = ($prefix)/bin/gt\n          - ^$bin completion bash | save ($prefix)/share/bash-completion/completions/gt\n          - ^$bin completion fish | save ($prefix)/share/fish/vendor_completions.d/gt.fish\n          - ^$bin completion zsh  | save ($prefix)/share/zsh/site-functions/_gt\n\nrequirements:\n  build:\n    - ${{ compiler('go-nocgo') }}\n    - go-licenses\n    - nushell\n\ntests:\n  - script:\n      env:\n        # required for the `gt-proxy-client --help` test to pass without a running `gt-proxy-server` instance, cf. https://github.com/gastownhall/gastown/blob/main/docs/proxy-server.md#gt-proxy-client\n        GT_REAL_BIN: bin/gt\n      content:\n        - gt --help\n        - gt --version\n        - gt-proxy-server --help\n        - if: unix\n          then: gt-proxy-client --help\n  - package_contents:\n      bin:\n        - gt\n        - gt-proxy-server\n        - if: unix\n          then: gt-proxy-client\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/gt\n            - share/fish/vendor_completions.d/gt.fish\n            - share/zsh/site-functions/_gt\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/gt\n            - Library/share/fish/vendor_completions.d/gt.fish\n            - Library/share/zsh/site-functions/_gt\n      strict: true\n\nabout:\n  summary: Multi-agent orchestration system for Claude Code, GitHub Copilot, and other AI agents with persistent work tracking\n  description: |\n    Gas Town is a workspace manager that lets you coordinate multiple AI coding\n    agents (Claude Code, GitHub Copilot, Codex, Gemini, and others) working on\n    different tasks. Instead of losing context when agents restart, Gas Town\n    persists work state in git-backed hooks, enabling reliable multi-agent\n    workflows.\n  license: MIT\n  license_file:\n    - LICENSE\n    - library_licenses/\n  homepage: https://github.com/gastownhall/gastown\n  documentation: https://github.com/gastownhall/gastown/tree/main/docs\n  repository: https://github.com/gastownhall/gastown\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
