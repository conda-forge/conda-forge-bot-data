  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: runner\n  version: \"2.0.0_20260512\"\n\npackage:\n  name: \"runner\"\n  version: ${{ version }}\n\n# Obtain the checksum using\n# curl -sL https://gitlab.com/runner-suite/runner2/-/archive/v{{ version }}/runner2-v{{ version }}.tar.gz | sha256sum\nsource:\n  url: https://gitlab.com/runner-suite/runner2/-/archive/${{ version }}/runner2-${{ version }}.tar.gz\n  sha256: c362553ae2aaaac7acea89ae2d3cf5a210fc0992943a9b39ad43d27208e420df\n\nbuild:\n  number: 1\n  string: \"${{ runner_variant }}_h${{ hash }}_${{ build_number }}\"\n  skip: not (linux or osx) or (is_intel and osx)\n\nrequirements:\n  build:\n    - cmake\n    - make\n    - m4\n    - ${{ stdlib('c') }}\n    - if: is_intel\n      then:\n        - ifx_linux-64\n        - dpcpp_linux-64\n      else:\n        - ${{ compiler('c') }}\n        - ${{ compiler('fortran') }}\n\n  host:\n    - if: is_intel\n      then:\n        - mkl\n        - mkl-include\n        - mkl-devel\n        - mkl-static\n        - intel-cmplr-lib-rt\n      else:\n        - libblas\n        - liblapack\n        - fftw\n    # OpenMP libraries for GNU differ between Linux and OSX.\n    - if: not is_intel and linux\n      then:\n        - libgomp\n    - if: not is_intel and osx\n      then:\n        - llvm-openmp\n    # MPI libraries differ between GNU and Intel toolchain.\n    - if: is_intel and with_mpi\n      then:\n        - openmpi-mpiicx\n    - if: not is_intel and with_mpi\n      then:\n        - openmpi\n\n  run:\n    - if: is_intel\n      then:\n        - mkl\n        - intel-fortran-rt\n        - intel-cmplr-lib-rt\n      else:\n        - libblas\n        - liblapack\n        - fftw\n    # OpenMP libraries for GNU differ between Linux and OSX.\n    - if: not is_intel and linux\n      then:\n        - libgomp\n    - if: not is_intel and osx\n      then:\n        - llvm-openmp\n    # MPI libraries differ between GNU and Intel toolchain.\n    - if: is_intel and with_mpi\n      then:\n        - openmpi-mpiicx\n    - if: not is_intel and with_mpi\n      then:\n        - openmpi\n\n  # ``dpcpp_linux-64`` is only needed at build time to provide ``icx``.  Its\n  # run export drags in the whole SYCL/OpenCL stack (``dpcpp-cpp-rt`` ->\n  # ``intel-cmplr-lib-ur`` -> ``umf`` -> ``libhwloc >=2.13``), which is both\n  # unused here and unsolvable: since 2026.1.1 ``intel-fortran-rt`` depends on\n  # ``mpich``, which requires ``libhwloc <2.12.3``.  RuNNer links only against\n  # libimf/libintlc/libsvml (intel-cmplr-lib-rt), libifcoremt (intel-fortran-rt)\n  # and MKL, so the SYCL runtime can be dropped safely.\n  ignore_run_exports:\n    by_name:\n      - dpcpp-cpp-rt\n\ntests:\n  - script:\n      - if: with_mpi\n        then:\n          - RuNNer_mpi.x --version\n        else:\n          - RuNNer.x --version\n      - if: is_intel and not with_mpi\n        then:\n          - ldd $(which RuNNer.x) | grep -i mkl\n      - if: is_intel and with_mpi\n        then:\n          - ldd $(which RuNNer_mpi.x) | grep -i mkl\n\nabout:\n  homepage: https://www.theochem2.ruhr-uni-bochum.de/tc/software/runner.html.en\n  license: GPL-3.0-or-later\n  license_family: GPL\n  license_file: LICENSE\n  summary: 'RuNNer - a Neural Network code for high-dimensional systems'\n  description: |\n    RuNNer is a software framework for the development of Behler-Parrinello\n    high-dimensional neural network potentials (HDNNPs), actively developed\n    at Ruhr Universität Bochum, Germany.\n\n    Three build variants are provided under the single package name ``runner``:\n\n    gnu_omp\n      GCC/gfortran, OpenBLAS, serial only.  Linux and macOS.\n\n    gnu_mpi_omp\n      GCC/gfortran, OpenBLAS, OpenMPI parallel build.  Linux and macOS.\n\n    intel\n      Intel ifx, MKL, serial only.  Linux x86-64 only.\n\n    Select a specific variant with a build-string glob, e.g.::\n\n      conda install \"runner=*=gnu_omp_*\"   # GNU serial\n      conda install \"runner=*=gnu_mpi_omp_*\"   # GNU parallel\n      conda install \"runner=*=intel_*\"   # Intel serial\n\n    A parallel Intel variant is not provided.\n  documentation: https://runner-suite.gitlab.io/runner2\n  repository: https://gitlab.com/runner-suite/runner2\n\nextra:\n  recipe-maintainers:\n    - Theochem2RUB\n    - gunnar1987\n    - mirajkovic\n    - lxknll\n    - M0M097\n    - jan-janssen\n",
  "req": {
