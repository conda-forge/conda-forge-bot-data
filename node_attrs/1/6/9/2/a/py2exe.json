  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.14.2.0\"\n\npackage:\n  name: py2exe\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/py2exe/py2exe/archive/v${{ version }}.tar.gz\n  sha256: 78d98d395a9192e5da12931613f858b201e056e345e93ec3899b85b92e89e9e4\n\nbuild:\n  number: 0\n  skip: not win or match(python, \">=3.15\")\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n  host:\n    - setuptools\n    - pip\n    - python\n    # package imports itself at build time\n    - pefile\n    - cachetools\n    - wheel\n  run:\n    - cachetools\n    - pefile\n    - python\n    - setuptools\n    - packaging\n\ntests:\n  - python:\n      imports:\n        - py2exe\n      pip_check: true\n\nabout:\n  summary: Build standalone executables for Windows\n  license: MIT AND X11 AND MPL-2.0\n  license_file:\n    - LICENSE.txt\n    - MPL2-License.txt\n    - MIT-License.txt\n  description: |\n    `py2exe` is a distutils extension which allows to build standalone Windows executable programs (32-bit and 64-bit) from Python scripts\n  homepage: http://www.py2exe.org/\n  repository: https://github.com/py2exe/py2exe\n  documentation: http://www.py2exe.org/index.cgi/Tutorial\n\nextra:\n  recipe-maintainers:\n    - HeavyTony2\n",
