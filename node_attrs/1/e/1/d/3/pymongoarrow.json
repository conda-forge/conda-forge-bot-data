  "raw_meta_yaml": "{% set name = \"pymongoarrow\" %}\n{% set version = \"1.15.0\" %}\n\n# just to be able to use libarrow in jinja below\n{% if libarrow is undefined %}\n{% set libarrow = \"19\" %}\n{% endif %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pymongoarrow/pymongoarrow-{{ version }}.tar.gz\n  sha256: 155a0a4491f5c88611c218038b7378697ed87e4d08e3915c0facae238a39c4e8\n\nbuild:\n  number: 0\n  {% if libarrow.split(\".\")[0]|int < 18 %}\n  # py3.13 only supported from v18 onwards\n  skip: true  # [py>=313]\n  {% endif %}\n  {% if libarrow.split(\".\")[0]|int < 21 %}\n  # py3.14 only supported from v21 onwards\n  skip: true  # [py>=314]\n  {% endif %}\n  {% if libarrow.split(\".\")[0]|int < 24 %}\n  # py3.14t (free-threaded) only supported from v24 onwards\n  skip: true  # [is_freethreading]\n  {% endif %}\n\nrequirements:\n  build:\n    - python                                 # [build_platform != target_platform]\n    - cross-python_{{ target_platform }}     # [build_platform != target_platform]\n    - cython >=3.0                           # [build_platform != target_platform]\n    - libarrow                               # [build_platform != target_platform]\n    - pyarrow                                # [build_platform != target_platform]\n    - libbson                                # [build_platform != target_platform]\n    - pkg-config                             # [build_platform != target_platform]\n    - cmake >=3.17\n    - ninja\n    - pip\n    - {{ compiler('c') }}\n    - {{ stdlib(\"c\") }}\n    - {{ compiler('cxx') }}\n\n  host:\n    - python\n    - libarrow\n    - pyarrow\n    - cython >=3.0\n    - libbson >=2.0.1,<3\n    - numpy  # for headers\n    - pip\n    - pkg-config\n    - scikit-build-core >=0.10\n\n  run:\n    - pymongo >=4.4,<5\n    - pyarrow\n    - numpy\n    - packaging >=23.2\n    - python\n\ntest:\n  source_files:\n    - .\n  files:\n    - run_the_tests.sh\n  requires:\n    - pip\n    - pandas\n    - numpy\n    - pytest\n    - polars  # [not is_freethreading]\n    # TODO: replace with mongodb install once https://github.com/conda-forge/mongodb-feedstock/pull/72 is resolved\n    - icu\n    - yaml-cpp\n    - boost-cpp\n    - curl\n    - pytz\n\n  commands:\n    - bash run_the_tests.sh  # [osx]\n\nabout:\n  home: https://pypi.org/project/pymongoarrow/\n  summary: Tools for using NumPy, Pandas and PyArrow with MongoDB\n  license: Apache-2.0\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - sleepystick\n    - noahstapp\n    - aclark4life\n    - caseyclements\n    - jibola\n    - blink1073\n    - ShaneHarvey\n",
