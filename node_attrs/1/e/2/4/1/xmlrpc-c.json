      },
      "script": "export CXXFLAGS=\"${CXXFLAGS} -std=c++14\"\n\ncp \"${BUILD_PREFIX}/share/gnuconfig/config.guess\" config.guess\ncp \"${BUILD_PREFIX}/share/gnuconfig/config.sub\" config.sub\n\n./configure \\\n  --build=\"${BUILD}\" \\\n  --host=\"${HOST}\" \\\n  --prefix=\"${PREFIX}\" \\\n  --enable-libxml2-backend\n\nmake -j${CPU_COUNT}\nmake install\nmake -C tools install\n\nmake check\n"
    },
    "extra": {
      "recipe-maintainers": [
        "Tobias-Fischer"
      ]
    },
    "outputs": [
      {
        "build": {
          "strong": [],
          "weak": [
            "xmlrpc-c"
          ]
        },
        "name": "xmlrpc-c",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "cxx_compiler_stub",
            "c_stdlib_stub",
            "make",
            "gnuconfig",
            "pkg-config"
          ],
          "host": [
            "libxml2-devel",
            "liblzma-devel",
            "libcurl",
            "openssl",
            "zlib",
            "readline"
          ],
          "run": [
            "libxml2-devel"
          ]
        },
        "tests": [
          {
            "script": [
              "test -f ${PREFIX}/lib/libxmlrpc${SHLIB_EXT}",
              "test -f ${PREFIX}/lib/libxmlrpc++${SHLIB_EXT}",
              "test -f ${PREFIX}/lib/libxmlrpc_server${SHLIB_EXT}",
