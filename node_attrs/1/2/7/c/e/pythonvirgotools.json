    "about": {
      "description": "PythonVirgoTools is a collection of Python functions for interacting\nwith the software, hardware and data of the Virgo Interferometer.\nThese functions were mainly written for daily use in the control room,\nbut some of these might also be useful for e.g. DetChar work.",
      "dev_url": "https://git.ligo.org/virgo/virgoapp/PythonVirgoTools.git",
      "home": "https://git.ligo.org/virgo/virgoapp/PythonVirgoTools",
      "license": "GPL-2.0-or-later",
      "license_family": "GPL-2.0-or-later",
      "license_file": "LICENSE",
      "summary": "Tools for interfacing with the Virgo interferometer"
    },
    "build": {
      "noarch": "python",
      "number": "3",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "duncanmmacleod",
        "erinelizabethseder-virgo",
        "fcarbogn"
      ]
    },
    "outputs": [
