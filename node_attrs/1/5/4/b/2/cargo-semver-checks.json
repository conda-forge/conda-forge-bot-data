  "linux_64_meta_yaml": {
    "about": {
      "description": "cargo-semver-checks is a linter for library crates. It compares\ntwo builds of the same crate and reports any breaking API changes\nthat would require a semver-major version bump, helping catch\naccidental breaking changes before publishing.",
      "dev_url": "https://github.com/obi1kenobi/cargo-semver-checks",
      "doc_url": "https://docs.rs/cargo-semver-checks",
      "home": "https://github.com/obi1kenobi/cargo-semver-checks",
      "license": "MIT OR Apache-2.0",
      "license_family": "MIT OR Apache-2.0",
      "license_file": "LICENSE-APACHE",
      "summary": "Scan your Rust crate for semver violations."
    },
    "build": {
      "number": "0",
      "script": {
        "content": "cargo auditable install --locked --no-track --bins --root \"${LIBRARY_PREFIX:-$PREFIX}\" --path .\ncargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n",
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        },
        "interpreter": "brush"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "baszalmstra"
      ]
    },
