  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.3.9\"\n\npackage:\n  name: pyfvs\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pyfvs/pyfvs-${{ version }}.tar.gz\n  sha256: bafc20fa5334619c603b96e61b67c5634625f21b993e90e5cbeead10976dc4e9\n\nbuild:\n  number: 0\n  script:\n    - if: win\n      then: |\n        :: Use Meson's selected C compiler instead of upstream's hard-coded gcc\n        sed -i \"s/'gcc','-v'/cc.cmd_array() + ['-v']/\" meson.build\n        :: Prevent Meson to use ninja instead of vs\n        ${{ PYTHON }} -m pip install . --no-build-isolation --no-deps -vv -Csetup-args=\"--backend=ninja\" --config-settings=setup-args=\"-Dbuildtype=release\" --config-settings=setup-args=\"-Dfvsvariants=pn\"\n      else: |\n        ${{ PYTHON }} -m pip install . --no-build-isolation --no-deps -vv --config-settings=setup-args=\"-Dbuildtype=release\" --config-settings=setup-args=\"-Dfvsvariants=pn\"\nrequirements:\n  build:\n    - meson\n    - ninja\n    - python\n    - setuptools-scm\n\n    - if: not win\n      then:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ compiler('fortran') }}\n        - ${{ stdlib('c') }}\n\n      else:\n        - ${{ compiler('m2w64_c') }}\n        - ${{ compiler('m2w64_cxx') }}\n        - ${{ compiler('m2w64_fortran') }}\n        - ${{ stdlib('m2w64_c') }}\n        - m2-sed\n    - if: linux\n      then:\n        - patchelf\n\n  host:\n    - python\n    - pip\n    - setuptools >=64\n    - setuptools-scm >=8\n    - wheel\n    - meson-python >=0.20.0\n    - numpy\n\n  run:\n    - python\n    - confuse\n    - click\n    - pandas\n    - numpy\n    - typing_extensions\n\ntests:\n  - python:\n      imports:\n        - pyfvs\n      pip_check: true\n  - script:\n      - python -c \"import pyfvs;print(list(pyfvs.list_variants().keys()))\"\n\nabout:\n  summary: Python wrappers and utilities for using the Forest Vegetation Simulator\n  license: MIT AND ISO-permission\n  license_file:\n    - LICENSE\n    - fvs/license.txt\n  homepage: https://github.com/forest-modeling/PyFVS\n\nextra:\n  recipe-maintainers:\n    - tharen\n",
