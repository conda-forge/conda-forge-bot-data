  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.0.2\"\n  python_min: '3.12'\n\npackage:\n  name: sim-atlas\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/s/sim-atlas/sim_atlas-${{ version }}.tar.gz\n  sha256: 4c305440fe169e45902392011440ff63736cdde042eaf2228f41b4fcbc39b362\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - sim-atlas-access-token = sim_atlas.cli:token\n      - sim-atlas = sim_atlas.cli:backend\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }},<3.14\n    - fastapi-mcp >=0.4.0\n    - fastapi >=0.122.0\n    - langfuse-python >=4.6.1\n    - numpy >=1.21\n    - openai >=2.8.1\n    - pydantic-settings >=2.13.1\n    - pyjwt >=2.12.1\n    - python-workflow-definition >=0.1.2\n    - tqdm >=4.67.3\n    - voyageai >=0.3.7\n\ntests:\n  - python:\n      imports:\n        - sim_atlas\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - sim-atlas-access-token --help\n      - sim-atlas --help\n\nabout:\n  summary: Search and discovery platform for simulation nodes — Python functions, workflow definitions, and pyiron nodes used in scientific computing.\n  license: BSD-3-Clause\n  license_file: LICENSE\n  homepage: https://github.com/XzzX/sim_atlas/\n\nextra:\n  recipe-maintainers:\n    - niklassiemer\n",
