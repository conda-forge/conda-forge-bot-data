  "raw_meta_yaml": "context:\n  name: gmime\n  version: \"3.2.15\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/jstedfast/gmime/releases/download/${{ version }}/gmime-${{ version }}.tar.xz\n  sha256: 84cd2a481a27970ec39b5c95f72db026722904a2ccf3fdbd57b280cf2d02b5c4\n\nbuild:\n  number: 2\n  skip: win\n  script: |\n    ./configure --prefix=$PREFIX --libdir=${PREFIX}/lib --build=${BUILD} --host=${HOST} LIBS=\"-liconv\"\n    make -j ${CPU_COUNT}\n    make install\n    rm -rf $PREFIX/share/gtk-doc\n    rm -rf $PREFIX/lib/libgmime-3.*.a\n\nrequirements:\n  run_exports:\n    - ${{ pin_subpackage(name, lower_bound=\"x.x\", upper_bound=\"x.x\") }}\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - make\n    - pkg-config\n  host:\n    - glib\n    - gpgme\n    - libidn2\n    - libiconv\n    - zlib\n\ntests:\n  - package_contents:\n      files:\n        not_exists:\n          - lib/*.a  # Don't include archives\n      include:\n        - gmime-3.0/gmime/gmime.h\n      lib:\n        - ${{ \"libgmime-3.0\" if linux else \"libgmime-3.0.0\" }}\n\nabout:\n  homepage: https://github.com/jstedfast/gmime\n  summary: \"A C/C++ MIME creation and parser library with support for S/MIME, PGP, and Unix mbox spools\"\n  license: LGPL-2.1-or-later\n  license_file: COPYING\n  documentation: https://github.com/jstedfast/gmime\n  repository: https://github.com/jstedfast/gmime\n\nextra:\n  recipe-maintainers:\n    - cbourjau\n",
