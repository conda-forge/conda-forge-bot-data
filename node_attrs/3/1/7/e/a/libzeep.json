  "raw_meta_yaml": "context:\n  version: \"8.2.0\"\n\npackage:\n  name: libzeep\n  version: ${{ version }}\n\nsource:\n  url: https://forge.hekkelman.net/maarten/zeep/archive/v${{ version }}.tar.gz\n  sha256: f42a87e53f79fa602b2714354ea7f12c2156f0ac6e88fbe62fd9588b567b3aec\nbuild:\n  number: 0\n  script:\n    - if: unix\n      then: |\n        set -exo pipefail\n        export CXXFLAGS=\"${CXXFLAGS} -D_LIBCPP_DISABLE_AVAILABILITY\"\n        if [[ ${build_platform} != ${target_platform} ]]; then\n            extra_cmake_args=\"-DTEST_STD_CHRONO_ZONED_TIME_R=ON -DCMAKE_CROSSCOMPILING=ON\"\n        fi\n        cmake -S . -B build -G Ninja \\\n          ${CMAKE_ARGS} \\\n          -DBUILD_SHARED_LIBS=ON \\\n          -DZEEP_USE_BOOST_ASIO=OFF \\\n          ${extra_cmake_args}\n        cmake --build build --parallel ${CPU_COUNT}\n        if [[ \"${CONDA_BUILD_CROSS_COMPILATION:-}\" != \"1\" || \"${CROSSCOMPILING_EMULATOR}\" != \"\" ]]; then\n            ctest -V --test-dir build\n        fi\n        cmake --install build\n    - if: win\n      then: |\n        @echo on\n        cmake -S . -B build -G Ninja ^\n          %CMAKE_ARGS% ^\n          -DCMAKE_WINDOWS_EXPORT_ALL_SYMBOLS=ON ^\n          -DBUILD_SHARED_LIBS=ON ^\n          -DZEEP_USE_BOOST_ASIO=OFF ^\n          || exit /b 1\n        cmake --build build --parallel %CPU_COUNT% || exit /b 1\n        set PATH=%SRC_DIR%\\build;%PATH%\n        @REM Run tests, excluding the http-test/fuzz-el-test which brings about a SEGFAULT/stack overflow error\n        ctest -V --test-dir build -E \"(http-test|fuzz-el-test)\" || exit /b 1\n        cmake --install build || exit /b 1\n\nrequirements:\n  build:\n    - ${{ compiler(\"cxx\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ \"clang-tools\" if osx }}\n    - cmake\n    - ninja\n    - pkg-config\n  host:\n    - asio\n    - catch2\n    - howardhinnant_date\n    - libzeem\n    - ${{ \"maartens_resource_compiler\" if linux }}\n    - nlohmann_json\n    - openssl\n  run_exports:\n    - ${{ pin_subpackage(\"libzeep\", upper_bound=\"x\") }}\n  ignore_run_exports:\n    from_package:\n      - catch2\n\ntests:\n  - package_contents:\n      include:\n        - zeep/*\n      lib:\n        - zeep\n\nabout:\n  homepage: https://mhekkel.github.io/libzeep\n  repository: https://forge.hekkelman.net/maarten/zeep\n  documentation: https://mhekkel.github.io/libzeep\n  license: BSD-2-Clause AND BSL-1.0\n  license_file: LICENSES/\n  summary: \"C++ library for reading and writing XML and creating web, REST and SOAP servers\"\n  description: |\n    Libzeep is a web application framework written in C++.\n    To see a starter project visit the [libzeep-webapp-starter](https://github.com/mhekkel/libzeep-webapp-starter.git) page.\n\nextra:\n  recipe-maintainers:\n    - eunos-1128\n",
