  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  python_min: \"3.10\"\n  name: metaxy\n  version: \"0.1.10\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name }}-${{ version }}.tar.gz\n  sha256: 62b4970cdc196ee1f31a3cc972002a521fbea1dc1280db66fd540fec1456030e\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    content:\n      - ${{ PYTHON }} -m build --wheel --no-isolation\n      - if: unix\n        then:\n          - ${{ PYTHON }} -m installer --destdir=$PREFIX dist/*.whl\n      - if: win\n        then:\n          - for %%f in (dist\\*.whl) do ${{ PYTHON }} -m installer --destdir=%PREFIX% \"%%f\"\n    env:\n      PYTHONHASHSEED: \"0\"\n  python:\n    entry_points:\n      - metaxy = metaxy.cli.app:main\n      - mx = metaxy.cli.app:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - python-build\n    - python-installer\n    - uv-build >=0.8.14,<0.9.0\n  run:\n    - python >=${{ python_min }}\n    - cyclopts >=4.4.0\n    - narwhals >=2.18.1\n    - typing-extensions >=4.0.0\n    - pydantic-core >=2.0.0\n    - polars >=1.35.0\n    - polars-hash >=0.5.1\n    - pydantic >=2.11.9\n    - pydantic-settings >=2.11.0\n    - python-dotenv >=1.0.0\n    - pyyaml >=6.0.0\n    - pytest-cases >=3.9.1\n    - sqlglot >=28.1.0\n    - tomli >=2.3.0\n    - rich >=13.0.0\n    - packaging >=25.0\n    - tomli-w >=1.2.0\n    - tomlkit >=0.13.2\n\ntests:\n  - python:\n      imports:\n        - metaxy\n      python_version: ${{ python_min }}.*\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - pip check\n      - metaxy --help\n      - mx --help\n\nabout:\n  license: Apache-2.0\n  license_file: LICENSE\n  summary: Pluggable versioned metadata management for incremental multimodal pipelines.\n  homepage: https://github.com/anam-org/metaxy\n  repository: https://github.com/anam-org/metaxy\n  documentation: https://docs.metaxy.io\n\nextra:\n  recipe-maintainers:\n    - geoHeil\n    - mrubenw\n",
