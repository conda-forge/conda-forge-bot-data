  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.14.4\"\n  python_min: \"3.10\"\n\nrecipe:\n  name: crewai-suite\n  version: ${{ version }}\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: crewai\n      version: ${{ version }}\n    source:\n      - url: https://pypi.org/packages/source/c/crewai/crewai-${{ version }}.tar.gz\n        sha256: 384ac08cca3753ae27ad099ce629e4e8b783d72e364efa041121c7fed48be106\n    build:\n      noarch: python\n      skip:\n        - win\n      python:\n        entry_points:\n          - crewai = crewai.cli.cli:crewai\n      script: |\n        python -m pip install . -vv --no-deps --no-build-isolation\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - hatchling\n        - pip\n      run:\n        - python >=${{ python_min }},<3.14\n        - pydantic >=2.11.9,<2.13\n        - openai >=2.30.0,<3\n        - instructor >=1.3.3\n        - pdfplumber >=0.11.4,<0.12.0\n        - regex >=2026.1.15,<2026.2.0\n        - opentelemetry-api >=1.34.0,<1.35.0\n        - opentelemetry-sdk >=1.34.0,<1.35.0\n        - opentelemetry-exporter-otlp-proto-http >=1.34.0,<1.35.0\n        - chromadb >=1.1.0,<1.2.0\n        - tokenizers >=0.21,<1\n        - openpyxl >=3.1.5,<3.2.0\n        - python-dotenv >=1.2.2,<2\n        - pyjwt >=2.9.0,<3\n        - textual >=7.5.0\n        - click >=8.1.7,<8.2.0\n        - appdirs >=1.4.4,<1.5.0\n        - jsonref >=1.1.0,<1.2.0\n        - json-repair >=0.25.2,<0.26.0\n        - tomli-w >=1.1.0,<1.2.0\n        - tomli >=2.0.2,<2.1.0\n        - json5 >=0.10.0,<0.11.0\n        - portalocker >=2.7.0,<2.8.0\n        - pydantic-settings >=2.10.1,<2.11.0\n        - httpx >=0.28.1,<0.29.0\n        - mcp >=1.26.0,<1.27.0\n        - uv >=0.11.6,<0.12.0\n        - aiosqlite >=0.21.0,<0.22.0\n        - pyyaml >=6.0,<7.0\n        - aiofiles >=24.1.0,<24.2.0\n        - lancedb >=0.29.2,<0.30.1\n    tests:\n      - python:\n          imports:\n            - crewai\n          pip_check: false\n          python_version: ${{ python_min }}.*\n      - script:\n          - crewai --help\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n    about:\n      summary: Cutting-edge framework for orchestrating role-playing, autonomous AI agents. By fostering collaborative intelligence, CrewAI empowers agents to work together seamlessly, tackling complex tasks.\n      license: MIT\n      license_file: LICENSE\n      homepage: https://github.com/crewAIInc/crewAI\n\n  - package:\n      name: crewai-tools\n      version: ${{ version }}\n    source:\n      - url: https://pypi.org/packages/source/c/crewai_tools/crewai_tools-${{ version }}.tar.gz\n        sha256: fe257e63a6fbc80f834543e033b2e5799446e32d471177397496d44d73a5a7d6\n    build:\n      noarch: python\n      skip:\n        - win\n      script: |\n        pip install . -vv --no-deps --no-build-isolation\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - hatchling\n        - pip\n      run:\n        - python >=${{ python_min }},<3.14\n        - ${{ pin_subpackage('crewai', exact=True) }}\n        - pytube >=15.0.0,<15.1.0\n        - requests >=2.33.0,<3\n        - tiktoken >=0.8.0,<0.13\n        - beautifulsoup4 >=4.13.4,<4.14.0\n        - python-docx >=1.2.0,<1.3.0\n        - youtube-transcript-api >=1.2.2,<1.3.0\n        - pymupdf >=1.26.6,<1.27.0\n    tests:\n      - python:\n          imports:\n            - crewai\n          pip_check: false\n          python_version: ${{ python_min }}.*\n    about:\n      summary: Set of tools for the crewAI framework\n      license: MIT\n      license_file: LICENSE\n      homepage: https://github.com/crewAIInc/crewAI\n\n  - package:\n      name: crewai-files\n      version: ${{ version }}\n    source:\n      - url: https://pypi.org/packages/source/c/crewai-files/crewai_files-${{ version }}.tar.gz\n        sha256: 920f8368ce816846fc9b4bfbbea338771328991de5ddc9d63697e7e7d9b7deb0\n    build:\n      noarch: python\n      skip:\n        - win\n      script: |\n        pip install . -vv --no-deps --no-build-isolation\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - hatchling\n        - pip\n      run:\n        - python >=${{ python_min }},<3.14\n        - ${{ pin_subpackage('crewai', exact=True) }}\n        - pillow >=12.1.1,<12.2.0\n        - pypdf >=6.10.0,<6.11.0\n        - python-magic >=0.4.27\n        - aiocache >=0.12.3,<0.13.0\n        - aiofiles >=24.1.0,<24.2.0\n        - tinytag >=2.2.1,<2.3.0\n        - av >=13.0.0,<13.1.0\n    tests:\n      - python:\n          imports:\n            - crewai\n          pip_check: false\n          python_version: ${{ python_min }}.*\n    about:\n      summary: File handling utilities for CrewAI multimodal inputs\n      license: MIT\n      license_file: LICENSE\n      homepage: https://github.com/crewAIInc/crewAI\n\nabout:\n  summary: CrewAI framework and tools for orchestrating autonomous AI agents\n  license: MIT\n  license_file: LICENSE\n  homepage: https://github.com/crewAIInc/crewAI\n\nextra:\n  recipe-maintainers:\n    - soapy1\n",
