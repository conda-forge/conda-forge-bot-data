            "python 3.11.*",
            "pip",
            "poetry-core >=1.0.0"
          ],
          "run": [
            "python >=3.11",
            "pytest >=8.0.0",
            "rich >=12.0.0",
            "textual >=0.28.0",
            "syrupy ==4.8.0",
            "jinja2 >=3.0.0"
          ]
        },
