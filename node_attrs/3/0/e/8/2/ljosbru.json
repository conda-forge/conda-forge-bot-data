  "raw_meta_yaml": "context:\n  version: \"0.0.4\"\n\nrecipe:\n  name: ljosbru\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/pavelzw/ljosbru/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 89e16926b539063fd92d0bad9fd81d64ce283aacf547543e6b19b9d66da11b3a\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: ljosbru-encode\n      version: ${{ version }}\n\n    build:\n      script:\n        env:\n          CARGO_PROFILE_RELEASE_STRIP: symbols\n          CARGO_PROFILE_RELEASE_LTO: fat\n        content:\n          - if: unix\n            then:\n              - cargo auditable install --locked --no-track --bin ljosbru-encode --root ${{ PREFIX }} --path .\n            else:\n              - cargo auditable install --locked --no-track --bin ljosbru-encode --root %LIBRARY_PREFIX% --path .\n          - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\n    requirements:\n      build:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('c') }}\n        - ${{ compiler('rust') }}\n        - cargo-bundle-licenses\n        - cargo-auditable\n\n    tests:\n      - script: ljosbru-encode --help\n      - package_contents:\n          bin:\n            - ljosbru-encode\n          strict: true\n\n  - package:\n      name: ljosbru-decode\n      version: ${{ version }}\n\n    build:\n      script:\n        env:\n          CARGO_PROFILE_RELEASE_STRIP: symbols\n          CARGO_PROFILE_RELEASE_LTO: fat\n        content:\n          - if: unix\n            then:\n              - cargo auditable install --locked --no-track --bin ljosbru-decode --features decode --root ${{ PREFIX }} --path .\n            else:\n              - cargo auditable install --locked --no-track --bin ljosbru-decode --features decode --root %LIBRARY_PREFIX% --path .\n          - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\n    requirements:\n      build:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('c') }}\n        - ${{ compiler('rust') }}\n        - cargo-bundle-licenses\n        - cargo-auditable\n        - if: linux\n          then:\n            - pkg-config\n      host:\n        - if: linux\n          then:\n            - wayland\n            - libegl-devel\n            - libgbm\n            - libxcb\n\n    tests:\n      - script: ljosbru-decode --help\n      - package_contents:\n          bin:\n            - ljosbru-decode\n          strict: true\n\nabout:\n  homepage: https://github.com/pavelzw/ljosbru\n  summary: Transfer data through QR codes\n  description: |\n    ljosbru turns an input file into a numbered sequence of QR PNGs and can later decode that sequence from screenshots of a monitor. It is useful when the only available path between two machines is a screen and an automated screenshot loop.\n  license: BSD-3-Clause\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://github.com/pavelzw/ljosbru\n  repository: https://github.com/pavelzw/ljosbru\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
