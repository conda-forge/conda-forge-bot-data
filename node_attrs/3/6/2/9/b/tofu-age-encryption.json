  "linux_64_meta_yaml": {
    "about": {
      "description": "OpenTofu encrypts state with a symmetric key derived from a shared passphrase\nthat every operator must share and rotate together.\nThis project replaces that workflow with age's asymmetric key pairs so operators\ncan keep private keys, specify their own recipients,\nand rotate access without redistributing a secret.",
      "dev_url": "https://github.com/josh/tofu-age-encryption",
      "doc_url": "https://github.com/josh/tofu-age-encryption",
      "home": "https://github.com/josh/tofu-age-encryption",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "src/LICENSE",
      "summary": "Encrypt OpenTofu state data with age encryption keys"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src",
        "go-licenses save . --save_path ../library_licenses",
        "go build -v -o $PREFIX/bin/tofu-age-encryption -ldflags=\"-s -w\""
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "brycekbargar"
      ]
    },
    "outputs": [
