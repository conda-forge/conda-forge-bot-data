  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: roboverse-py\n  # The latest version available on PyPI (0.1.17) has excessive dependency\n  # version pinning, which includes optional dependencies as required ones.\n  # The latest commit has more relaxed dependency constraints, so use that\n  # commit as the source and version it as 0.1.17.99 until a new release exists.\n  version: \"0.1.17.99\"\n  commit: 47b3ebfd55e96117ec2ee4000b6a6a8f6018c182\n  python_min: \"3.10\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  # TODO: Change URL to PyPI once a new version is available.\n  # https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/roboverse_py-${{ version }}.tar.gz\n  url: https://github.com/RoboVerseOrg/RoboVerse/archive/${{ commit }}.tar.gz\n  sha256: d850f5a8fa5cacbe146a3913d0facc47d668cff5f5eefd9c1ada4003efd5a92c\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - setuptools\n  run:\n    - dm-control\n    - fsspec\n    - gymnasium\n    - huggingface_hub\n    - imageio\n    - imageio-ffmpeg\n    - loguru\n    - mujoco-python\n    - numpy <2\n    - py-opencv\n    - pybullet\n    - python >=${{ python_min }},<3.11\n    - pytorch\n    - rich\n    - rootutils\n    - torchvision\n    - tqdm\n    - tyro\n\ntests:\n  - script:\n      - pip check\n      - python -c \"import metasim\"\n      - python run_test.py\n    files:\n      recipe:\n        - run_test.py\n    requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n        - pytorch * cpu*\n        - torchvision * cpu*\n\nabout:\n  homepage: https://github.com/RoboVerseOrg/RoboVerse\n  repository: https://github.com/RoboVerseOrg/RoboVerse\n  summary: Towards a Unified Platform, Dataset and Benchmark for Scalable and Generalizable Robot Learning\n  license: Apache-2.0\n  license_file: LICENSE\n\nextra: