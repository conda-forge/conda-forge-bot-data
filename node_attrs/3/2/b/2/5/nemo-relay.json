  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.6.0\"\n\nrecipe:\n  name: nemo-relay\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/NVIDIA/NeMo-Relay/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 17e16753696a8319835ebfa7a98cd7b8dd2b27f7d893f16c2a385d8d7c13205e\n\nbuild:\n  number: 0\n\noutputs:\n  - staging:\n      name: nemo-relay-build\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('rust') }}\n        - ${{ stdlib('c') }}\n        - brush\n        - cargo-auditable\n        - cargo-bundle-licenses\n        - pkg-config\n    build:\n      script:\n        interpreter: brush\n        env:\n          CARGO_PROFILE_RELEASE_STRIP: symbols\n          CARGO_PROFILE_RELEASE_LTO: fat\n        content:\n          - |\n            if [[ \"${build_platform:-}\" != \"${target_platform:-}\" ]]; then\n              export RUSTFLAGS=\"-C link-self-contained=no ${RUSTFLAGS:-}\"\n            fi\n            # lld is not available in the ppc64le cross-compilation sysroot,\n            # so fall back to the native linker (bfd) for this target only.\n            if [[ \"${target_platform:-}\" == \"linux-ppc64le\" ]]; then\n              export RUSTFLAGS=\"-C link-arg=-fuse-ld=bfd ${RUSTFLAGS:-}\"\n            fi\n            pushd crates/cli\n            cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n            popd\n            pushd crates/ffi\n            cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n            popd\n            cargo auditable build --release --locked -p nemo-relay-cli -p nemo-relay-ffi\n            \n            # Resolve Cargo target and release directories\n            target_root=\"${CARGO_TARGET_DIR:-target}\"\n            release_dir=\"${target_root}/release\"\n            if [[ -n \"${CARGO_BUILD_TARGET:-}\" ]]; then\n              release_dir=\"${target_root}/${CARGO_BUILD_TARGET}/release\"\n            fi\n            export NEMO_RELEASE_DIR=\"${release_dir}\"\n          \n          - if: unix\n            then: |\n              mkdir -p ${PREFIX}/bin ${PREFIX}/lib ${PREFIX}/include\n              cp \"${NEMO_RELEASE_DIR}/nemo-relay\" ${PREFIX}/bin/\n              cp \"${NEMO_RELEASE_DIR}\"/libnemo_relay_ffi.* ${PREFIX}/lib/\n              cp crates/ffi/*.h ${PREFIX}/include/\n          \n          - if: win\n            then: |\n              mkdir -p ${PREFIX}/bin/ ${LIBRARY_BIN} ${LIBRARY_LIB} ${LIBRARY_INC}\n              cp \"${NEMO_RELEASE_DIR}/nemo-relay.exe\" ${PREFIX}/bin/\n              cp \"${NEMO_RELEASE_DIR}/nemo_relay_ffi.dll\" ${LIBRARY_BIN}\n              cp \"${NEMO_RELEASE_DIR}/nemo_relay_ffi.dll.lib\" ${LIBRARY_LIB}\n              cp \"${NEMO_RELEASE_DIR}/nemo_relay_ffi.lib\" ${LIBRARY_LIB}\n              cp crates/ffi/*.h ${LIBRARY_INC}\n\n  - package:\n      name: nemo-relay-cli\n    inherit: nemo-relay-build\n    build:\n      files:\n        - bin/nemo-relay${{ \".exe\" if win }}\n    tests:\n      - package_contents:\n          bin:\n            - nemo-relay\n        strict: true\n      - script:\n          - nemo-relay --version\n          - nemo-relay --help\n    about:\n      summary: NeMo Relay CLI\n      license: Apache-2.0\n      license_file:\n        - ${{ SRC_DIR }}/LICENSE\n        - ${{ SRC_DIR }}/crates/cli/THIRDPARTY.yml\n\n  - package:\n      name: nemo-relay-ffi\n    inherit: nemo-relay-build\n    build:\n      files:\n        - if: unix\n          then:\n            - lib/libnemo_relay_ffi.*\n            - include/*.h\n        - if: win\n          then:\n            - Library/bin/nemo_relay_ffi.*\n            - Library/lib/nemo_relay_ffi.*\n            - Library/include/*.h\n    requirements:\n      run_exports:\n        - ${{ pin_subpackage(\"nemo-relay-ffi\", upper_bound=\"x.x.x\") }}\n    tests:\n      - package_contents:\n          lib:\n            - nemo_relay_ffi\n            - if: unix\n              then:\n                - libnemo_relay_ffi.a\n            - if: win\n              then:\n                - nemo_relay_ffi.dll.lib\n          include:\n            - nemo_relay.h\n        strict: true\n    about:\n      summary: C ABI FFI library for NeMo Relay\n      license: Apache-2.0\n      license_file:\n        - ${{ SRC_DIR }}/LICENSE\n        - ${{ SRC_DIR }}/crates/ffi/THIRDPARTY.yml\n\n  - package:\n      name: python-nemo-relay\n    build:\n      skip: match(python, \"<3.11\")\n      script:\n        interpreter: brush\n        content: |\n          export PYO3_PYTHON=\"${PYTHON}\"\n          pushd crates/python\n          cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n          popd\n          maturin build --release --manifest-path crates/python/Cargo.toml --out ${SRC_DIR}/dist --interpreter ${PYTHON}\n          ${PYTHON} -m pip install ${SRC_DIR}/dist/*.whl --no-deps --no-build-isolation -vv\n    requirements:\n      build:\n        - ${{ compiler('rust') }}\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - brush\n        - cargo-bundle-licenses\n        - if: build_platform != target_platform\n          then:\n            - cross-python_${{ target_platform }}\n            - maturin >=1.0,<2\n            - python\n      host:\n        - maturin >=1.0,<2.0\n        - pip\n        - python\n      run:\n        - python\n    tests:\n      - python:\n          imports:\n            - nemo_relay\n          pip_check: true\n          python_version: ${{ python }}\n    about:\n      summary: Python bindings for NeMo Relay\n      license: Apache-2.0\n      license_file:\n        - ${{ SRC_DIR }}/LICENSE\n        - ${{ SRC_DIR }}/crates/python/THIRDPARTY.yml\n\nabout:\n  homepage: https://docs.nvidia.com/nemo/relay\n  repository: https://github.com/NVIDIA/NeMo-Relay\n  documentation: https://docs.nvidia.com/nemo/relay\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n  summary: Multi-language agent runtime and library for execution scope management, lifecycle events, and middleware on tool and LLM calls.\n  description: |\n    NVIDIA NeMo Relay provides visibility into and control over agent runs without\n    requiring changes to the existing agent stack. It gives coding agents,\n    applications, framework integrations, middleware, and observability backends a\n    shared runtime for scopes, policy, plugins, and lifecycle events.\n\n    For how Relay complements OpenTelemetry GenAI conventions and observability or\n    evaluation products, see [the Ecosystem guide](https://docs.nvidia.com/nemo/relay/about-nemo-relay/ecosystem).\n\nextra:\n  recipe-maintainers:\n    - eunos-1128\n",
