  "raw_meta_yaml": "{% set python_min = '3.11' %}\n{% set name = \"smee\" %}\n{% set version = \"0.17.0\" %}\n\npackage:\n  name: {{ name|lower }}-split\n  version: {{ version }}\n\nsource:\n  url: https://github.com/openforcefield/smee/archive/{{ version }}.tar.gz\n  sha256: 5ec61e50b4e3f3839221780715d8219c56ed60ee67f5db6e430f8beb6ceeef28\n\nbuild:\n  number: 1\n\noutputs:\n  - name: {{ name|lower }}-base\n    script: build_base.sh\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python {{ python_min }}\n        - pip\n        - setuptools >=61.0\n        - setuptools_scm >=8\n      run:\n        - python >={{ python_min }}\n        - openff-units\n        - openff-toolkit-base >=0.9.2\n        - openff-interchange-base >=0.3.17\n        - pytorch  # [unix]\n        - __unix  # [unix]\n    test:\n      requires:\n        - python {{ python_min }}\n      imports:\n        - smee\n\n  - name: {{ name|lower }}\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - python >={{ python_min }}\n        - {{ pin_subpackage('smee-base', exact=True) }}\n        # md simulations\n        - openmm\n        - packmol\n        - numpy\n        - msgpack-python\n        - pydantic\n        - pydantic-units\n        # included for convenience so that the openff toolkit can\n        # parameterize molecules without needing extra installs\n        - rdkit\n        - __unix  # [unix]\n        - nnpops\n    test:\n      requires:\n        - python {{ python_min }}\n      imports:\n        - smee\n\nabout:\n  home: https://github.com/openforcefield/smee\n  summary: 'Differentiably evaluate energies using SMIRNOFF force fields'\n  description: |\n    A framework that aims to offer a simple API for differentiably evaluating \n    the energy of SMIRNOFF force fields applied to molecules using pytorch.\n  license: MIT\n  license_file:\n    - LICENSE\n  doc_url: https://github.com/openforcefield/smee\n  dev_url: https://github.com/openforcefield/smee\n\nextra:\n  recipe-maintainers:\n    - SimonBoothroyd\n    - j-wags\n    - lilyminium\n    - mattwthompson\n    - Yoshanuikabundi\n    - fjclark\n",
