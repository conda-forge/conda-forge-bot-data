  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.3.2\"\n  py_cffi_min: \"1.17.1\"\n  # test\n  python_check_max: \"3.14\"\n  abi3_ext: ${{ \"pyd\" if win else \"abi3.so\" }}\n  unix_sp_dir: |-\n    $(python -c \"print(__import__('site').getsitepackages()[-1])\")/moocore\n  win_sp_dir: |-\n    Lib\\site-packages\\moocore\n  sp_dir: |-\n    ${{ \"%PREFIX%\\\\\" ~ win_sp_dir if win else unix_sp_dir }}\n\nrecipe:\n  name: moocore\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/multi-objective/moocore/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 5047868830dabc7cb96063db294f27e7887593b299108f3bc2edf5ef4d0f9a15\n\nbuild:\n  number: 0\n\noutputs:\n  # TODO?\n  # - package:\n  #    name: libmoocore\n  # - package:\n  #    name: r-moocore\n  - package:\n      name: python-moocore\n    build:\n      skip: is_abi3 and not is_python_min\n      python:\n        version_independent: ${{ is_abi3 }}\n      script:\n        # replace a symlink from `python/src/moocore/libmoocore` to `c` (which also has a symlink) that confuses `cl.exe`\n        - ${{ PYTHON }} -c \"import os, shutil; d = 'python/src/moocore/libmoocore'; [os.unlink(p) for p in [d, 'c/COPYRIGHTS', 'c/LICENSE']]; shutil.copytree('c', d)\"\n        - cd python\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n    requirements:\n      build:\n        - ${{ compiler(\"c\") }}\n        - ${{ compiler(\"cxx\") }}\n        - ${{ stdlib(\"c\") }}\n      host:\n        - cffi >=${{ py_cffi_min }}\n        - pip\n        - python\n        - setuptools >=77.0.3\n        - wheel\n        - if: is_abi3\n          then:\n            - python-abi3\n      run:\n        - cffi >=${{ py_cffi_min }}\n        - numpy >=1.24\n        - platformdirs\n        - python\n    tests:\n      - if: is_abi3\n        then:\n          - python:\n              imports: moocore\n              pip_check: true\n              python_version:\n                - ${{ python_min }}.*\n                - ${{ python_check_max }}.*\n        else:\n          - python:\n              imports: moocore\n              pip_check: true\n      - files:\n          recipe:\n            - python_moocore_tests.py\n        requirements:\n          run:\n            - pandas >=2\n            - pytest-cov\n            - if: is_abi3\n              then:\n                - python ${{ python_check_max }}.*\n                - abi3audit\n        script:\n          - python python_moocore_tests.py\n          - if: is_abi3\n            then:\n              - cd ${{ sp_dir }}\n              - abi3audit -s -v --assume-minimum-abi3 ${{ python_min }} _libmoocore.${{ abi3_ext }}\n    about:\n      license_file:\n        - COPYRIGHTS\n        - LICENSE\n      homepage: https://pypi.org/project/moocore\n      repository: https://github.com/multi-objective/moocore\n      documentation: https://multi-objective.github.io/moocore/python\n\nabout:\n  summary: Core Algorithms for Multi-Objective Optimization\n  license: LGPL-2.1-or-later\n  license_file:\n    - COPYRIGHTS\n    - LICENSE\n  homepage: https://multi-objective.github.io/moocore\n  repository: https://github.com/multi-objective/moocore\n\nextra:\n  feedstock-name: moocore\n  recipe-maintainers:\n    - bollwyvl\n",
