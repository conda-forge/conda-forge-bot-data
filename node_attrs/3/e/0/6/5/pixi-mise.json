    "about": {
      "description": "Pixi extension (`pixi mise …`) that resolves and installs GitHub release\nbinaries into Pixi-managed local or global environments, with mise-like\nasset matching and a lockfile for reproducible installs.",
      "dev_url": "https://github.com/amirhosseindavoody/pixi-mise",
      "home": "https://github.com/amirhosseindavoody/pixi-mise",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Install GitHub release binaries into Pixi environments (Pixi extension)"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "amirhosseindavoody"
