  "linux_64_meta_yaml": {
    "about": {
      "description": "Mecatl is an open source, cloud-native agent harness. It provides the\nloop, tools, permissions, hooks, delegation, and service boundaries for\nrunning AI agents as production workloads on infrastructure you operate.\n\nThis package installs mecated (the server) and mecatui (the terminal\nclient), matching the project's official Homebrew formula. Other\nbinaries in the repository (mecak8s, mecatequi, mecademo) are not\nincluded; see the upstream README for building those from source.",
      "dev_url": "https://github.com/stacklok/mecatl",
      "doc_url": "https://mecatl.dev/docs",
      "home": "https://github.com/stacklok/mecatl",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "src/LICENSE",
      "summary": "Open source, cloud-native agent harness (server + terminal client)"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src",
        "go-licenses save ./cmd/mecated ./cmd/mecatui --save_path ../library_licenses --ignore github.com/stacklok/mecatl --ignore github.com/segmentio/asm --ignore go.opentelemetry.io/otel/exporters/jaeger",
        "go build -v -o $PREFIX/bin/mecated -ldflags=\"-s -w\" ./cmd/mecated",
        "go build -v -o $PREFIX/bin/mecatui -ldflags=\"-s -w\" ./cmd/mecatui"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "keponk"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "mecatl",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": "mecated --help"
          },
          {
            "script": "mecatui --help"
          },
