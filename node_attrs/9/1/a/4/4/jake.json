  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"3.1.0\"\n  python_check_max: \"3.14\"\n\npackage:\n  name: jake\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/j/jake/jake-${{ version }}.tar.gz\n  sha256: 5122b30cbb925f540519f3be53b2a7c641210e4b90294331656ef655825da87b\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n    - ${{ PYTHON }} -c \"(__import__('pathlib').Path(__import__('site').getsitepackages()[0]) / 'LICENSE').unlink()\"\n  python:\n    entry_points:\n      - jake = jake.app:main\n\nrequirements:\n  host:\n    - pip\n    - poetry-core >=1.0.0,<2\n    - python ${{ python_min }}.*\n  run:\n    - python >=${{ python_min }}\n    # these get translated from ~^ to concrete values in poetry-generated setup.py\n    - cyclonedx-bom >=3.0.0,<4.0.0\n    - ossindex-lib >=1.0.0,<2.0.0\n    - polling2 >=0.5.0,<0.6.0\n    - pyfiglet >=0.8.post1,<2.0.0\n    - requests >=2.32.4,<3.0.0\n    - rich >=10.10.0\n    # some tight pin above needs `pkg_resources`\n    - setuptools <82\n\ntests:\n  - python:\n      imports:\n        - jake\n        - jake.app\n      pip_check: true\n      python_version:\n        - ${{ python_min }}\n        - ${{ python_check_max }}.*\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - jake --version\n      - jake --help\n      - conda list --explicit | jake sbom -t CONDA\n\nabout:\n  summary: An OSS Index integration to check for vulnerabilities in your Conda environments\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://pypi.org/project/jake\n  repository: https://github.com/sonatype-nexus-community/jake\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n",
