      "description": "nokap captures screenshots and PDFs from web pages or local HTML using\nheadless Chrome via the Chrome DevTools Protocol. It communicates directly\nwith Chrome over WebSockets and does not require Selenium or Playwright.",
      "dev_url": "https://github.com/posit-dev/nokap",
      "doc_url": "https://posit-dev.github.io/nokap/",
      "home": "https://github.com/posit-dev/nokap",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Capture screenshots and PDFs from web pages using headless Chrome via CDP"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": {
        "content": "python -m pip install . -vv --no-deps --no-build-isolation --no-index --use-deprecated=legacy-certs",
        "env": {
          "PYTHONHASHSEED": "1",
          "SETUPTOOLS_SCM_PRETEND_VERSION": "0.1.0"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "rich-iannone",
        "timkpaine"
      ]
    },
