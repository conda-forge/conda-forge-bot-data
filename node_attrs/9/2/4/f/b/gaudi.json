    "build": {
      "number": "0",
      "run_exports": {
        "weak": [
          "gaudi"
        ]
      },
      "script": [
        "cmake ${CMAKE_ARGS} \\\n    -GNinja \\\n    -DCMAKE_BUILD_TYPE=Release \\\n    -DCMAKE_INSTALL_PREFIX=$PREFIX \\\n    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \\\n    -DCMAKE_CXX_SCAN_FOR_MODULES=OFF \\\n    -DBUILD_SHARED_LIBS=ON \\\n    -DGAUDI_INSTALL_PYTHONDIR=$SP_DIR \\\n    -DGAUDI_DEFAULT_PLUGIN_PATH=$PREFIX/lib \\\n    -DPython_EXECUTABLE=$PYTHON \\\n    -DGAUDI_USE_DOXYGEN=OFF \\\n    -S $SRC_DIR \\\n    -B build\ncmake --build build --parallel ${CPU_COUNT}\n",
        "which ps",
        "ctest --output-on-failure -E 'cmake\\.test_dummyGaudiDownstreamProject|whiteboard\\.test_bug_cfhep114' --repeat until-pass:3 -j${CPU_COUNT} --test-dir build",
        "cmake --install build",
        "root -l -b -q -e 'if (TClass::GetClass(\"DataObject\") == nullptr) { std::cerr << \"Failed to load DataObject\" << std::endl; return 1; } return 0;'"
      ]
    },
