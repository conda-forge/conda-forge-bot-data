  "raw_meta_yaml": "---\nschema_version: 1\n\ncontext:\n  version: \"0.1.6\"\n  release_hash: \"ed86a942ee86ba26ec33e8e0cc4dd4f7563674d9df7ce632651425499c7a0d93\"\n  dev_version: ${{ env.get('PIXI_PROJECT_VERSION') if env.exists('PIXI_PROJECT_VERSION') else '0.0.0.dev' }}\n  is_dev: ${{ env.exists('_CONDA_BUILD_LOCAL') }}\n\npackage:\n  name: \"chlibc\"\n  version: ${{ version }}\n\nsource:\n  - if: is_dev\n    then:\n      path: ..\n  - if: not is_dev\n    then:\n      # use the source archive with checksum.txt\n      url: https://github.com/gzm55/chlibc/releases/download/v${{ version }}/source.tar.gz\n      sha256: ${{ release_hash }}\n\nbuild:\n  skip: ${{ target_platform not in [\"linux-64\", \"linux-aarch64\", \"linux-ppc64le\"] }}\n  number: 0\n  dynamic_linking:\n    binary_relocation: false\n    rpath_allowlist: []\n  script:\n    content: |\n      {% if target_platform in [\"linux-64\", \"linux-aarch64\"] %}\n      unset CFLAGS\n      unset LDFLAGS\n      {% endif %}\n\n      unset LD_RUN_PATH\n      env\n\n      cmake --fresh --preset conda-build ${CMAKE_ARGS} -U CMAKE_LINKER -U CMAKE_STRIP\n      cmake --build --preset conda-build --parallel ${CPU_COUNT}\n      cmake --install build/conda-build\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n\n    - cmake >=4.2\n    - ninja\n\n    - if: target_platform in [\"linux-64\", \"linux-aarch64\"]\n      then: compiler-rt_${{ target_platform }}\n    - if: target_platform in [\"linux-64\", \"linux-aarch64\"]\n      then: lld\n    - if: target_platform in [\"linux-64\", \"linux-aarch64\"]\n      then: llvm-tools\n    - if: target_platform in [\"linux-64\", \"linux-aarch64\"]\n      then: clang-tools\n  host:\n  run:\n    - __glibc\n\n  ignore_run_exports:\n    from_package:\n      - ${{ compiler('c') }}  # do not depend on libgcc\n      - ${{ stdlib('c') }}  # do not introduce __glibc version limit\n\ntests:\n  - script:\n      - file $PREFIX/bin/chlibc\n      - sha256sum $PREFIX/bin/chlibc\n      - if: build_platform == target_platform\n        then: $PREFIX/bin/chlibc\n    requirements:\n      build:\n        - file\n        - coreutils\n        - zstd\n\n  - if: not is_dev\n    then:\n      script:\n        - echo Verifying the binary checksum\n        - |\n          case ${{ target_platform }} in\n            linux-64)      NATIVE_ARCH=\"x86_64\" ;;\n            linux-aarch64) NATIVE_ARCH=\"aarch64\" ;;\n            linux-ppc64le) NATIVE_ARCH=\"ppc64le\" ;;\n            *)             NATIVE_ARCH=\"unknown\" ;;\n          esac\n        - EXPECTED_HASH=$(grep \"chlibc-$NATIVE_ARCH\" checksum.txt | awk '{print $1}')\n        - echo \"Expected hash $EXPECTED_HASH\"\n        - echo \"$EXPECTED_HASH  $PREFIX/bin/chlibc\" | sha256sum -c\n      files:\n        source:\n          - checksum.txt\n\nabout:\n  summary: 'A userspace transparent ld-linux interpreter and glibc swapper.'\n  license: MIT\n  license_file: LICENSE\n  homepage: https://github.com/gzm55/chlibc\n\nextra:\n  recipe-maintainers:\n    - gzm55\n",
