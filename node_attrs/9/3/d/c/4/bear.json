  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: bear\n  version: \"4.1.3\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/rizsotto/Bear/archive/refs/tags/${{ version }}.tar.gz\n    sha256: 87a5b385b01000a3ae2c69f535384dca33da7f23925a523ba177f98b1bb7f301\n\nbuild:\n  number: 0\n  script:\n    - cargo auditable build --release --locked\n    - if: win\n      then: |\n        if not exist %LIBRARY_PREFIX%\\libexec\\bear\\bin mkdir %LIBRARY_PREFIX%\\libexec\\bear\\bin\n        echo F | xcopy target\\%CARGO_BUILD_TARGET%\\release\\bear-driver.exe %LIBRARY_PREFIX%\\libexec\\bear\\bin\\bear-driver.exe /F /Y\n        if %ERRORLEVEL% neq 0 exit 1\n        echo F | xcopy target\\%CARGO_BUILD_TARGET%\\release\\bear-wrapper.exe %LIBRARY_PREFIX%\\libexec\\bear\\bin\\bear-wrapper.exe /F /Y\n        if %ERRORLEVEL% neq 0 exit 1\n        if not exist %LIBRARY_PREFIX%\\share\\man mkdir %LIBRARY_PREFIX%\\share\\man\n        echo F | xcopy man\\bear.1 %LIBRARY_PREFIX%\\share\\man\\bear.1 /F /Y\n        if %ERRORLEVEL% neq 0 exit 1\n        if not exist %LIBRARY_PREFIX%\\share\\doc\\bear mkdir %LIBRARY_PREFIX%\\share\\doc\\bear\n        echo F | xcopy README.md %LIBRARY_PREFIX%\\share\\doc\\bear\\README.md /F /Y\n        if %ERRORLEVEL% neq 0 exit 1\n        echo F | xcopy COPYING %LIBRARY_PREFIX%\\share\\doc\\bear\\COPYING /F /Y\n        if %ERRORLEVEL% neq 0 exit 1\n        if not exist %LIBRARY_BIN% mkdir %LIBRARY_BIN%\n        echo F | xcopy %RECIPE_DIR%\\bear.cmd %LIBRARY_BIN%\\bear.cmd /F /Y\n        if %ERRORLEVEL% neq 0 exit 1\n      else: |\n        rm -rf target/release\n        mv target/${CARGO_BUILD_TARGET}/release target/release\n        unset CARGO_BUILD_TARGET\n        cargo run --bin generate-completions target/release/completions --target ${BUILD}\n        PREFIX=$PREFIX scripts/install.sh\n        cp $RECIPE_DIR/bear.sh $PREFIX/bin/bear\n        chmod +x $PREFIX/bin/bear\n    - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ compiler(\"rust\") }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - if: linux\n      then: lld\n\ntests:\n  - package_contents:\n      bin:\n        - bear\n      files:\n        - if: win\n          then:\n            - Library\\libexec\\bear\\bin\\bear-driver.exe\n            - Library\\libexec\\bear\\bin\\bear-wrapper.exe\n          else:\n            - libexec/bear/bin/bear-driver\n            - libexec/bear/bin/bear-wrapper\n        - if: osx\n          then: libexec/bear/lib/libexec.dylib\n        - if: linux\n          then: libexec/bear/lib/libexec.so\n  - if: build_platform == target_platform\n    then:\n      script:\n        - bear -V\n        - bear -- make --version\n        - if: win\n          then: type compile_commands.json\n          else: test -f compile_commands.json\n      requirements:\n        run:\n          - make\n\nabout:\n  homepage: https://github.com/rizsotto/Bear\n  license: GPL-3.0-or-later\n  license_file:\n    - COPYING\n    - THIRDPARTY.yml\n  summary: A tool that generates a compilation database for clang tooling\n  description: A tool that generates a compilation database for clang tooling.\n  repository: https://github.com/rizsotto/Bear\n\nextra:\n  recipe-maintainers:\n    - chawyehsu\n    - mwittgen\n    - h-vetinari\n    - lindsayad\n",
