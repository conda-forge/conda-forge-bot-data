  "raw_meta_yaml": "{% set name = \"pyvkfft\" %}\n{% set version = \"2025.1.1\" %}\n\n# cuda_compiler_version is always defined by the CI matrix (.ci_support/*.yaml\n# files, either as a CUDA version or \"None\"), so it does not need to be set here.\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}/pyvkfft-{{ version }}.tar.gz\n  sha256: 359648e089cac0e3c82fc685dc7b8a9e1a249b338dcd7c94677d68207c9842bb\n  patches:\n    - conda_libraries.diff\n\nbuild:\n  number: 1\n  entry_points:\n    - pyvkfft-test = pyvkfft.scripts.pyvkfft_test:main\n  script:\n    # CUDA 13 moved the win-64 import libraries to Library/lib/x64 to support\n    # cross-compiling, cuda-nvcc's activate.bat sets INCLUDE but never LIB, unlike its\n    # activate.sh counterpart, so the host prefix is missing from the link path.\n    # https://github.com/conda-forge/cuda-nvcc-feedstock/issues/47\n    - set \"LIB=%LIBRARY_LIB%\\x64;%LIB%\"      # [win and cuda_compiler_version != \"None\"]\n    - {{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  ignore_run_exports_from:\n    - cuda-nvrtc-dev                         # [cuda_compiler_version != \"None\"]\n  ignore_run_exports:\n    - cuda-version                           # [cuda_compiler_version != \"None\"]\n  missing_dso_whitelist:\n    # The CUDA driver must come from the system at runtime.\n    - \"*/libcuda.so.1\"                       # [linux and cuda_compiler_version != \"None\"]\n    # ocl-icd-system symlinks the system's copy at runtime.\n    - \"*/libOpenCL.so.1\"                     # [linux]\n\nrequirements:\n  build:\n    - python                                 # [build_platform != target_platform]\n    - cross-python_{{ target_platform }}     # [build_platform != target_platform]\n    - setuptools                             # [build_platform != target_platform]\n    - {{ compiler('c') }}\n    - {{ stdlib(\"c\") }}\n    - {{ compiler('cxx') }}\n    - {{ compiler('cuda') }}                 # [cuda_compiler_version != \"None\"]\n  host:\n    - pip\n    - python\n    - ocl-icd-system                        # [linux]\n    - khronos-opencl-icd-loader             # [win or osx]\n    - ocl_icd_wrapper_apple                 # [osx]\n    - cuda-version {{ cuda_compiler_version }}  # [cuda_compiler_version != \"None\"]\n    - cuda-nvrtc-dev                        # [cuda_compiler_version != \"None\"]\n    - setuptools\n  run:\n    - numpy\n    - psutil\n    - pyopencl\n    - python\n    - __cuda                                # [cuda_compiler_version != \"None\"]\n    - {{ pin_compatible('cuda-version', max_pin='x', min_pin='x') }}  # [cuda_compiler_version != \"None\"]\n    - cuda-nvrtc                            # [cuda_compiler_version != \"None\"]\n  run_constrained:\n    - __cuda <0.0a0                         # [cuda_compiler_version == \"None\"]\n\ntest:\n  imports:\n    - pyvkfft\n    - pyvkfft.base\n    - pyvkfft.test._test_opencl_lib\n    - pyvkfft.test._test_cuda_lib           # [cuda_compiler_version != \"None\"]\n#  commands:\n#    - pyvkfft-test --help\n\nabout:\n  home: https://github.com/vincefn/pyvkfft\n  summary: Python wrapper for the CUDA and OpenCL backends of VkFFT, providing GPU FFT for PyCUDA, PyOpenCL and CuPy\n  license: MIT\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - vincefn\n    - isuruf\n",
