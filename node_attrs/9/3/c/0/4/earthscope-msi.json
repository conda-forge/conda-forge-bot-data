  "raw_meta_yaml": "context:\n  version: \"4.2.4\"\n\npackage:\n  name: earthscope-msi\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/EarthScope/msi/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 3b7e7d3ec805fd3461c55ae64e72c43d1ba58d1855ab1af7d9755ceed2917c78\n\nbuild:\n  number: 0\n  # build.sh is a Unix shell script; EarthScope does not target Windows.\n  skip:\n    - win\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - make\n  host:\n    - libmseed\n\ntests:\n  - script:\n      - msi -V\n      - msi -h\n      # Confirm the build was compiled with URL-based read support.\n      # msi prints its usage to stderr, so redirect it before grepping.\n      - msi -h 2>&1 | grep -q \"URL-based reads\"\n\nabout:\n  homepage: https://github.com/EarthScope/msi\n  summary: miniSEED Inspector, a general purpose tool for parsing miniSEED records\n  description: |\n    msi (miniSEED Inspector) is a command-line tool for parsing, inspecting\n    and summarizing miniSEED formatted data records. It links the libmseed\n    library and can optionally read records directly from http(s) URLs.\n  license: Apache-2.0\n  license_file: LICENSE\n  repository: https://github.com/EarthScope/msi\n\nextra:\n  recipe-maintainers:\n    - omid-earthscope\n",
