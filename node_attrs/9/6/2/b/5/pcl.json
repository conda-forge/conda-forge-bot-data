  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: pcl\n  version: \"1.15.1\"\n  major_version: ${{ (version | split('.'))[0] }}\n  minor_version: ${{ (version | split('.'))[1] }}\n  sha256: e1d862c7b6bd27a45884a825a2e509bfcbd4561307d5bfe17ce5c8a3d94a6c29\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/pointcloudlibrary/${{ name }}/archive/${{ name }}-${{ version }}.tar.gz\n  sha256: ${{ sha256 }}\n  patches:\n    - 6354.patch\n    - 6394.patch\n    - 6412.patch\n    - 6456.patch\n    - boost-system-header-only.patch\n\nbuild:\n  number: 15\n\nrequirements:\n  build:\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - if: win\n      then: ninja\n    - if: unix\n      then: make\n    - pkgconfig\n    - if: build_platform != target_platform\n      then: qt6-main\n  host:\n    - if: linux\n      then: xorg-libxfixes\n    - if: linux\n      then: libgl-devel\n    - flann\n    - nanoflann\n    - eigen\n    - eigen-abi-devel\n    - libboost-devel\n    - if: win\n      then: tbb-devel\n    - qhull\n    - vtk\n    - libpng\n    - glew\n    - if: not ppc64le\n      then: qt6-main\n  run:\n    # These dependencies are required for find_package(PCL) to work, they can be moved to a pcl-devel package if that is created\n    - flann\n    - nanoflann\n    - qhull\n    - glew\n    - eigen\n    - libboost-devel\n    - vtk\n  run_exports:\n    - ${{ pin_subpackage('pcl', upper_bound='x.x.x') }}\n\ntests:\n  - requirements:\n      run:\n        - cmake-package-check\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n    script:\n      - if: not win\n        then: test -d $PREFIX/include/${{ name }}-${{ major_version }}.${{ minor_version }}/${{ name }}\n      - if: win\n        then: if not exist %LIBRARY_INC%\\\\${{ name }}-${{ major_version }}.${{ minor_version }}\\\\${{ name }} exit 1\n      - cmake-package-check PCL\n\nabout:\n  license: BSD-3-Clause\n  license_file: LICENSE.txt\n  summary: Point Cloud Library (PCL)\n  description: |\n    The Point Cloud Library (PCL) is a standalone, large scale, open project for 2D/3D image and point cloud processing.\n  homepage: http://www.pointclouds.org\n  repository: https://github.com/pointcloudlibrary/pcl\n  documentation: http://www.pointclouds.org\n\nextra:\n  recipe-maintainers:\n    - oursland\n    - chambbj\n    - hobu\n    - Tobias-Fischer\n    - traversaro\n",
