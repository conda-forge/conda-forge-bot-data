  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: precice\n  version: \"3.4.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/precice/precice/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 1155178da7271c404947d1ff64b6e5028a82575fd532baa26bd6418de5ef2623\n\nbuild:\n  number: 3\n  skip: win\n\nrequirements:\n  build:\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('fortran') }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - make\n    - pkgconfig\n    - python\n    - numpy\n  host:\n    - python\n    - libboost-devel\n    - eigen\n    - fmt\n    - libxml2-devel\n    - nlohmann_json\n    - numpy\n    - petsc\n    - ${{ mpi }}\n  run:\n    - python\n  run_exports:\n    - ${{ pin_subpackage('precice', upper_bound='x.x') }}\n\ntests:\n  - script:\n      - if: linux\n        then: test -f ${PREFIX}/lib/libprecice.so\n\nabout:\n  license: LGPL-3.0-or-later\n  license_file: LICENSE\n  summary: A coupling library for partitioned multi-physics simulations, including, but not restricted to fluid-structure interaction and conjugate heat transfer simulations.\n  description: |\n    preCICE stands for Precise Code Interaction Coupling Environment. Its\n    main component is a library that can be used by simulation programs\n    to be coupled together in a partitioned way, enabling multi-physics\n    simulations, such as fluid-structure interaction.\n  homepage: https://precice.org/\n  repository: https://github.com/precice/precice\n  documentation: https://precice.org/docs.html\n\nextra:\n  recipe-maintainers:\n    - IshaanDesai\n    - jan-janssen\n",
