  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.10.3\"\n  python_min: \"3.11\"\n  sdk_version: \"0.2.3\"\n\nrecipe:\n  name: langflow-suite\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/langflow-ai/langflow/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: f2da6699844a8f84dabd82a7bdf33410f1026f81543ca6750a9d0482b86933bd\n  # Langflow bundles a very large number of third-party integrations (IBM watsonx,\n  # MongoDB, ClickHouse, etc.) as hard dependencies by default. These patches strip\n  # out everything that isn't needed to import and run langflow. Nobody uses all of\n  # these integrations at once, so keeping them as hard deps would force every user\n  # to install a large set of heavy libraries/ecosystems they will likely never touch,\n  # which only grows the install footprint and blast radius for no benefit.\n  patches:\n    - patches/0001-strip-integration-deps.patch\n    - patches/0002-lean-umbrella-deps.patch\n\nbuild:\n  number: 1\n\noutputs:\n  - package:\n      name: langflow-sdk\n      version: ${{ sdk_version }}\n    build:\n      noarch: python\n      script:\n        - ${{ PYTHON }} -m pip install src/sdk -vv --no-deps --no-build-isolation\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling\n      run:\n        - python >=${{ python_min }},<3.15\n        - httpx\n        - h2\n        - pydantic-settings >=2.10.1\n        - pydantic >=2.0.0\n        - tomli >=2.2.1\n        - typing_extensions >=4.14.0\n    tests:\n      - python:\n          imports:\n            - langflow_sdk\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n\n  - package:\n      name: lfx\n      version: ${{ version }}\n    build:\n      noarch: python\n      script:\n        - ${{ PYTHON }} -m pip install src/lfx -vv --no-deps --no-build-isolation\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling\n      run:\n        - python >=${{ python_min }},<3.15\n        - langchain-core >=1.2.28,<2.0.0\n        - pandas >=2.0.0,<3.0.0\n        - pydantic >=2.0.0,<3.0.0\n        - pillow >=11.1.0,<13.0.0\n        - fastapi >=0.135.0,<1.0.0\n        - uvicorn >=0.34.3,<1.0.0\n        - typer >=0.16.0,<1.0.0\n        - platformdirs >=4.3.8,<5.0.0\n        - aiofiles >=24.1.0,<25.0.0\n        - typing_extensions >=4.14.0,<5.0.0\n        - python-dotenv >=1.0.0,<2.0.0\n        - rich >=13.0.0,<14.0.0\n        - httpx >=0.24.0,<1.0.0\n        - aiofile >=3.8.0,<4.0.0\n        - json-repair >=0.30.3,<1.0.0\n        - docstring_parser >=0.16,<1.0.0\n        - networkx >=3.4.2,<4.0.0\n        - nanoid >=2.0.0,<3.0.0\n        - cachetools >=6.0.0\n        - emoji >=2.14.1,<3.0.0\n        - chardet >=7.3.0\n        - defusedxml >=0.7.1,<1.0.0\n        - passlib >=1.7.4,<2.0.0\n        - pydantic-settings >=2.10.1,<3.0.0\n        - tomli >=2.2.1,<3.0.0\n        - pyyaml >=6.0.0,<7.0.0\n        - orjson >=3.11.6,<4.0.0\n        - asyncer >=0.0.8,<1.0.0\n        - structlog >=25.4.0,<26.0.0\n        - loguru >=0.7.3,<1.0.0\n        - langchain >=1.3.0,<1.4.0\n        - langchain-classic >=1.0.7,<1.1.0\n        - validators >=0.34.0,<1.0.0\n        - filelock >=3.20.1,<4.0.0\n        - pypdf >=6.10.0,<7.0.0\n        - cryptography >=48.0.1\n        - ag-ui-protocol >=0.1.10\n        - ${{ pin_subpackage('langflow-sdk', exact=True) }}\n        - markitdown >=0.1.4,<2.0.0\n        - setuptools >=80.0.0,<81.0.0\n        - wheel >=0.46.2,<1.0.0\n        - mcp >=1.17.0,<2.0.0\n      run_constraints:\n        - magika >=0.6.1,!=0.6.3,<0.7.0\n    tests:\n      - python:\n          imports:\n            - lfx\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n\n  - package:\n      name: langflow-base\n      version: ${{ version }}\n    build:\n      noarch: python\n      script:\n        - if: win\n          then: |\n            call npm --prefix src/frontend ci\n            if errorlevel 1 exit 1\n            call npm --prefix src/frontend run build\n            if errorlevel 1 exit 1\n            call npx --yes license-checker --production --start src/frontend --customPath %RECIPE_DIR%\\license-checker-format.json --json --out src/frontend/third-party-licenses.json\n            if errorlevel 1 exit 1\n          else: |\n            set -ex\n            npm --prefix src/frontend ci\n            npm --prefix src/frontend run build\n            npx --yes license-checker --production --start src/frontend --customPath \"$RECIPE_DIR/license-checker-format.json\" --json --out src/frontend/third-party-licenses.json\n        # The frontend build bundles code from hundreds of third-party npm packages into\n        # langflow/frontend/assets/*.js. license-checker collects each package's own license\n        # text (via --customPath) into a single JSON disclaimer, which is shipped as this\n        # output's license_file below alongside Langflow's own LICENSE.\n        - ${{ PYTHON }} -c \"import shutil; d='src/backend/base/langflow/frontend'; shutil.rmtree(d, ignore_errors=True); shutil.copytree('src/frontend/build', d)\"\n        - ${{ PYTHON }} -m pip install src/backend/base -vv --no-deps --no-build-isolation\n    requirements:\n      build:\n        - nodejs >=20.19.0\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling\n      run:\n        - python >=${{ python_min }},<3.15\n        - ${{ pin_subpackage('lfx', exact=True) }}\n        - fastapi >=0.135.0,<1.0.0\n        - slowapi >=0.1.9,<1.0.0\n        - httpx >=0.27,<1.0.0\n        - aiofile >=3.9.0,<4.0.0\n        - uvicorn >=0.30.0,<1.0.0\n        - langchain >=1.3.0,<1.4.0\n        - langchain-community >=0.4.1,<0.5.0\n        - langchain-weaviate >=0.0.6\n        - langchain-core >=1.3.3,<2.0.0\n        - langchainhub >=0.1.15,<0.2.0\n        - loguru >=0.7.1,<1.0.0\n        - structlog >=25.4.0,<26.0.0\n        - rich >=13.7.0,<14.0.0\n        - langchain-experimental >=0.4.1,<0.5.0\n        - sqlmodel >=0.0.37,<0.1.0\n        - pydantic >=2.13.0,<3.0.0\n        - pydantic-settings >=2.2.0,<3.0.0\n        - email-validator >=2.0.0\n        - typer >=0.13.0,<1.0.0\n        - cachetools >=6.0.0\n        - platformdirs >=4.2.0,<5.0.0\n        - python-multipart >=0.0.12,<1.0.0\n        - orjson >=3.11.6,<4.0.0\n        - alembic >=1.13.0,<2.0.0\n        - passlib >=1.7.4,<2.0.0\n        - bcrypt ==4.0.1\n        - pillow >=12.1.1,<13.0.0\n        - docstring_parser >=0.16,<1.0.0\n        - pyjwt >=2.12.1\n        - pandas >=2.2.3\n        - multiprocess >=0.70.14,<1.0.0\n        - python-docx >=1.1.0,<2.0.0\n        - nest-asyncio >=1.6.0,<2.0.0\n        - emoji >=2.12.0,<3.0.0\n        - cryptography >=48.0.1\n        - asyncer >=0.0.5,<1.0.0\n        - pyperclip >=1.8.2,<2.0.0\n        - uncurl >=0.0.11,<1.0.0\n        - sentry-sdk >=2.5.1,<3.0.0\n        - chardet >=7.3.0\n        - firecrawl >=1.0.16,<2.0.0\n        - opentelemetry-api >=1.30.0,<2.0.0\n        - opentelemetry-sdk >=1.30.0,<2.0.0\n        - opentelemetry-exporter-prometheus >=0.50b0,<1.0.0\n        - opentelemetry-exporter-otlp >=1.30.0,<2.0.0\n        - opentelemetry-instrumentation-fastapi >=0.50b0,<1.0.0\n        - opentelemetry-instrumentation-requests >=0.50b0,<1.0.0\n        - opentelemetry-instrumentation-urllib3 >=0.50b0,<1.0.0\n        - prometheus_client >=0.20.0,<1.0.0\n        - aiofiles >=24.1.0,<25.0.0\n        - pip >=26.0.0,<27.0.0\n        - setuptools >=80.0.0,<81.0.0\n        - nanoid >=2.0.0,<3.0.0\n        - filelock >=3.20.1,<4.0.0\n        - grandalf >=0.8.0,<1.0.0\n        - assemblyai >=0.33.0,<1.0.0\n        - fastapi-pagination >=0.13.1,<1.0.0\n        - defusedxml >=0.7.1,<1.0.0\n        - pypdf >=6.10.0,<7.0.0\n        - validators >=0.34.0,<1.0.0\n        - networkx >=3.4.2,<4.0.0\n        - json-repair >=0.30.3,<1.0.0\n        - mcp >=1.17.0,<2.0.0\n        - aiosqlite >=0.20.0,<1.0.0\n        - greenlet >=3.1.1,<4.0.0\n        - jsonquerylang >=1.1.1,<2.0.0\n        - sqlalchemy >=2.0.38,<3.0.0\n        - scipy >=1.15.2,<2.0.0\n        - jaraco.context >=6.1.0\n        - wheel >=0.46.2,<1.0.0\n        - dynaconf >=3.2.13,<4.0.0\n        - pyasn1 >=0.6.3,<0.7.0\n        - langgraph-checkpoint >4.0.0,<5.0.0\n      run_constraints:\n        - gunicorn >=25.3.0,<27.0.0\n        - langchain-mongodb >=0.11.0\n        - langchain-perplexity >=1.0.0,<2.0.0\n        - langchain-qdrant >=1.0.0,<2.0.0\n        - langchain-chroma >=0.2.6,<0.3.0\n        - elevenlabs >=1.52.0,<2.0.0\n        - clickhouse-connect ==0.7.19\n        - duckdb >=1.0.0,<2.0.0\n        - jq >=1.7.0,<2.0.0\n        - onnxruntime >=1.20\n        - transformers >=5.6.0,<6.0.0\n    tests:\n      - python:\n          imports:\n            - langflow\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n      - package_contents:\n          site_packages:\n            - langflow/frontend/index.html\n            - langflow/frontend/assets/*.js\n    about:\n      license_file:\n        - LICENSE\n        - src/frontend/third-party-licenses.json\n\n  - package:\n      name: langflow\n      version: ${{ version }}\n    build:\n      noarch: python\n      script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling\n      run:\n        - python >=${{ python_min }},<3.15\n        - ${{ pin_subpackage('langflow-base', exact=True) }}\n      run_constraints:\n        - fastmcp >=3.2.0\n        - lark ==1.2.2\n        - sseclient-py ==1.8.0\n        - litellm >=1.85.1,<2.0.0\n        - openai >=1.68.2,<3.0.0\n        - langchain-anthropic >=1.4.6,<1.5.0\n        - langchain-aws >=1.1.0,<1.2.0\n        - langchain-chroma >=0.2.6,<0.3.0\n        - langchain-experimental >=0.4.1,<0.5.0\n        - langchain-google-genai >=4.1.2,<4.2