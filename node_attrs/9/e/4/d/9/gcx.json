  "linux_64_meta_yaml": {
    "about": {
      "description": "gcx is a CLI for Grafana. It gives you and your AI coding agent structured access to your Grafana instance: dashboards, alerts, SLOs, metrics, logs, traces, and more.\n\ngcx works with any agentic coding tool. It ships with a suite of agent skills for common workflows like alert investigation, dashboard creation and GitOps, SLO management, and observability setup - ready to use out of the box.",
      "dev_url": "https://github.com/grafana/gcx",
      "doc_url": "https://pkg.go.dev/github.com/grafana/gcx",
      "home": "https://github.com/grafana/gcx",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "A CLI for managing Grafana Cloud resources. Optimized for agentic usage."
    },
    "build": {
      "number": "0",
      "script": [
        "go-licenses save ./cmd/gcx --ignore github.com/grafana/grafana/pkg/apimachinery --ignore github.com/grafana/grafana/apps/folder/pkg/apis/folder/v1beta1 --ignore github.com/mattn/go-localereader --ignore github.com/alecthomas/chroma/v2 --save_path ./library_licenses",
        "go build -v -o $PREFIX/bin/gcx -ldflags=\"-s -w\" ./cmd/gcx",
        "mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d",
        "$PREFIX/bin/gcx completion zsh > $PREFIX/share/zsh/site-functions/_gcx",
        "$PREFIX/bin/gcx completion bash > $PREFIX/share/bash-completion/completions/gcx",
        "$PREFIX/bin/gcx completion fish > $PREFIX/share/fish/vendor_completions.d/gcx.fish"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "rneacsu"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "gcx",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": "gcx --help"
          },
          {
            "package_contents": {
              "bin": [
                "gcx"
              ],
              "files": [
                "share/bash-completion/completions/gcx",
                "share/fish/vendor_completions.d/gcx.fish",
                "share/zsh/site-functions/_gcx"
              ],
              "strict": true
            }
          }
        ],
        "version": "1.0.0"
      }
    ],
    "package": {
      "name": "gcx",
      "version": "1.0.0"
    },
