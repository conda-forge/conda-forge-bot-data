  "raw_meta_yaml": "context:\n  version: \"1.0.0\"\n\npackage:\n  name: gcx\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/grafana/gcx/archive/v${{ version }}.tar.gz\n    sha256: e4095c1462a4f69eeb5ed356a13efe5b25b5041699d9ce7b06e38ba4b1c5627f\n  - url: https://github.com/grafana/grafana/raw/refs/heads/main/LICENSE\n    sha256: 0d96a4ff68ad6d4b6f1f30f713b18d5184912ba8dd389f86aa7710db079abcb0\n    target_directory: grafana-LICENSE\n  - url: https://github.com/alecthomas/chroma/raw/refs/heads/master/COPYING\n    sha256: 13654b052f885cb3fa47d7343e13975d9c8a64c3bcd84993c35d5eb01f22b23f\n    target_directory: chroma-LICENSE\n  - if: win\n    then:\n      - url: https://github.com/mattn/go-localereader/raw/refs/heads/master/LICENSE\n        sha256: dceede03550621e65ec7b79fcba87cf6dbb9d31132a8ae71a8fe8ceec0af7da3\n        target_directory: go-localereader-LICENSE\n\nbuild:\n  number: 0\n  script:\n    - go-licenses save ./cmd/gcx --ignore github.com/grafana/grafana/pkg/apimachinery --ignore github.com/grafana/grafana/apps/folder/pkg/apis/folder/v1beta1 --ignore github.com/mattn/go-localereader --ignore github.com/alecthomas/chroma/v2 --save_path ./library_licenses\n    - if: unix\n      then:\n        - go build -v -o $PREFIX/bin/gcx -ldflags=\"-s -w\" ./cmd/gcx\n        - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n        - $PREFIX/bin/gcx completion zsh > $PREFIX/share/zsh/site-functions/_gcx\n        - $PREFIX/bin/gcx completion bash > $PREFIX/share/bash-completion/completions/gcx\n        - $PREFIX/bin/gcx completion fish > $PREFIX/share/fish/vendor_completions.d/gcx.fish\n      else: go build -v -o %LIBRARY_BIN%\\gcx.exe -ldflags=\"-s\" .\\cmd\\gcx\nrequirements:\n  build:\n    - ${{ compiler('go-nocgo') }}\n    - go-licenses\n\ntests:\n  - script: gcx --help\n  - package_contents:\n      bin:\n        - gcx\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/gcx\n            - share/fish/vendor_completions.d/gcx.fish\n            - share/zsh/site-functions/_gcx\n      strict: true\n\nabout:\n  homepage: https://github.com/grafana/gcx\n  summary: 'A CLI for managing Grafana Cloud resources. Optimized for agentic usage.'\n  description: |\n    gcx is a CLI for Grafana. It gives you and your AI coding agent structured access to your Grafana instance: dashboards, alerts, SLOs, metrics, logs, traces, and more.\n\n    gcx works with any agentic coding tool. It ships with a suite of agent skills for common workflows like alert investigation, dashboard creation and GitOps, SLO management, and observability setup - ready to use out of the box.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - library_licenses/\n    - grafana-LICENSE/LICENSE\n    - chroma-LICENSE/COPYING\n    - if: win\n      then:\n        - go-localereader-LICENSE/LICENSE\n  documentation: https://pkg.go.dev/github.com/grafana/gcx\n  repository: https://github.com/grafana/gcx\n\nextra:\n  recipe-maintainers:\n    - rneacsu\n",
