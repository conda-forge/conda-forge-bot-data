  "raw_meta_yaml": "context:\n  version: \"0.212.0\"\n\npackage:\n  name: metricflow\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/m/metricflow/metricflow-${{ version }}.tar.gz\n  sha256: d85a4d2a37791e2215a5aad373bf50721191b223102ffe9318d8326b926eeadc\n\nbuild:\n  number: 0\n  noarch: python\n  # Required to ensure that test files shipped as zipped symlinks work on Windows\n  # as well as on unix-like platforms. We can remove this once we have a real\n  # feedstock because noarch packages are just built on linux, so long as the\n  # package isn't unzipped on the user's machine.\n  script: |\n    ${{ PYTHON }} -c \"import glob, os, shutil; shared = 'metricflow_semantics/test_helpers/semantic_manifest_yamls/shared/project_configuration.yaml'; targets = [p for p in glob.glob('metricflow_semantics/test_helpers/semantic_manifest_yamls/*/project_configuration.yaml') if os.path.normpath(p) != os.path.normpath(shared)]; [os.remove(t) for t in targets if os.path.lexists(t)]; [shutil.copyfile(shared, t) for t in targets]\"\n    ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling >=1.27.0,<1.28.0\n    - hatch-requirements-txt >=0.4.1,<0.5.0\n  run:\n    - python >=${{ python_min }}\n    - importlib-metadata >=4.0\n    - jinja2 >=3.1.6,<3.7\n    - jsonschema >=4.17,<5.0\n    - more-itertools >=10.0.0,<11.0\n    - pydantic >=1.10.0,<3.0\n    - python-dateutil >=2.9.0,<2.10\n    - pyyaml >=6.0,<7.0\n    - rapidfuzz >=3.0,<4.0\n    - referencing >=0.28\n    - sqlglot >=20.0.0\n    - tabulate >=0.8.9\n    - typing_extensions >=4.4,<5.0\n\ntests:\n  - python:\n      imports:\n        - metricflow\n        - metricflow_semantics\n        - metricflow_semantic_interfaces\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - '*'\n\nabout:\n  homepage: https://github.com/dbt-labs/metricflow\n  repository: https://github.com/dbt-labs/metricflow\n  documentation: https://docs.getdbt.com/docs/build/about-metricflow\n  summary: Translates a simple metric definition into reusable SQL and executes it against the SQL engine of your choice\n  license: Apache-2.0\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - maresb\n    - zaneselvans\n",
