  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  name: fastmcp\n  version: \"3.4.5\"\n\nrecipe:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/fastmcp-${{ version }}.tar.gz\n    sha256: a95f2bc876bef42e8b50f7872f24f3f2fe3b1d37408c734e8b9d9e03014b72d3\n    target_directory: fastmcp/\n  - url: https://pypi.org/packages/source/${{ name[0] }}/fastmcp-slim/fastmcp_slim-${{ version }}.tar.gz\n    sha256: 5badc3bceee61f61297eeb9494f499325f3ce1cafabf4611b31f6c3e9d7dff59\n    target_directory: fastmcp-slim/\n\nbuild:\n  number: 1\n\noutputs:\n  - package:\n      name: fastmcp-slim\n      version: ${{ version }}\n\n    build:\n      noarch: python\n      script: ${{ PYTHON }} -m pip install ./fastmcp-slim -vv --no-deps --no-build-isolation\n      python:\n        entry_points:\n          - fastmcp = fastmcp.cli:app\n\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - hatchling\n        - uv-dynamic-versioning >=0.7.0\n        - pip\n      run:\n        - python >=${{ python_min }},<4\n        - email-validator >=2.0.0\n        - platformdirs >=4.0.0\n        - pydantic >=2.11.7\n        - pydantic-settings >=2.0.0\n        - python-dotenv >=1.1.0\n        - rich >=13.9.4\n        - typing_extensions >=4.0.0\n      run_constraints:\n        - anthropic >=0.48.0\n        - authlib >=1.6.11\n        - azure-identity >=1.16.0\n        - cyclopts >=4.0.0\n        - exceptiongroup >=1.2.2\n        - google-genai >=1.18.0\n        - griffelib >=2.0.0\n        - httpx >=0.28.1,<1.0\n        - joserfc >=1.1.0\n        - jsonref >=1.1.0\n        - jsonschema-path >=0.3.4\n        - mcp >=1.24.0,<2.0  # move to mcp>=2.0.0 is fastmcp v4.0.0\n        - openai >=1.102.0\n        - openapi-pydantic >=0.5.1\n        - opentelemetry-api >=1.20.0\n        - packaging