  "linux_64_meta_yaml": {
    "about": {
      "description": "onionize takes a local port and instantly creates a temporary .onion\naddress for it. No registration, no central servers, no NAT configuration\nrequired. Think of it as a decentralized, private alternative to ngrok,\npowered by Arti, the Tor implementation in Rust.\n\nBecause it embeds the Arti client, no torrc editing or separate tor daemon\nis needed. Services can be restricted to authorized clients using x25519\nkeys, and a QR code can be generated to open the link in Tor Browser for\nmobile.",
      "dev_url": "https://github.com/AndSemenoff/onionize",
      "doc_url": "https://docs.rs/onionize",
      "home": "https://github.com/AndSemenoff/onionize",
      "license": "MIT OR Apache-2.0",
      "license_family": "MIT OR Apache-2.0",
      "license_file": "LICENSE-APACHE",
      "summary": "A CLI tool for creating ephemeral Tor Onion Services to proxy local ports"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bin onionize --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "LIBSQLITE3_SYS_USE_PKG_CONFIG": "1"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "onionize",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable",
            "pkg-config"
          ],
          "host": [
            "openssl",
            "libsqlite",
            "liblzma-devel"
          ],
          "run": []
        },
        "tests": [
          {
            "script": [
              "onionize --help",
              "onionize --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "onionize"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.1.2"
      }
    ],
