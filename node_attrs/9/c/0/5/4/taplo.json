    "build": {
      "number": "2",
      "script": {
        "content": [
          "export OPENSSL_DIR=\"${PREFIX}\"",
          "cargo auditable install --locked --features lsp,rustls-tls --no-track --bins --root ${{ PREFIX }} --path crates/taplo-cli",
