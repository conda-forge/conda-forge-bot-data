  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: 0.10.0\n\npackage:\n  name: taplo\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/tamasfe/taplo/archive/refs/tags/release-taplo-cli-${{ version }}.tar.gz\n  sha256: eaec8435bfb5ccd89f7b4dd09385b6be25c2ff00aa25417cb82c88a59d4ccde0\n\nbuild:\n  number: 2\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: ppc64le\n        then:\n          # Rust 1.90 uses lld by default and has issue linking to conda libraries\n          # compiled with newer gcc\n          - export RUSTFLAGS=\"$RUSTFLAGS -C link-arg=-fuse-ld=bfd\"\n      - if: unix\n        then:\n          - export OPENSSL_DIR=\"${PREFIX}\"\n          - cargo auditable install --locked --features lsp,rustls-tls --no-track --bins --root ${{ PREFIX }} --path crates/taplo-cli\n        else:\n          - cargo auditable install --locked --features lsp,rustls-tls --no-track --bins --root %LIBRARY_PREFIX% --path crates\\taplo-cli\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ compiler(\"rust\") }}\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n  host:\n    - if: unix\n      then:\n        - openssl\n\ntests:\n  - requirements:\n      run:\n        - if: win\n          then: m2-grep\n    script:\n      - taplo --version\n      - taplo --help\n      - taplo --version | grep -iE \"taplo ${{ version | replace(\".\", \"\\\\.\") }}\"\n  - package_contents:\n      bin:\n        - taplo\n      strict: true\n\nabout:\n  license: MIT\n  summary: A TOML toolkit written in Rust\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/tamasfe/taplo\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n",
