  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.0.7\"\n\npackage:\n  name: cocoindex\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/c/cocoindex/cocoindex-${{ version }}.tar.gz\n  sha256: 30aca52897228c1e1e342776f3a6dd6d7a21a89664ecf427a7db4197f312e129\n\nbuild:\n  number: 0\n  script:\n    - if: unix\n      then: |\n        export CFLAGS=\"${CFLAGS:-} -D_BSD_SOURCE -D_DEFAULT_SOURCE\"\n        cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n        ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n      else: |\n        cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n        ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  skip:\n    - match(python, \"<3.11\")\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - maturin >=1.10.0,<2.0\n  host:\n    - python\n    - pip\n    - maturin >=1.10.0,<2.0\n  run:\n    - python\n    - typing_extensions >=4.12\n    - click >=8.1.8\n    - rich >=14.0.0\n    - python-dotenv >=1.1.0\n    - watchdog >=6.0.0\n    - numpy >=1.23.2\n    - psutil >=7.2.1\n    - msgspec >=0.19.0\n\ntests:\n  - python:\n      imports:\n        - cocoindex\n      pip_check: true\n  - if: not win\n    then:\n      - script:\n          - cocoindex --help\n\nabout:\n  homepage: https://cocoindex.io/\n  repository: https://github.com/cocoindex-io/cocoindex\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: Incremental indexing engine for AI agents — keeps derived indexes fresh from source updates with minimal recomputation.\n\nextra:\n  recipe-maintainers:\n    - rxm7706\n",
