  "raw_meta_yaml": "context:\n  version: \"1.17.0\"\n  #  keep synchronized with build.sh\n  am_version: \"1.15\"\n\npackage:\n  name: xcb-proto\n  version: ${{ version }}\n\nsource:\n  url: https://xorg.freedesktop.org/archive/individual/proto/xcb-proto-${{ version }}.tar.gz\n  sha256: 392d3c9690f8c8202a68fdb89c16fd55159ab8d65000a6da213f4a1576e97a16\n  patches:\n    - if: win\n      then: windows-pythondir.patch\n\nbuild:\n  noarch: python\n  number: 5\n  prefix_detection:\n    ignore_binary_files: false\n\nrequirements:\n  build:\n    # uses m2w64 toolchain on windows, see conda_build_config.yaml\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"c\") }}\n    - pkg-config\n    - if: unix\n      then:\n        - autoconf\n        - automake\n        - gettext\n        - libtool\n        - make\n      else:\n        - m2-autoconf\n        - m2-automake${{ am_version }}\n        - m2-base\n        - m2-libtool\n        - m2-make\n  host:\n    - python ${{ python_min }}.*\n    - xorg-util-macros\n  run:\n    - python >=${{ python_min }}\n    - if: unix\n      then: __unix\n      else: __win\n  ignore_run_exports:\n    from_package:\n      - ${{ stdlib(\"c\") }}\n      - ${{ compiler(\"c\") }}\n\ntests:\n  - python:\n      imports:\n        - xcbgen\n      python_version:\n        - ${{ python_min }}\n        - \"*\"\n  - requirements:\n      run:\n        - pkg-config\n    script:\n      - pkg-config --variable=pythondir xcb-proto\n\nabout:\n  homepage: http://xcb.freedesktop.org/\n  license: MIT\n  license_file: COPYING\n  summary: \"Provides the XML-XCB protocol descriptions that libxcb uses to generate the majority of its code and API\"\n\nextra:\n  recipe-maintainers:\n    - ccordoba12\n    - pkgw\n",
