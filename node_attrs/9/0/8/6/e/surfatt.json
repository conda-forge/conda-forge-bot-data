  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.1.1\"\n  build_number: 2\n  mpi_prefix: ${{ \"mpi_\" + mpi }}\n\npackage:\n  name: surfatt\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/TomoATT/SurfATT/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 2ca5d636fba0054e18ba9bde9bc403bf97551590870766e7880173cb96497ade\n\nbuild:\n  number: ${{ build_number }}\n  string: ${{ mpi_prefix }}_h${{ hash }}_${{ build_number }}\n  skip:\n    - win\n  script:\n    - cmake ${CMAKE_ARGS} -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${PREFIX} -DBUILD_TESTS=OFF\n    - cmake --build build --parallel ${CPU_COUNT}\n    - cmake --install build\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"cxx\") }}\n    - ${{ compiler(\"fortran\") }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - ninja\n  host:\n    - ${{ mpi }}\n    - hdf5 * nompi_*\n    - eigen\n    - yaml-cpp\n    - spdlog\n  run:\n    - ${{ mpi }}\n\ntests:\n  - package_contents:\n      bin:\n        - SURFATT_tomo\n        - SURFATT_cb_fwd\n        - SURFATT_rotate_model\n        - SURFATT_rotate_src_rec\n        - SURFATT_rotate_topo\n  - script:\n      - SURFATT_tomo -h\n      - SURFATT_cb_fwd -h\n      - SURFATT_rotate_model -h\n      - SURFATT_rotate_src_rec -h\n      - SURFATT_rotate_topo -h\n\nabout:\n  summary: Surface-wave adjoint travel-time tomography software\n  license: GPL-3.0-only\n  license_file:\n    - LICENSE.txt\n  homepage: https://tomoatt.com/\n  repository: https://github.com/TomoATT/SurfATT\n  documentation: https://tomoatt.com/\n\nextra:\n  recipe-maintainers:\n    - xumi1993\n",
