  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: qcachegrind\n  version: \"25.07.90\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://invent.kde.org/sdk/kcachegrind/-/archive/v${{ version }}/kcachegrind-v${{ version }}.tar.gz\n  sha256: 3e3f683d92dd990124bd06de7b8be131dec9ae3aea4dbbfe7084fca471ee4da7\n\nbuild:\n  number: 2\n  skip: ppc64le\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib(\"c\") }}\n    - if: linux\n      then: ${{ cdt('mesa-libgl-devel') }}\n    - if: linux\n      then: ${{ cdt('mesa-dri-drivers') }}\n    - if: linux\n      then: libglx-devel\n    - if: linux\n      then: libopengl-devel\n    - if: win\n      then: jom\n    - if: win\n      then: m2-patch\n    - if: not win\n      then: make\n    - if: not win\n      then: patch\n  host:\n    - if: linux\n      then: ${{ cdt('libglvnd-glx') }}\n    - qt6-main\n\ntests:\n  - script:\n      - if: unix\n        then: test -f ${PREFIX}/bin/cgview\n      - if: unix\n        then: test -f ${PREFIX}/bin/qcachegrind\n      - if: win\n        then: if not exist %LIBRARY_BIN%\\cgview.exe exit 1\n      - if: win\n        then: if not exist %LIBRARY_BIN%\\qcachegrind.exe exit 1\n\nabout:\n  license: GPL-2.0-only\n  license_file: LICENSES/GPL-2.0-only.txt\n  summary: A profiling data visualizer\n  description: |\n    This tool allows visualisation of profiling data in the callgrind-format.\n  homepage: https://apps.kde.org/en-gb/kcachegrind/\n  repository: https://invent.kde.org/sdk/kcachegrind\n  documentation: https://docs.kde.org/stable5/en/kcachegrind/kcachegrind/index.html\n\nextra:\n  recipe-maintainers:\n    - timkpaine\n",
