  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  name: coin3d\n  version: \"4.0.9\"\n  superglue_version: \"1.3.0\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/coin3d/coin/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 1ad9b959eb1498bb4b7c4ed4931d6aba69f04ab108ba35d24aecfe17d4fd8f6a\n    # patches:\n    #   - patches/0001-Only-use-GLX-on-platforms-with-X11.patch\n\n  - url: https://github.com/coin3d/superglu/archive/superglu-${{ superglue_version }}.tar.gz\n    sha256: f408adcfb706e7c781db9c218ef9e8ba56d43995ccb61dffad5f6154c34f17d6\n    target_directory: superglue\n    patches:\n      - patches/0002-superglue.patch\n\nbuild:\n  number: 1\n\nrequirements:\n  run_exports:\n    - ${{ pin_subpackage(name, upper_bound='x.x') }}\n  build:\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n  host:\n    - if: linux\n      then:\n        - libgl-devel\n        - libglu\n        - xorg-libxt\n        - xorg-libxi\n    - expat\n  run:\n    - if: linux\n      then:\n        - libglu\n        - xorg-libxt\n        - xorg-libxi\n    - expat\n\ntests:\n  - if: linux\n    then:\n      script:\n        - ${CXX} -o test test.cpp -Wl,-rpath-link -lCoin -L${PREFIX}/lib/ -I${PREFIX}/include/\n        - ./test\n      files:\n        recipe:\n          - test.cpp\n      requirements:\n        build:\n          - ${{ compiler('c') }}\n          - ${{ compiler('cxx') }}\n  - if: win\n    then:\n      script:\n        - where /r \"%PREFIX%\" Coin4.dll\n  - if: osx\n    then:\n      script:\n        - test -f ${PREFIX}/lib/libCoin.dylib\n\nabout:\n  homepage: https://bitbucket.org/Coin3D/coin/wiki/Home\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: COPYING\n  summary: Coin3D is a C++ high-level 3D graphics toolkit.\n  description: Coin3D is a high-level, retained-mode toolkit for effective 3D graphics development. It is API compatible with Open Inventor 2.1.\n  documentation: https://bitbucket.org/Coin3D/coin/wiki/Home\n  repository: https://bitbucket.org/Coin3D/coin/wiki/Home\n\nextra:\n  recipe-maintainers:\n    - oursland\n    - looooo\n",
