  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  # replicate GIT_* variables based on output of `git describe --tags dc42231f0 [+local patches]`, c.f.\n  # https://github.com/conda/conda-build/blob/26.5.0/conda_build/environ.py#L253-L265\n  # https://docs.conda.io/projects/conda-build/en/stable/user-guide/environment-variables.html#git-environment-variables\n  GIT_DESCRIBE_TAG: \"v12.0.0\"\n  GIT_DESCRIBE_NUMBER: \"4\"\n  GIT_DESCRIBE_HASH: \"g4f2fc60ca\"\n  version: ${{ GIT_DESCRIBE_TAG[1:] }}.r${{ GIT_DESCRIBE_NUMBER }}.g${{ GIT_DESCRIBE_HASH }}\n\nrecipe:\n  name: m2w64-sysroot\n  version: ${{ version }}\n\nsource:\n  git: https://github.com/mingw-w64/mingw-w64\n  rev: dc42231f0\n  patches:\n    - 0001-Allow-to-use-bessel-and-complex-functions-without-un.patch\n    - 0002-heades-add-full-name-winrt.patch\n    - 0003-use-pthread_compat.h-in-sched.h.patch\n\nbuild:\n  number: 11\n\noutputs:\n  - staging:\n      name: m2w64-sysroot-stage\n    build:\n      script:\n        file: build\n    requirements:\n      build:\n        - gcc_bootstrap_win-64\n        - make\n\n  - package:\n      name: mingw-w64-ucrt-x86_64-headers-git\n    inherit: m2w64-sysroot-stage\n    build:\n      noarch: generic\n      script:\n        file: install.sh\n        env:\n          # work-around for r-b using noarch\n          target_platform: ${{ target_platform }}\n      files:\n        - x86_64-w64-mingw32/sysroot/usr/include\n        - Library/x86_64-w64-mingw32/sysroot/usr/include\n    requirements:\n      build:\n        - gcc_bootstrap_win-64\n        - make\n      host:\n      run:\n        - if: unix\n          then: __unix\n        - if: win\n          then: m2-conda-epoch\n      run_constraints:\n        - mingw-w64-ucrt-x86_64-crt-git ${{ version }}.*\n        - mingw-w64-ucrt-x86_64-winpthreads-git ${{ version }}.*\n    tests:\n      - package_contents:\n          files:\n            # sample test as stand-in for many\n            - if: unix\n              then: x86_64-w64-mingw32/sysroot/usr/include/_mingw.h\n              else: Library/x86_64-w64-mingw32/sysroot/usr/include/_mingw.h\n    about:\n      license: ZPL-2.1 AND LGPL-2.1-or-later\n      license_file:\n        - mingw-w64-headers/ddk/readme.txt\n        - COPYING\n        - COPYING.MinGW-w64/COPYING.MinGW-w64.txt\n      summary: |\n        MinGW-w64 headers for Windows (mingw-w64)\n      homepage: https://www.mingw-w64.org/\n\n  - package:\n      name: mingw-w64-ucrt-x86_64-winpthreads-git\n    inherit: m2w64-sysroot-stage\n    build:\n      noarch: generic\n      merge_build_and_host_envs: false\n      script:\n        file: install.sh\n        env:\n          target_platform: ${{ target_platform }}\n      files:\n        - x86_64-w64-mingw32/sysroot/usr/include/semaphore.h\n        - x86_64-w64-mingw32/sysroot/usr/include/sched.h\n        - x86_64-w64-mingw32/sysroot/usr/include/pthread*.h\n        - x86_64-w64-mingw32/sysroot/usr/lib/lib*pthread*.a\n        - Library/x86_64-w64-mingw32/sysroot/usr/include/semaphore.h\n        - Library/x86_64-w64-mingw32/sysroot/usr/include/sched.h\n        - Library/x86_64-w64-mingw32/sysroot/usr/include/pthread*.h\n        - Library/x86_64-w64-mingw32/sysroot/usr/lib/lib*pthread*.a\n    requirements:\n      build:\n        - gcc_bootstrap_win-64\n        - make\n      host:\n      run:\n        - ${{ pin_subpackage(\"mingw-w64-ucrt-x86_64-headers-git\", exact=True) }}\n        - if: unix\n          then: __unix\n        - if: win\n          then: m2-conda-epoch\n      run_constraints:\n        - mingw-w64-ucrt-x86_64-crt-git ${{ version }}.*\n    tests:\n      - package_contents:\n          files:\n            - if: unix\n              then:\n                - x86_64-w64-mingw32/sysroot/usr/include/pthread.h\n                - x86_64-w64-mingw32/sysroot/usr/include/sched.h\n              else:\n                - Library/x86_64-w64-mingw32/sysroot/usr/include/pthread.h\n                - Library/x86_64-w64-mingw32/sysroot/usr/include/sched.h\n    about:\n      license: MIT AND BSD-3-Clause-Clear\n      license_file:\n        - mingw-w64-libraries/winpthreads/COPYING\n        - COPYING.MinGW-w64/COPYING.MinGW-w64.txt\n      summary: |\n        MinGW-w64 winpthreads library (mingw-w64)\n      homepage: https://www.mingw-w64.org/\n\n  - package:\n      name: libwinpthread\n    inherit: m2w64-sysroot-stage\n    build:\n      skip: not win\n      merge_build_and_host_envs: false\n      script:\n        file: install.sh\n        env:\n          target_platform: ${{ target_platform }}\n      files:\n        - Library/bin/libwinpthread-1.dll\n    requirements:\n      build:\n        - gcc_bootstrap_win-64\n        - make\n      host:\n        - ucrt\n      run:\n        - ucrt\n      run_constraints:\n        - msys2-conda-epoch <0.0a0\n        - pthreads-win32 <0.0a0\n    tests:\n      - package_contents:\n          files:\n            - Library/bin/libwinpthread-1.dll\n    about:\n      license: MIT AND BSD-3-Clause-Clear\n      license_file:\n        - mingw-w64-libraries/winpthreads/COPYING\n        - COPYING.MinGW-w64/COPYING.MinGW-w64.txt\n      summary: |\n        MinGW-w64 winpthreads library (mingw-w64)\n      homepage: https://www.mingw-w64.org/\n\n  - package:\n      name: winpthreads-devel\n    inherit: m2w64-sysroot-stage\n    build:\n      skip: not win\n      merge_build_and_host_envs: false\n      script:\n        file: install.sh\n        env:\n          target_platform: ${{ target_platform }}\n      files:\n        - Library/include/semaphore.h\n        - Library/include/sched.h\n        - Library/include/pthread*.h\n        - Library/lib/lib*pthread*.a\n        - Library/lib/pthread.lib\n    requirements:\n      build:\n        - gcc_bootstrap_win-64\n        - make\n      host:\n        - ${{ pin_subpackage(\"libwinpthread\", exact=True) }}\n      run:\n        - ${{ pin_subpackage(\"libwinpthread\", exact=True) }}\n      run_exports:\n        - ${{ pin_subpackage(\"libwinpthread\", u