  "linux_64_meta_yaml": {
    "about": {
      "description": "ast-grep is an AST-based tool to search code by pattern code. Think it as\nyour old-friend grep but it matches AST nodes instead of text. You can\nwrite patterns as if you are writing ordinary code. It will match all code\nthat has the same syntactical structure. You can use $ sign + upper case\nletters as wildcard, e.g. $MATCH, to match any single AST node. Think it as\nREGEX dot ., except it is not textual.",
      "dev_url": "https://github.com/ast-grep/ast-grep",
      "doc_url": "https://ast-grep.github.io/",
      "home": "https://github.com/ast-grep/ast-grep",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "THIRDPARTY.yml",
      "summary": "ast-grep(sg) is a CLI tool for code structural search, lint, and rewriting."
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path ./crates/cli",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
