  "linux_64_meta_yaml": {
    "about": {
      "description": "OnionCat creates a transparent IPv6 layer on top of Tor's hidden services\nor I2P's tunnels. It transmits any kind of IP-based data transparently\nthrough the Tor/I2P network on a location hidden basis. You can think of it\nas a peer-to-peer VPN between hidden services.\n\nOnionCat is a stand-alone application which runs in userland and is a\nconnector between Tor/I2P and the local OS. Any protocol which is based on\nIP can be transmitted, most notably TCP, UDP and ICMP.",
      "dev_url": "https://github.com/rahra/onioncat",
      "doc_url": "https://github.com/rahra/onioncat/blob/master/README.md",
      "home": "https://www.onioncat.org/",
      "license": "GPL-3.0-only",
      "license_family": "GPL-3.0-only",
      "license_file": "COPYING",
      "summary": "A VPN adapter for Tor and I2P"
    },
    "build": {
      "number": "0",
      "script": [
        "./autogen.sh",
        "./configure --prefix=${PREFIX} --host=${HOST} --build=${BUILD}",
        "make -j${CPU_COUNT}",
        "make install"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
