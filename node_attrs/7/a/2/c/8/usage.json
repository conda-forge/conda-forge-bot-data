  "raw_meta_yaml": "context:\n  version: \"4.0.0\"\n\npackage:\n  name: usage\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/jdx/usage/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 8bdc11ab0937325480df51c28d7528179e37efb25fa1f3283c6645c08b332cea\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - cd cli\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n          # copy manpage and generate shell completions\n          - mkdir -p \"$PREFIX\"/share/man/man1 \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n          - cp assets/usage.1 \"$PREFIX\"/share/man/man1/usage.1\n          - if: build_platform == host_platform\n            then:\n              - '\"$PREFIX\"/bin/usage --completions bash > \"$PREFIX\"/share/bash-completion/completions/usage'\n              - '\"$PREFIX\"/bin/usage --completions fish > \"$PREFIX\"/share/fish/vendor_completions.d/usage.fish'\n              - '\"$PREFIX\"/bin/usage --completions zsh  > \"$PREFIX\"/share/zsh/site-functions/_usage'\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n          # copy manpage and generate shell completions\n          - mkdir \"%LIBRARY_PREFIX%\"\\share\\man\\man1\n          - mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n          - mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n          - mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n          - powershell -Command \"Copy-Item -Path 'assets\\usage.1' -Destination '%LIBRARY_PREFIX%\\share\\man\\man1\\usage.1'\"\n          - if: build_platform == host_platform\n            then:\n              - '\"%LIBRARY_BIN%\"\\usage.exe --completions bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\usage'\n              - '\"%LIBRARY_BIN%\"\\usage.exe --completions fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\usage.fish'\n              - '\"%LIBRARY_BIN%\"\\usage.exe --completions zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_usage'\n      - cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n\ntests:\n  - script:\n      - usage --help\n      - usage --version\n  - package_contents:\n      bin:\n        - usage\n      files:\n        - if: unix\n          then:\n            - share/man/man1/usage.1\n            - if: build_platform == host_platform\n              then:\n                - share/bash-completion/completions/usage\n                - share/fish/vendor_completions.d/usage.fish\n                - share/zsh/site-functions/_usage\n        - if: win\n          then:\n            - Library/share/man/man1/usage.1\n            - if: build_platform == host_platform\n              then:\n                - Library/share/bash-completion/completions/usage\n                - Library/share/fish/vendor_completions.d/usage.fish\n                - Library/share/zsh/site-functions/_usage\n      strict: true\n\nabout:\n  summary: Usage Spec processor CLI\n  description: |\n    Usage is a spec and CLI for defining CLI tools. Arguments, flags, environment\n    variables, and config files can all be defined in a Usage spec. It can be\n    thought of like OpenAPI (swagger) for CLIs. Use it to generate autocompletion\n    scripts, markdown documentation, man pages, and more.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://usage.jdx.dev\n  documentation: https://usage.jdx.dev/cli/reference/\n  repository: https://github.com/jdx/usage\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
