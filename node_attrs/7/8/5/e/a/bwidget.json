  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: 1.10.1\n\npackage:\n  name: bwidget\n  version: ${{ version }}\n\nsource:\n  # use a separate folder to avoid moving scripts generated by conda-build\n  url: https://downloads.sourceforge.net/project/tcllib/BWidget/${{ version }}/bwidget-${{ version }}.tar.gz\n  sha256: 4aea02f38cf92fa4aa44732d4ed98648df839e6537d6f0417c3fe18e1a34f880\n  target_directory: src\n\nbuild:\n  number: 2\n\nrequirements:\n  run:\n    - tk\n\ntests:\n  - script:\n      - if: linux\n        then: xvfb-run tclsh test_bwidget.tcl ${{ version }}\n        else: tclsh test_bwidget.tcl ${{ version }}\n    files:\n      recipe:\n        - test_bwidget.tcl\n    requirements:\n      run:\n        # there is no tcl package for win-arm64; its tk package ships tclsh itself\n        - if: target_platform == \"win-arm64\"\n          then: tk\n          else: tcl\n\nabout:\n  license: TCL\n  license_file: src/LICENSE.txt\n  summary: Simple Widgets for Tcl/Tk.\n  homepage: http://www.tcl.tk/\n  documentation: https://core.tcl-lang.org/bwidget/home\n\nextra:\n  recipe-maintainers:\n    - fhoehle\n",
