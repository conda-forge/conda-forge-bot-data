      "license_file": "LICENSE.txt",
      "summary": "Distributed Evolutionary Algorithms in Python"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . --no-deps -vv --no-build-isolation --disable-pip-version-check"
