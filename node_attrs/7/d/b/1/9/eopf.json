    "about": {
      "description": "The EOPF Core Python Modules (EOPF-CPM) is python package gathering the\nbest-in-class open-source python modules in a harmonized framework\nintended for the development of image processors. Particularly the\nre-engineering of the operational Level-0, Level-1 and Level-2 processors\nfor the instruments on-board of the Copernicus Sentinel-1, Sentinel-2,\nSentinel-3 (Land) missions.\nIt is providing features such as:\n* A generic product representation EOProduct compatible with the UNIDATA\n  CDM model with utilities library allowing:\n  - Writing an EOProduct to different external representations,\n    formats and file systems.\n  - Reading an EOProduct from different external representations\n    including the legacy file format (mostly SAFE).\n* Distributed and parallel computing based on Dask.\n* Logging and tracing tools.\n* Processors triggering and workflows definition.",
      "dev_url": "https://gitlab.eopf.copernicus.eu/cpm/eopf-cpm",
      "doc_url": "https://cpm.pages.eopf.copernicus.eu/eopf-cpm/main/index.html",
      "home": "https://gitlab.eopf.copernicus.eu/cpm/eopf-cpm",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "EOPF Core Python Modules"
    },
    "build": {
      "noarch": "python",
      "number": "1",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "avalentino"
      ]
    },
