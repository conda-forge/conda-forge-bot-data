  "raw_meta_yaml": "{% set name = \"openff-toolkit\" %}\n{% set version = \"0.18.1\" %}\n{% set python_min = '3.12' %}\n\npackage:\n  name: openff-toolkit-split\n  version: {{ version }}\n\nsource:\n  git_url: https://github.com/openforcefield/{{ name }}.git\n  git_rev: {{ version }}\n  git_depth: -1\n\nbuild:\n  number: 2\n\noutputs:\n  - name: openff-toolkit-base\n    script: build_base.sh\n    build:\n      noarch: python\n\n    requirements:\n      host:\n        - python {{ python_min }}\n        - pip\n        - setuptools\n        - versioningit\n      run:\n        # Downpinning against 3.14 for this issue https://github.com/openforcefield/openff-toolkit/issues/2207\n        # Will likely be resolved by https://github.com/openforcefield/openff-units/pull/178\n        - python >={{ python_min }},<3.14.0a0 \n        - packaging\n        - numpy\n        - openff-forcefields\n        - openff-amber-ff-ports >=2025.09.0\n        - openff-units >=0.2\n        - openff-utilities\n        - networkx >=2.5\n        - xmltodict <1.0.3\n        - bson\n        - python-constraint\n        - cachetools\n      run_constrained:\n        - openforcefield ==9999999999\n        - pydantic <3.0.0a0\n        - qcportal >=0.50.0\n\n    test:\n      requires:\n        - python {{ python_min }}\n      imports:\n        - openff.toolkit\n\n  - name: openff-toolkit\n    build:\n      noarch: python\n\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - python >={{ python_min }}\n        - openmm >=8\n        - openff-interchange >=0.5\n        - rdkit !=2024.03.6\n        - {{ pin_subpackage('openff-toolkit-base', exact=True) }}\n        - openff-nagl >=0.5.2\n      run_constrained:\n        - ambertools >=22\n\n    test:\n      requires:\n        - python {{ python_min }}\n        - qcportal\n      imports:\n        - openff.toolkit\n        - rdkit\n      files:\n        - test_openff_toolkit.py\n      commands:\n        - python test_openff_toolkit.py\n\n  - name: openff-toolkit-examples\n    script: move-examples.sh\n    build:\n      noarch: python\n\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - python >={{ python_min }}\n        - jupyterlab\n        - nglview\n        - mdtraj\n        - qcelemental\n        - qcportal >=0.50.0\n        - qcengine\n        - openmmforcefields\n        - pdbfixer\n        - {{ pin_subpackage('openff-toolkit', exact=True) }}\n\n    test:\n      requires:\n        - python {{ python_min }}\n      files:\n        - test_examples_copied.py\n      source_files:\n        - examples\n      commands:\n        - python test_examples_copied.py\n\nabout:\n  home: https://openforcefield.org/\n  license: MIT\n  license_family: MIT\n  license_file: LICENSE\n  summary: A modern, extensible library for molecular mechanics force field science from the Open Force Field Initiative\n  description: |\n    The Open Force Field Toolkit, built by the Open Force Field Initiative, is a Python\n    toolkit for the development and application of modern molecular mechanics force fields\n    based on direct chemical perception and rigorous statistical parameterization methods.\n  doc_url: https://docs.openforcefield.org/projects/toolkit/en/stable/\n  dev_url: https://github.com/openforcefield/openff-toolkit\n\nextra:\n  recipe-maintainers:\n    - jaimergp\n    - j-wags\n    - mattwthompson\n",
