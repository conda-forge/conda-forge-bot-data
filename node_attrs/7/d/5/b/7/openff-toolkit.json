    "about": {
      "description": "The Open Force Field Toolkit, built by the Open Force Field Initiative, is a Python\ntoolkit for the development and application of modern molecular mechanics force fields\nbased on direct chemical perception and rigorous statistical parameterization methods.\n",
      "dev_url": "https://github.com/openforcefield/openff-toolkit",
      "doc_url": "https://docs.openforcefield.org/projects/toolkit/en/stable/",
      "home": "https://openforcefield.org/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "A modern, extensible library for molecular mechanics force field science from the Open Force Field Initiative"
    },
    "build": {
      "number": "2"
    },
    "extra": {
      "recipe-maintainers": [
        "jaimergp",
        "j-wags",
        "mattwthompson"
      ]
    },
    "outputs": [
      {
        "build": {
          "noarch": "python"
        },
        "name": "openff-toolkit-base",
        "requirements": {
          "host": [
            "python 3.12",
            "pip",
            "setuptools",
            "versioningit"
          ],
          "run": [
            "python >=3.12,<3.14.0a0",
            "packaging",
            "numpy",
            "openff-forcefields",
            "openff-amber-ff-ports >=2025.09.0",
            "openff-units >=0.2",
            "openff-utilities",
            "networkx >=2.5",
            "xmltodict <1.0.3",
            "bson",
            "python-constraint",
            "cachetools"
          ],
          "run_constrained": [
            "openforcefield ==9999999999",
            "pydantic <3.0.0a0",
            "qcportal >=0.50.0"
          ]
        },
        "script": "build_base.sh",
        "test": {
          "imports": [
            "openff.toolkit"
          ],
          "requires": [
            "python 3.12"
          ]
        }
      },
      {
        "build": {
          "noarch": "python"
        },
        "name": "openff-toolkit",
        "requirements": {
          "host": [
            "python 3.12"
          ],
          "run": [
            "python >=3.12",
            "openmm >=8",
            "openff-interchange >=0.5",
            "rdkit !=2024.03.6",
            "openff-toolkit-base",
            "openff-nagl >=0.5.2"
          ],
          "run_constrained": [
            "ambertools >=22"
          ]
        },
        "test": {
          "commands": [
            "python test_openff_toolkit.py"
