    "about": {
      "description": "chebpy is a Python implementation of the popular MATLAB package\nChebfun <http://chebfun.org>, allowing for computing with functions\nto near machine precision. It relies on polynomial interpolation\nusing Chebyshev points and, through FFTs, expansions in Chebyshev\npolynomials.\n",
      "dev_url": "https://github.com/chebpy/chebpy",
      "doc_url": "https://github.com/chebpy/chebpy",
      "home": "https://github.com/chebpy/chebpy",
      "license": "BSD-3-Clause",
      "license_family": "BSD",
      "license_file": "LICENSE.rst",
      "summary": "A Python implementation of Chebfun"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "PYTHON -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
