  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.54.1\"\n  python_check_max: \"3.14\"\n  grep: ${{ \"grep -iE\" if unix else \"findstr /c\" }}\n\nrecipe:\n  name: jupyterlab-git-split\n  version: ${{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/j/jupyterlab-git-core/jupyterlab_git_core-${{ version }}.tar.gz\n    sha256: e79900ec3623cdbefc260e9e90d912536266ca3f40f8332a0a9df0dd7ee77cbc\n    target_directory: core\n  - url: https://pypi.org/packages/source/j/jupyterlab-git/jupyterlab_git-${{ version }}.tar.gz\n    sha256: eb9adadf351c8e28f3a990952d294e30885768d636e88cdc72d3c6ac5c0e88b6\n    target_directory: jupyterlab\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: jupyterlab-git-core\n    build:\n      noarch: python\n      script:\n        - cd core\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n    requirements:\n      host:\n        - hatch-jupyter-builder >=0.5\n        - hatch-nodejs-version >=0.3.2\n        - hatchling >=1.5.0\n        - jupyterlab >=4,<5\n        - pip\n        - python ${{ python_min }}.*\n      run:\n        - anyio\n        - nbformat\n        - packaging\n        - pexpect\n        - python >=${{ python_min }}\n        - traitlets >=5.0,<6.0\n        # [nbdime]\n        - nbdime >=4.0.1,<4.1\n      run_constraints:\n        - jupyterlab >=4,<5\n        # avoid installing clobbering jupyterlab-git<0.53\n        - jupyterlab-git ${{ version }}.*\n    tests:\n      - python:\n          imports: jupyterlab_git_core\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n      - requirements:\n          run:\n            - jupyterlab\n            - python ${{ python_min }}.*\n        script:\n          - jupyter labextension list\n          - jupyter labextension list 2>&1 | ${{ grep }} \"@jupyterlab/git.*OK.*(python, jupyterlab-git-core)\"\n          - jupyter labextension list 2>&1 | ${{ grep }} \"nbdime-jupyterlab.*OK\"\n    about:\n      description: Core Git operations library for the jupyterlab-git JupyterLab extension.\n      homepage: https://pypi.org/project/jupyterlab-git-core\n      license_file:\n        - core/LICENSE\n        - core/jupyterlab_git_core/labextension/static/third-party-licenses.json\n\n  - package:\n      name: jupyterlab-git\n    build:\n      noarch: python\n      script:\n        - cd jupyterlab\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n    requirements:\n      host:\n        - hatch-nodejs-version >=0.3.2\n        - hatchling >=1.5.0\n        - pip\n        - python ${{ python_min }}.*\n      run:\n        - ${{ pin_subpackage(\"jupyterlab-git-core\", exact=True) }}\n        - jupyter_server >=2.0.1,<3.0\n        - nbdime\n        - python >=${{ python_min }}\n        - traitlets >=5.0,<6.0\n      run_constraints:\n        - jupyterlab >=4,<5\n    tests:\n      - python:\n          imports: jupyterlab_git\n          pip_check: true\n          python_version: ${{ python_min }}\n      - requirements:\n          run:\n            - jupyterlab\n            - python ${{ python_min }}.*\n        script:\n          - jupyter server extension list\n          - jupyter server extension list 2>&1 | ${{ grep }} \"jupyterlab_git.*OK\"\n          - jupyter labextension list\n          - jupyter labextension list 2>&1 | ${{ grep }} \"@jupyterlab/git.*OK\"\n    about:\n      homepage: https://pypi.org/project/jupyterlab-git\n      license_file: jupyterlab/LICENSE\n\nabout:\n  license: BSD-3-Clause\n  license_file: core/LICENSE\n  summary: A Git extension for JupyterLab\n  description: A JupyterLab extension for version control using git\n  homepage: https://github.com/jupyterlab/jupyterlab-git\n  repository: https://github.com/jupyterlab/jupyterlab-git\n\nextra:\n  feedstock-name: jupyterlab-git\n  recipe-maintainers:\n    - jtpio\n    - krassowski\n    - dlqqq\n    - dbast\n    - blink1073\n    - fcollonval\n    - bollwyvl\n",
