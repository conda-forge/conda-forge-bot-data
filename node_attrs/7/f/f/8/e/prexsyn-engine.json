  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: 1.1.1\n\npackage:\n  name: prexsyn-engine\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/luost26/prexsyn-engine/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: cba542c19a035bb690f33436479672889a080dc59eff7c49e4ecb8243d0b92b8\n\nbuild:\n  skip:\n    - osx and not arm64\n    - match(python, \"<3.10\")\n  number: 0\n  script:\n    - if: linux\n      then: export CMAKE_ARGS=\"-G Ninja -DCMAKE_CXX_COMPILER=${CXX} -DUSE_SYSTEM_BOOST=ON -DPREXSYN_OPENMP_ROOT=${PREFIX} ${CMAKE_ARGS}\"\n    - if: osx\n      then: >-\n        export CMAKE_ARGS=\"-G Ninja -DCMAKE_CXX_COMPILER=${CXX}\n        -DUSE_SYSTEM_BOOST=ON -DPREXSYN_OPENMP_ROOT=${PREFIX}\n        -DCMAKE_CXX_SCAN_FOR_MODULES=OFF\n        -DCMAKE_THREAD_LIBS_INIT=-lpthread -DCMAKE_HAVE_THREADS_LIBRARY=1\n        -DCMAKE_USE_WIN32_THREADS_INIT=0 -DCMAKE_USE_PTHREADS_INIT=1\n        -DTHREADS_PREFER_PTHREAD_FLAG=ON ${CMAKE_ARGS}\"\n    - if: win\n      then: set \"CMAKE_ARGS=-G Ninja -DUSE_SYSTEM_BOOST=ON %CMAKE_ARGS%\"\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - git\n    - ninja\n  host:\n    - python\n    - scikit-build-core\n    - pip\n    - libboost-devel\n    - if: osx\n      then: llvm-openmp\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - prexsyn_engine\n      pip_check: true\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  homepage: https://github.com/luost26/prexsyn-engine\n  repository: https://github.com/luost26/prexsyn-engine\n  documentation: https://prexsyn.readthedocs.io/\n  summary: 'C++ backend library for PrexSyn with Python bindings'\n\nextra:\n  recipe-maintainers:\n    - luost26\n",
