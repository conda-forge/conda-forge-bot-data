    "about": {
      "description": "hickle is a neat, quick way of dumping python variables to HDF5 files that can be read\nin most programming languages. Hickle is fast, and allows for transparent\ncompression of your data (LZF / GZIP). Hickle is built upon h5py, and can be used as a\ndrop-in replacement for pickle/cPickle.",
      "dev_url": "https://github.com/telegraphic/hickle",
      "doc_url": "http://github.com/telegraphic/hickle/README.md",
      "home": "http://github.com/telegraphic/hickle",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "A HDF5-based python pickle replacement for dumping and loading python variables to file."
    },
    "build": {
      "noarch": "python",
      "number": "3",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "telegraphic",
        "jan-janssen"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "hickle",
        "requirements": {
          "build": [],
