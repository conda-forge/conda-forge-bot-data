  "raw_meta_yaml": "context:\n  version: \"1.0.0beta.9\"\n  tag: ${{ version | replace(\"beta\", \"-beta\") }}\n\npackage:\n  name: rustfs\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/rustfs/rustfs/archive/refs/tags/${{ tag }}.tar.gz\n  sha256: 96adfe308111de5fcb980b3f5ed32869c38e90b3cf611a51599f0891d405e1cd\n\nbuild:\n  number: 0\n  # Currently don't ship the web console because `rustfs/static` is empty at build time.\n  skip: win\n  script:\n    env:\n      # No fat LTO: the final binary is large and fat-LTO linking exhausts CI\n      # memory (OOM). Upstream's default release profile also omits LTO.\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path ./rustfs\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - cmake\n    - ninja\n    - make\n    - libprotobuf\n\ntests:\n  - script: rustfs --help\n  - package_contents:\n      bin:\n        - rustfs\n      strict: true\n\nabout:\n  homepage: https://rustfs.com\n  summary: High-performance distributed S3-compatible object storage written in Rust\n  description: |\n    RustFS is an open-source, S3-compatible high-performance object storage\n    system built in Rust. It supports erasure coding, identity and access\n    management, policy management, S3 Select, and migration and coexistence\n    with other S3-compatible platforms such as MinIO and Ceph.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://docs.rustfs.com/\n  repository: https://github.com/rustfs/rustfs\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
