  "linux_64_meta_yaml": {
    "about": {
      "description": "goose is a general-purpose AI agent that runs on your machine.\nNot just for code — use it for research, writing, automation, data analysis, or anything you need to get done.\n\ngoose works with 15+ providers — Anthropic, OpenAI, Google, Ollama, OpenRouter, Azure, Bedrock, and more.\nUse API keys or your existing Claude, ChatGPT, or Gemini subscriptions via [ACP](https://goose-docs.ai/docs/guides/acp-providers).\nConnect to 70+ extensions via the [Model Context Protocol](https://modelcontextprotocol.io/) open standard.",
      "dev_url": "https://github.com/aaif-goose/goose",
      "doc_url": "https://goose-docs.ai/docs",
      "home": "https://goose-docs.ai/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "An open source, extensible AI agent that goes beyond code suggestions - install, execute, edit, and test with any LLM"
    },
    "build": {
      "number": "0",
      "script": [
        "export CMAKE_GENERATOR=Ninja\nexport RUSTFLAGS=\"-Clink-arg=-L${PREFIX}/lib -Clink-arg=-lomp\"\npushd crates/goose-cli\ncargo-bundle-licenses --format yaml --output ${{ SRC_DIR }}/THIRDPARTY.yml\n",
        "cargo install --no-track --locked --root ${{ PREFIX }} --path .",
        "popd"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "eunos-1128"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "goose-cli",
        "requirements": {
          "build": [
            "cxx_compiler_stub",
            "c_stdlib_stub",
            "rust_compiler_stub",
            "protobuf",
            "cargo-bundle-licenses",
            "cmake",
            "ninja",
            "pkg-config"
          ],
          "host": [
            "dbus",
            "libxcb",
            "clangdev",
            "zlib"
          ],
          "run": []
        },
        "tests": [
          {
            "script": [
              "goose --version",
              "goose --help",
              "goose serve --help"
            ]
          }
        ],
        "version": "1.45.0"
      }
    ],
