  "linux_64_meta_yaml": {
    "about": {
      "description": "ghgrab provides a streamlined command-line interface for cherry-picking\nspecific files or folders from supported Git forges, powered by the Rust\ntokio and ratatui ecosystem. Focused on speed and ease of use, it offers a\nTUI that lets you grab exactly what you need without the wait times of a\nfull git clone.\n\nIt also supports fuzzy search and repository discovery, in-TUI file\npreviews, GitHub LFS, batch downloads and OS/architecture-aware GitHub\nrelease asset downloads.",
      "dev_url": "https://github.com/abhixdd/ghgrab",
      "doc_url": "https://ghgrab.readthedocs.io/",
      "home": "https://github.com/abhixdd/ghgrab",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Browse and download files from GitHub, GitLab, Codeberg, Gitea and Forgejo from your terminal"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "ghgrab",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable",
            "pkg-config"
          ],
          "host": [
            "liblzma-devel"
          ],
          "run": []
        },
        "tests": [
          {
            "script": [
              "ghgrab --help",
              "ghgrab --version",
              "ghg --help"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "ghgrab",
                "ghg"
              ],
              "strict": true
            }
          }
        ],
        "version": "2.0.2"
      },
