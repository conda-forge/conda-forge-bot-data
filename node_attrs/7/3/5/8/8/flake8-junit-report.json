  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.1.0\"\n  python_min: \"3.11\"\n\nrecipe:\n  name: flake8-junit-report\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/f/flake8-junit-report/flake8-junit-report-${{ version }}.tar.gz\n  sha256: f8890c1ebe0acb516fefacddec4b802bca9f89bb07db933e4ee3cd11ceaa1e8b\n\nbuild:\n  number: 2\n  noarch: python\n\noutputs:\n  - package:\n      name: flake8-junit-report\n    build:\n      noarch: python\n      script: ${{ PYTHON }} -m pip install . --no-deps -vv\n      python:\n        entry_points:\n          - flake8_junit = junit_conversor.__main__:main\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - setuptools\n      run:\n        - python >=${{ python_min }}\n        - flake8\n    tests:\n      - python:\n          imports:\n            - junit_conversor\n          pip_check: true\n          python_version:\n            - ${{ python_min }}\n            - \"*\"\n      - files:\n          recipe:\n            - test_flake8_file.py\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n        script:\n          - flake8 test_flake8_file.py --output-file flake8.txt || python -m junit_conversor flake8.txt flake8_junit.xml\n\n  - package:\n      name: flake8_junit_report\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - ${{ pin_subpackage(\"flake8-junit-report\", exact=True) }}\n\nabout:\n  homepage: https://github.com/initios/flake8-junit-report\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: LICENSE\n  summary: Simple tool that converts a flake8 file to junit format. Use it on your CI server to see the flake8 failures with ease\n  repository: https://github.com/initios/flake8-junit-report\n\nextra:\n  recipe-maintainers:\n    - timkpaine\n",
