  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  tag_version: \"2_4_7_2\"\n  version: ${{ tag_version | replace('_', '.') }}\n\npackage:\n  name: clhep\n  version: ${{ version }}\n\nsource:\n  url: https://gitlab.cern.ch/CLHEP/CLHEP/-/archive/CLHEP_${{ tag_version }}/CLHEP-CLHEP_${{ tag_version }}.tar.gz\n  sha256: c40c239fa2c5810b60f4e9ddd6a8cc2ce81b962aa170994748cd2a2b5ac87f84\n  target_directory: CLHEP\n\nbuild:\n  number: 2\n  skip: win\n  dynamic_linking:\n    overlinking_behavior: error\n    overdepending_behavior: error\n\nrequirements:\n  build:\n    - cmake\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib(\"c\") }}\n    - make\n  run_exports:\n    - ${{ pin_subpackage('clhep', upper_bound='x.x.x.x') }}\n\ntests:\n  - package_contents:\n      strict: true\n      bin:\n        - clhep-config\n      lib:\n        - CLHEP\n      include:\n        - CLHEP/ClhepVersion.h\n      files:\n        exists:\n          # One config script per component, plus the top-level one.\n          - bin/*-config\n          - include/CLHEP/**\n          # module.modulemap up to 2.4.4.0, clhep.modulemap from 2.4.4.1 on.\n          - include/*.modulemap\n          # Shared and static, full library and per-component, each also under a\n          # version-stamped name.\n          - lib/libCLHEP*\n          - lib/CLHEP-${{ version }}/CLHEPConfig.cmake\n          - lib/CLHEP-${{ version }}/**\n          - lib/pkgconfig/*.pc\n  - script:\n      file: test_clhep\n      env:\n        CLHEP_VERSION: ${{ version }}\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - make\n\nabout:\n  license: LGPL-3.0-only\n  license_file: CLHEP/COPYING.LESSER\n  summary: A Class Library for High Energy Physics\n  description: |\n    It is intended to be a set of HEP specific foundation and utility classes such as\n    random generators, physics vectors, geometry and linear algebra.\n  homepage: http://proj-clhep.web.cern.ch/proj-clhep/\n  repository: https://gitlab.cern.ch/CLHEP/CLHEP\n  documentation: http://proj-clhep.web.cern.ch/proj-clhep/index.html#docu\n\nextra:\n  recipe-maintainers:\n    - giacomov\n    - jasercion\n    - Areustle\n    - chrisburr\n    - tkittel\n",
