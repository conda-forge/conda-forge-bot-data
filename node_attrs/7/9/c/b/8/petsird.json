  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.10.0\"\n\nrecipe:\n  name: petsird\n  version: ${{ version }}\n\nbuild:\n  number: 1\n  skip:\n    - win\n    - osx and not arm64\n\noutputs:\n  - package:\n      name: petsird\n    source:\n      - url: https://pypi.org/packages/source/p/petsird/petsird-${{ version }}.tar.gz\n        sha256: cc63f8d3605b44668567ecdee2c355ac78c8e1ba4f55ba31d54215a82812e282\n    build:\n      noarch: python\n      skip:\n        - not linux\n      script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - setuptools >=42\n        - setuptools-scm >=3.4\n        - pip\n      run:\n        - python >=${{ python_min }}\n        - numpy >=1.22\n    tests:\n      - python:\n          imports:\n            - petsird\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n  - package:\n      name: libpetsird\n    source:\n      - if: target_platform == \"linux-64\"\n        then:\n          url: https://github.com/ETSInitiative/PETSIRD/releases/download/v${{ version }}/petsird_v${{ version }}_linux_x86_64.tar.gz\n          sha256: 3edc9333cbe3b801c1581df1d31ce8f57d04b1ef82367197bdfadb4e8e88f278\n      - if: target_platform == \"osx-arm64\"\n        then:\n          url: https://github.com/ETSInitiative/PETSIRD/releases/download/v${{ version }}/petsird_v${{ version }}_darwin_arm64.tar.gz\n          sha256: ca84943e71184e9a8253faac269c7dee1257896b233889752ea10c785a509284\n    build:\n      script: cp -R include lib $PREFIX\n      files:\n        - include/*\n        - lib/*\n    tests:\n      - package_contents:\n          include:\n            - petsird_helpers.h\n            - petsird/types.h\n            - petsird/protocols.h\n            # self-distributed yardl (i.e. under petsird/) since there is no yardl-headers conda package (yet) to pin to instead\n            - petsird/yardl/yardl.h\n          files:\n            - lib/cmake/PETSIRD-*/PETSIRDConfig.cmake\n            - lib/cmake/PETSIRD-*/PETSIRDConfigVersion.cmake\n            - lib/*petsird.* # libpetsird.a or equivalent should be present\n\nabout:\n  summary: Library and tools for working with Positron Emission Tomography Standardization Initiative Raw Data (PETSIRD)\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://github.com/ETSInitiative/PETSIRD\n\nextra:\n  recipe-maintainers:\n    - gschramm\n    - KrisThielemans\n    - casperdcl\n",
