  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: filament\n  version: \"1.71.5\"\n  python: \"3.12\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/google/filament/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: d137b3fae02d138734bd1e16e350ad8fcd179b40bb04ce3831d09c62d7c362b3\n  patches:\n    - patches/0001-guard-newer-metal-command-buffer-errors.patch\n    - patches/0002-drop-strict-vtable-pointers-with-gcc.patch\n    - patches/0003-use-system-libpng-zlib.patch\n    - patches/0004-build-selected-shared-libraries.patch\n\nbuild:\n  number: 0\n  skip: win\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n    - python ${{ python }}.*\n  host:\n    - assimp\n    - if: linux\n      then: libegl-devel\n    - if: linux\n      then: libgl-devel\n    - if: linux\n      then: libgles-devel\n    - libpng\n    - meshoptimizer\n    - zlib\n    - zstd\n  run:\n    - meshoptimizer\n    - tsl_robin_map\n    - zstd\n  run_exports:\n    - ${{ pin_subpackage('filament', upper_bound='x.x') }}\n  ignore_run_exports:\n    from_package:\n      - if: linux\n        then: libgles-devel\n\ntests:\n  - files:\n      recipe:\n        - bakedColor.mat\n        - check_package_payload.py\n        - test-cmake\n    requirements:\n      run:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - ninja\n        - python ${{ python }}.*\n    script:\n      - python check_package_payload.py\n      - matc --help\n      - matinfo --help\n      - cmgen --help\n      - filamesh --help\n      - matc -a opengl -p desktop -o bakedColor.filamat bakedColor.mat\n      - test -f \"${PREFIX}/include/filament/Engine.h\"\n      - test -f \"${PREFIX}/include/backend/DriverEnums.h\"\n      - test -f \"${PREFIX}/lib/libfilament${SHLIB_EXT}\"\n      - test -f \"${PREFIX}/lib/libbackend${SHLIB_EXT}\"\n      - test -f \"${PREFIX}/lib/libutils${SHLIB_EXT}\"\n      - test -f \"${PREFIX}/lib/cmake/Filament/FilamentConfig.cmake\"\n      - cmake -S test-cmake -B test-cmake-build -G Ninja -DCMAKE_BUILD_TYPE=Release\n      - cmake --build test-cmake-build --verbose\n      - ./test-cmake-build/hello_world\n\nabout:\n  summary: Real-time physically based rendering engine\n  description: |\n    Filament is a real-time physically based rendering engine for Android,\n    iOS, Windows, Linux, macOS, and WebGL2. This package provides host-side\n    command line tools and a constrained shared C++ development surface for\n    downstream consumers.\n  license: Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND MIT AND Zlib\n  license_file:\n    - LICENSE\n    - third_party/basisu/LICENSE\n    - third_party/benchmark/LICENSE\n    - third_party/cgltf/LICENSE\n    - third_party/civetweb/LICENSE.md\n    - third_party/clang/LICENSE.TXT\n    - third_party/dawn/LICENSE\n    - third_party/getopt/LICENSE\n    - third_party/gl-matrix/LICENSE.md\n    - third_party/glslang/LICENSE\n    - third_party/glslang/LICENSE.txt\n    - third_party/gltumble/LICENSE\n    - third_party/jsmn/LICENSE\n    - third_party/libgtest/LICENSE\n    - third_party/markdeep/LICENSE\n    - third_party/robin-map/LICENSE\n    - third_party/smol-v/LICENSE\n    - third_party/spirv-cross/LICENSE\n    - third_party/spirv-cross/LICENSES/LicenseRef-KhronosFreeUse.txt\n    - third_party/spirv-headers/LICENSE\n    - third_party/spirv-tools/LICENSE\n    - third_party/stb/LICENSE\n    - third_party/tinyexr/LICENSE\n    - third_party/vkmemalloc/LICENSE.txt\n  homepage: https://github.com/google/filament\n  repository: https://github.com/google/filament\n\nextra:\n  recipe-maintainers:\n    - jeongseok-meta\n",
