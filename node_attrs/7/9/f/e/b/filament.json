        "tests": [
          {
            "files": {
              "recipe": [
                "bakedColor.mat",
                "check_package_payload.py",
                "test-cmake"
              ]
            },
            "requirements": {
              "run": [
                "cxx_compiler_stub",
                "c_stdlib_stub",
                "cmake",
                "ninja",
                "python 3.12.*"
              ]
            },
            "script": [
              "python check_package_payload.py",
              "matc --help",
