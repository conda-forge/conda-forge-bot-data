  "raw_meta_yaml": "context:\n  version: \"27.1.0\"\n\npackage:\n  name: cargo-mutants\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/sourcefrog/cargo-mutants/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: e57d8c31a8edee7d9265949aef896768729c824626897938e98a5d162a82bda0\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .\n          - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n          - $PREFIX/bin/cargo-mutants mutants --completions zsh > $PREFIX/share/zsh/site-functions/_cargo-mutants\n          - $PREFIX/bin/cargo-mutants mutants --completions bash > $PREFIX/share/bash-completion/completions/cargo-mutants\n          - $PREFIX/bin/cargo-mutants mutants --completions fish > $PREFIX/share/fish/vendor_completions.d/cargo-mutants.fish\n        else:\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path .\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n\ntests:\n  - script:\n      - cargo-mutants mutants --version\n  - package_contents:\n      bin:\n        - cargo-mutants\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/cargo-mutants\n            - share/fish/vendor_completions.d/cargo-mutants.fish\n            - share/zsh/site-functions/_cargo-mutants\n      strict: true\n\nabout:\n  homepage: https://mutants.rs/\n  summary: Inject bugs and see if your tests catch them\n  description: |\n    cargo-mutants is a mutation testing tool for Rust. It modifies your source\n    code to check that test failures are detected, helping you find gaps in test\n    coverage that traditional line coverage tools miss.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://mutants.rs/\n  repository: https://github.com/sourcefrog/cargo-mutants\n\nextra:\n  recipe-maintainers:\n    - ytausch\n",
