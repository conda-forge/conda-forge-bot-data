  "linux_64_meta_yaml": {
    "about": {
      "description": "The Versity S3 Gateway (versitygw) is an open-source, stateless server that\npresents an AWS S3-compatible API in front of existing storage systems,\nincluding POSIX filesystems, Versity ScoutFS, Azure Blob Storage, and other\nS3 servers. It is written in Go and licensed under Apache 2.0.",
      "dev_url": "https://github.com/versity/versitygw",
      "doc_url": "https://github.com/versity/versitygw/wiki",
      "home": "https://github.com/versity/versitygw",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "src/LICENSE",
      "summary": "High-performance S3-compatible gateway that translates S3 API calls to filesystem and other storage backends"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src",
        "go-licenses save ./cmd/versitygw --save_path ../library_licenses",
        "go build -v -trimpath -o ${PREFIX}/bin/versitygw -ldflags=\"-s -w -X main.Version=v${{ version }}\" ./cmd/versitygw"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "tropicrainforest"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "versitygw",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "versitygw --version",
              "versitygw --help"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "versitygw"
              ],
              "strict": true
            }
          }
        ],
        "version": "1.4.1"
      }
