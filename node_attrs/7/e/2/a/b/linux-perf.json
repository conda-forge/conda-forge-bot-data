    },
    "outputs": [
      {
        "build": null,
        "name": "linux-perf",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "cxx_compiler_stub",
            "c_stdlib_stub",
            "make",
            "flex",
            "bison",
            "pkg-config"
          ],
          "host": [
            "elfutils",
            "capstone",
            "libcapstone",
            "libnuma",
            "libtraceevent",
            "slang",
            "liblzma-devel",
            "zlib",
            "zstd",
            "python",
            "setuptools"
          ],
          "run": [
            "python",
            "libnuma"
          ]
        },
        "tests": [
          {
            "script": [
              "perf version --build-options",
              "for f in libtraceevent libslang libcapstone libelf dwarf debuginfod libpython libnuma zlib lzma zstd bpf aio; do perf version --build-options | grep -E \"$f: +\\[ on\" || { echo \"feature $f is not enabled\"; exit 1; }; done",
              "perf list | grep -i \"cpu-clock\""
            ]
          },
          {
            "package_contents": {
              "bin": [
                "perf",
