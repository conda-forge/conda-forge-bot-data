              ],
              "files": [
                "bin/perf",
                "bin/trace",
                "etc/bash_completion.d/perf",
                "include/perf/perf_dlfilter.h",
                "libexec/perf-core/**",
                "share/doc/perf-tip/**"
              ],
              "include": [
                "perf/perf_dlfilter.h"
              ],
              "strict": true
            }
          }
        ],
        "version": "7.2.2"
