  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  python_min: \"3.11\"\n  name: lomap2\n  package_name: lomap\n  version: \"3.3.0\"\n\nrecipe:\n  name: lomap2-suite\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/OpenFreeEnergy/${{ package_name }}/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 624cc8d71febd2e4d054456713670dd9993bd811e7ee5a02bab5ad134e38855b\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: lomap2-base\n    build:\n      noarch: python\n      script: SETUPTOOLS_SCM_PRETEND_VERSION=${{ version }} ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n      python:\n        entry_points:\n          - lomap = lomap.dbmol:startup\n    requirements:\n      host:\n        - pip\n        - python ${{ python_min }}.*\n        - setuptools\n        - setuptools_scm\n      run:\n        - matplotlib-base\n        - networkx\n        - numpy\n        - python >=${{ python_min }}\n        - rdkit >=2024\n    tests:\n      - python:\n          imports:\n            - lomap\n          pip_check: true\n          python_version: ${{ python_min }}\n      - requirements:\n          run:\n            - pip\n            - pytest-xdist\n            - python ${{ python_min }}.*\n        script:\n          - lomap --help\n          - python -c \"import ${{ package_name }}; print(${{ package_name }}.__version__)\"\n          - python -c \"import ${{ package_name }}; assert(${{ package_name }}.__version__ == '${{ version }}')\"\n          - pytest -v -n auto --pyargs lomap\n  - package:\n      name: lomap2\n    build:\n      noarch: python\n    requirements:\n      host:\n        - pip\n        - python ${{ python_min }}.*\n        - setuptools\n        - setuptools_scm\n      run:\n        - gufe ~=1.0\n        - ${{ pin_subpackage('lomap2-base', exact=True) }}\n    tests:\n      - python:\n          imports:\n            - lomap\n          pip_check: true\n          python_version: ${{ python_min }}\n      - requirements:\n          run:\n            - pip\n            - pytest-xdist\n            - python ${{ python_min }}.*\n        script:\n          - lomap --help\n          - python -c \"import ${{ package_name }}; print(${{ package_name }}.__version__)\"\n          - python -c \"import ${{ package_name }}; assert(${{ package_name }}.__version__ == '${{ version }}')\"\n          - pytest -v -n auto --pyargs lomap\n  - package:\n      name: lomap2-extra\n    build:\n      noarch: python\n    requirements:\n      host:\n        - pip\n        - python ${{ python_min }}.*\n        - setuptools\n        - setuptools_scm\n      run:\n        - pygraphviz\n        - ${{ pin_subpackage('lomap2', exact=True) }}        \n    tests:\n      - python:\n          imports:\n            - lomap\n          pip_check: true\n          python_version: ${{ python_min }}\n      - requirements:\n          run:\n            - pip\n            - pytest-xdist\n            - python ${{ python_min }}.*\n        script:\n          - lomap --help\n          - python -c \"import ${{ package_name }}; print(${{ package_name }}.__version__)\"\n          - python -c \"import ${{ package_name }}; assert(${{ package_name }}.__version__ == '${{ version }}')\"\n          - pytest -v -n auto --pyargs lomap\n\nabout:\n  homepage: https://openfree.energy/\n  repository: https://github.com/OpenFreeEnergy/Lomap\n  documentation: https://lomap.openfree.energy/en/latest/\n  license: MIT\n  license_file: LICENSE.txt\n  summary: Alchemical mutation scoring map\n  description: |\n    Lead optimization mapper (LOMAP) is an automated algorithm to plan efficient \n    relative free energy calculations between potential ligands within a \n    substantial of compounds. The original LOMAP code was mainly based \n    on commercial APIs such as OpenEye and Schrodinger. \n    The aim of this project is to develop a new version of LOMAP based on \n    free avalaible APIs such as RDKit offering the scientific community \n    a free tool to plan in advance binding free energy calculations.\n\nextra:\n  feedstock-name: lomap2\n  recipe-maintainers:\n    - atravitz\n    - mikemhenry\n    - atravitz\n    - IAlibay\n    - dwhswenson\n",
