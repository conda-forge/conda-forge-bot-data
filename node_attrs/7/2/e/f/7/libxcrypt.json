  "raw_meta_yaml": "context:\n  version: \"4.4.38\"\n\nrecipe:\n  name: libxcrypt-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/besser82/libxcrypt/releases/download/v${{ version }}/libxcrypt-${{ version }}.tar.xz\n  sha256: 80304b9c306ea799327f01d9a7549bdb28317789182631f1b54f4511b4206dd6\n\nbuild:\n  number: 0\n  skip: win\n\noutputs:\n  - package:\n      name: libxcrypt\n    build:\n      skip: win\n      script:\n        file: build\n        env:\n          OBSOLETE_API: \"no\"\n    requirements:\n      build:\n        - ${{ stdlib(\"c\") }}\n        - ${{ compiler(\"c\") }}\n        - make\n        - pkg-config\n        # We get perl from yum to avoid creating a dependency cycle\n        # - perl\n      run_exports:\n        # The ABI is very stable\n        - ${{ pin_subpackage('libxcrypt', upper_bound=None) }}\n    tests:\n      - package_contents:\n          # see below\n          # include: crypt.h\n          # lib: crypt\n          files:\n            exists:\n              # moved here due to https://github.com/prefix-dev/rattler-build/issues/2722\n              - include/crypt.h\n              - if: linux\n                then: lib/libcrypt.so\n                else: lib/libcrypt.dylib\n              # pkgconfig metadata\n              - lib/pkgconfig/libxcrypt.pc\n              # correct SOVER\n              - if: linux\n                then: lib/libcrypt.so.2\n                else: lib/libcrypt.2.dylib\n            not_exists:\n              # incorrect SOVER\n              - if: linux\n                then: lib/libcrypt.so.1\n                else: lib/libcrypt.1.dylib\n\n  # the difference is OBSOLETE_API\n  - package:\n      name: libxcrypt1\n    build:\n      skip: not linux\n      script:\n        file: build\n        env:\n          OBSOLETE_API: \"glibc\"\n    requirements:\n      build:\n        - ${{ stdlib(\"c\") }}\n        - ${{ compiler(\"c\") }}\n        - make\n        - pkg-config\n        - perl\n    tests:\n      - package_contents:\n          files:\n            exists:\n              - lib/libcrypt.so.1\n            not_exists:\n              # should be in libxcrypt output\n              - include/crypt.h\n              - lib/libcrypt.so\n              - lib/libcrypt.dylib\n              - lib/pkgconfig/libxcrypt.pc\n\nabout:\n  homepage: https://github.com/besser82/libxcrypt\n  repository: https://github.com/besser82/libxcrypt\n  license: LGPL-2.1-or-later\n  license_file:\n    - COPYING.LIB\n    - LICENSING\n  summary: Extended crypt library for descrypt, md5crypt, bcrypt, and others\n\nextra:\n  recipe-maintainers:\n    - chrisburr\n    - mbargull\n    - h-vetinari\n  feedstock-name: libxcrypt\n",
