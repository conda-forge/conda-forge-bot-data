  "raw_meta_yaml": "context:\n  version: \"0.8.2\"\n\npackage:\n  name: veccore\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/root-project/veccore/archive/v${{ version }}.tar.gz\n  sha256: 1268bca92acf00acd9775f1e79a2da7b1d902733d17e283e0dd5e02c41ac9666\n\nbuild:\n  script:\n    - cmake -S . -B build -G Ninja -DVC=ON -DUMESIMD=OFF -DCUDA=OFF -DBUILD_TESTING=ON -DBUILD_BENCHMARKS=OFF -DBUILD_VC=OFF -DBUILD_UMESIMD=OFF ${CMAKE_ARGS}\n    - cmake build -LH\n    - cmake --build build --parallel ${CPU_COUNT}\n    # Test binaries are built for the target; only run them on native builds.\n    - if: build_platform == target_platform\n      then: ctest --test-dir build --output-on-failure\n    - cmake --install build\n  number: 3\n  skip:\n    - win\n\nrequirements:\n  build:\n    - ${{ compiler(\"cxx\") }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - gtest\n    - ninja\n  host:\n    - vector-classes\n  ignore_run_exports:\n    # Header-only package: no compiled artifacts ship, so the C++ runtime and C\n    # stdlib run-exports pulled in by the compiler/stdlib are spurious here.\n    from_package:\n      - ${{ compiler(\"cxx\") }}\n      - ${{ stdlib(\"c\") }}\n\ntests:\n  - package_contents:\n      include:\n        - VecCore/*\n      files:\n        - lib/cmake/VecCore/*\n      strict: true\n\nabout:\n  homepage: https://github.com/root-project/veccore\n  summary: 'An abstraction layer on top of other vectorization libraries - VecCore'\n  description: |\n    VecCore is a simple abstraction layer on top of other vectorization libraries. It provides an\n    architecture-independent API for expressing vector operations on data. Code written with this API can\n    then be dispatched to one of several backends implemented using libraries like Vc, UME::SIMD, or a\n    scalar implementation.\n  license: Apache-2.0\n  license_file: LICENSE\n  documentation: https://root-project.github.io/veccore/docs/latest/index.html\n  repository: https://github.com/root-project/veccore\n\nextra:\n  recipe-maintainers:\n    - utk4r-sh\n    - GiacomoXT\n    - vvsagar\n    - AlexanderHeidelbach\n",
