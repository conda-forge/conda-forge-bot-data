      "license_file": "LICENSE",
      "summary": "An abstraction layer on top of other vectorization libraries - VecCore"
    },
    "build": {
      "number": "3",
      "script": [
        "cmake -S . -B build -G Ninja -DVC=ON -DUMESIMD=OFF -DCUDA=OFF -DBUILD_TESTING=ON -DBUILD_BENCHMARKS=OFF -DBUILD_VC=OFF -DBUILD_UMESIMD=OFF ${CMAKE_ARGS}",
        "cmake build -LH",
        "cmake --build build --parallel ${CPU_COUNT}",
        "ctest --test-dir build --output-on-failure",
        "cmake --install build"
      ]
    },
