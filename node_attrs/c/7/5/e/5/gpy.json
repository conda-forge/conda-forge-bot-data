  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: GPy\n  version: \"1.14.2\"\n  sha256: 3c6a102cd0939ca62aab27038acc7c9970559fbda653dbdccc5d8ad02bd1dbad\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name | lower }}-${{ version }}.tar.gz\n  sha256: ${{ sha256 }}\n\nbuild:\n  number: 2\n  skip: match(python, \"<3.12\")\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then: python\n    - if: build_platform != target_platform\n      then: cross-python_${{ target_platform }}\n    - if: build_platform != target_platform\n      then: numpy\n    - if: build_platform != target_platform\n      then: cython\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n  host:\n    - python\n    - pip\n    - numpy\n    - cython\n    - setuptools\n    - scipy >=0.16\n    - six\n  run:\n    - python\n    - cython\n    - paramz >0.9.6\n    - ${{ pin_compatible('numpy') }}\n    - scipy\n    - six\n    - matplotlib-base\n\ntests:\n  - requirements:\n      run:\n        - pip\n    script:\n      - if: linux and match(python, \">=2,<3\")\n        then: export MPLBACKEND=\"AGG\"\n      - python -c \"import GPy\"\n      - pip check\n\nabout:\n  license: BSD-3-Clause\n  license_file: LICENSE.txt\n  summary: The Gaussian Process Toolbox\n  homepage: http://github.com/SheffieldML/GPy\n  repository: https://github.com/SheffieldML/GPy\n  documentation: https://pythonhosted.org/GPy/\n\nextra:\n  recipe-maintainers:\n    - dirmeier\n    - thompsonsed\n    - jan-janssen\n",
