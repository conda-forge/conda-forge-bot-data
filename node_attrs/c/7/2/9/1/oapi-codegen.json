  "raw_meta_yaml": "context:\n  version: \"2.7.0\"\n\npackage:\n  name: oapi-codegen\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/oapi-codegen/oapi-codegen/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: ceb1c0f9812b7d7c8ea9a5f05790ee80020e7b65c7872eb6bf0425c1ef2c9825\n  target_directory: src\n\nbuild:\n  number: 0\n  script:\n    - cd src\n    - go-licenses save ./cmd/oapi-codegen --save_path \"../library_licenses\"\n    - if: unix\n      then: go build -v -o $PREFIX/bin/oapi-codegen -ldflags=\"-s -w\" ./cmd/oapi-codegen\n      else: go build -v -o %LIBRARY_BIN%\\oapi-codegen.exe -ldflags=\"-s -w\" ./cmd/oapi-codegen\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script: oapi-codegen --help\n  - package_contents:\n      bin:\n        - oapi-codegen\n      strict: true\n\nabout:\n  homepage: https://github.com/oapi-codegen/oapi-codegen\n  summary: Generate Go client and server boilerplate from OpenAPI 3 specifications\n  description: |\n    oapi-codegen is a Go-based tool for generating Go client and server boilerplate\n    code from OpenAPI 3 specifications. It supports generating types, client code,\n    server code, and more from a single OpenAPI specification file.\n  license: Apache-2.0\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n  documentation: https://pkg.go.dev/github.com/oapi-codegen/oapi-codegen/v2\n  repository: https://github.com/oapi-codegen/oapi-codegen\n\nextra:\n  recipe-maintainers:\n    - xhochy\n",
