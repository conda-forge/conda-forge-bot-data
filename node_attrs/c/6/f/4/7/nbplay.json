  "raw_meta_yaml": "context:\n  version: \"0.1.1\"\n\npackage:\n  name: nbplay\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/n/nbplay/nbplay-${{ version }}.tar.gz\n  sha256: 455956bacf2d48d7bcb457e3f1ae8a9e1b1634feebc3328254ed1950a891e450\n\nbuild:\n  number: 0\n  python:\n    version_independent: true\n  script:\n    - if: unix\n      then:\n        - export PYO3_PYTHON=\"$PYTHON\"\n        - export RUSTFLAGS=\"\"\n      else:\n        - set \"PYO3_PYTHON=%PYTHON%\"\n        - set \"RUSTFLAGS=\"\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  skip: is_abi3 and not is_python_min\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('rust') }}\n    - rust-std-wasm32-unknown-unknown\n    - wasm-bindgen-cli ==0.2.121\n    - cargo-bundle-licenses\n    - if: linux\n      then:\n        - pkg-config\n  host:\n    - python\n    - pip\n    - hatchling\n    - hatch-js\n    - hatch-rs\n    - pnpm\n    - if: linux\n      then:\n        - alsa-lib\n    - if: is_abi3\n      then:\n      - python-abi3\n  run:\n    - python\n    - anywidget\n    - ipywidgets >=8\n  ignore_run_exports:\n    from_package:\n      - cross-python_${{ target_platform }}\n\ntests:\n  - python:\n      imports:\n        - nbplay\n      pip_check: true\n      python_version: ${{ python_min }}.*\n  - if: is_abi3\n    then:\n      script:\n        - if: win\n          then: abi3audit %PREFIX%/Lib/site-packages/nbplay/nbplay.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          else:\n            - export SP_DIR=$(python -c \"import site; print(site.getsitepackages()[0])\")\n            - abi3audit $SP_DIR/nbplay/nbplay.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      requirements:\n        run:\n          - abi3audit\n\nabout:\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: Let's play!\n  homepage: https://github.com/1kbgz/nbplay\n  repository: https://github.com/1kbgz/nbplay\n\nextra:\n  recipe-maintainers:\n    - timkpaine\n",
