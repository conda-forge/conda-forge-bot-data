  "linux_64_meta_yaml": {
    "about": {
      "description": "A subcommand for Cargo that builds a Windows installer (MSI) using the\nWiX Toolset from the contents of a Cargo project. It can optionally sign\nthe installer if a code signing certificate is available.",
      "dev_url": "https://github.com/volks73/cargo-wix",
      "doc_url": "https://volks73.github.io/cargo-wix",
      "home": "https://github.com/volks73/cargo-wix",
      "license": "MIT OR Apache-2.0",
      "license_family": "MIT OR Apache-2.0",
      "license_file": "LICENSE-APACHE",
      "summary": "Build Windows installers using the WiX Toolset"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "Hofer-Julian",
        "baszalmstra"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "cargo-wix",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": "cargo-wix --help"
          },
          {
            "package_contents": {
              "bin": [
                "cargo-wix"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.3.9"
      }
    ],
