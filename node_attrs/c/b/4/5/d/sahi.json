  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: sahi\n  version: \"0.12.6\"\n  python_min: '3.10'\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/sahi-${{ version }}.tar.gz\n  sha256: edc8457a4a4432e7466c80afab71b0faf6990a7bd534f8fcd389680f967ddbf8\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - sahi=sahi.cli:app\n\nrequirements:\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - hatchling\n  run:\n    # IMPORTANT: please use py-opencv, not opencv, see\n    # https://github.com/conda-forge/sahi-feedstock/pull/58#discussion_r1674766023\n    - click\n    - fire\n    - matplotlib-base\n    - numpy\n    - pillow >=8.2.0\n    - py-opencv >=4.12.0.88\n    - python >=${{ python_min }}\n    - pyyaml\n    - requests\n    - shapely >=2.0.0\n    - tqdm >=4.48.2\ntests:\n  - python:\n      imports:\n        - sahi\n        - sahi.annotation\n        - sahi.auto_model\n        - sahi.postprocess\n        - sahi.prediction\n        - sahi.models.base\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - sahi --help\n      - sahi coco --help\n      - sahi version\n\nabout:\n  homepage: https://obss.github.io/sahi/\n  repository: https://github.com/obss/sahi\n  summary: A vision library for performing sliced inference on large images/small objects\n  license: MIT\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - onuralpszr\n    - fcakyon\n    - weiji14\n",
