  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: viser\n  version: \"1.1.0\"\n  build_number: 0\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  # PyPI sdist includes the pre-built web client. GitHub archives do not.\n  - url: https://pypi.org/packages/source/v/viser/viser-${{ version }}.tar.gz\n    sha256: 28c27da73f391fdc7a1ffc3e3d122fd8eede9d15508128bc53c7e02904169412\n  # Keep upstream's tests/docs without overlaying the GitHub source tree.\n  - url: https://github.com/viser-project/viser/archive/refs/tags/v${{ version }}.zip\n    sha256: 028444c36690923b063b7bc73692dabf60bd98fe29f990860e5b9d11dbfb0891\n    target_directory: upstream-src\n\nbuild:\n  noarch: python\n  number: ${{ build_number }}\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - viser-build-client = viser._client_autobuild:build_client_entrypoint\n\nrequirements:\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - hatchling\n  run:\n    - python >=${{ python_min }}\n    - requests >=2.0.0,<3.0.0\n    - websockets >=13.1,<17.0.0\n    - numpy >=1.0.0,<3.0.0\n    - msgspec >=0.18.6,<1.0.0\n    - imageio >=2.0.0,<3.0.0\n    - tqdm >=4.0.0,<5.0.0\n    - rich >=13.3.3,<15.0.0\n    - trimesh >=3.21.7,<5.0.0\n    - typing-extensions >=4.0.0\n    - zstandard >=0.20.0,<1.0.0\n\ntests:\n  - python:\n      imports:\n        - viser\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      # Browser e2e tests require Playwright-managed browsers; keep the\n      # feedstock validation to import and unit-level tests.\n      # Keep localhost HTTP checks out of proxy environments.\n      - export NO_PROXY=\"localhost,127.0.0.1,${NO_PROXY:-}\"\n      - export no_proxy=\"localhost,127.0.0.1,${no_proxy:-}\"\n      - pytest upstream-src/tests --ignore upstream-src/tests/e2e --deselect \"upstream-src/tests/test_image_encode.py::test_image_encode_png\" --deselect \"upstream-src/tests/test_version_sync.py::test_versions_match\"\n    files:\n      source:\n        - upstream-src/tests/\n        - upstream-src/docs/source/api/\n        # Upstream's camera-default parity tests inspect the TypeScript source.\n        - upstream-src/src/viser/client/src/CameraControls.tsx\n        - upstream-src/src/viser/client/src/InitialCameraState.ts\n    requirements:\n      run:\n        - hypothesis\n        - pip\n        - pytest\n        - python ${{ python_min }}.*\n\nabout:\n  homepage: https://github.com/viser-project/viser\n  summary: Web-based 3D visualization in Python\n  license: Apache-2.0\n  license_file: LICENSE\n\nextra:\n  feedstock-name: viser\n  recipe-maintainers:\n    - jeongseok-meta\n",
