  "linux_64_meta_yaml": {
    "about": {
      "description": "Python library from Pollen Robotics for reading the Bosch BMI088\nsix-axis inertial measurement unit (accelerometer and gyroscope) over\nI2C using smbus3, with sensor fusion for orientation estimation built\non the ahrs library. It is used for the IMU in the Reachy Mini robot.",
      "dev_url": "https://github.com/pollen-robotics/pollen_BMI088_imu_library",
      "home": "https://pypi.org/project/pollen-bmi088-imu-library/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "BMI088 IMU library for Pollen Robotics hardware"
    },
    "build": {
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "ruben-arts"
      ]
    },
    "outputs": [
      {
