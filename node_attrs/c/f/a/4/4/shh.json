  "linux_64_meta_yaml": {
    "about": {
      "description": "Systemd Hardening Helper (SHH) can generate an optimal set of hardening\noptions for systemd services. It profiles service behavior using strace and\nautomatically generates appropriate systemd security options, enabling\nsecurity hardening without breaking services due to overly restrictive\nsandboxing.",
      "dev_url": "https://github.com/desbma/shh",
      "home": "https://github.com/desbma/shh",
      "license": "GPL-3.0-only",
      "license_family": "GPL-3.0-only",
      "license_file": "LICENSE",
      "summary": "Automatic systemd service hardening guided by strace profiling"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --features=generate-extras --root=\"$PREFIX\" --path .",
          "mkdir -p \"$PREFIX\"/share/man/man1 \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions",
          "\"$PREFIX\"/bin/shh gen-man-pages                        \"$PREFIX\"/share/man/man1",
          "\"$PREFIX\"/bin/shh gen-shell-completions --shell=bash > \"$PREFIX\"/share/bash-completion/completions/shh",
          "\"$PREFIX\"/bin/shh gen-shell-completions --shell=fish > \"$PREFIX\"/share/fish/vendor_completions.d/shh.fish",
          "\"$PREFIX\"/bin/shh gen-shell-completions --shell=zsh  > \"$PREFIX\"/share/zsh/site-functions/_shh",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "shh",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [
            "strace"
          ],
          "run": []
        },
        "tests": [
          {
            "requirements": {
              "run": [
                "strace"
              ]
            },
            "script": [
              "shh --help",
              "shh --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
