  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.7.6\"\n\npackage:\n  name: rignore\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/r/rignore/rignore-${{ version }}.tar.gz\n  sha256: 00d3546cd793c30cb17921ce674d2c8f3a4b00501cb0e3dd0e82217dbeba2671\n\nbuild:\n  number: 1\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    env:\n      MATURIN_PEP517_ARGS: \"--features pyo3/abi3-py38\"\n    content:\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - maturin >=1,<2\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n  host:\n    - if: is_abi3\n      then: python-abi3\n    - python\n    - pip\n    - maturin >=1.9.6,<2.0\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - rignore\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/rignore/rignore.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%/rignore/rignore.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://github.com/patrick91/rignore\n  summary: Python Bindings for the ignore crate\n  description: |\n    rignore provides Python bindings for the ignore Rust crate, offering\n    high-performance file system traversal that respects .gitignore rules\n    with customizable ignore patterns and efficient memory usage.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/patrick91/rignore\n\nextra:\n  recipe-maintainers:\n    - pb01ka\n",
