  "raw_meta_yaml": "context:\n  version: \"0.9.0\"\n\npackage:\n  name: polars-cli\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/pola-rs/polars-cli/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 8a3733bf50779c454ec014db0501d63318e6104ac9dd59aa4037688cfc34c126\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      # ethnum 1.5.0 as pinned in Cargo.lock transmutes `()` into `TryFromIntError`,\n      # which no longer compiles since that type stopped being zero-sized. Fixed in 1.5.1.\n      - cargo update --package ethnum --precise 1.5.3\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .\n        else:\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path .\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - if: linux\n      then:\n        # jemallocator is a linux-only dependency and jemalloc-sys builds the\n        # bundled jemalloc with configure + make\n        - make\n\ntests:\n  - script:\n      - polars --help\n      - polars -c \"select 1 as a\"\n  - package_contents:\n      bin:\n        - polars\n      strict: true\n\nabout:\n  homepage: https://github.com/pola-rs/polars-cli\n  summary: CLI interface for running SQL queries with Polars as backend\n  description: |\n    The Polars command line interface provides a convenient way to execute SQL\n    commands using Polars as a backend. Running `polars` without any arguments\n    starts an interactive shell in which SQL commands can be executed against\n    local files, with results printed as tables or written out as CSV, JSON,\n    Parquet, Arrow IPC or Markdown.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/pola-rs/polars-cli\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
