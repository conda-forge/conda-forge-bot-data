  "linux_64_meta_yaml": {
    "about": {
      "description": "The Polars command line interface provides a convenient way to execute SQL\ncommands using Polars as a backend. Running `polars` without any arguments\nstarts an interactive shell in which SQL commands can be executed against\nlocal files, with results printed as tables or written out as CSV, JSON,\nParquet, Arrow IPC or Markdown.",
      "dev_url": "https://github.com/pola-rs/polars-cli",
      "home": "https://github.com/pola-rs/polars-cli",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "CLI interface for running SQL queries with Polars as backend"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cargo update --package ethnum --precise 1.5.3",
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "polars-cli",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "cxx_compiler_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable",
            "make"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "polars --help",
