  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"26.1.0\"\n  python_check_max: \"3.14\"\n\nrecipe:\n  name: service-identity-split\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/s/service-identity/service_identity-${{ version }}.tar.gz\n  sha256: 6358c52882c96e66ac4a55eb3a72c7dd4a70763f8cc6fa4e70abde2656f4bf3b\n\nbuild:\n  number: 0\n  noarch: python\n\noutputs:\n  - package:\n      name: service-identity\n    build:\n      number: 0\n      noarch: python\n      script:\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n    requirements:\n      host:\n        - hatch-fancy-pypi-readme\n        - hatch-vcs\n        - hatchling\n        - pip\n        - python ${{ python_min }}.*\n      run:\n        - attrs >=19.1.0\n        - cryptography >=47\n        - python >=${{ python_min }}\n      run_constraints:\n        - service_identity ${{ version }}.*\n\n  - package:\n      name: service_identity\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"service-identity\", upper_bound=\"x.x.x\") }}\n    tests:\n      - python:\n          imports: service_identity\n          pip_check: false\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n\n  - package:\n      name: service-identity-with-pyopenssl\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"service-identity\", upper_bound=\"x.x.x\") }}\n        - pyopenssl\n    tests:\n      - python:\n          imports: service_identity\n          pip_check: false\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n\n  - package:\n      name: service-identity-with-idna\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"service-identity\", upper_bound=\"x.x.x\") }}\n        - idna\n    tests:\n      - python:\n          imports: service_identity\n          pip_check: false\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n\n  - package:\n      name: service-identity-with-all\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"service-identity\", upper_bound=\"x.x.x\") }}\n        - ${{ pin_subpackage(\"service-identity-with-idna\", upper_bound=\"x.x.x\") }}\n        - ${{ pin_subpackage(\"service-identity-with-pyopenssl\", upper_bound=\"x.x.x\") }}\n    tests:\n      - python:\n          imports: service_identity\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n      - files:\n          source:\n            - tests/\n        requirements:\n          run:\n            - pytest-cov\n            - python ${{ python_min }}.*\n        script:\n          - coverage run --source=service_identity --branch -m pytest -vv --tb=long --color=yes\n          - coverage report --show-missing --skip-covered --fail-under=98\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: Service identity verification for pyOpenSSL.\n  description: |\n    service_identity aspires to give you all the tools you need for verifying\n    whether a certificate is valid for the intended purposes.\n  homepage: https://pypi.org/project/service-identity\n  repository: https://github.com/pyca/service-identity\n  documentation: https://service-identity.readthedocs.io\n\nextra:\n  feedstock-name: service_identity\n  recipe-maintainers:\n    - isuruf\n    - bollwyvl\n",
