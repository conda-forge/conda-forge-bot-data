    "about": {
      "description": "Jsonnet is a data templating language for app and tool developers. It\ngenerates configuration data in JSON, YAML, or any text-based format,\nwith computed expressions, parameters, conditionals, arrays, objects,\nand import. This package provides the C/C++ shared libraries\n(libjsonnet, libjsonnet++), public headers, and the `jsonnet` CLI.\n\nThe conda-forge `jsonnet` package ships only the Python bindings; this\n`libjsonnet` package complements it for native consumers (following the\nlibgit2 / libxml2 naming convention).",
      "dev_url": "https://github.com/google/jsonnet",
      "doc_url": "https://jsonnet.org/",
      "home": "https://jsonnet.org/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Data templating language — C/C++ library, headers, and CLI"
    },
