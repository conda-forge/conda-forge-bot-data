  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.6.2\"\n\npackage:\n  name: deltalake\n  version: ${{ version }}\n\nsource:\n  # no sdist since 1.6.0, https://github.com/delta-io/delta-rs/issues/4645\n  url: https://github.com/delta-io/delta-rs/archive/refs/tags/python-v${{ version }}.tar.gz\n  sha256: af060741b38f2ed8aded4712f2da2302935113921ecc89f3fa8c49d6c1b2bd8e\n\nbuild:\n  number: 0\n  skip:\n    # build failures on ppc64le\n    - ppc64le\n    - is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n    - maturin >=1,<2\n    - make\n    - cargo-bundle-licenses\n    - ${{ compiler('rust') }}\n    - ${{ stdlib(\"c\") }}\n    - if: linux\n      then:\n        - ${{ compiler('c') }}\n    - if: win\n      then: m2-sed\n      else: sed\n    # see https://aws.github.io/aws-lc-rs/requirements/linux.html\n    - if: linux and not (x86_64 or aarch64)\n      then:\n        - cmake\n        - clang\n        - libclang\n  host:\n    - if: is_abi3\n      then: python-abi3\n    - python\n    - maturin >=1,<2\n    - pip\n    - if: linux\n      then: liblzma-devel\n  run:\n    - arro3-core >=0.5.0\n    - deprecated >=1.2.18\n    - python\n  run_constraints:\n    - pyarrow >=21\n\ntests:\n  - python:\n      imports:\n        - deltalake\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/deltalake/_internal.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%/deltalake/_internal.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  summary: Native Delta Lake Python binding based on delta-rs with Pandas integration\n  license: Apache-2.0\n  license_file:\n    - python/LICENSE.txt\n    - python/THIRDPARTY.yml\n  homepage: https://github.com/delta-io/delta-rs\n\nextra:\n  recipe-maintainers:\n    - dhirschfeld\n    - charlesbluca\n    - mgorny\n",
