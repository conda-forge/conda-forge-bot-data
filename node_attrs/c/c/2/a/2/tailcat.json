  "linux_64_meta_yaml": {
    "about": {
      "description": "Tailcat is a remix of Tailscale open source pieces to act like netcat, but\nover Tailscale's data plane, without Tailscale's control plane. Tailscale's\ndata plane gives you point-to-point WireGuard-encrypted tunnels between two\nmachines with DERP as the NAT-hole-punching communication side channel and\nthe relay of last resort if NAT traversal fails. Instead of using the\nTailscale control plane, all tailcat connection metadata is exchanged out of\nband, however you want.\n\nOne side runs a tailcat server (listener) and gets back a short connection\ntoken. The other side passes that token to tailcat's client side to connect.\nAll traffic between the two is encrypted end-to-end with WireGuard.\n\nNo Tailscale account and no root/admin access are required; tailcat does not\nalter the machine's routing tables or DNS.",
      "dev_url": "https://github.com/tailscale/tailcat",
      "doc_url": "https://pkg.go.dev/github.com/tailscale/tailcat",
      "home": "https://github.com/tailscale/tailcat",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "src/LICENSE",
      "summary": "Like netcat, but over Tailscale's data plane, without Tailscale's control plane"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src",
        "go-licenses save ./cmd/tailcat --save_path ../library_licenses",
        "go build -v -o $PREFIX/bin/tailcat -tags \"$(cat build-tags.txt)\" -ldflags=\"-s -w -X main.version=v${{ version }}\" ./cmd/tailcat"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "tailcat",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "tailcat --version",
              "tailcat --help",
              "tailcat version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "tailcat"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.5.0"
      },
      {
