    "about": {
      "description": "- What: Automatically generate shell tab completion scripts for Python CLI apps\n- Why: Speed & correctness. Alternatives like `argcomplete` & `pyzshcomplete` are slow and have side-effects\n- How: `shtab` processes an `argparse.ArgumentParser` object to generate a tab completion script for your shell",
      "dev_url": "https://github.com/tqdm/shtab",
      "home": "https://tqdm.github.io/shtab",
      "license": "MPL-2.0",
      "license_family": "MPL-2.0",
      "license_file": "LICENCE",
      "summary": "Automagic shell tab completion for Python CLI applications"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv --no-build-isolation --no-deps"
    },
    "extra": {
      "recipe-maintainers": [
        "casperdcl",
        "0x2b3bfa0",
        "shcheklein"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "shtab",
        "requirements": {
          "build": [],
          "host": [
            "python 3.10.*",
            "pip",
            "setuptools >=77",
            "setuptools_scm >=3.4",
            "toml"
          ],
          "run": [
            "python >=3.10"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "shtab"
              ],
              "python_version": [
                "3.10.*",
                "*"
              ]
            }
          },
          {
            "files": {
              "source": [
                "tests",
                "pyproject.toml"
              ]
            },
            "requirements": {
              "run": [
                "pytest >=6.0",
                "pytest-cov",
                "pytest-timeout",
                "python 3.10.*"
              ]
            },
            "script": [
              "shtab -h",
              "shtab -u shtab.main.get_main_parser",
              "pytest"
            ]
          }
        ],
        "version": "1.8.1"
      }
    ],
