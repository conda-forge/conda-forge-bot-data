  "raw_meta_yaml": "schema_version: 1\n\npackage:\n  name: uwham\n  version: \"1.0.1\"\n\nsource:\n  url: https://github.com/pittbin/UWHAM-and-SWHAM/archive/refs/tags/v1.0.1.tar.gz\n  sha256: 221b9a7632d9f9a6cd223c763fce436bd4d935fd324556b1c055f87bf9c07ffb\n  # v1.0.1 builds the math.h-><cmath> fix directly upstream (old sysroots /\n  # glibc 2.17 no longer hit the C++17 isinf/isnan conflict), so no patch needed.\n  # (Earlier v1.0.0 needed recipes/uwham/math_h_to_cmath.patch; removed on bump.)\n\nbuild:\n  number: 0\n  # POSIX-only code (unistd.h, getopt) -> no Windows builds\n  skip:\n    - win\n\nrequirements:\n  build:\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - make\n  host:\n    - gsl\n    - libopenblas\n\ntests:\n  - script: uwham -h\n  - package_contents:\n      bin:\n        - uwham\n        - swham\n        - sreswham\n\nabout:\n  homepage: https://github.com/pittbin/UWHAM-and-SWHAM\n  license: MIT\n  license_file: LICENSE\n  summary: Unbinned and Stochastic Weighted Histogram Analysis Method\n\nextra:\n  recipe-maintainers:\n    - pittbin\n",
