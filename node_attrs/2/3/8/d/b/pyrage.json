  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.4.0\"\n\npackage:\n  name: pyrage\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pyrage/pyrage-${{ version }}.tar.gz\n  sha256: 545bf188e8d217ec88c32bc8e8bf56026c8c0b1b1f96d2688cedf1427ab0e827\n  patches:\n    # https://github.com/woodruffw/pyrage/pull/156\n    - 0001-bump-pyo3.patch\n\nbuild:\n  number: 2\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n      - python -m pip install . --no-deps --ignore-installed -vv --no-build-isolation --disable-pip-version-check\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1.0,<2.0\n    - ${{ compiler('rust') }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - maturin >=1.0,<2.0\n    - pip\n    - if: is_abi3\n      then: python-abi3\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - pyrage\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - '*'\n      pip_check: true\n  - if: is_abi3\n    then:\n      script:\n        - if: win\n          then: abi3audit %SP_DIR%/pyrage/pyrage.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit $SP_DIR/pyrage/pyrage.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      requirements:\n        run:\n          - abi3audit\n\nabout:\n  summary: Python bindings for rage (age in Rust)\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/woodruffw/pyrage\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
