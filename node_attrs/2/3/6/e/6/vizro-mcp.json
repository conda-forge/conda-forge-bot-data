  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.1.4\"\n\npackage:\n  name: vizro-mcp\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/v/vizro-mcp/vizro_mcp-${{ version }}.tar.gz\n  sha256: b5f819c6c97cb73a7c3ec237d5bb7d5a042371d5e6a013025523834ea8d9b765\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - vizro-mcp = vizro_mcp:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - pydantic\n    - httpx >=0.28.1\n    - mcp >=1.6.0\n    - vizro >=0.1.46\n    - click >=8.1.7\n    # Refer to https://github.com/mckinsey/vizro/blob/main/vizro-mcp/pyproject.toml#L21\n    # \"pandas[html,parquet,excel]\"\n    - pandas\n    # Refer to https://github.com/pandas-dev/pandas/blob/main/pyproject.toml#L68\n    # html = ['beautifulsoup4>=4.12.3', 'html5lib>=1.1', 'lxml>=4.9.2']\n    - beautifulsoup4 >=4.12.3\n    - html5lib >=1.1\n    - lxml >=4.9.2\n    # excel = ['odfpy>=1.4.1', 'openpyxl>=3.1.2', 'python-calamine>=0.1.7', 'pyxlsb>=1.0.10', 'xlrd>=2.0.1', 'xlsxwriter>=3.2.0']\n    - odfpy >=1.4.1\n    - openpyxl >=3.1.2\n    - python-calamine >=0.1.7\n    - pyxlsb >=1.0.10\n    - xlrd >=2.0.1\n    - xlsxwriter >=3.2.0\n    # parquet = ['pyarrow>=10.0.1']\n    - pyarrow >=10.0.1\n\ntests:\n  - python:\n      imports:\n        - vizro_mcp\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        - python\n    script:\n      - vizro-mcp --help\n\nabout:\n  summary: MCP server to help create Vizro dashboards and charts\n  license: Apache-2.0\n  license_file: LICENSE.txt\n  homepage: https://pypi.org/project/vizro-mcp/\n  description: Vizro-MCP is a Python library that provides a server to help create Vizro dashboards and charts.\n  repository: https://github.com/mckinsey/vizro\n  documentation: https://vizro.readthedocs.io/en/stable/\n\nextra:\n  recipe-maintainers:\n    - rxm7706\n",
