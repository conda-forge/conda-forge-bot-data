  "raw_meta_yaml": "schema_version: 1\ncontext:\n  name: \"openmeeg\"\n  version: \"2.5.16\"\n  build_number: 3\n  sha256: 29485a732e3555425889cfd28474fccd2b3e76b51bb694fc83d86ca052e70884\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/${{ name }}/${{ name }}/archive/${{ version }}.tar.gz\n  sha256: ${{ sha256 }}\n  patches:\n    - sabi.patch\n\n# https://conda-forge.org/docs/maintainer/knowledge_base.html\nbuild:\n  number: ${{ build_number }}\n  python:\n    version_independent: ${{ is_abi3 }}\n  skip: is_abi3 and not is_python_min\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - numpy\n    - cmake >=3.19\n    - make\n    - if: not win\n      then: ninja\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib(\"c\") }}\n    - if: osx\n      then: llvm-openmp\n    - if: win\n      then: pthread-stubs\n    - swig\n\n  host:\n    - python\n    - if: is_abi3\n      then: python-abi3\n    - numpy\n    - openblas\n    - libmatio\n    - setuptools >=68.0.0\n    - setuptools_scm >=6.2\n    - wheel >=0.37.0\n\n  run:\n    - python\n    - if: win\n      then: ucrt\n    - libopenblas\n    - libmatio\n\ntests:\n  - python:\n      imports:\n        - openmeeg\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - if: not win\n          then: pytest\n          else: pytest <8\n        - packaging\n        - pip\n        - if: is_abi3\n          then: abi3audit\n    script:\n      - om_minverser --help\n      - if: unix and is_abi3\n        then:\n          - ls $SP_DIR/openmeeg/_openmeeg.*\n          - abi3audit $SP_DIR/openmeeg/_openmeeg.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      - if: win and is_abi3\n        then:\n          - dir %SP_DIR%\\openmeeg\\_openmeeg.*\n          - abi3audit %SP_DIR%/openmeeg/_openmeeg.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          # In case we run into problems in the future:\n          # curl -LO https://github.com/lucasg/Dependencies/releases/download/v1.11.1/Dependencies_x64_Release.zip\n          # powershell.exe -nologo -noprofile -command \"& { Add-Type -A 'System.IO.Compression.FileSystem'; [IO.Compression.ZipFile]::ExtractToDirectory('Dependencies_x64_Release.zip', 'Dependencies'); }\"\n          # .\\Dependencies\\Dependencies.exe -modules %SP_DIR%\\openmeeg\\_openmeeg.pyd\n      - python -c \"import faulthandler; faulthandler.enable(); import warnings; warnings.simplefilter('error'); from packaging.version import parse; import openmeeg; print(openmeeg.__version__); assert parse(openmeeg.__version__) == parse('${{ version }}'), openmeeg.__version__\"\n      - pip check\n      - pip show openmeeg\n\nabout:\n  homepage: https://openmeeg.github.io/\n  license: CECILL-B\n  license_file: LICENSE.txt\n  summary: >\n    A C++ package for solving the forward problems of electroencephalography (EEG) and magnetoencephalography (MEG).\n\nextra:\n  recipe-maintainers:\n    - agramfort\n    - larsoner\n",
