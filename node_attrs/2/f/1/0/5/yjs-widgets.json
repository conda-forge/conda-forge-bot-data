  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: yjs-widgets\n  version: \"0.6.0\"\n\nrecipe:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/yjs_widgets-${{ version }}.tar.gz\n  sha256: 6eaf3673a5147bccf20d32f63bc40a387d9edee8d22bdefe85dce3d2f9f6b5e0\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: ${{ name|lower }}\n    build:\n      noarch: python\n      script: ${{ PYTHON }} -m pip install --no-deps --no-build-isolation -vv .\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - yarn =3\n        - hatchling\n        - hatch-nodejs-version\n        - hatch-jupyter-builder\n        - jupyterlab >=4.0.0,<5\n      run:\n        - python >=${{ python_min }}\n    tests:\n      - python:\n          imports:\n            - yjs_widgets\n          pip_check: true\n          python_version: ${{ python_min }}\n      - requirements:\n          run:\n            - pip\n            - jupyterlab >=4,<5\n            - python ==${{ python_min }}\n        script:\n          - if: unix\n            then:\n              - jupyter labextension list\n              - jupyter labextension list 1>labextensions 2>&1\n              - cat labextensions | grep \"yjs-widgets.*OK\"\n\n  - package:\n      name: ${{ name|lower }}-collection\n    build:\n      noarch: python\n      script: |\n        ${{ PYTHON }} -m pip install \\\n          --no-deps --no-build-isolation -vv \\\n          examples/yjs-widget-controls/\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - yarn =3\n        - hatchling\n        - hatch-nodejs-version\n        - hatch-jupyter-builder\n        - jupyterlab >=4.0.0,<5\n      run:\n        - ${{ pin_subpackage(name | lower, exact=true) }}\n        - python >=${{ python_min }}\n    tests:\n      - python:\n          imports:\n            - yjs_widget_controls\n          pip_check: