  "linux_64_meta_yaml": {
    "about": {
      "description": "`handlr-regex` is a fork of the unmaintained [`handlr`](https://github.com/chmln/handlr) with additional support for\nregular expressions. It is a modern alternative to [`xdg-utils`](https://www.freedesktop.org/wiki/Software/xdg-utils/)\nthat allows to set default file handlers by file extension or MIME type, to set arbitrary commands as handlers based\non regular expressions, to open multiple files at once, and more.",
      "dev_url": "https://github.com/Anomalocaridid/handlr-regex",
      "home": "https://github.com/Anomalocaridid/handlr-regex",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Modern CLI to set default file handlers by extension or MIME type"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins",
          "mkdir -p \"$PREFIX\"/share/man/man1 \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions",
          "cp -r target/*/release/build/handlr-regex-*/out/manual/man1/* \"$PREFIX\"/share/man/man1/",
          "COMPLETE=bash \"$PREFIX\"/bin/handlr > \"$PREFIX\"/share/bash-completion/completions/handlr",
          "COMPLETE=fish \"$PREFIX\"/bin/handlr > \"$PREFIX\"/share/fish/vendor_completions.d/handlr.fish",
          "COMPLETE=zsh  \"$PREFIX\"/bin/handlr > \"$PREFIX\"/share/zsh/site-functions/_handlr",
          "cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "handlr-regex",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
