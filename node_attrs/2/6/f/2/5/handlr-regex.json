  "raw_meta_yaml": "context:\n  version: \"0.13.0\"\n\npackage:\n  name: handlr-regex\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/Anomalocaridid/handlr-regex/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 963126a7aa8277b7cc7886c518528473ce5117a5999c949b809e14beffdbad0d\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=THIRDPARTY.yml\n      # copy manpage\n      - mkdir ($prefix)/share/man/man1\n      - cp --recursive target/*/release/build/handlr-regex-*/out/manual/man1/* ($prefix)/share/man/man1/\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - let bin = ($prefix)/bin/handlr\n          - COMPLETE=bash ^$bin completion bash | save ($prefix)/share/bash-completion/completions/handlr\n          - COMPLETE=fish ^$bin completion fish | save ($prefix)/share/fish/vendor_completions.d/handlr.fish\n          - COMPLETE=zsh  ^$bin completion zsh  | save ($prefix)/share/zsh/site-functions/_handlr\n  skip:\n    - osx\n    - win\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nushell\n\ntests:\n  - script:\n      - handlr --help\n      - handlr --version\n  - package_contents:\n      bin:\n        - handlr\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/man/man1/handlr*.1\n            - share/bash-completion/completions/handlr\n            - share/fish/vendor_completions.d/handlr.fish\n            - share/zsh/site-functions/_handlr\n      strict: true\n\nabout:\n  summary: Modern CLI to set default file handlers by extension or MIME type\n  description: |\n    `handlr-regex` is a fork of the unmaintained [`handlr`](https://github.com/chmln/handlr) with additional support for\n    regular expressions. It is a modern alternative to [`xdg-utils`](https://www.freedesktop.org/wiki/Software/xdg-utils/)\n    that allows to set default file handlers by file extension or MIME type, to set arbitrary commands as handlers based\n    on regular expressions, to open multiple files at once, and more.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/Anomalocaridid/handlr-regex\n  repository: https://github.com/Anomalocaridid/handlr-regex\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
