  "raw_meta_yaml": "context:\n  name: beckhoff-ads\n  tag: 113.0.34-1\n  version: ${{ tag | replace('-', '.') }}\n\nrecipe:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/Beckhoff/ADS/archive/refs/tags/${{ tag }}.tar.gz\n  sha256: 2523bbdf90b153992ced68a689c02943516ec93260b4eddd3108edc710a63596\n  patches: \n    - meson-build-install-executables.patch\n\nbuild:\n  number: 0\n  skip:\n    - win\n  script: |\n    meson setup build --prefix=\"$PREFIX\" -Dlibdir=\"$PREFIX/lib\" -Dwerror=false\n    ninja -C build install\n\noutputs:\n  - package:\n      name: ${{ name }}\n    requirements:\n      build:\n        - ${{ stdlib(\"c\") }}\n        - ${{ compiler('cxx') }}\n        - meson\n        - ninja\n      run_exports:\n        - ${{ pin_subpackage(name, upper_bound='x.x.x') }}\n    build:\n      files:\n        - include\n        - bin\n        - if: linux\n          then:\n            - lib/*.so*\n        - if: osx\n          then:\n            - lib/*.dylib*\n        - lib/pkgconfig\n    tests:\n      - script:\n          - test -d \"${PREFIX}/include/AdsLib\"\n          - test -d \"${PREFIX}/include/AdsLib/bhf\"\n          - test -d \"${PREFIX}/include/AdsLib/standalone\"\n          - test -d \"${PREFIX}/include/AdsLib/TwinCAT\"\n          - test -f \"${PREFIX}/include/AdsLib/AdsDef.h\"\n          - test -f \"${PREFIX}/include/AdsLib/AdsNotification.h\"\n          - test -f \"${PREFIX}/include/AdsLib/AmsPort.h\"\n          - test -f \"${PREFIX}/include/AdsLib/NotificationDispatcher.h\"\n          - test -f \"${PREFIX}/include/AdsLib/RouterAccess.h\"\n          - test -f \"${PREFIX}/include/AdsLib/AdsDevice.h\"\n          - test -f \"${PREFIX}/include/AdsLib/AdsNotificationOOI.h\"\n          - test -f \"${PREFIX}/include/AdsLib/AmsRouter.h\"\n          - test -f \"${PREFIX}/include/AdsLib/RTimeAccess.h\"\n          - test -f \"${PREFIX}/include/AdsLib/Semaphore.h\"\n          - test -f \"${PREFIX}/include/AdsLib/AdsException.h\"\n          - test -f \"${PREFIX}/include/AdsLib/AdsVariable.h\"\n          - test -f \"${PREFIX}/include/AdsLib/Frame.h\"\n          - test -f \"${PREFIX}/include/AdsLib/RegistryAccess.h\"\n          - test -f \"${PREFIX}/include/AdsLib/Sockets.h\"\n          - test -f \"${PREFIX}/include/AdsLib/wrap_endian.h\"\n          - test -f \"${PREFIX}/include/AdsLib/AdsFile.h\"\n          - test -f \"${PREFIX}/include/AdsLib/AmsConnection.h\"\n          - test -f \"${PREFIX}/include/AdsLib/LicenseAccess.h\"\n          - test -f \"${PREFIX}/include/AdsLib/RingBuffer.h\"\n          - test -f \"${PREFIX}/include/AdsLib/SymbolAccess.h\"\n          - test -f \"${PREFIX}/include/AdsLib/wrap_registry.h\"\n          - test -f \"${PREFIX}/include/AdsLib/AdsLib.h\"\n          - test -f \"${PREFIX}/include/AdsLib/AmsHeader.h\"\n          - test -f \"${PREFIX}/include/AdsLib/Log.h\"\n          - test -f \"${PREFIX}/include/AdsLib/Router.h\"\n          - test -f \"${PREFIX}/include/AdsLib/wrap_socket.h\"\n          - test -f \"${PREFIX}/include/AdsLib/bhf/ParameterList.h\"\n          - test -f \"${PREFIX}/include/AdsLib/bhf/StringToInteger.h\"\n          - test -f \"${PREFIX}/include/AdsLib/bhf/WindowsQuirks.h\"\n          - test -f \"${PREFIX}/include/AdsLib/standalone/AdsDef.h\"\n          - test -f \"${PREFIX}/include/AdsLib/standalone/AdsLib.h\"\n          - test -f \"${PREFIX}/include/AdsLib/TwinCAT/AdsDef.h\"\n          - test -f \"${PREFIX}/include/AdsLib/TwinCAT/AdsLib.h\"\n          - if: linux\n            then:\n              - test -f \"${PREFIX}/lib/libAdsLib.so\"\n          - if: osx\n            then:\n              - test -f \"${PREFIX}/lib/libAdsLib.dylib\"\n          - adstool --help\n\n  - package:\n      name: ${{ name }}-static\n    requirements:\n      build:\n        - ${{ stdlib(\"c\") }}\n        - ${{ compiler('cxx') }}\n        - meson\n        - ninja\n    build:\n      files:\n        - lib/*.a\n    tests:\n      - script:\n          - test -f \"${PREFIX}/lib/libAdsLib.a\"\n\nabout:\n  homepage: https://github.com/Beckhoff/ADS\n  license: MIT\n  license_file: LICENSE\n  summary: Beckhoff protocol to communicate with TwinCAT devices\n  description: |\n    This library is intended to provide easy use as ADS client applications running on non-windows systems \n    (e.g. FreeBSD, Linux, ...) to communicate with TwinCAT devices via TCP/IP.\n  documentation: https://infosys.beckhoff.com/english.php?content=../content/1033/tc3_ads_intro/index.html\n  repository: https://github.com/Beckhoff/ADS\n\nextra:\n  recipe-maintainers:\n    - AndreFavotto\n    - mac-kan\n    - javicereijo\n",
