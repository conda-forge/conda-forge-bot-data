  "raw_meta_yaml": "context:\n  name: vsgxchange\n  version: \"1.1.13\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/vsg-dev/vsgXchange/archive/v${{ version }}.tar.gz\n  sha256: e1a94460235a0dba9a0dd2f7f407c5397ffa618d0f744cc247259b581beb3ba4\n\nbuild:\n  number: 1\n  script:\n    - if: win\n      then: call \"%RECIPE_DIR%\\\\build.bat\"\n    - if: unix\n      then: bash \"${RECIPE_DIR}/build.sh\"\n\nrequirements:\n  build:\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n    - if: linux\n      then: pkgconfig\n  host:\n    - assimp\n    - freetype\n    # GDAL 3.12+ has namespace GDAL that conflicts with vsgXchange class GDAL.\n    - gdal\n    - libcurl\n    - libvulkan-headers\n    - libvulkan-loader\n    - openexr\n    # build 0 was linked against the older VulkanSceneGraph ABI.\n    - osg2vsg >=0.3.0 *_1\n    - vulkanscenegraph >=1.1.15\n  run:\n    # GDAL 3.12+ has namespace GDAL that conflicts with vsgXchange class GDAL.\n    - libgdal-core\n    # Keep runtime resolution away from osg2vsg build 0's old VSG ABI.\n    - osg2vsg >=0.3.0 *_1\n  run_exports:\n    - ${{ pin_subpackage('vsgxchange', upper_bound='x.x') }}\n  ignore_run_exports:\n    from_package:\n      - libvulkan-loader\n\ntests:\n  - requirements:\n      run:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - if: unix\n          then: ninja\n        - if: linux\n          then: pkgconfig\n    files:\n      recipe:\n        - run_test.bat\n        - run_test.sh\n        - tests/\n    script:\n      - if: unix\n        then:\n          - test -f \"${PREFIX}/include/vsgXchange/all.h\"\n          - test -f \"${PREFIX}/lib/libvsgXchange${SHLIB_EXT}\"\n          - test -f \"${PREFIX}/lib/cmake/vsgXchange/vsgXchangeConfig.cmake\"\n          - bash run_test.sh\n      - if: win\n        then:\n          - if not exist \"%PREFIX%\\\\Library\\\\include\\\\vsgXchange\\\\all.h\" exit 1\n          - if not exist \"%PREFIX%\\\\Library\\\\lib\\\\vsgXchange.lib\" exit 1\n          - if not exist \"%PREFIX%\\\\Library\\\\bin\\\\vsgXchange.dll\" exit 1\n          - if not exist \"%PREFIX%\\\\Library\\\\bin\\\\vsgconv.exe\" exit 1\n          - if not exist \"%PREFIX%\\\\Library\\\\lib\\\\cmake\\\\vsgXchange\\\\vsgXchangeConfig.cmake\" exit 1\n          - call run_test.bat\n\nabout:\n  homepage: https://vsg-dev.github.io/vsg-dev.io/\n  repository: https://github.com/vsg-dev/vsgXchange\n  summary: Utility library for converting data+materials to/from VulkanSceneGraph\n  license: MIT\n  license_file: LICENSE.md\n\nextra:\n  recipe-maintainers:\n    - jeongseok-meta\n",
