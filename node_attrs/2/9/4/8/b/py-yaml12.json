  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.2.0\"\n\npackage:\n  name: py-yaml12\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/py-yaml12/py_yaml12-${{ version }}.tar.gz\n  sha256: b8326c144e26a4ae7e03d13175667d85c580a9f0512fd7b809e5c92b5569f74e\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    version_independent: true\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - maturin >=1,<2\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - pip\n    - maturin >=1.7,<2.0\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - yaml12\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  homepage: https://github.com/posit-dev/py-yaml12\n  repository: https://github.com/posit-dev/py-yaml12\n  documentation: https://posit-dev.github.io/py-yaml12/\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: A modern YAML 1.2 parser and emitter for Python, written in Rust.\n  description: |\n    yaml12 is a YAML 1.2 parser/formatter for Python, implemented in Rust\n    for speed and correctness. Built on the `saphyr` crate.\n\n    For almost every use case, yaml12 lets you work with plain builtin\n    Python types end to end: dict, list, int, float, str, and None. JSON\n    is a subset of YAML 1.2, so all valid JSON is also valid YAML and\n    parses the same way. 100% compliance with the yaml-test-suite.\n\nextra:\n  recipe-maintainers:\n    - rxm7706\n",
