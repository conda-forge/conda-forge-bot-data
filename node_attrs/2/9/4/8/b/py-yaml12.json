  "linux_64_meta_yaml": {
    "about": {
      "description": "yaml12 is a YAML 1.2 parser/formatter for Python, implemented in Rust\nfor speed and correctness. Built on the `saphyr` crate.\n\nFor almost every use case, yaml12 lets you work with plain builtin\nPython types end to end: dict, list, int, float, str, and None. JSON\nis a subset of YAML 1.2, so all valid JSON is also valid YAML and\nparses the same way. 100% compliance with the yaml-test-suite.",
      "dev_url": "https://github.com/posit-dev/py-yaml12",
      "doc_url": "https://posit-dev.github.io/py-yaml12/",
      "home": "https://github.com/posit-dev/py-yaml12",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "A modern YAML 1.2 parser and emitter for Python, written in Rust."
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml",
          "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "rxm7706"
      ]
    },
