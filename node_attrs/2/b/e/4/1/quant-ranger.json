  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.1.3\"\n  python_min: \"3.14\"\n\nrecipe:\n  name: quant-ranger\n  version: ${{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/q/quant-ranger/quant_ranger-${{ version }}.tar.gz\n    sha256: 25e1b068bf8e679a032638d5cb75dd303fe9a421b6f03afb0e375643456cef5d\n  - url: https://raw.githubusercontent.com/Quantco/quant-ranger/refs/tags/v${{ version }}/skills/create-custom-updater/SKILL.md\n    sha256: cca10bdf839986dc3c64fa1667194ba97d4492e4f9725795d412ce743bbbcfca\n    file_name: SKILL.md\n    target_directory: skills/create-custom-updater\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: quant-ranger\n    build:\n      noarch: python\n      script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n      python:\n        entry_points:\n          - quant-ranger = quant_ranger.cli:main\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - hatchling\n        - pip\n      run:\n        - ${{ pin_subpackage(\"agent-skill-quant-ranger\", exact=True) }}\n        # pyproject.toml\n        - python >=${{ python_min }}\n        - copier >=9.8.0,<10\n        - packaging >=26.2\n        - pixi-diff-to-markdown >=0.3.3,<0.4.0\n        - pydantic >=2.13.4,<3\n        - pygithub >=2.9.1,<3\n        - pyyaml >=6.0.3,<7\n        - requests >=2.34.2,<3\n        - rich >=15.0.0,<16\n        - tomlkit >=0.15.0,<0.16.0\n        - typer >=0.25.1,<0.26\n        - urllib3 >=2.7.0,<3\n        - zizmor ==1.22.0\n        # pixi.toml\n        - git >=2.54.0,<3\n        - mergiraf >=0.17.0,<0.18.0\n        - rattler-sandbox >=0.2.3,<0.3.0\n    tests:\n      - python:\n          imports:\n            - quant_ranger\n          # conda-forge's zizmor ships no dist-info\n          pip_check: false\n          python_version:\n            - ${{ python_min }}.*\n            - '*'\n      - requirements:\n          run:\n            - python ${{ python_min }}.*\n        script:\n          - quant-ranger --help\n          - quant-ranger update --help\n\n  - package:\n      name: agent-skill-quant-ranger\n    build:\n      noarch: generic\n      script:\n        - mkdir -p $PREFIX/share/agent-skills/create-custom-updater\n        - cp skills/create-custom-updater/SKILL.md $PREFIX/share/agent-skills/create-custom-updater/SKILL.md\n    requirements:\n      run_constraints:\n        - quant-ranger ==${{ version }}\n    tests:\n      - package_contents:\n          files:\n            - share/agent-skills/create-custom-updater/SKILL.md\n          strict: true\n    about:\n      summary: Agent skill for creating quant-ranger custom updaters\n      description: |\n        Guides coding agents through writing, debugging, and running one-off\n        quant-ranger custom updaters for repository migrations and audits. The\n        skill can be configured for supported coding agents with pixi-skills.\n\nabout:\n  summary: Tool for maintenance work across GitHub repositories.\n  description: |\n    Automated repository maintenance across GitHub organizations. quant-ranger\n    discovers applicable work, runs typed update tasks in fresh checkouts, and\n    can publish the results as pull requests.\n  license: BSD-3-Clause\n  license_file: LICENSE\n  homepage: https://github.com/quantco/quant-ranger\n  repository: https://github.com/quantco/quant-ranger\n  documentation: https://ranger.quantco.cloud/\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n    - ytausch\n",
