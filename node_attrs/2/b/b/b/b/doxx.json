  "raw_meta_yaml": "context:\n  name: doxx\n  version: \"0.1.4\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/bgreenwell/doxx/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 72af676ca30b27adc7a13b17a48aac88589c940accba28453f3d94a861bed961\n\nbuild:\n  number: 0\n  script:\n    - if: unix\n      then:\n        - cargo install --locked --root ${PREFIX} --path . --no-track\n        - cargo-bundle-licenses --format yaml --output ${SRC_DIR}/THIRDPARTY.yml\n      else:\n        - cargo install --locked --root %PREFIX% --path . --no-track\n        - if errorlevel 1 exit 1\n        - cargo-bundle-licenses --format yaml --output %SRC_DIR%/THIRDPARTY.yml\n        - if errorlevel 1 exit 1\n\nrequirements:\n  build:\n    - ${{ compiler('rust') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - cargo-bundle-licenses\n    - if: linux\n      then:\n        - libxcb\n\ntests:\n  - script:\n      - doxx --version\n\nabout:\n  homepage: https://bgreenwell.github.io/doxx\n  summary: 'Expose the contents of .docx files without leaving your terminal. Fast, safe, and smart — no Office required!'\n  description: |\n    A fast, terminal-native document viewer for Word files. View, search, and export .docx documents without leaving your command line.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/bgreenwell/doxx\n\nextra:\n  recipe-maintainers:\n    - claudiushaag\n",
