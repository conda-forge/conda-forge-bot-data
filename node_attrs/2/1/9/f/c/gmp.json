  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"6.3.0\"\n\npackage:\n  name: gmp\n  version: ${{ version }}\n\nsource:\n  url:\n    - https://gmplib.org/download/gmp/gmp-${{ version }}.tar.xz\n    - https://ftp.gnu.org/gnu/gmp/gmp-${{ version }}.tar.xz\n  sha256: a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898\n\nbuild:\n  number: 3\n  script: build\n\nrequirements:\n  build:\n    - gnuconfig\n    - if: unix\n      then:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - m4\n        - make\n    - if: win\n      then:\n        - ${{ stdlib('m2w64_c') }}\n        - ${{ compiler('m2w64_c') }}\n        - m2-m4\n        - m2-make\n        - m2-base\n        - m2-diffutils\n        - gendef\n  run_exports:\n    - ${{ pin_subpackage('gmp') }}\n  run_constraints:\n    - if: win\n      then: mpir <0.0a0\n\ntests:\n  - package_contents:\n      include:\n        - gmp.h\n      lib:\n        - if: unix\n          then:\n            - gmp\n            - gmpxx\n      files:\n        exists:\n          - if: win\n            then:\n              - Library/bin/libgmp-10.dll\n              - Library/lib/libgmp.dll.a\n              - Library/lib/gmp.lib\n        not_exists:\n          - if: unix\n            then:\n              - lib/libgmp.a\n              - lib/libgmpxx.a\n  - if: unix\n    then:\n      files:\n        recipe:\n          - test.c\n      requirements:\n        build:\n          - ${{ compiler('c') }}\n          - ${{ stdlib('c') }}\n      script:\n        - $CC -I$PREFIX/include -L$PREFIX/lib test.c -lgmp -Wl,-rpath,$PREFIX/lib -o test.out\n        - if: build_platform == target_platform\n          then: ./test.out\n  - if: win\n    then:\n      files:\n        recipe:\n          - test.c\n      requirements:\n        build:\n          - ${{ compiler('c') }}\n          - ${{ stdlib('c') }}\n      script:\n        - cl test.c /I%LIBRARY_INC% %LIBRARY_LIB%\\gmp.lib /Fe:test.exe\n        - test.exe\n        # Give Windows time to release the executable before rattler-build removes the test directory.\n        - ping 127.0.0.1 -n 3 > nul\n        - del /F /Q test.exe test.obj\n\nabout:\n  homepage: http://gmplib.org/\n  repository: https://gmplib.org/repo/gmp/\n  license: GPL-2.0-or-later OR LGPL-3.0-or-later\n  license_file: COPYING.LESSERv3\n  summary: The GNU multiprecision library.\n\nextra:\n  recipe-maintainers:\n    - asmeurer\n    - isuruf\n    - jakirkham\n",
