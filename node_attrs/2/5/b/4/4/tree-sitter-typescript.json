  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.23.2\"\n\npackage:\n  name: tree-sitter-typescript\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/tree-sitter/tree-sitter-typescript/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 2c4ce711ae8d1218a3b2f899189298159d672870b5b34dff5d937bed2f3e8983\n\nbuild:\n  number: 1\n  # abi3 packages build once at python_min and ship one artifact per platform.\n  skip: is_abi3 and not is_python_min\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    version_independent: ${{ is_abi3 }}\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n  host:\n    - if: is_abi3\n      then: python-abi3\n    - python\n    - pip\n    - setuptools >=42\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - tree_sitter_typescript\n      # Verify the abi3 wheel works on the build-time Python AND the latest.\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/tree_sitter_typescript/_binding.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%/tree_sitter_typescript/_binding.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://github.com/tree-sitter/tree-sitter-typescript\n  summary: TypeScript and TSX grammars for tree-sitter\n  license: MIT\n  license_file: LICENSE\n  repository: https://github.com/tree-sitter/tree-sitter-typescript\n\nextra:\n  recipe-maintainers:\n    - killua156\n    - mgorny\n    - rxm7706\n",
