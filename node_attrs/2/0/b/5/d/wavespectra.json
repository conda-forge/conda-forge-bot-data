  "raw_meta_yaml": "{% set name = \"wavespectra\" %}\n{% set version = \"4.8.0\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}/{{ name }}-{{ version }}.tar.gz\n  sha256: 1d88a74a4aae83261d31d80ecb64fc1ad43a56a1f7f3de10477fe5b0f68643aa\n\n\nbuild:\n  number: 0\n  script: {{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  build:\n    # Compilers are named 'c', 'cxx' and 'fortran'.\n    - {{ compiler('fortran') }}\n    - {{ stdlib(\"c\") }}\n  host:\n    - python\n    - pip\n    # pyproject.toml sets build-backend = \"setuptools.build_meta\" with\n    # requires = [\"numpy\", \"setuptools\"]. setuptools used to arrive implicitly\n    # via pytest-runner and via pip, but pip's python>=3.13 build no longer\n    # depends on it, so it must be requested explicitly.\n    - setuptools\n    - numpy\n  run:\n    - python\n    - click\n    - cmocean\n    - dask\n    - gcsfs\n    - fsspec\n    - matplotlib-base\n    - numpy\n    - pandas\n    - python-dateutil\n    - pyyaml\n    - sortedcontainers\n    - scipy\n    - xarray\n    - zarr\n\ntest:\n  imports:\n    - wavespectra\n  commands:\n    - pip check\n  requires:\n    - pip\n\nabout:\n  home: https://github.com/wavespectra/wavespectra\n  license: MIT\n  license_family: MIT\n  license_file: LICENSE.txt\n  summary: Python library for ocean wave spectra\n  description: |\n    Wavespectra is an open source project for working with ocean wave spectral data. \n    The library is built on top of xarray, leveraging from xarray’s labelled \n    multi-dimensional arrays and making dealing with wave spectra simple and fast..\n  doc_url: https://wavespectra.readthedocs.io/en/latest/\n  dev_url: https://github.com/wavespectra/wavespectra\n\nextra:\n  recipe-maintainers:\n    - RubendeBruin\n    - rafa-guedes\n",
