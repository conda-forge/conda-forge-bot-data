  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.3.1\"\n\npackage:\n  name: primp\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/primp/primp-${{ version }}.tar.gz\n  sha256: b04a5941bf9c876d011c5defaf5a25be093d56e7270b8da52c9788b9df2a829a\n\nbuild:\n  number: 1\n  script:\n    env:\n      PYTHONUTF8: \"1\"\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n      OPENSSL_NO_VENDOR: \"1\"\n    content:\n      - if: unix\n        then: |\n          export OPENSSL_DIR=\"$PREFIX\"\n          pushd crates/primp-python\n          cargo-bundle-licenses --format yaml --output ../../THIRDPARTY.yml\n          popd\n          ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n        else: |\n          set \"OPENSSL_DIR=%LIBRARY_PREFIX%\"\n          pushd crates\\primp-python\n          cargo-bundle-licenses --format yaml --output ../../THIRDPARTY.yml\n          popd\n          ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - maturin >=1.5,<2.0\n  host:\n    - python\n    - pip\n    - maturin >=1.5,<2.0\n    - openssl\n    - if: is_abi3\n      then: python-abi3\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - primp\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/primp/primp.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%\\primp\\primp.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://github.com/deedy5/primp\n  repository: https://github.com/deedy5/primp\n  license: MIT\n  license_file:\n    - crates/primp/LICENSE-MIT\n    - THIRDPARTY.yml\n  summary: HTTP client that can impersonate web browsers, mimicking their headers and `TLS/JA3/JA4/HTTP2` fingerprints\n\nextra:\n  recipe-maintainers:\n    - rxm7706\n",
