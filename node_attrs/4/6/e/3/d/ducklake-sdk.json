  "raw_meta_yaml": "context:\n  version: \"0.0.9\"\n\npackage:\n  name: ducklake-sdk\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/d/ducklake-sdk/ducklake_sdk-${{ version }}.tar.gz\n  sha256: 9899b001e26a6d9c0930cd4138a7c7c9d23629dc949b39ae42c25e2d05c2145d\n\nbuild:\n  number: 0\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: true\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - maturin >=1.7,<2\n    - ${{ compiler('rust') }}\n    - ${{ stdlib('c') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n  host:\n    - python\n    - if: is_abi3\n      then: python-abi3\n    - pip\n    - maturin >=1.7,<2\n  run:\n    - python\n    - typing_extensions\n  ignore_run_exports:\n    from_package:\n      - cross-python_${{ target_platform }}\n  run_constraints:\n    - polars >=1.40\n    - sqlalchemy >=2\n\ntests:\n  - python:\n      python_version: \"${{ python_min ~ '.*' }}\"\n      imports:\n        - ducklake\n      pip_check: true\n  - if: is_abi3\n    then:\n      script:\n        - if: win\n          then: abi3audit %PREFIX%/Lib/site-packages/ducklake/_native.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          else:\n            - export SP_DIR=$(python -c \"import site; print(site.getsitepackages()[0])\")\n            - abi3audit $SP_DIR/ducklake/_native.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      requirements:\n        run:\n          - abi3audit\n\nabout:\n  homepage: https://github.com/borchero/ducklake-sdk\n  summary: Python SDK to interact with DuckLake.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://ducklake-sdk.readthedocs.io/\n  repository: https://github.com/borchero/ducklake-sdk\n\nextra:\n  recipe-maintainers:\n    - borchero\n",
