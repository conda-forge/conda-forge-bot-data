  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.1.4\"\n\npackage:\n  name: llama-cpp-server-py-core\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/l/llama-cpp-server-py-core/llama_cpp_server_py_core-${{ version }}.tar.gz\n  sha256: a38c3a0e0b2756e542618369a0105b82c2ffa7c538463221f6a784928b6ff995\n\nbuild:\n  number: 0\n  skip:\n    - match(python, \"<3.10\")\n  script:\n    content:\n      - if: unix\n        then: export CMAKE_GENERATOR=Ninja\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation -Ccmake.define.LLAMA_BUILD=OFF -Ccmake.define.LLAVA_BUILD=OFF\n      - if: unix\n        then: |\n          mkdir -p \"$SP_DIR/llama_cpp_server_py_core/lib\"\n          ln -s \"$PREFIX/bin/llama-server\" \"$SP_DIR/llama_cpp_server_py_core/lib/llama-server\"\n          ln -s \"$PREFIX/bin/llama-quantize\" \"$SP_DIR/llama_cpp_server_py_core/lib/llama-quantize\" || true\n      - if: win\n        then: |\n          mkdir \"%SP_DIR%\\llama_cpp_server_py_core\\lib\"\n          copy \"%LIBRARY_BIN%\\llama-server.exe\" \"%SP_DIR%\\llama_cpp_server_py_core\\lib\\\"\n          copy \"%LIBRARY_BIN%\\llama-quantize.exe\" \"%SP_DIR%\\llama_cpp_server_py_core\\lib\\\"\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n  host:\n    - python\n    - pip\n    - scikit-build-core\n    - llama.cpp ==5289\n  run:\n    - python\n    - requests\n    - urllib3\n    - llama.cpp ==5289\n\ntests:\n  - python:\n      imports:\n        - llama_cpp_server_py_core\n      pip_check: true\n\nabout:\n  homepage: https://github.com/fangyinc/llama-cpp-server-py\n  summary: Python core library wrapping llama.cpp server, quantize, and conversion tools\n  license: MIT\n  license_file: llama.cpp/LICENSE\n  repository: https://github.com/fangyinc/llama-cpp-server-py\n\nextra:\n  recipe-maintainers:\n    - pb01ka\n",
