  "raw_meta_yaml": "{% set name = \"pybacktrack\" %}\n{% set version = \"1.5.0\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: \"https://pypi.org/packages/source/{{ name[0] }}/{{ name }}/{{ name }}-{{ version }}.tar.gz\"\n  sha256: 8b540d2839062ba4964b6635177e376b649ba360720040f1b519afd7f0cab1d3\n\nbuild:\n  noarch: python\n  script_env:\n    # There's no '.git' directory in source tarball, so explicitly provide version for setuptools_scm.\n    - SETUPTOOLS_SCM_PRETEND_VERSION_FOR_PYBACKTRACK={{ version }}\n  script:\n    - {{ PYTHON }} -m pip install . -vv\n  number: 0\n\nrequirements:\n  host:\n    - python {{ python_min }}\n    - pip\n    # Using same setuptools[_scm] versions as pyproject.toml (in source tarball).\n    - setuptools >=61.0\n    - setuptools_scm >=8.0  # Need this to process SETUPTOOLS_SCM_PRETEND_VERSION_FOR_PYBACKTRACK env var.\n  run:\n    - python >={{ python_min }}\n    - gmt >=5.0\n    - numpy\n    - pygplates\n    - scipy\n    - packaging >=20.0  # Dependency in pyproject.toml (to parse versions in pybacktrack).\n\ntest:\n  source_files:\n    - tests\n  imports:\n    - pybacktrack\n  requires:\n    - python {{ python_min }}\n    - pytest\n  commands:\n    # Temporary: Tests only pass on Windows.\n    #            Fails on Linux/macOS.\n    #            GMT is reporting grdtrack error: Named variable does not exist in file (sediment thickness grid).\n    #            Appears to not detect the 'z' variable in grid (even though 'ncdump -h' shows it).\n    #            Likely some NetCDF/HDF5 driver issue within GMT. The same versions of GMT/libnetcdf/hdf4/hdf5 and\n    #            pretty much all the libraries are the same on my local macOS machine and it works fine.\n    #\n    # TODO: Remove this in the next version upgrade of pyBacktrack.\n    - pytest  # [win]\n\nabout:\n  home: https://github.com/EarthByte/pyBacktrack\n  summary: A tool for reconstructing paleobathymetry on oceanic and continental crust.\n  dev_url: https://github.com/EarthByte/pyBacktrack\n  doc_url: https://pybacktrack.readthedocs.io\n  license: GPL-2.0-only\n  license_family: GPL2\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - jcannon-gplates\n",
