  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  name: liteparse\n  version: \"2.0.1\"\n\nrecipe:\n  name: ${{ name }}-split\n  version: ${{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/l/liteparse/liteparse-${{ version }}.tar.gz\n    sha256: c036eae33edaa8da527e0e8f9b5449fe36eadb0b6dc48a2bf3136095f918c170\n  - url: https://raw.githubusercontent.com/run-llama/liteparse/ae1ae83f527b016d4f318ee27023381109702425/LICENSE\n    sha256: c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4\n    file_name: LICENSE\n  - url: https://github.com/run-llama/pdfium-binaries/releases/download/chromium%2F7847/pdfium-linux-x64.tgz\n    sha256: 3e8326bc517d071c569efc23f6e18d60a83c7b775c714bb571c609fffebd5320\n    target_directory: pdfium-linux-x64\n  - url: https://github.com/run-llama/pdfium-binaries/releases/download/chromium%2F7847/pdfium-mac-x64.tgz\n    sha256: f72f89d175c16cc692fa1218aa777270faaac054be351ce40185cbedb0c4280f\n    target_directory: pdfium-mac-x64\n  - url: https://github.com/run-llama/pdfium-binaries/releases/download/chromium%2F7847/pdfium-mac-arm64.tgz\n    sha256: 38f3c04decee8304283b0e779d520d7ff40d3ceafd93eaf4eb07cd73be34481a\n    target_directory: pdfium-mac-arm64\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: ${{ name }}\n      version: ${{ version }}\n\n    build:\n      skip: win or ppc64le\n      script:\n        env:\n          CARGO_PROFILE_RELEASE_STRIP: symbols\n          CARGO_PROFILE_RELEASE_LTO: fat\n        content:\n          - if: linux\n            then:\n              - export PDFIUM_ROOT=\"${SRC_DIR}/pdfium-linux-x64\"\n              - export PDFIUM_DYLIB=\"libpdfium.so\"\n          - if: osx and x86_64\n            then:\n              - export PDFIUM_ROOT=\"${SRC_DIR}/pdfium-mac-x64\"\n              - export PDFIUM_DYLIB=\"libpdfium.dylib\"\n          - if: osx and arm64\n            then:\n              - export PDFIUM_ROOT=\"${SRC_DIR}/pdfium-mac-arm64\"\n              - export PDFIUM_DYLIB=\"libpdfium.dylib\"\n          - export PDFIUM_LIB_PATH=\"${PDFIUM_ROOT}/lib\"\n          - export PDFIUM_INCLUDE_PATH=\"${PDFIUM_ROOT}/include\"\n          - cargo fetch\n          - cargo update --workspace --offline\n          - cargo auditable install --locked --no-default-features --path crates/liteparse --root ${{ PREFIX }} --no-track\n          - cp \"${PDFIUM_LIB_PATH}/${PDFIUM_DYLIB}\" \"${PREFIX}/bin/${PDFIUM_DYLIB}\"\n          - cp \"${PDFIUM_ROOT}/LICENSE\" PDFIUM-LICENSE\n          - cp -R \"${PDFIUM_ROOT}/licenses\" pdfium-licenses\n          - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ compiler('rust') }}\n        - ${{ stdlib('c') }}\n        - cargo-auditable\n        - cargo-bundle-licenses\n\n    tests:\n      - script:\n          - lit --help\n      - package_contents:\n          bin:\n            - lit\n\n    about:\n      summary: Fast, lightweight document parsing CLI\n      license: Apache-2.0\n      license_file:\n        - LICENSE\n        - THIRDPARTY.yml\n        - PDFIUM-LICENSE\n        - pdfium-licenses/*.txt\n        - pdfium-licenses/*.md\n\n  - package:\n      name: python-${{ name }}\n      version: ${{ version }}\n\n    build:\n      skip: win or ppc64le\n      script:\n        env:\n          CARGO_PROFILE_RELEASE_STRIP: symbols\n          CARGO_PROFILE_RELEASE_LTO: fat\n        content:\n          - if: linux\n            then:\n              - export PDFIUM_ROOT=\"${SRC_DIR}/pdfium-linux-x64\"\n              - export PDFIUM_DYLIB=\"libpdfium.so\"\n          - if: osx and x86_64\n            then:\n              - export PDFIUM_ROOT=\"${SRC_DIR}/pdfium-mac-x64\"\n              - export PDFIUM_DYLIB=\"libpdfium.dylib\"\n          - if: osx and arm64\n            then:\n              - export PDFIUM_ROOT=\"${SRC_DIR}/pdfium-mac-arm64\"\n              - export PDFIUM_DYLIB=\"libpdfium.dylib\"\n          - export PDFIUM_LIB_PATH=\"${PDFIUM_ROOT}/lib\"\n          - export PDFIUM_INCLUDE_PATH=\"${PDFIUM_ROOT}/include\"\n          - cp \"${PDFIUM_LIB_PATH}/${PDFIUM_DYLIB}\" \"liteparse/${PDFIUM_DYLIB}\"\n          - cargo fetch\n          - cargo update --workspace --offline\n          - maturin build --release --locked --no-default-features --interpreter ${{ PYTHON }} --out dist\n          - ${{ PYTHON }} -m pip install dist/*.whl -vv --no-deps --no-build-isolation\n          - rm -f \"${PREFIX}/bin/lit\"\n          - cp \"${PDFIUM_ROOT}/LICENSE\" PDFIUM-LICENSE\n          - cp -R \"${PDFIUM_ROOT}/licenses\" pdfium-licenses\n          - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\n    requirements:\n      build:\n        - if: build_platform != target_platform\n          then:\n            - cross-python_${{ target_platform }}\n            - python\n            - maturin\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ compiler('rust') }}\n        - ${{ stdlib('c') }}\n        - cargo-bundle-licenses\n      host:\n        - python\n        - maturin\n        - pip\n      run:\n        - python\n\n    tests:\n      - python:\n          imports:\n            - liteparse\n          pip_check: true\n      - package_contents:\n          site_packages:\n            - liteparse\n\n    about:\n      summary: Python bindings for LiteParse document parsing\n      license: Apache-2.0\n      license_file:\n        - LICENSE\n        - THIRDPARTY.yml\n        - PDFIUM-LICENSE\n        - pdfium-licenses/*.txt\n        - pdfium-licenses/*.md\n\nabout:\n  summary: Open-source document parsing with spatial text extraction and OCR processing\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://github.com/run-llama/liteparse\n  repository: https://github.com/run-llama/liteparse\n\nextra:\n  recipe-maintainers:\n    - moritzwilksch\n",
