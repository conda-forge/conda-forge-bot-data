  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: cp2k\n  version: \"2026.1\"\n  mpi_prefix: \"mpi_${{ mpi }}\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/${{ name }}/${{ name }}/releases/download/v${{ version }}/${{ name }}-${{ version }}.tar.bz2\n    sha256: 4364c74bcffaa474bc234e11686b09550e4d06932acf2147a341e4f7679dd88e\n\nbuild:\n  number: 12\n  script: build.sh\n  string: mpi_${{ mpi }}_h${{ hash }}_${{ build_number }}\n  skip:\n    - if: aarch64 or osx or win\n      then: true\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"cxx\") }}\n    - ${{ compiler(\"fortran\") }}\n    - ${{ mpi }}\n    - cmake >=3.27\n    - ninja >=1.13\n    - pkg-config\n  host:\n    - ${{ mpi }}\n    - \"dbcsr >=2.9 *${{ mpi_prefix }}_*\"\n    - \"fftw * *${{ mpi_prefix }}_*\"\n    - hdf5\n    - libint\n    - libint-fortran-devel\n    - \"libtorch >=2.7.1 *cpu_generic_*\"\n    - \"libxc >=7.0.0 *cpu_*\"\n    - libxsmm\n    - \"openblas * *openmp_*\"\n    - \"plumed >=2.9.2 *${{ mpi_prefix }}_*\"\n    - scalapack\n    - \"sirius * *${{ mpi_prefix }}_*\"\n    - \"spfft * ${{ mpi_prefix }}_*\"\n    - \"spla * ${{ mpi_prefix }}_*\"\n    - spglib\n#   - tblite\n    - trexio\n    - if: mpi == \"openmpi\"\n      then:\n        - \"elpa >=2024.05.001 *${{ mpi_prefix }}_*\"\n  run:\n    - ${{ mpi }}\n    - \"fftw * *${{ mpi_prefix }}_*\"\n    - \"libtorch >=2.7.1 *cpu_generic_*\"\n    - \"openblas * *openmp_*\"\n    - \"plumed >=2.9.2 *${{ mpi_prefix }}_*\"\n    - \"sirius * *${{ mpi_prefix }}_*\"\n    - \"spfft * ${{ mpi_prefix }}_*\"\n    - \"spla * ${{ mpi_prefix }}_*\"\n\ntests:\n  - package_contents:\n      bin:\n        - cp2k.psmp\n        - cp2k.popt\n        - cp2k\n  - script:\n      - cp2k -h\n\nabout:\n  homepage: https://www.cp2k.org\n  license: GPL-2.0-only\n  license_family: GPL\n  license_file: LICENSE\n  summary: Quantum chemistry and solid state physics software package\n  description: |\n    CP2K is a quantum chemistry and solid state physics software package\n    that can perform atomistic simulations of solid state, liquid,\n    molecular, periodic, material, crystal, and biological systems.\n  documentation: https://manual.cp2k.org\n  repository: https://github.com/cp2k/cp2k\n\nextra:\n  recipe-maintainers:\n    - jan-janssen\n    - oschuett\n    - ltalirz\n    - mkrack\n",
