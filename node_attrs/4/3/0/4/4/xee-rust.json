  "win_64_meta_yaml": {
    "about": {
      "description": "Xee is an XML execution engine written in Rust. The `xee` CLI provides an\nalmost complete XPath 3.1 implementation that can load XML documents, issue\nXPath expressions against them (including in a REPL), pretty-print XML\ndocuments, and transform XML documents using XSLT stylesheets.",
      "dev_url": "https://github.com/Paligo/xee",
      "doc_url": "https://github.com/Paligo/xee/tree/main/xee",
      "home": "https://github.com/Paligo/xee",
      "license": "MIT AND Unicode-3.0",
      "license_family": "MIT AND Unicode-3.0",
      "license_file": "COPYRIGHT",
      "summary": "Swiss Army knife for XML, XPath and XSLT"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cd xee",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins",
          "cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml"
        ],
        "env": {
          "AR_x86_64_pc_windows_msvc": "llvm-lib",
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "CC_x86_64_pc_windows_msvc": "clang-cl",
          "CXX_x86_64_pc_windows_msvc": "clang-cl"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
