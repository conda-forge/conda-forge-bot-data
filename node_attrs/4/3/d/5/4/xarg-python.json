  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: xarg-python\n  version: \"1.8.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name | replace('-', '_') }}-${{ version }}.tar.gz\n  sha256: 11f20e13b839ec7d0362fbd8fb6f64d0f749fecfbe68bc9df737fc563ed83c70\n  patches:\n    - requirements.patch\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - xargcomplete = xarg.complete:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - argcomplete\n    - pip\n    - colorama\n    - colorlog\n    - openpyxl\n    - wcwidth\n    - xlrd\n    - xlwt\n    - tabulate\n    - setuptools\n    - filelock\n  run:\n    - filelock\n    - openpyxl\n    - wcwidth\n    - xlrd\n    - xlwt\n    - tabulate\n    - colorama\n    - colorlog\n    - python >=${{ python_min }}\n    - argcomplete >=3.2.1\n    - tabulate\n\ntests:\n  - python:\n      imports:\n        - xarg\n      pip_check: true\n      python_version:\n        - ${{ python_min }}\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - xargcomplete --help\n\nabout:\n  summary: Simple command-line tool based on argparse.\n  license: MIT\n  license_file: LICENSE\n  homepage: https://github.com/bondbox/xarg-python/\n\nextra:\n  recipe-maintainers:\n    - jan-janssen\n",
