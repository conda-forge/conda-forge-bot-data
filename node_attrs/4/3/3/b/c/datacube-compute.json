  "raw_meta_yaml": "context:\n  name: datacube-compute\n  python_min: \"3.10\"\n  version: \"0.1.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/auspatious/datacube-compute/archive/${{ version }}.tar.gz\n  sha256: f9bbe480778e1184261909ce164e551e5d80e80ef071aebd8257426b026e7d84\n\nbuild:\n  number: 0\n  python:\n    version_independent: true\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: win\n        then: set MATURIN_PEP517_ARGS=\"--features=pyo3/abi3-py310\"\n        else: export MATURIN_PEP517_ARGS=\"--features=pyo3/abi3-py310\"\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  skip:\n    - not (match(python, python_min ~ \".*\") and is_abi3)\n\nrequirements:\n  build:\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n    - maturin >=1.0,<2.0\n  host:\n    - maturin >=1.0,<2.0\n    - pip\n    - python ${{ python_min }}.*\n    - if: is_abi3\n      then:\n        - python-abi3 ${{ python_min }}.*\n  run:\n    - numpy\n    - python >=${{ python_min }}\n    - xarray\n\ntests:\n  - python:\n      imports:\n        - datacube_compute\n      pip_check: true\n      python_version: ${{ python_min }}.*\n  - script:\n      - python -c \"import datacube_compute; assert datacube_compute.__version__ == '${{ version }}', datacube_compute.__version__\"\n      - if: unix and is_abi3\n        then: abi3audit $SP_DIR/datacube_compute/backend.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      - if: win and is_abi3\n        then: abi3audit %SP_DIR%\\\\datacube_compute\\\\backend.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n    requirements:\n      run:\n        - abi3audit\n\nabout:\n  summary: A library with fast implementations of algorithms for processing satellite images.\n  license: Apache-2.0\n  license_file:\n    - THIRDPARTY.yml\n    - LICENSE\n  homepage: https://github.com/auspatious/datacube-compute\n\nextra:\n  recipe-maintainers:\n    - alexgleith\n    - weiji14\n",
