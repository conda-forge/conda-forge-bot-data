  "raw_meta_yaml": "# Check if the files exists\nschema_version: 1\n\ncontext:\n  name: rte_rrtmgp\n  version: \"1.9.2\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/earth-system-radiation/rte-rrtmgp/archive/refs/tags/v${{ version }}.zip\n  sha256: b969d8745687de277e29247212a254afef3adcaec19492e580a4541955941542\n\n# In fact Windows builds win using compiler('m2w64_fortran'), compiler('m2w64_c'), stdlib('m2w64_c')\n#   but package_contents aren't found and I can't figure out how to skip tests for \n#   only one platform \nbuild:\n  number: 2\n  skip: win\n\nrequirements:\n  build:\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('fortran') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - ninja\n    - if: unix\n      then: \n        - gnuconfig\n    - python\n    - netcdf-fortran >=4.5,<5.0\n  host:\n    - python\n    - netcdf4\n    - xarray\n    - dask\n    - numpy\n  run:\n    - python\n\ntests:\n  - package_contents:\n      lib: \n        - librte\n        - librrtmgp\n      include:\n        - rte_types.h\n        - rte_kernels.h\n        - rrtmgp_kernels.h\n\nabout:\n  summary: Fortran codes for computing radiative fluxes in planetary atmospheres.\n  license: BSD-3-Clause\n  license_file: LICENSE.txt\n  homepage: https://github.com/earth-system-radiation/rte-rrtmgp\n  documentation: https://earth-system-radiation.github.io/rte-rrtmgp/\n\nextra:\n  recipe-maintainers:\n    - RobertPincus\n    - makepath-alex\n",
