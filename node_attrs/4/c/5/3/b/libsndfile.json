  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: libsndfile\n  version: \"1.2.2\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/libsndfile/${{ name }}/releases/download/${{ version }}/${{ name }}-${{ version }}.tar.xz\n  sha256: 3799ca9924d3125038880367bf1468e53a1b7e3686a934f098b7e1d286cdb80e\n  patches:\n    # Libs.private is only useful for static linking, which this package does\n    # not provide. On Windows it also produced an empty -l entry that broke\n    # downstream linking.\n    # https://github.com/libsndfile/libsndfile/issues/827\n    - disable_libs_private_pkgconfig.patch\n\nbuild:\n  number: 3\n  script: build\n  variant:\n    ignore_keys:\n      - python\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - python\n    - if: unix\n      then:\n        - gnuconfig\n        - make\n        - pkg-config\n    - if: win\n      then:\n        - cmake\n        - ninja\n  host:\n    - libflac\n    - libvorbis\n    - libogg\n    - libopus\n    - lame\n    - mpg123\n  run_exports:\n    # https://abi-laboratory.pro/?view=timeline&l=libsndfile\n    - ${{ pin_subpackage(name, upper_bound='x.x') }}\n\ntests:\n  - package_contents:\n      bin:\n        - sndfile-info\n      include:\n        - sndfile.h\n      lib:\n        - if: unix\n          then: sndfile\n      files:\n        - if: win\n          then:\n            - Library/bin/sndfile.dll\n            - Library/lib/sndfile.lib\n  - if: unix and build_platform == target_platform\n    then:\n      script:\n        - sndfile-info --help || test $? -le 1\n  - if: win\n    then:\n      script:\n        - cmd /V:ON /C \"sndfile-info --help & if !ERRORLEVEL! GTR 1 (exit /b !ERRORLEVEL!) else (exit /b 0)\"\n\nabout:\n  homepage: http://www.mega-nerd.com/libsndfile\n  repository: https://github.com/libsndfile/libsndfile\n  license: LGPL-2.1-or-later\n  license_file: COPYING\n  summary: libsndfile - a C library for reading and writing files containing sampled sound through one standard library interface\n\nextra:\n  recipe-maintainers:\n    - hbredin\n    - thomasfillon\n    - SylvainCorlay\n    - wolfv\n    - JohanMabille\n    - bmcfee\n",
