  "raw_meta_yaml": "context:\n  version: \"0.7.0\"\n\npackage:\n  name: finch-tensor\n  version: ${{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/f/finch-tensor/finch_tensor-${{ version }}.tar.gz\n    sha256: e7b3fd48fc804dbaec90b98556c44dd44a37517b0553d96dbe355786fdf99a7c\n\nbuild:\n  noarch: python\n  script: uv pip install --python ${{ PYTHON }} . -vv --no-deps\n  number: 0\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - uv\n  run:\n    - python >=${{ python_min }}\n    - numpy >=2.0,<2.4\n    - numba >=0.61,<2\n    - donfig >=0.8.1.post1,<0.9.0\n    - lark >=1.3.0,<2\n    - scipy >=1.7,<2\n    # A C compiler is one of the optional backends, with the others based on Julia and MLIR.\n    # Consider shipping each backend separately once optional dependency support\n    # per https://conda.org/learn/ceps/cep-0044 is available in conda-forge.\n    # C backend:\n    - c-compiler >=2.0.0  # minimally activated on unix\n    # Julia backend:\n    # - pyjuliapkg >=0.1.16,<0.2.0\n    # - pyjuliacall >=0.9.24,<0.10.0\n    # MLIR backend:\n    # - mlir-python-bindings  # pending https://github.com/finch-tensor/finch-tensor/issues/567\n\ntests:\n  - python:\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n      imports: finch\n  - script: pytest -v -ra src/finch/tests/ -m \"not slow and not mlir_backend\" --ignore-glob=src/finch/tests/reference/* -o addopts=\"\"\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pytest\n        - pytest-regressions\n        - sparse\n        # for array-api-tests:\n        - pytest-json-report\n        - hypothesis\n        - ndindex\n    files:\n      source:\n        - src/finch/tests/\n        - array-api-skips.txt\n        - pyproject.toml\n\nabout:\n  homepage: https://github.com/finch-tensor/finch-tensor\n  summary: Productive Sparse Array Programming\n  description: Sparse array programming backed by Finch.jl.\n  license: MIT\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - lucascolley\n    - mtsokol\n    - willow-ahrens\n",
