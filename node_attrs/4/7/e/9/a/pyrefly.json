  "raw_meta_yaml": "context:\n  name: pyrefly\n  version: \"1.1.1\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/facebook/${{ name }}/archive/refs/tags/${{ version }}.tar.gz\n  sha256: b0de811112349a53422532ab393bdd52c7a3a97720c5bc498c1a314e6b2406bd\n\nbuild:\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - cd pyrefly\n      - if: win\n        then:\n          # path too long for git dependencies\n          - set CARGO_HOME=C:\\.cargo\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .\n        else:\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path .\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n  number: 1\n\nrequirements:\n  build:\n    - ${{ compiler('rust') }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - make\n\ntests:\n  - script: pyrefly --help\n  - package_contents:\n      bin:\n        - pyrefly\n      strict: true\n\nabout:\n  homepage: http://pyrefly.org\n  summary: A fast type checker and IDE for Python\n  description: |\n    Pyrefly is a fast type checker for Python. It's designed to replace the existing Pyre type checker at Meta by the end of 2025. This README describes basic usage. See the Pyrefly website for full documentation and a tool for checking code.\n  license: MIT\n  license_file:\n    - LICENSE\n    - pyrefly/THIRDPARTY.yml\n  documentation: https://pyrefly.org/en/docs/\n  repository: https://github.com/facebook/pyrefly\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
