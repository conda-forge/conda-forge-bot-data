  "linux_64_meta_yaml": {
    "about": {
      "description": "The CernVM File System (CernVM-FS) provides a scalable, reliable and\nlow-maintenance software distribution service. libcvmfs allows\napplications to mount and access CernVM-FS repositories in\nuser space without a FUSE kernel module.\n\nThe package contains the libcvmfs_client library together with its\ncompanion libraries libcvmfs_util and libcvmfs_crypto. The Keccak\nreference SHA-3 implementation (CC0-1.0) is statically linked into\nthe package; unlike upstream's binary packages, libcvmfs_crypto is\nbuilt against OpenSSL rather than a bundled static LibreSSL.",
      "dev_url": "https://github.com/cvmfs/cvmfs",
      "doc_url": "https://cvmfs.readthedocs.io/",
      "home": "https://cernvm.cern.ch/fs/",
      "license": "BSD-3-Clause AND CC0-1.0",
      "license_family": "BSD-3-Clause AND CC0-1.0",
      "license_file": "COPYING",
      "summary": "CernVM-FS client library for embedding a CernVM-FS client without FUSE"
    },
    "build": {
      "number": "1",
      "run_exports": {
        "weak": [
          "libcvmfs"
        ]
      }
    },
    "extra": {
      "feedstock-name": "cvmfs",
      "recipe-maintainers": [
        "chrisburr"
      ]
    },
    "outputs": [
      {
        "build": {
          "strong": [],
          "weak": [
