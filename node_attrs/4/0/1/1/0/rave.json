  "raw_meta_yaml": "context:\n  version: \"0.6.25\"\n\npackage:\n  name: rave\n  version: ${{ version }}\n\nsource:\n  url: https://rave.hepforge.org/downloads?f=rave-${{ version }}.tar.gz\n  sha256: fb52fff3aa32e78d7576569113743af1f0868a5dc7b5c055e2ea0e6c1c49d070\n  patches:\n    - 0001-cpp17.patch\n    - 0002-glibc2.3-isnan.patch\n    - 0003-silence-cout.patch\n    - 0004-template-fix.patch\n    - 0005-uniqueptr.patch\n\nbuild:\n  script:\n    - rm -rf src/boost\n    - ln -sf \"${PREFIX}/include/boost\" src/boost\n    - rm -rf src/ROOT/*/Math src/ROOT/*/TMath.h\n    - ln -sf \"${PREFIX}/include/Math\" src/ROOT/mathcore && ln -sf \"${PREFIX}/include/Math\" src/ROOT/smatrix && ln -sf \"${PREFIX}/include/TMath.h\" src/ROOT/mathcore/TMath.h\n    - rm -rf src/ROOT/genvector/Math\n    - ln -sf \"${PREFIX}/include/Math\" src/ROOT/genvector/Math\n    - echo \"\" > src/ROOT/src/GenVector_Throw.cc\n    - CXXFLAGS=\"${CXXFLAGS} $(root-config --cflags)\" LDFLAGS=\"${LDFLAGS} $(root-config --libs)\" ./configure --prefix=${PREFIX} --disable-java --disable-static --with-clhep=${PREFIX} --with-boost=${PREFIX}\n    - make -j${CPU_COUNT} CXX=$CXX && make install\n    - rm -rf ${PREFIX}/bin/memorytests ${PREFIX}/bin/propagatortests\n  number: 0\n  skip:\n    - win\n    - osx\n\nrequirements:\n  build:\n    - ${{ compiler(\"cxx\") }}\n    - ${{ stdlib(\"c\") }}\n    - make\n  host:\n    - clhep\n    - libboost-devel\n    - pkg-config\n    - root_base\n  run_exports:\n    - ${{ pin_subpackage(\"rave\", upper_bound=\"x.x\") }}\n\ntests:\n  - script:\n    - rave_version\n    - kinematics01\n    - kinematics02\n    - kinematics03\n  - package_contents:\n      bin:\n        - kinematics01\n        - kinematics02\n        - kinematics03\n        - rave_version\n      lib:\n        - RaveBase\n        - RaveCore\n        - RaveFlavorTag\n        - RaveVertex\n        - RaveVertexKinematics\n        - archer\n      include:\n        - rave/*\n      files:\n        - lib/pkgconfig/rave-impl.pc\n        - lib/pkgconfig/rave.pc\n        - share/rave/RaveConfig.cmake\n      strict: true\n\nabout:\n  homepage: https://rave.hepforge.org/\n  summary: 'Reconstruction in an Abstract, Versatile Environment - Rave'\n  description: |\n    Rave takes a set of reconstructed particle tracks as its input and produces reconstructed interaction vertices as\n    its output. It deals both with finding (pattern recognition) and with fitting (statistical estimation) of the\n    interaction vertices.\n  license: GPL-2.0-or-later\n  license_file: COPYING\n  documentation: https://rave.hepforge.org/doxygen/html/\n  repository: https://repo.hepforge.org/source/ravesvn/\n\nextra:\n  recipe-maintainers:\n    - utk4r-sh\n    - GiacomoXT\n    - vvsagar\n    - AlexanderHeidelbach\n",
