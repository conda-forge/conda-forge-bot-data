  "linux_64_meta_yaml": {
    "about": {
      "description": "PipeWire is a server and user space API to deal with multimedia pipelines.\nIt provides a low-latency, graph-based processing engine on top of audio\nand video devices that can be used to support the use cases currently\nhandled by both PulseAudio and JACK.\n\nThis is a minimal build providing only the core client library\n(libpipewire-0.3) and the SPA plugin API headers (libspa-0.2), which is\nwhat Weston's backend-pipewire links against. The session managers,\nALSA/JACK/V4L2 integrations, bluez5, gstreamer, ffmpeg and pulse support\nare all disabled to keep the dependency footprint small.",
      "dev_url": "https://gitlab.freedesktop.org/pipewire/pipewire",
      "home": "https://pipewire.org/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "COPYING",
      "summary": "Server and user space API to deal with multimedia pipelines"
    },
    "build": {
      "number": "0",
      "run_exports": {
        "weak": [
          "pipewire"
        ]
      },
      "script": "build.sh"
    },
