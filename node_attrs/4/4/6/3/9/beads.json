  "linux_64_meta_yaml": {
    "about": {
      "description": "Beads (bd) is a fast, local-first CLI issue tracker designed for software\nteams and AI agents. It stores issues alongside your code in a Dolt\n(MySQL-compatible) database, supports hierarchical issues, dependencies,\nmolecules (multi-step workflows), integrations with GitHub/GitLab/Jira/Linear,\nand MCP server support for AI agents.",
      "dev_url": "https://github.com/gastownhall/beads",
      "doc_url": "https://github.com/gastownhall/beads/tree/main/docs",
      "home": "https://github.com/gastownhall/beads",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "A developer-centric issue tracker that lives in your Git repo"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "let default_branch = (http get https://api.github.com/repos/gastownhall/beads).default_branch",
          "let commit_hash = (http get https://api.github.com/repos/gastownhall/beads/commits/v${{ version }}).sha",
          "let short_commit_hash = ($commit_hash | str substring 0..6)",
          "go build -o=($prefix)/bin/ -v -ldflags=$'-s -w -X main.Branch=($default_branch) -X main.Build=($short_commit_hash) -X main.Commit=($commit_hash) -X main.Version=${{ version }}' -tags=gms_pure_go -trimpath ./cmd/bd",
          "go-licenses save ./cmd/bd --save_path=library_licenses --ignore=github.com/apache/arrow/go/arrow --ignore=github.com/apache/thrift/lib/go/thrift --ignore=github.com/dolthub/eventkit --ignore=github.com/dolthub/eventkit/transport/ga4 --ignore=github.com/kch42/buzhash --ignore=github.com/mattn/go-localereader",
          "cp --recursive library_licenses_2/* library_licenses/",
          "rm --recursive library_licenses_2",
          "mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions",
          "let bin = ($prefix)/bin/bd",
          "^$bin completion bash | save ($prefix)/share/bash-completion/completions/bd",
          "^$bin completion fish | save ($prefix)/share/fish/vendor_completions.d/bd.fish",
          "^$bin completion zsh  | save ($prefix)/share/zsh/site-functions/_bd"
        ],
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "maphew",
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "beads",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "go-cgo_compiler_stub",
            "go-licenses",
            "nushell"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": {
              "content": [
                "bd --help",
                "bd --version"
              ],
              "env": {
                "BD_DISABLE_EVENT_FLUSH": "1",
                "BD_DISABLE_METRICS": "1",
                "BD_NO_DAEMON": "1",
                "BEADS_DOLT_AUTO_START": "0"
              }
            }
          },
          {
            "package_contents": {
              "bin": [
                "bd"
              ],
              "files": [
                "share/bash-completion/completions/bd",
                "share/fish/vendor_completions.d/bd.fish",
                "share/zsh/site-functions/_bd"
              ],
              "strict": true
            }
          }
        ],
        "version": "1.2.2"
      }
    ],
    "package": {
