      "doc_url": "https://github.com/gastownhall/beads/tree/main/docs",
      "home": "https://github.com/gastownhall/beads",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "A developer-centric issue tracker that lives in your Git repo"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "let default_branch = (http get https://api.github.com/repos/gastownhall/beads).default_branch",
          "let commit_hash = (http get https://api.github.com/repos/gastownhall/beads/commits/v${{ version }}).sha",
          "let short_commit_hash = ($commit_hash | str substring 0..6)",
          "go build -o=($prefix)/bin/ -v -ldflags=$'-s -w -X main.Branch=($default_branch) -X main.Build=($short_commit_hash) -X main.Commit=($commit_hash) -X main.Version=${{ version }}' -tags=gms_pure_go -trimpath ./cmd/bd",
          "go-licenses save ./cmd/bd --save_path=library_licenses --ignore=github.com/apache/arrow/go/arrow --ignore=github.com/apache/thrift/lib/go/thrift --ignore=github.com/dolthub/eventkit --ignore=github.com/dolthub/eventkit/transport/ga4 --ignore=github.com/kch42/buzhash --ignore=github.com/mattn/go-localereader",
          "cp --recursive library_licenses_2/* library_licenses/",
          "rm --recursive library_licenses_2"
        ],
        "interpreter": "nu"
      }
    },
