  "raw_meta_yaml": "context:\n  version: \"1.2.2\"\n\npackage:\n  name: beads\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/gastownhall/beads/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 892b8b641d1f9eb3fa9f0cddf704f3f41aea0da872e546fe623ddec30b2ea9cf\n  # the following dependencies miss standard license file layout, so we have to manually add their license files\n  # (`github.com/dolthub/eventkit` has no license)\n  - url: https://raw.githubusercontent.com/apache/arrow-go/main/LICENSE.txt\n    sha256: ff2fe52b8dfd2574c6ea7f0c407948c857f62672c2a3a9a17083ee10af8067ef\n    target_directory: library_licenses_2/github.com/apache/arrow-go\n  - url: https://raw.githubusercontent.com/apache/thrift/master/LICENSE\n    sha256: c866aafb79e8d5885eabb9d44a0105c8fcca35d26c5088025b131a908458a8af\n    target_directory: library_licenses_2/github.com/apache/thrift\n  - url: https://raw.githubusercontent.com/kch42/buzhash/master/LICENSE\n    sha256: e36eb71189a6d30b09337cbf5fb5155f7286bc0e728d5fbad163723abc6b170c\n    target_directory: library_licenses_2/github.com/kch42/buzhash\n  - url: https://raw.githubusercontent.com/mattn/go-localereader/master/LICENSE\n    sha256: dceede03550621e65ec7b79fcba87cf6dbb9d31132a8ae71a8fe8ceec0af7da3\n    target_directory: library_licenses_2/github.com/mattn/go-localereader\n\nbuild:\n  number: 0\n  script:\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      # upstream refs: https://github.com/gastownhall/beads/blob/main/docs/INSTALLING.md & https://github.com/gastownhall/beads/blob/main/.goreleaser.yml\n      - let default_branch = (http get https://api.github.com/repos/gastownhall/beads).default_branch\n      - let commit_hash = (http get https://api.github.com/repos/gastownhall/beads/commits/v${{ version }}).sha\n      - let short_commit_hash = ($commit_hash | str substring 0..6)\n      - go build\n        -o=($prefix)/bin/\n        -v\n        -ldflags=$'-s -w -X main.Branch=($default_branch) -X main.Build=($short_commit_hash) -X main.Commit=($commit_hash) -X main.Version=${{ version }}'\n        -tags=gms_pure_go\n        -trimpath\n        ./cmd/bd\n      - go-licenses save ./cmd/bd\n        --save_path=library_licenses\n        --ignore=github.com/apache/arrow/go/arrow\n        --ignore=github.com/apache/thrift/lib/go/thrift\n        --ignore=github.com/dolthub/eventkit\n        --ignore=github.com/dolthub/eventkit/transport/ga4\n        --ignore=github.com/kch42/buzhash\n        --ignore=github.com/mattn/go-localereader\n      # merge library license files\n      - cp --recursive library_licenses_2/* library_licenses/\n      - rm --recursive library_licenses_2\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - let bin = ($prefix)/bin/bd\n          - ^$bin completion bash | save ($prefix)/share/bash-completion/completions/bd\n          - ^$bin completion fish | save ($prefix)/share/fish/vendor_completions.d/bd.fish\n          - ^$bin completion zsh  | save ($prefix)/share/zsh/site-functions/_bd\n\nrequirements:\n  build:\n    # Build fails on both Windows and macOS with CGO enabled. On macOS, CGO-enabled code links the Security/CoreFoundation symbol\n    # `_SecTrustCopyCertificateChain` which apparently isn't available. The error on Windows is unclear (truncated from logs). Disabling CGO implies not\n    # embedding the default Dolt backend, which means the resulting Windows and macOS binaries require a running `dolt sql-server`.\n    - if: linux\n      then:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('c') }}\n        - ${{ compiler('go-cgo') }}\n      else:\n        - ${{ compiler('go-nocgo') }}\n    - go-licenses\n    - nushell\n\ntests:\n  - script:\n      env:\n        BEADS_DOLT_AUTO_START: \"0\"\n        BD_DISABLE_EVENT_FLUSH: \"1\"\n        BD_DISABLE_METRICS: \"1\"\n        BD_NO_DAEMON: \"1\"\n      content:\n        - bd --help\n        - bd --version\n  - package_contents:\n      bin:\n        - bd\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/bd\n            - share/fish/vendor_completions.d/bd.fish\n            - share/zsh/site-functions/_bd\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/bd\n            - Library/share/fish/vendor_completions.d/bd.fish\n            - Library/share/zsh/site-functions/_bd\n      strict: true\n\nabout:\n  summary: A developer-centric issue tracker that lives in your Git repo\n  description: |\n    Beads (bd) is a fast, local-first CLI issue tracker designed for software\n    teams and AI agents. It stores issues alongside your code in a Dolt\n    (MySQL-compatible) database, supports hierarchical issues, dependencies,\n    molecules (multi-step workflows), integrations with GitHub/GitLab/Jira/Linear,\n    and MCP server support for AI agents.\n  license: MIT\n  license_file:\n    - LICENSE\n    - library_licenses/\n  homepage: https://github.com/gastownhall/beads\n  documentation: https://github.com/gastownhall/beads/tree/main/docs\n  repository: https://github.com/gastownhall/beads\n\nextra:\n  recipe-maintainers:\n    - maphew\n    - salim-b\n",
