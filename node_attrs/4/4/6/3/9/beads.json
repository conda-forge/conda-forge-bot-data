  "raw_meta_yaml": "context:\n  version: \"1.0.5\"\n\npackage:\n  name: beads\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/steveyegge/beads/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 06e52a953b2e46044c70bc41421554c5d006370b1a25905b752d02eb0b337f0d\n  # Windows-only dep `go-localereader` (MIT-licensed) misses standard license file layout,\n  # so we have to manually add the license file\n  - url: https://raw.githubusercontent.com/mattn/go-localereader/master/LICENSE\n    sha256: dceede03550621e65ec7b79fcba87cf6dbb9d31132a8ae71a8fe8ceec0af7da3\n    target_directory: library_licenses_2/github.com/go-localereader\n\nbuild:\n  number: 0\n  script:\n    - if: unix\n      then:\n        - DEFAULT_BRANCH=\"$(curl -s \"https://api.github.com/repos/bitnami/ini-file\" | jq -r '.default_branch')\"\n        - COMMIT_HASH=\"$(curl -s \"https://api.github.com/repos/bitnami/ini-file/commits/v${{ version }}\" | jq -r '.sha')\"\n        - SHORT_COMMIT_HASH=\"$(echo \"${COMMIT_HASH}\" | cut -c 1-7)\"\n        - go build -o=\"$PREFIX\"/bin/bd -v -ldflags=\"-s -w -X main.Branch=${DEFAULT_BRANCH} -X main.Build=${SHORT_COMMIT_HASH} -X main.Commit=${COMMIT_HASH} -X main.Version=${{ version }}\" -trimpath ./cmd/bd\n        # generate shell completions\n        - mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n        - '\"$PREFIX\"/bin/bd completion bash > \"$PREFIX\"/share/bash-completion/completions/bd'\n        - '\"$PREFIX\"/bin/bd completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/bd.fish'\n        - '\"$PREFIX\"/bin/bd completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_bd'\n    - if: win\n      then:\n        - for /f \"usebackq delims=\" %%T in (`powershell -Command \"((Invoke-RestMethod 'https://api.github.com/repos/bitnami/ini-file').default_branch)\"`) do set DEFAULT_BRANCH=%%T\n        - for /f \"usebackq delims=\" %%T in (`powershell -Command \"((Invoke-RestMethod 'https://api.github.com/repos/bitnami/ini-file/commits/v${{ version }}').sha)\"`) do set COMMIT_HASH=%%T\n        - set \"SHORT_COMMIT_HASH=%COMMIT_HASH:~0,7%\"\n        - go build -o=\"%LIBRARY_BIN%\"\\bd.exe -v -ldflags=\"-s -w -X main.Branch=%DEFAULT_BRANCH% -X main.Build=%SHORT_COMMIT_HASH% -X main.Commit=%COMMIT_HASH% -X main.version=${{ version }}\" -trimpath ./cmd/bd\n        # generate shell completions\n        - mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n        - mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n        - mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n        - '\"%LIBRARY_BIN%\"\\bd.exe completion bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\bd'\n        - '\"%LIBRARY_BIN%\"\\bd.exe completion fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\bd.fish'\n        - '\"%LIBRARY_BIN%\"\\bd.exe completion zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_bd'\n    - go-licenses save ./cmd/bd --save_path=library_licenses --ignore=github.com/mattn/go-localereader\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script:\n      - bd --version\n      - bd --help\n  - package_contents:\n      bin:\n        - bd\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/bd\n            - share/fish/vendor_completions.d/bd.fish\n            - share/zsh/site-functions/_bd\n        - if: win\n          then:\n            - Library/share/bash-completion/completions/bd\n            - Library/share/fish/vendor_completions.d/bd.fish\n            - Library/share/zsh/site-functions/_bd\n      strict: true\n\nabout:\n  summary: A developer-centric issue tracker that lives in your Git repo\n  description: |\n    Beads (bd) is a fast, local-first CLI issue tracker designed for software\n    teams and AI agents. It stores issues alongside your code in a Dolt\n    (MySQL-compatible) database, supports hierarchical issues, dependencies,\n    molecules (multi-step workflows), integrations with GitHub/GitLab/Jira/Linear,\n    and MCP server support for AI agents.\n  license: MIT\n  license_file:\n    - LICENSE\n    - library_licenses/\n    - library_licenses_2/\n  homepage: https://github.com/steveyegge/beads\n  documentation: https://github.com/steveyegge/beads/tree/main/docs\n  repository: https://github.com/steveyegge/beads\n\nextra:\n  recipe-maintainers:\n    - maphew\n    - salim-b\n",
