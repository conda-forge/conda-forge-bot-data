  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.9.0\"\n  python_min: \"3.11\"\n\npackage:\n  name: reachy-mini\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/r/reachy-mini/reachy_mini-${{ version }}.tar.gz\n  sha256: 3a7e022cd585396c4b5ba7dbf356f93509cba9211bb1e06d90417dec7a3ee7cf\n\nbuild:\n  number: 0\n  # Pure python, but with OS-specific run dependencies: one noarch variant is\n  # built per OS (noarch_platforms in conda-forge.yml), each locked to its OS\n  # via a __linux/__osx/__win virtual package in the run requirements.\n  noarch: python\n  # The default build string doesn't distinguish the per-OS variants, so the\n  # OS goes into it explicitly (same approach as the mne feedstock).\n  string: ${{ \"linux\" if linux else (\"osx\" if osx else \"win\") }}_h${{ hash }}_${{ build_number }}\n  script:\n    # On windows, --use-deprecated=legacy-certs keeps pip from building a\n    # truststore SSL context, which reads the Windows certificate store and\n    # fails on the Azure CI runners (malformed cert in the runner's store) —\n    # the same issue documented for the skipped CLI tests below.\n    - if: win\n      then: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --use-deprecated=legacy-certs\n      else: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - reachy-mini-daemon = reachy_mini.daemon.app.main:main\n      - reachy-mini-app-assistant = reachy_mini.apps.app:main\n      - reachy-mini-reflash-motors = reachy_mini.tools.reflash_motors:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools\n    - pip\n  run:\n    # Core dependencies\n    - python >=${{ python_min }}\n    - numpy >=2.2.5\n    - scipy >=1.15.3,<2.0.0\n    - reachy-mini-motor-controller >=1.5.5\n    - psutil\n    - platformdirs\n    - jinja2\n    - uvicorn-standard\n    - fastapi\n    - pydantic >=2.12.5,<3.0.0\n    - python-multipart >=0.0.27\n    - starlette <1.0.0\n    - pyserial\n    - huggingface_hub >=1.17.0,<2\n    - reachy-mini-rust-kinematics >=1.0.3\n    - asgiref\n    - aiohttp >=3.14.0\n    - log-throttling ==0.0.3\n    - pyusb >=1.2.1\n    # Upstream pins >=1.0.26.3, but conda-forge ships 1.0.26.0 (the .x patch\n    # releases are PyPI-only); relaxed like the other pins above.\n    - libusb-package >=1.0.26\n    - pip >=26.1\n    - rich\n    - questionary\n    - websockets >=12,<16\n    - toml\n    - rustypot >=1.4.2\n    - pyyaml >=6.0\n    - requests >=2.33.0\n    # Upstream bumped the floor to >=0.149.7, but conda-forge's last <1 build\n    # is 0.147.3 (it jumps straight to 1.0.0); relaxed to the highest\n    # available series like the other pins above.\n    - zeroconf >=0.147,<1\n    # Extras (this package ships all optional features)\n    # Upstream pins are exact (==); conda-forge lacks those exact builds, so relaxed to >=.\n    - mujoco >=3.3.0\n    - onnxruntime >=1.26\n    - rerun-sdk >=0.29.0,<=0.31.3\n    - semver\n    - cryptography >=42.0\n    - pynput\n    - pysoundfile\n    - opencv\n    - cv2-enumerate-cameras\n    - gradio-client\n    - if: not win\n      then:\n        - placo >=0.9.14\n        # Upstream moved tornado (a meshcat transitive dep) into the\n        # placo_kinematics extra, scoped to non-Windows.\n        - tornado >=6.5.5\n    - if: linux\n      then:\n        - __linux\n        - pulsectl >=24.1.0\n    - if: osx\n      then:\n        - __osx\n    - if: win\n      then:\n        - __win\n        - pycaw >=20240210\n    # PyPI ships a bundled gstreamer (\"gstreamer-bundle\") off-Linux; on conda-forge we use the\n    # native gstreamer stack plus the GObject-introspection python bindings on all platforms.\n    - gstreamer >=1.28.3\n    - gst-plugins-base >=1.28.3\n    - gst-plugins-good >=1.28.3\n    - gst-python >=1.28.3\n    - pygobject >=3.42.2\n\ntests:\n  - python:\n      python_version: ${{ python_min }}.*\n      imports:\n        - reachy_mini\n      # The wheel METADATA pins several deps with == while the conda\n      # dependencies above are intentionally relaxed, so pip check always\n      # reports mismatches; this stays disabled as long as the pins diverge.\n      pip_check: false\n  # aiohttp (imported by the daemon) creates an SSL context at import time;\n  # loading the Windows certificate store fails on the Azure CI runners with\n  # \"ssl.SSLError: [ASN1: NOT_ENOUGH_DATA]\" (malformed cert in the runner's\n  # store), so the CLI checks are skipped there.\n  - if: not win\n    then:\n      requirements:\n        run:\n          - pip\n          - python\n      script:\n        - reachy-mini-daemon --help\n        - reachy-mini-app-assistant --help\n        - reachy-mini-reflash-motors --help\n\nabout:\n  summary: Python SDK, daemon, and tools for the Reachy Mini desktop robot\n  description: |\n    reachy-mini is the official Python package for Reachy Mini, the\n    open-source expressive desktop robot by Pollen Robotics and Hugging\n    Face. It bundles the SDK for controlling the robot's head, antennas,\n    audio, and camera, the `reachy-mini-daemon` that manages the hardware\n    and serves the web dashboard, tooling for installing and running apps\n    from the Hugging Face Hub, and MuJoCo-based simulation support.\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://huggingface.co/reachy-mini\n  repository: https://github.com/pollen-robotics/reachy_mini\n\nextra:\n  recipe-maintainers:\n    - ruben-arts\n",
