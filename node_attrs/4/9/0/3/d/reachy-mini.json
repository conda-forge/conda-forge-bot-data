    "about": {
      "description": "reachy-mini is the official Python package for Reachy Mini, the\nopen-source expressive desktop robot by Pollen Robotics and Hugging\nFace. It bundles the SDK for controlling the robot's head, antennas,\naudio, and camera, the `reachy-mini-daemon` that manages the hardware\nand serves the web dashboard, tooling for installing and running apps\nfrom the Hugging Face Hub, and MuJoCo-based simulation support.",
      "dev_url": "https://github.com/pollen-robotics/reachy_mini",
      "home": "https://huggingface.co/reachy-mini",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Python SDK, daemon, and tools for the Reachy Mini desktop robot"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "ruben-arts"
      ]
    },
