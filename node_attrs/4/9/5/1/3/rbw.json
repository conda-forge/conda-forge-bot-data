  "hash_type": "sha256",
  "linux_64_meta_yaml": {
    "about": {
      "description": "`rbw` is an unofficial command line client for Bitwarden that maintains\na background agent to manage encryption keys, similar to `ssh-agent` or\n`gpg-agent`. This avoids the need to repeatedly decrypt the vault for\neach operation, providing a faster and more convenient experience.",
      "dev_url": "https://github.com/doy/rbw",
      "home": "https://github.com/doy/rbw",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Unofficial Bitwarden CLI"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins",
          "mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions",
          "\"$PREFIX\"/bin/rbw gen-completions bash > \"$PREFIX\"/share/bash-completion/completions/rbw",
          "\"$PREFIX\"/bin/rbw gen-completions fish > \"$PREFIX\"/share/fish/vendor_completions.d/rbw.fish",
          "\"$PREFIX\"/bin/rbw gen-completions zsh  > \"$PREFIX\"/share/zsh/site-functions/_rbw",
          "cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "rbw",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "rbw --help",
              "rbw --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "rbw",
                "rbw-agent"
              ],
              "files": [
                "share/bash-completion/completions/rbw",
                "share/fish/vendor_completions.d/rbw.fish",
                "share/zsh/site-functions/_rbw"
              ],
              "strict": true
            }
          }
        ],
        "version": "1.15.0"
      }
    ],
