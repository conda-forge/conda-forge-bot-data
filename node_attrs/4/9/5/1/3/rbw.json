  "raw_meta_yaml": "context:\n  version: \"1.15.0\"\n\npackage:\n  name: rbw\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/doy/rbw/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 660cfa4c727711665bef060046c28dd3924ca1e490fdc058d90d35372b2d2cf6\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n          # generate shell completions\n          - mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n          - '\"$PREFIX\"/bin/rbw gen-completions bash > \"$PREFIX\"/share/bash-completion/completions/rbw'\n          - '\"$PREFIX\"/bin/rbw gen-completions fish > \"$PREFIX\"/share/fish/vendor_completions.d/rbw.fish'\n          - '\"$PREFIX\"/bin/rbw gen-completions zsh  > \"$PREFIX\"/share/zsh/site-functions/_rbw'\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n          # generate shell completions\n          - mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n          - mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n          - mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n          - '\"%LIBRARY_BIN%\"\\rbw.exe gen-completions bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\rbw'\n          - '\"%LIBRARY_BIN%\"\\rbw.exe gen-completions fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\rbw.fish'\n          - '\"%LIBRARY_BIN%\"\\rbw.exe gen-completions zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_rbw'\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n  skip: win\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n\ntests:\n  - script:\n      - rbw --help\n      - rbw --version\n  - package_contents:\n      bin:\n        - rbw\n        - rbw-agent\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/rbw\n            - share/fish/vendor_completions.d/rbw.fish\n            - share/zsh/site-functions/_rbw\n        - if: win\n          then:\n            - Library/share/bash-completion/completions/rbw\n            - Library/share/fish/vendor_completions.d/rbw.fish\n            - Library/share/zsh/site-functions/_rbw\n      strict: true\n\nabout:\n  summary: Unofficial Bitwarden CLI\n  description: |\n    `rbw` is an unofficial command line client for Bitwarden that maintains\n    a background agent to manage encryption keys, similar to `ssh-agent` or\n    `gpg-agent`. This avoids the need to repeatedly decrypt the vault for\n    each operation, providing a faster and more convenient experience.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/doy/rbw\n  repository: https://github.com/doy/rbw\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
