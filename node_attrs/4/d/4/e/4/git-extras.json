  "linux_64_meta_yaml": {
    "about": {
      "description": "GIT utilities -- repo summary, repl, changelog population,\nauthor commit percentages and more. Provides 60+ git subcommands such as\ngit-summary, git-effort, git-changelog, git-ignore, git-undo, git-rename-tag,\nand many others.",
      "dev_url": "https://github.com/tj/git-extras",
      "doc_url": "https://github.com/tj/git-extras/blob/main/Commands.md",
      "home": "https://github.com/tj/git-extras",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Little git extras"
    },
    "build": {
      "number": "0",
      "script": [
        "export SKIP_CONFLICT_CHECK=yes",
        "make install PREFIX=\"${PREFIX}\" SYSCONFDIR=\"${PREFIX}/etc\" COMPL_DIR=\"${PREFIX}/etc/bash_completion.d\"",
        "install -d \"${PREFIX}/share/zsh/site-functions\"",
        "install -m 644 etc/git-extras-completion.zsh \"${PREFIX}/share/zsh/site-functions/_git-extras\"",
        "install -d \"${PREFIX}/share/fish/vendor_completions.d\"",
        "install -m 644 etc/git-extras.fish \"${PREFIX}/share/fish/vendor_completions.d/git-extras.fish\""
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "baszalmstra"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "git-extras",
        "requirements": {
          "build": [
            "make",
            "util-linux"
          ],
          "host": [],
          "run": [
            "bash",
            "git",
            "util-linux"
          ]
        },
        "tests": [
          {
            "requirements": {
              "run": [
                "git"
              ]
            },
            "script": [
              "git-extras --version",
              "git extras --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "git-extras",
                "git-summary",
                "git-changelog",
                "git-ignore",
                "git-effort"
              ],
              "files": [
                "share/man/man1/git-extras.1",
                "etc/bash_completion.d/git-extras",
                "share/zsh/site-functions/_git-extras",
                "share/fish/vendor_completions.d/git-extras.fish"
              ]
            }
          }
        ],
        "version": "7.4.0"
      }
    ],
    "package": {
      "name": "git-extras",
      "version": "7.4.0"
    },
