  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"2.7.0\"\n  python_check_max: \"3.14\"\n\npackage:\n  name: httpx2\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/h/httpx2/httpx2-${{ version }}.tar.gz\n  sha256: 8b30709aed5c8465b0dd3b95c09ce301c8f79e7e7a2d00ab0af551e0d0375b07\n\nbuild:\n  noarch: python\n  number: 0\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n  python:\n    entry_points:\n      - httpx2 = httpx2:main\n\nrequirements:\n  host:\n    - hatch-fancy-pypi-readme\n    - hatchling\n    - pip\n    - python ${{ python_min }}.*\n    - uv-dynamic-versioning >=0.8.0\n  run:\n    - anyio\n    - httpcore2 ==${{ version }}\n    - idna >=3.18\n    - python >=${{ python_min }}\n    - truststore >=0.10\n    - typing_extensions >=4.5.0\n  run_constraints:\n    - click >=8.4\n    - pygments 2.*\n    - rich >=10,<16\n    - h2 >=3,<5\n    - socksio 1.*\n    - wsproto >=1.2\n    - zstandard >=0.18.0\n  # depends on https://github.com/conda/ceps/pull/146\n  # extras:\n  #   cli:\n  #     - click 8.*\n  #     - pygments 2.*\n  #     - rich >=10,<16\n  #   http2:\n  #     - h2 >=3,<5\n  #   socks:\n  #     - socksio 1.*\n  #   brotli:\n  #     - brotli\n  #   zstd:\n  #     - zstandard >=0.18.0\n\ntests:\n  - python:\n      imports: httpx2\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - ${{ python_check_max }}.*\n  - requirements:\n      run:\n        - click >=8.4\n        - python ${{ python_min }}.*\n        - pygments 2.*\n        - rich >=10,<16\n    script:\n      env:\n        PYTHONIOENCODING: utf-8\n        PYTHONUTF8: \"1\"\n      content:\n        - httpx2 --help\n\nabout:\n  homepage: https://pypi.org/project/httpx2\n  summary: The next generation HTTP client.\n  license: BSD-3-Clause\n  license_file: LICENSE.md\n  repository: https://github.com/pydantic/httpx2\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n    - Kludex\n",
