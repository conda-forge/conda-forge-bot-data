  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.2.0\"\n\npackage:\n  name: httpx2\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/h/httpx2/httpx2-${{ version }}.tar.gz\n  sha256: f3428d59b1752b8f5629826277262fb4d65e3a683f48af8a5b16c4d012e0b801\n\nbuild:\n  noarch: python\n  number: 0\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - httpx2 = httpx2:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling\n    - hatch-fancy-pypi-readme\n    - uv-dynamic-versioning >=0.7.0\n  run:\n    - python >=${{ python_min }}\n    - anyio\n    - certifi\n    - httpcore2 ==${{ version }}\n    - idna\n  run_constraints:\n    - click 8.*\n    - pygments 2.*\n    - rich >=10,<15\n    - h2 >=3,<5\n    - socksio 1.*\n    - zstandard >=0.18.0\n  # depends on https://github.com/conda/ceps/pull/146\n  # extras:\n  #   cli:\n  #     - click 8.*\n  #     - pygments 2.*\n  #     - rich >=10,<15\n  #   http2:\n  #     - h2 >=3,<5\n  #   socks:\n  #     - socksio 1.*\n  #   brotli:\n  #     - brotli\n  #   zstd:\n  #     - zstandard >=0.18.0\n\ntests:\n  - python:\n      imports:\n        - httpx2\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n      pip_check: true\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n        - click 8.*\n        - pygments 2.*\n        - rich >=10,<15\n    script:\n      - if: win\n        then:\n          - set PYTHONIOENCODING=utf-8\n          - set PYTHONUTF8=1\n      - httpx2 --help\n\nabout:\n  homepage: https://github.com/pydantic/httpx2\n  summary: The next generation HTTP client.\n  license: BSD-3-Clause\n  license_file: LICENSE.md\n  repository: https://github.com/pydantic/httpx2\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n    - Kludex\n",
