  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"2.12.0\"\n  python_check_max: \"3.14\"\n\nrecipe:\n  name: httpx2-split\n  version: ${{ version }}\n\nsource:\n  - target_directory: httpcore2\n    url: https://pypi.org/packages/source/h/httpcore2/httpcore2-${{ version }}.tar.gz\n    sha256: 9293522bba0aa7c4c8e9e3f040c16575bd8868e155a77fa30c7a9085a5eae648\n  - target_directory: httpx2\n    url: https://pypi.org/packages/source/h/httpx2/httpx2-${{ version }}.tar.gz\n    sha256: 7631fe9887a8a2275f4a2540e053aa670fcc50742864a9ae7c66e609fdcf12cf\n\nbuild:\n  noarch: python\n  number: 1\n\noutputs:\n  - package:\n      name: httpcore2\n      version: ${{ version }}\n    build:\n      noarch: python\n      script:\n        - cd httpcore2\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n    requirements:\n      host:\n        - hatch-fancy-pypi-readme\n        - hatchling\n        - pip\n        - python ${{ python_min }}.*\n        - uv-dynamic-versioning >=0.14.0\n      run:\n        - h11 >=0.16\n        - python >=${{ python_min }}\n        - truststore >=0.10\n      run_constraints:\n        - anyio >=4.5.0,<5.0\n        - h2 >=3,<5\n        - socksio 1.*\n        - trio >=0.22.0,<1.0\n    tests:\n      - python:\n          imports: httpcore2\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n    about:\n      homepage: https://pypi.org/project/httpcore2\n      summary: A minimal low-level HTTP client.\n      license_file: httpcore2/LICENSE.md\n\n  - package:\n      name: httpx2\n    build:\n      script:\n        - cd httpx2\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n      python:\n        entry_points:\n          - httpx2 = httpx2:main\n    requirements:\n      host:\n        - hatch-fancy-pypi-readme\n        - hatchling\n        - pip\n        - python ${{ python_min }}.*\n        - uv-dynamic-versioning >=0.8.0\n      run:\n        - ${{ pin_subpackage(\"httpcore2\", exact=True) }}\n        - anyio\n        - idna >=3.18\n        - python >=${{ python_min }}\n        - truststore >=0.10\n        - typing_extensions >=4.5.0\n      run_constraints:\n        - backports.zstd >=1.0.0\n        - click >=8.4\n        - pygments 2.*\n        - rich >=10,<16\n        - h2 >=3,<5\n        - socksio 1.*\n        - wsproto >=1.2\n    tests:\n      - python:\n          imports: httpx2\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - ${{ python_check_max }}.*\n      - requirements:\n          run:\n            - click >=8.4\n            - python ${{ python_min }}.*\n            - pygments 2.*\n            - rich >=10,<16\n        script:\n          env:\n            PYTHONIOENCODING: utf-8\n            PYTHONUTF8: \"1\"\n          content:\n            - httpx2 --help\n\nabout:\n  homepage: https://pypi.org/project/httpx2\n  summary: The next generation HTTP client.\n  license: BSD-3-Clause\n  repository: https://github.com/pydantic/httpx2\n  license_file: httpx2/LICENSE.md\n\nextra:\n  feedstock-name: httpx2\n  recipe-maintainers:\n    - bollwyvl\n    - Kludex\n",
