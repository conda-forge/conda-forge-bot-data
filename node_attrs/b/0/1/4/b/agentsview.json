  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-parsers/main/schema.json\n\ncontext:\n  version: \"0.30.1\"\n\npackage:\n  name: agentsview\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/kenn-io/agentsview/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 773df9382ea36eb66fc00d7a3bc0e47d2960e1673793132afb170c5dabaa9fde\n  target_directory: src\n\nbuild:\n  # There are some spurious failures with pnpm on Windows; skip for now.\n  skip: win\n  number: 0\n  script:\n    - cd src\n    - cd frontend && pnpm install && pnpm run build && cd ..\n    - rm -rf internal/web/dist\n    - cp -r frontend/dist internal/web/dist\n    - cd frontend && pnpm-licenses generate-disclaimer --prod --output-file ../frontend_licenses.txt && cd ..\n    - go-licenses save go.kenn.io/agentsview/cmd/agentsview --save_path ../library_licenses\n    - if: unix\n      then: |\n        go build -tags fts5 -v -ldflags=\"-s -w -X main.version=${{ version }}\" -o $PREFIX/bin/agentsview ./cmd/agentsview\n      else: |\n        go build -tags fts5 -v -ldflags=\"-s -w -X main.version=${{ version }}\" -o %LIBRARY_BIN%\\agentsview.exe ./cmd/agentsview\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"go-cgo\") }}\n    - go-licenses\n    - nodejs >=20.19,<25\n    - pnpm\n    - pnpm-licenses\n\ntests:\n  - script: agentsview --help\n  - package_contents:\n      bin:\n        - agentsview\n      strict: true\n\nabout:\n  homepage: https://github.com/kenn-io/agentsview\n  summary: Local-first session intelligence and analytics for coding agents\n  description: |\n    Local-first session intelligence and analytics for coding agents,\n    supporting Claude Code, Codex, and more than 20 other agents.\n    Also: 100x faster replacement for ccusage!\n  license: MIT\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n    - src/frontend_licenses.txt\n  repository: https://github.com/kenn-io/agentsview\n\nextra:\n  recipe-maintainers:\n    - xhochy\n",
