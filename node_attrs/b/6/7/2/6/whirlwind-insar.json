  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.6.0\"\n  python_min: \"3.11\"\n\npackage:\n  name: whirlwind-insar\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/w/whirlwind-insar/whirlwind_insar-${{ version }}.tar.gz\n  sha256: 934eb0adf7681e50fe51bc30d4c3496d27af8e0a4a92d263857fd5a100c5e3d2\n\nbuild:\n  number: 0\n  script:\n    - ${{ PYTHON }} -m pip install . --no-deps --no-build-isolation --disable-pip-version-check\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n  python:\n    # Single abi3 build (PyO3 abi3-py311): build once against python_min and run\n    # on any later CPython, instead of one build per python minor version.\n    version_independent: true\n    entry_points:\n      - whirlwind = whirlwind._climain:main\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - maturin >=1,<2\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - ${{ stdlib(\"c\") }}\n    - cargo-bundle-licenses\n  host:\n    - python ${{ python_min }}.*\n    - python-abi3 ${{ python_min }}.*\n    - pip\n    - maturin >=1,<2\n  run:\n    - python >=${{ python_min }}\n    - numpy >=1.21\n\ntests:\n  - python:\n      imports:\n        - whirlwind\n      pip_check: true\n  - script:\n      - whirlwind --help\n\nabout:\n  summary: Fast Rust-backed 2D phase unwrapper for InSAR\n  license: BSD-3-Clause OR Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/scottstanie/whirlwind-insar\n  repository: https://github.com/scottstanie/whirlwind-insar\n  documentation: https://github.com/scottstanie/whirlwind-insar/tree/main/docs\n\nextra:\n  recipe-maintainers:\n    - scottstanie\n",
