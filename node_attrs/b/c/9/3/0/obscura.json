  "raw_meta_yaml": "context:\n  version: \"0.2.0\"\n\npackage:\n  name: obscura\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/h4ckf0r0day/obscura/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 9eac1a0e40be1cb55ff522a412fa91104f52ebe45431225cd3b532a7d651e3b3\n\nbuild:\n  number: 0\n  skip: win\n  script:\n    content:\n      - export LIBCLANG_PATH=${BUILD_PREFIX}/lib\n      - export BINDGEN_EXTRA_CLANG_ARGS=\"--sysroot=${CONDA_BUILD_SYSROOT} -isystem $(${CC} -print-file-name=include)\"\n      - if: osx\n        then:\n          - export CFLAGS=\"${CFLAGS} -mlinker-version=100\"\n          - export CXXFLAGS=\"${CXXFLAGS} -mlinker-version=100\"\n      - cargo auditable install --locked --path crates/obscura-cli --features stealth --root ${{ PREFIX }} --no-track\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - ${{ stdlib('c') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - cmake\n    - libclang\n    - make\n    - perl\n\ntests:\n  - script:\n      - obscura --help\n  - package_contents:\n      bin:\n        - obscura\n        - obscura-worker\n      strict: true\n\nabout:\n  homepage: https://github.com/h4ckf0r0day/obscura\n  summary: The headless browser for AI agents and web scraping\n  description: |\n    Obscura is a headless browser engine written in Rust for web scraping\n    and AI agent automation. It runs JavaScript via V8, supports the Chrome\n    DevTools Protocol, and provides a command line interface for serving and\n    fetching pages.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/h4ckf0r0day/obscura\n\nextra:\n  recipe-maintainers:\n    - moritzwilksch\n",
