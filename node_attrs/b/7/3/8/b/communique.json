  "raw_meta_yaml": "context:\n  version: \"1.2.0\"\n\npackage:\n  name: communique\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/jdx/communique/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: ff1889ffa83fda89b33d6e448b3c24f34a4d352ad04bd0e63399bc747a6195f4\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n\ntests:\n  - script:\n      - communique --help\n      - communique --version\n  - package_contents:\n      bin:\n        - communique\n      strict: true\n\nabout:\n  summary: Editorialized release notes powered by AI\n  description: |\n    communiqué turns your Git history, pull requests, and repository context into\n    polished release notes optimized for human consumption. It can print notes locally,\n    update `CHANGELOG.md`, or publish directly to GitHub releases.\n  license: MIT\n  license_file:\n    - THIRDPARTY.yml\n  homepage: https://communique.jdx.dev\n  repository: https://github.com/jdx/communique\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
