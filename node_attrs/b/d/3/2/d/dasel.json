  "raw_meta_yaml": "context:\n  version: \"3.11.2\"\n\npackage:\n  name: dasel\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/TomWright/dasel/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 5471fe33b28c98efed2b1a13431ed24097785f56a24dc9fb15e37b1e266446e1\n  # the following dependencies miss standard license file layout, so we have to manually add their license files\n  - url: https://raw.githubusercontent.com/mattn/go-localereader/master/LICENSE\n    sha256: dceede03550621e65ec7b79fcba87cf6dbb9d31132a8ae71a8fe8ceec0af7da3\n    target_directory: library_licenses_2/github.com/mattn/go-localereader\n\nbuild:\n  number: 1\n  script:\n    - go-licenses save ./cmd/dasel --save_path=library_licenses --ignore=github.com/mattn/go-localereader\n    - if: unix\n      then:\n        - go build -v -trimpath -ldflags \"-s -w -X github.com/tomwright/dasel/v3/internal.Version=v${{ version }}\" -o=\"$PREFIX\"/bin/dasel ./cmd/dasel\n        # generate manpage and shell completions\n        - if: build_platform == host_platform\n          then:\n            - mkdir -p \"$PREFIX\"/share/man/man1 \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n            - '\"$PREFIX\"/bin/dasel man             > \"$PREFIX\"/share/man/man1/dasel.1'\n            - '\"$PREFIX\"/bin/dasel completion bash > \"$PREFIX\"/share/bash-completion/completions/dasel'\n            - '\"$PREFIX\"/bin/dasel completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/dasel.fish'\n            - '\"$PREFIX\"/bin/dasel completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_dasel'\n        # merge library license files\n        - cp -a library_licenses_2/. library_licenses/ && rm -rf library_licenses_2\n    - if: win\n      then:\n        - go build -v -trimpath -ldflags=\"-s -w -X github.com/tomwright/dasel/v3/internal.Version=v${{ version }}\" -o=\"%LIBRARY_BIN%\"\\dasel.exe ./cmd/dasel\n        # generate manpage and shell completions\n        - if: build_platform == host_platform\n          then:\n            - mkdir \"%LIBRARY_PREFIX%\"\\share\\man\\man1\n            - mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n            - mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n            - mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n            - '\"%LIBRARY_BIN%\"\\dasel.exe man             > \"%LIBRARY_PREFIX%\"\\share\\man\\man1\\dasel.1'\n            - '\"%LIBRARY_BIN%\"\\dasel.exe completion bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\dasel'\n            - '\"%LIBRARY_BIN%\"\\dasel.exe completion fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\dasel.fish'\n            - '\"%LIBRARY_BIN%\"\\dasel.exe completion zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_dasel'\n        # merge library license files\n        - xcopy \"library_licenses_2\\*\" \"library_licenses\\\" /E /I /Y & if errorlevel 1 exit /b %ERRORLEVEL% & rmdir /S /Q \"library_licenses_2\"\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script:\n      - dasel --help\n      - dasel version\n      - if: not win\n        then: dasel version | grep ${{ version }}\n  - package_contents:\n      bin:\n        - dasel\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/man/man1/dasel.1\n            - share/bash-completion/completions/dasel\n            - share/fish/vendor_completions.d/dasel.fish\n            - share/zsh/site-functions/_dasel\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/man/man1/dasel.1\n            - Library/share/bash-completion/completions/dasel\n            - Library/share/fish/vendor_completions.d/dasel.fish\n            - Library/share/zsh/site-functions/_dasel\n      strict: true\n\nabout:\n  license: MIT\n  license_file:\n    - LICENSE\n    - library_licenses/\n  summary: |\n    Dasel (short for data-selector) allows you to query and modify data structures\n    using selector strings.\n  description: |\n    Select, put and delete data from JSON, TOML, YAML, XML and CSV files with a single\n    tool. Supports conversion between formats and can be used as a Go package.\n  homepage: https://daseldocs.tomwright.me\n  repository: https://github.com/TomWright/dasel\n\nextra:\n  recipe-maintainers:\n    - salim-b\n    - tomwright\n    - maresb\n",
