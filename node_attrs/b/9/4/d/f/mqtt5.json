  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.7.0\"\n  python_min: \"3.11\"\n\n  m2: ${{ \"\" if unix else \"m2-\" }}\n  so: ${{ \"abi3.so\" if unix else \"pyd\" }}\n\npackage:\n  name: mqtt5\n  version: ${{ version }}\n  \nsource:\n  url: https://pypi.org/packages/source/m/mqtt5/mqtt5-${{ version }}.tar.gz\n  sha256: b210ce32ce98731b42589a0ae655a10511fb61052a4b9e0afbfc70937b9cbd16\n\nbuild:\n  number: 1\n  skip: is_abi3 and not is_python_min\n  script: build.sh\n  python:\n    version_independent: true\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - ${{ stdlib('c') }}\n    - ${{ m2 }}bash >=5.2\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - if: build_platform != target_platform\n      then:\n        - cross-python_${{ target_platform }}\n        - maturin >=1.13.1\n        - python ${{ python_min }}.*\n  host:\n    - maturin <2.0\n    - python ${{ python_min }}.*\n    - if: is_abi3\n      then:\n        - python-abi3\n    - pip\n  run:\n    - python\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - site-packages/mqtt5/__init__.py\n        - site-packages/mqtt5/mqtt5.${{ so }}\n        - site-packages/mqtt5/mqtt5.pyi\n        - site-packages/mqtt5/py.typed\n        - site-packages/mqtt5-${{ version }}.dist-info/*\n  - if: is_abi3\n    then:\n      script:\n        - if: unix\n          then:\n            - export SP_DIR=$(python -c \"import site; print(site.getsitepackages()[0])\")\n            - abi3audit $SP_DIR/mqtt5/mqtt5.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else:\n            - abi3audit %PREFIX%/Lib/site-packages/mqtt5/mqtt5.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n      requirements:\n        run:\n          - abi3audit\n  - python:\n      imports:\n        - mqtt5\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  homepage: https://github.com/empicano/mqtt5\n  summary: 'The MQTTv5 protocol for Python written in Rust'\n  description: |\n    A sans-I/O implementation of the MQTTv5 protocol for Python,\n    written in Rust. Serialization is ~5x faster and deserialization\n    ~20x faster than comparable Python code\n  license: BSD-3-Clause\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/empicano/mqtt5\n\nextra:\n  recipe-maintainers:\n    - MementoRC\n",
