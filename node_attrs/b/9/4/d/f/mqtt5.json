        "MementoRC"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "mqtt5",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "rust_compiler_stub",
            "c_stdlib_stub",
            "bash >=5.2",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [
            "maturin <2.0",
            "python 3.11.*",
            "python-abi3",
            "pip"
          ],
          "run": [
            "python"
          ]
        },
        "tests": [
          {
            "package_contents": {
              "files": [
                "site-packages/mqtt5/__init__.py",
                "site-packages/mqtt5/mqtt5.abi3.so",
                "site-packages/mqtt5/mqtt5.pyi",
                "site-packages/mqtt5/py.typed",
                "site-packages/mqtt5-0.7.0.dist-info/*"
              ],
              "strict": true
            }
          },
          {
            "requirements": {
              "run": [
                "abi3audit"
              ]
            },
            "script": [
              "export SP_DIR=$(python -c \"import site; print(site.getsitepackages()[0])\")",
              "abi3audit $SP_DIR/mqtt5/mqtt5.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}"
            ]
          },
          {
            "python": {
              "imports": [
                "mqtt5"
              ],
              "python_version": [
                "3.11.*",
                "*"
              ]
            }
          }
        ],
        "version": "0.7.0"
      }
