  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.8\"\n  base_build_number: 1\n  bootstrapping: ${{ env.get(\"CONDA_BUILD_BOOTSTRAPPING\", default=\"\") }}\n  build_number: ${{ base_build_number if bootstrapping == \"yes\" else base_build_number + 1002 }}\n\npackage:\n  name: patch\n  version: ${{ version }}\n\nsource:\n  url:\n    - https://ftpmirror.gnu.org/gnu/patch/patch-${{ version }}.tar.gz\n    - https://ftp.gnu.org/gnu/patch/patch-${{ version }}.tar.gz\n  sha256: 308a4983ff324521b9b21310bfc2398ca861798f02307c79eb99bb0e0d2bf980\n\nbuild:\n  number: ${{ build_number }}\n  string: h${{ hash }}_${{ build_number }}${{ \"_bootstrapping\" if bootstrapping == \"yes\" }}\n  skip: win\n  script:\n    file: build\n    env:\n      CONDA_BUILD_BOOTSTRAPPING: ${{ bootstrapping }}\n\nrequirements:\n  build:\n    - if: bootstrapping != \"yes\"\n      then: libtool\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - make\n\ntests:\n  - script:\n      - patch --help\n  - if: bootstrapping != \"yes\"\n    then:\n      files:\n        recipe:\n          - testfile\n          - testfile2\n          - testfile.patch\n      script:\n        - patch -i testfile.patch\n        - cmp testfile testfile2\n\nabout:\n  homepage: http://savannah.gnu.org/projects/patch/\n  license: GPL-3.0-or-later\n  license_file: COPYING\n  summary: Utility to apply diffs to files\n  description: |\n    Patch takes a patch file containing a difference listing produced by the\n    diff program and applies those differences to one or more original files,\n    producing patched versions.\n  repository: http://git.savannah.gnu.org/cgit/patch.git\n\nextra:\n  recipe-maintainers:\n    - nehaljwani\n    - mgorny\n",
