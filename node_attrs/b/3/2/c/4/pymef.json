  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: pymef\n  version: \"1.4.8\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  # Upstream publishes an sdist only sporadically (5 of the last 8 releases were\n  # wheels-only). If a future version has no sdist, fall back to the GitHub tag\n  # plus the meflib submodule -- see git history of this recipe.\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name }}-${{ version }}.tar.gz\n  sha256: 242074b714a0762cd1cc6ec2447c662f7a46dbddbfe49f2af0abff93ff08bb96\n\nbuild:\n  number: 1\n  script:\n    # The vendored meflib C is compiled straight into the extension and contains\n    # ~100 type-punning pointer casts; upstream also hardcodes -O3.\n    #\n    # pymef3_file.h declares its create_*_dtype helpers with an empty parameter\n    # list and registers them as METH_VARARGS. GCC >=14 rejects that outright,\n    # so keep it a warning until upstream fixes the prototypes.\n    - if: unix\n      then: export CFLAGS=\"${CFLAGS} -fno-strict-aliasing -Wno-error=incompatible-pointer-types\"\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n  host:\n    - python\n    - pip\n    - setuptools\n    - numpy\n  run:\n    - python\n    - numpy >=2.0\n\ntests:\n  - python:\n      imports:\n        - pymef\n        - pymef.mef_file.pymef3_file\n      pip_check: true\n  - script:\n      - python -m unittest discover -s tests -v\n    files:\n      source:\n        - tests/\n\nabout:\n  summary: Python wrapper for Multiscale Electrophysiology Format (MEF)\n  description: |\n    Pymef is a wrapper library for Multiscale Electrophysiology Format (MEF)\n    version 3.0, developed by the Mayo Systems Electrophysiology Laboratory.\n    MEF is a medical data file format designed for storing neurophysiological\n    electrographic data, such as intracranial EEG.\n  license: Apache-2.0\n  license_file:\n    - LICENSE.txt\n    # meflib and its bundled AES/SHA-256/UTF-8 code are compiled into the\n    # extension, but the sdist ships no license for them (MANIFEST.in includes\n    # only meflib/meflib/*.c and *.h), so the notices are carried here.\n    - vendored_licenses/meflib.txt\n    - vendored_licenses/meflib_third_party.txt\n  homepage: https://github.com/msel-source/pymef\n  repository: https://github.com/msel-source/pymef\n  documentation: https://pymef.readthedocs.io/\n\nextra:\n  recipe-maintainers:\n    - bruAristimunha\n    - larsoner\n",
