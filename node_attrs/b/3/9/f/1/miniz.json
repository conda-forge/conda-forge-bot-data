  "linux_64_meta_yaml": {
    "about": {
      "description": "miniz is a lossless, high performance data compression library in a single\nsource file that implements the zlib (RFC 1950) and Deflate (RFC 1951)\ncompressed data format specification standards. It supports the most\ncommonly used functions exported by the zlib library, but is a completely\nindependent implementation so zlib's licensing requirements do not apply.\nminiz also contains simple to use functions for writing PNG format image\nfiles and reading/writing/appending ZIP format archives.",
      "dev_url": "https://github.com/richgel999/miniz",
      "doc_url": "https://github.com/richgel999/miniz/blob/master/readme.md",
      "home": "https://github.com/richgel999/miniz",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Single source file zlib/Deflate compression and ZIP archive library"
    },
    "build": {
      "number": "0",
      "run_exports": {
        "weak": [
          "miniz"
        ]
      },
      "script": [
        "cmake -G Ninja -B build -S . ${CMAKE_ARGS} -DBUILD_SHARED_LIBS=ON -DBUILD_EXAMPLES=OFF -DBUILD_TESTS=OFF -DBUILD_FUZZERS=OFF -DINSTALL_PROJECT=ON",
        "cmake --build build -j ${CPU_COUNT}",
        "cmake --install build"
      ]
    },
    "extra": {
