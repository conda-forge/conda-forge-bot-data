    "about": {
      "description": "lazyrsync is a front-end for the system rsync rather than a\nreimplementation of it. It provides reusable profiles and tasks, a dry-run\npreview of what would change, a live progress bar, and snapshot support,\nplus a headless mode for scheduled runs over cron.",
      "dev_url": "https://github.com/westpoint-io/lazyrsync",
      "doc_url": "https://lazyrsync.westpoint.io/docs/install",
      "home": "https://lazyrsync.westpoint.io/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "A terminal UI for rsync — profiles, honest dry-run preview, live progress"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "lazyrsync",
        "requirements": {
          "build": [
