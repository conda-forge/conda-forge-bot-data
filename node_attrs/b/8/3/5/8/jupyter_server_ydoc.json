  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"3.0.0\"\n  python_check_max: \"3.14\"\n  # mismatch-sensitve upstream deps\n  jupyter_ydoc_min: \"4.1.1\"\n  jupyter_server_min: \"2.19.0\"\n  pycrdt_websocket_min: \"0.16.4\"\n  # testing\n  grep: ${{ \"grep -iE\" if unix else \"findstr /c\" }}\n  cov_fail_under: \"74\"\n  pytest_k: |-\n    -k \"not room_handler_doc_client_should_emit_awareness_event\"\n\npackage:\n  name: jupyter_server_ydoc\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/j/jupyter-server-ydoc/jupyter_server_ydoc-${{ version }}.tar.gz\n  sha256: f252498e76a90bee9c0b6b8499dd75885c9646e0a928c7e61f01f456c1f85c04\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n\nrequirements:\n  host:\n    - hatchling >=1.4.0\n    - pip\n    - python ${{ python_min }}.*\n  run:\n    - jsonschema >=4.18.0\n    - jupyter_events >=0.11.0\n    - jupyter_server >=${{ jupyter_server_min }},<3.0.0\n    - jupyter_server_fileid >=0.7.0,<1\n    - jupyter_ydoc >=${{ jupyter_ydoc_min }},<5.0.0\n    - pycrdt\n    - pycrdt-websocket >=${{ pycrdt_websocket_min }},<0.17.0\n    - python >=${{ python_min }}\n\ntests:\n  - python:\n      imports: jupyter_server_ydoc\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - ${{ python_check_max }}.*\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n        - jupyter_server ${{ jupyter_server_min }}.*\n        - jupyter_ydoc ${{ jupyter_ydoc_min }}.*\n        - pycrdt-websocket ${{ pycrdt_websocket_min }}.*\n    script:\n      - pip check\n  - files:\n      source:\n        - tests/\n    requirements:\n      run:\n        - dirty-equals\n        - httpx-ws >=0.5.2\n        - pytest-cov\n        - python ${{ python_min }}.*\n        - pytest-jupyter\n        - pip\n    script:\n      env:\n        JUPYTER_PLATFORM_DIRS: \"1\"\n      content:\n        - pip check\n        - jupyter server extension list\n        - jupyter server extension list 2>&1 | ${{ grep }} \"jupyter_server_ydoc.*${{ version | replace(\".\", \"\\\\.\") }}.*OK\"\n        - coverage run --source=jupyter_server_ydoc --branch -m pytest -vv --tb=long --color=yes ${{ pytest_k }}\n        - coverage report --show-missing --skip-covered --fail-under=${{ cov_fail_under }}\n\nabout:\n  license: BSD-3-Clause\n  license_file: LICENSE\n  summary: jupyter-server extension integrating collaborative shared models.\n  homepage: https://pypi.org/project/jupyter-server-ydoc\n  repository: https://github.com/jupyterlab/jupyter_collaboration\n\nextra:\n  recipe-maintainers:\n    - davidbrochart\n    - conda-forge/jupyter_server\n",
