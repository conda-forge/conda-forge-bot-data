  "raw_meta_yaml": "context:\n  version: \"0.1.23\"\n\npackage:\n  name: idt\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/sh-cho/idt/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 79404c0aef153f350d2c2982641f42bc881fc597e58f92024382ee9f8c528cc4\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n          # generate shell completions and manpage\n          - if: build_platform == host_platform\n            then:\n              - mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions \"$PREFIX\"/share/man/man1\n              - '\"$PREFIX\"/bin/idt completions bash > \"$PREFIX\"/share/bash-completion/completions/idt'\n              - '\"$PREFIX\"/bin/idt completions fish > \"$PREFIX\"/share/fish/vendor_completions.d/idt.fish'\n              - '\"$PREFIX\"/bin/idt completions zsh  > \"$PREFIX\"/share/zsh/site-functions/_idt'\n              - '\"$PREFIX\"/bin/idt manpage            \"$PREFIX\"/share/man/man1'\n        else:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n          # generate shell completions and manpage\n          - if: build_platform == host_platform\n            then:\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\man\\man1\n              - '\"%LIBRARY_BIN%\"\\idt.exe completions bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\idt'\n              - '\"%LIBRARY_BIN%\"\\idt.exe completions fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\idt.fish'\n              - '\"%LIBRARY_BIN%\"\\idt.exe completions zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_idt'\n              - '\"%LIBRARY_BIN%\"\\idt.exe manpage            \"%LIBRARY_PREFIX%\"\\share\\man\\man1'\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n\ntests:\n  - script:\n      - idt --help\n      - idt --version\n  - package_contents:\n      bin:\n        - idt\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/idt\n            - share/fish/vendor_completions.d/idt.fish\n            - share/zsh/site-functions/_idt\n            - share/man/man1/idt*.1\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/idt\n            - Library/share/fish/vendor_completions.d/idt.fish\n            - Library/share/zsh/site-functions/_idt\n            - Library/share/man/man1/idt*.1\n      strict: true\n\nabout:\n  summary: A fast, ergonomic CLI tool for working with various ID formats\n  description: |\n    idt (ID Tool) is a fast, ergonomic CLI tool for working with various\n    identifier formats. Whether you need to generate, inspect, convert, or\n    validate IDs, idt provides a unified interface for all your identifier needs\n    including support for UUID (all versions), ULID, NanoID, Snowflake, assigned\n    IDs (EAN, ISBN, ISIN), and more.\n  license: MIT OR Apache-2.0\n  license_file:\n    - LICENSE-APACHE\n    - LICENSE-MIT\n    - THIRDPARTY.yml\n  homepage: https://sh-cho.github.io/idt\n  repository: https://github.com/sh-cho/idt\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
