  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: resolvo-cpp\n  version: 0.4.0\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/prefix-dev/resolvo/archive/refs/tags/resolvo_cpp-v${{ version }}.zip\n  sha256: 897efde3dd3be52cb0bc3c90a271b8bcfd9f1b9ff6b51477b7bbe1735c781680\n\nbuild:\n  number: 0\n  script:\n    interpreter: brush\n    content: |\n      set -ex\n      cmake ${CMAKE_ARGS} -GNinja \"$SRC_DIR\" \\\n        ${CARGO_BUILD_TARGET:+-DRust_CARGO_TARGET=$CARGO_BUILD_TARGET}\n      cmake --build . --target install\n      cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - cmake\n    - ninja\n    - cargo-bundle-licenses\n    - corrosion\n    - brush\n  run_exports:\n    - ${{ pin_subpackage('resolvo-cpp', upper_bound='x.x') }}\n\ntests:\n  - package_contents:\n      include:\n        - resolvo/resolvo.h\n        - resolvo/resolvo_internal.h\n      lib:\n        # On Windows the import library keeps its natural name\n        # (resolvo_cpp.dll.lib), so name the DLL and import lib explicitly.\n        - if: win\n          then:\n            - resolvo_cpp.dll\n            - resolvo_cpp.dll.lib\n          else:\n            - resolvo_cpp\n      files:\n        - if: win\n          then:\n            - Library/lib/cmake/Resolvo/ResolvoTargets.cmake\n            - Library/lib/cmake/Resolvo/ResolvoConfigVersion.cmake\n            - Library/lib/cmake/Resolvo/ResolvoConfig.cmake\n          else:\n            - lib/cmake/Resolvo/ResolvoTargets.cmake\n            - lib/cmake/Resolvo/ResolvoConfigVersion.cmake\n            - lib/cmake/Resolvo/ResolvoConfig.cmake\n  # Build and run the bundled sudoku example against the installed package to\n  # verify that the headers, shared library and CMake config work together.\n  - script:\n      interpreter: brush\n      content: |\n        set -ex\n        cmake -G Ninja -S cpp/examples/sudoku -B build-sudoku ${CMAKE_ARGS}\n        cmake --build build-sudoku\n        ./build-sudoku/sudoku\n    files:\n      source:\n        - cpp/examples/sudoku\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - ninja\n        - brush\n\nabout:\n  license: BSD-3-Clause\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: C++ bindings for resolvo, a universal package resolver.\n  homepage: https://github.com/prefix-dev/resolvo\n  repository: https://github.com/prefix-dev/resolvo\n\nextra:\n  feedstock-name: resolvo-cpp\n  recipe-maintainers:\n    - baszalmstra\n    - jjerphan\n",
