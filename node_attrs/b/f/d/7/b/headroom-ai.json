    "about": {
      "description": "Headroom compresses tool outputs, logs, files, and RAG chunks before\nthey reach the LLM — 60-95% fewer tokens, same answers. It ships as a\nPython library (SmartCrusher, ContentRouter, CodeCompressor, CCR,\nTOIN compressors with a Rust core), a transparent proxy, and an MCP\nserver.\n\nThis package provides the core library and CLI. Upstream optional\nextras (proxy server, MCP, tree-sitter code compression, ML/Kompress,\nmemory/vector stacks, OCR, LangChain/Agno integrations) are not\nincluded; install their dependencies separately as needed.",
      "dev_url": "https://github.com/headroomlabs-ai/headroom",
      "doc_url": "https://headroom-docs.vercel.app/docs",
      "home": "https://headroom-docs.vercel.app/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "The Context Optimization Layer for LLM Applications - Cut costs by 50-90%"
    },
    "build": {
      "number": "1",
      "script": [
        "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml",
        "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "soapy1",
        "rxm7706"
      ]
    },
