  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.32.1\"\n\npackage:\n  name: headroom-ai\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/h/headroom-ai/headroom_ai-${{ version }}.tar.gz\n  sha256: 329dda3328f0fb45ec7128353f7fc9108f08e9676c9dc1873b4841c5c00c94bd\n\nbuild:\n  number: 1\n  skip:\n    # litellm pulls the compiled fastuuid, which ships py311+ on macOS while\n    # linux gets py310 too. \n    - osx and match(python, \"<3.11\")\n  script:\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - headroom = headroom.cli:main\n\nrequirements:\n  build:\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"cxx\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - maturin >=1.5,<2.0\n    - pip\n  run:\n    - python\n    - tiktoken >=0.5.0\n    - pydantic >=2.0.0\n    - if: match(python, \"<3.14\")\n      then:\n        - litellm >=1.86.2,<2.0\n    - click >=8.3.3\n    - rich >=13.0.0\n    - opentelemetry-api >=1.24.0\n    - ast-grep >=0.30.0\n    - pyyaml >=6.0\n    - tomlkit >=0.13.0,<1.0\n    - fastapi\n    - if: match(python, \"<3.11\")\n      then:\n        - tomli >=2.0.0\n\ntests:\n  - python:\n      imports:\n        - headroom\n        - headroom._core\n      # ast-grep-cli is satisfied by the conda ast-grep binary package,\n      # which leaves no ast-grep-cli dist-info -> pip check cannot pass.\n      pip_check: false\n  - script:\n      - headroom --help\n\nabout:\n  summary: The Context Optimization Layer for LLM Applications - Cut costs by 50-90%\n  description: |\n    Headroom compresses tool outputs, logs, files, and RAG chunks before\n    they reach the LLM — 60-95% fewer tokens, same answers. It ships as a\n    Python library (SmartCrusher, ContentRouter, CodeCompressor, CCR,\n    TOIN compressors with a Rust core), a transparent proxy, and an MCP\n    server.\n\n    This package provides the core library and CLI. Upstream optional\n    extras (proxy server, MCP, tree-sitter code compression, ML/Kompress,\n    memory/vector stacks, OCR, LangChain/Agno integrations) are not\n    included; install their dependencies separately as needed.\n  homepage: https://headroom-docs.vercel.app\n  repository: https://github.com/headroomlabs-ai/headroom\n  documentation: https://headroom-docs.vercel.app/docs\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - NOTICE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - soapy1\n    - rxm7706\n",
