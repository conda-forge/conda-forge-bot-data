      "description": "data-wrangler turns messy data (arrays, text, DataFrames, files, URLs,\nnull/empty values, and nested lists of these) into clean DataFrame\nobjects, with a special emphasis on text and natural language processing\nembeddings. Every operation supports two backends: pandas (default) and\nPolars. The package is published on PyPI as pydata-wrangler and imported\nas datawrangler (or dw).",
      "dev_url": "https://github.com/ContextLab/data-wrangler",
      "doc_url": "https://data-wrangler.readthedocs.io/",
      "home": "https://github.com/ContextLab/data-wrangler",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Wrangle messy data into DataFrames (pandas or Polars), with a special focus on text data and natural language processing"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
