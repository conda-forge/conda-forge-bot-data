  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"26.4.0\"\n\npackage:\n  name: twisted\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/T/Twisted/twisted-${{ version }}.tar.gz\n  sha256: dbfd0fe1ee409d0243fdd7a6a6ff14f4948cec1fd78e0376291f805e1501fae9\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    - ${{ PYTHON }} -m pip install . --no-deps -vv\n  python:\n    entry_points:\n      - ckeygen = twisted.conch.scripts.ckeygen:run\n      - cftp = twisted.conch.scripts.cftp:run\n      - conch = twisted.conch.scripts.conch:run\n      - mailmail = twisted.mail.scripts.mailmail:run\n      - pyhtmlizer = twisted.scripts.htmlizer:run\n      - tkconch = twisted.conch.scripts.tkconch:run\n      - trial = twisted.scripts.trial:run\n      - twist = twisted.application.twist._twist:Twist.main\n      - twistd = twisted.scripts.twistd:run\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - cython\n    - hatchling\n    - hatch-fancy-pypi-readme\n    - incremental >=21.3.0\n  run:\n    - python >=${{ python_min }}\n    - attrs >=22.2.0\n    - automat >=24.8.0\n    - constantly >=15.1\n    - hyperlink >=17.1.1\n    - incremental >=24.7.0\n    - if: win\n      then: twisted-iocpsupport >=1.0.2\n    - typing-extensions >=4.2.0\n    - zope.interface >=5\n    - if: win\n      then: pywin32\n    # conch deps\n    - bcrypt >=3.1.3\n    - cryptography >=3.3\n    - appdirs >=1.4.0\n    # tls deps\n    - idna >=2.4\n    - pyopenssl >=21.0.0\n    - service_identity >=18.1.0\n    - if: linux\n      then: __linux\n    - if: win\n      then: __win\n    - if: osx\n      then: __osx\n  run_constraints:\n    - pyserial >=3.0\n    - if: osx\n      then: pyobjc-core\n    - if: osx\n      then: pyobjc-framework-cocoa\n    - h2 >=3.0,<5.0\n    - priority >=1.1.0,<2.0\n\ntests:\n  - python:\n      imports:\n        - twisted\n        - twisted._threads\n        - twisted.application\n        - twisted.application.runner\n        - twisted.application.twist\n        - twisted.conch\n        - twisted.conch.client\n        - twisted.conch.insults\n        - twisted.conch.openssh_compat\n        - twisted.conch.scripts\n        - twisted.conch.ssh\n        - twisted.conch.ui\n        - twisted.cred\n        - twisted.enterprise\n        - twisted.internet\n        - if: win\n          then: twisted.internet.iocpreactor\n        - twisted.logger\n        - twisted.mail\n        - twisted.mail.scripts\n        - twisted.names\n        - twisted.pair\n        - twisted.persisted\n        - twisted.plugins\n        - twisted.positioning\n        - twisted.protocols\n        - twisted.protocols.haproxy\n        - twisted.python\n        - twisted.runner\n        - twisted.scripts\n        - twisted.spread\n        - twisted.tap\n        - twisted.trial\n        - twisted.trial._dist\n        - twisted.web\n        - twisted.web._auth\n        - twisted.words\n        - twisted.words.im\n        - twisted.words.protocols\n        - twisted.words.protocols.jabber\n        - twisted.words.xish\n      pip_check: false\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pyhamcrest >=1.9.0\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - ckeygen --help\n      - if: not win\n        then: cftp --help\n      - if: not win\n        then: conch --help\n      - pyhtmlizer --help\n      - if: win\n        then: tkconch --help\n      - trial --help\n      - twist --help\n      - twistd --help\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: An asynchronous networking framework written in Python\n  description: |\n    Twisted is an event-driven networking engine written in Python.\n    It runs on Python 2 and an ever growing subset also works with Python 3.\n  homepage: http://twistedmatrix.com/\n  repository: https://github.com/twisted/twisted\n  documentation: http://twistedmatrix.com/documents/current/\n\nextra:\n  recipe-maintainers:\n    - akrherz\n    - nehaljwani\n    - ocefpaf\n",
