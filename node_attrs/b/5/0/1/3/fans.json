  "raw_meta_yaml": "context:\n  version: \"0.8.1\"\n  # abi3 floor; must match requires-python in pyfans/pyproject.toml\n  python_min: \"3.12\"\n\nrecipe:\n  name: fans\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/DataAnalyticsEngineering/FANS/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 6d0063ba38ddac9d9f7f18d920a509a2d4496bf9afaf1cd9fb7088ceaf11e23d\n\nbuild:\n  number: 0\n  skip:\n    - win\n\noutputs:\n  # The solver: binary, library, headers and cmake package. No Python.\n  - package:\n      name: fans\n    build:\n      script:\n        - if: unix\n          then:\n            - if: (build_platform != target_platform)\n              then:\n                # flags from https://conda-forge.org/docs/maintainer/knowledge_base/#cross-compilation and https://github.com/conda-forge/mumps-feedstock/blob/966474677d28486ef897b0d3bb2c10558dc9b5ca/recipe/build-mumps.sh\n                - export OMPI_CC=$CC\n                - export OMPI_CXX=$CXX\n                - export OMPI_FC=$FC\n                - export OPAL_PREFIX=\"$PREFIX\"\n                - export FFLAGS=\"${FFLAGS} -DAVOID_MPI_IN_PLACE\"\n                - export LDFLAGS=\"${LDFLAGS} -headerpad_max_install_names\"\n                - |\n                  # Filter out host-only CPU flags safely\n                  for var in CFLAGS CXXFLAGS DEBUG_CFLAGS DEBUG_CXXFLAGS; do\n                    val=\"${!var}\"\n                    # Remove -march=nocona and -mtune=haswell as whole tokens\n                    val=\"$(echo \"$val\" | sed -E 's/(^|[[:space:]])-march=nocona([[:space:]]|$)/ /g; s/(^|[[:space:]])-mtune=haswell([[:space:]]|$)/ /g')\"\n                    # Normalize spacing (trim and collapse multiple spaces)\n                    val=\"$(echo \"$val\" | tr -s ' ' | sed -E 's/^ //; s/ $//')\"\n                    export \"$var=$val\"\n                  done\n                  for var in CFLAGS CXXFLAGS DEBUG_CFLAGS DEBUG_CXXFLAGS; do\n                    echo \"$var cleaned: '${!var}'\"\n                  done\n            - cmake -S . -B build $CMAKE_ARGS\n            - cmake --build build -j\n            - cmake --install build\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - make\n        - ninja\n        - if: (build_platform != target_platform)\n          then:\n            - openmpi-mpicxx\n      host:\n        # Pinned to 1.14 deliberately: unpinned resolves to hdf5 2.1, and every\n        # conda-forge fenics-dolfinx pins 1.14, so pyfans could not share an\n        # environment with the Micro Manager's macro side.\n        - hdf5 >=1.14,<2 mpi_openmpi*\n        - fftw * mpi_openmpi*\n        - openmpi-mpicxx\n        - eigen\n        - nlohmann_json\n        - spdlog\n    tests:\n      - package_contents:\n          bin:\n            - FANS\n          lib:\n            - FANS\n      - script:\n          # JSON test file has relative path to h5 included - changing that\n          - JSON_FILE=\"$PREFIX/etc/conda/test-files/$PKG_NAME/0/test/input_files/test_LinearElastic.json\"\n          - MODIFIED_JSON_FILE=\"$PREFIX/etc/conda/test-files/$PKG_NAME/0/test/input_files/test_LinearElastic_mod.json\"\n          - NEW_MS_FILENAME=\"$PREFIX/etc/conda/test-files/$PKG_NAME/0/test/microstructures/sphere32.h5\"\n          # Use jq to create a modified copy of the JSON file\n          - jq --arg new_filename \"$NEW_MS_FILENAME\" '.microstructure.filepath = $new_filename' \"$JSON_FILE\" > \"$MODIFIED_JSON_FILE\"\n          # Run tests\n          - mpiexec -n 1 FANS \"$MODIFIED_JSON_FILE\" \"$PREFIX/etc/conda/test-files/$PKG_NAME/0//test/test_results.h5\"\n        requirements:\n          run:\n            - jq\n        files:\n          source:\n            - test/\n      - script:\n          - FANS --version\n\n  # The nanobind bindings, built against the `fans` package above rather than\n  # rebuilding the solver. One abi3 build serves every supported Python.\n  - package:\n      name: pyfans\n    build:\n      # One abi3 build serves every Python from python_min up, so build it once\n      # rather than once per Python in the variant matrix.\n      skip:\n        - match(python, \"!=\" + python_min)\n      python:\n        version_independent: true\n      script:\n        - if: (build_platform != target_platform)\n          then:\n            # Same MPI wrapper setup and host-flag scrubbing the fans output\n            # needs when cross compiling.\n            - export OMPI_CC=$CC\n            - export OMPI_CXX=$CXX\n            - export OPAL_PREFIX=\"$PREFIX\"\n            - |\n              for var in CFLAGS CXXFLAGS DEBUG_CFLAGS DEBUG_CXXFLAGS; do\n                val=\"${!var}\"\n                val=\"$(echo \"$val\" | sed -E 's/(^|[[:space:]])-march=nocona([[:space:]]|$)/ /g; s/(^|[[:space:]])-mtune=haswell([[:space:]]|$)/ /g')\"\n                val=\"$(echo \"$val\" | tr -s ' ' | sed -E 's/^ //; s/ $//')\"\n                export \"$var=$val\"\n              done\n        - ${{ PYTHON }} -m pip install ./pyfans -vv --no-deps --no-build-isolation\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - make\n        - ninja\n        - if: (build_platform != target_platform)\n          then:\n            - openmpi-mpicxx\n            - python\n            - cross-python_${{ target_platform }}\n      host:\n        - python\n        - pip\n        - scikit-build-core\n        - nanobind\n        - ${{ pin_subpackage('fans', exact=True) }}\n        # FANSConfig.cmake re-resolves these through find_dependency.\n        - hdf5 >=1.14,<2 mpi_openmpi*\n        - fftw * mpi_openmpi*\n        - openmpi-mpicxx\n        - eigen\n        - nlohmann_json\n        - spdlog\n      run:\n        - python\n        - ${{ pin_subpackage('fans', exact=True) }}\n    tests:\n      - python:\n          imports:\n            - PyFANS\n\nabout:\n  homepage: https://github.com/DataAnalyticsEngineering/FANS\n  summary: \"FANS: an open-source, efficient, and parallel FFT-based homogenization solver designed to solve microscale multiphysics problems.\"\n  description: |\n    Fourier-Accelerated Nodal Solver (FANS) is an FFT-based homogenization solver for microscale multiphysics problems.\n    FANS is written in C++, built using CMake, and it has MPI parallelization.\n    The `fans` package provides the FANS binary and the libFANS library; the\n    `pyfans` package provides the Python bindings used by the preCICE Micro Manager.\n  license: LGPL-3.0-only\n  license_family: LGPL\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - sanathkeshav\n    - claudiushaag\n    - EMMAOpenSource\n",
