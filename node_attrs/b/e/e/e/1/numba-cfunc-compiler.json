      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "numba-cfunc-compiler",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub"
          ],
          "host": [
            "python",
            "pip",
            "hatchling",
            "hatch-cpp",
            "python-abi3"
          ],
          "run": [
            "python",
            "numba >=0.64",
            "llvmlite >=0.46"
          ]
        },
        "tests": [
          {
            "python": {
