              "abi3audit $SP_DIR/numba_cfunc_compiler/numba_rt/_py_nrt_init.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}"
            ]
          }
        ],
        "version": "0.1.3"
      }
    ],
