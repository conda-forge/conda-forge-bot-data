  "raw_meta_yaml": "context:\n  version: \"1.0.4\"\n  build: 0\n\nrecipe:\n  name: patchworkpp\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/url-kaist/patchwork-plusplus/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 0d3e3376bffd1cc0a206a391086c79e0ab5df8f1a247c79fdb8a22bd87129ed7\n  patches:\n    - patches/python-use-system-patchworkpp.patch\n    - patches/cpp-static-to-shared.patch\n\nbuild:\n  number: ${{ build }}\n  skip: win\n\noutputs:\n  - package:\n      name: patchworkpp\n    build:\n      script:\n        - cmake -S $SRC_DIR/cpp -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$PREFIX -DUSE_SYSTEM_EIGEN3=ON -DINCLUDE_CPP_EXAMPLES=OFF\n        - cmake --build build --parallel $CPU_COUNT\n        - cmake --install build\n    requirements:\n      build:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('cxx') }}\n        - cmake\n        - ninja\n      host:\n        - eigen\n      run_exports:\n        - ${{ pin_subpackage('patchworkpp', upper_bound='x.x') }}\n    tests:\n      - script:\n          - test -f $PREFIX/include/patchwork/patchworkpp.h\n          - test -f $PREFIX/lib/libground_seg_cores$SHLIB_EXT\n          - test -f $PREFIX/lib/cmake/patchworkpp/patchworkppConfig.cmake\n\n  - package:\n      name: pypatchworkpp\n    build:\n      script:\n        - export CMAKE_ARGS=\"$CMAKE_ARGS -DUSE_SYSTEM_PATCHWORKPP=ON\"\n        - export CMAKE_GENERATOR=Ninja\n        - $PYTHON -m pip install $SRC_DIR/python --no-deps --no-build-isolation -vv\n    requirements:\n      build:\n        - ${{ stdlib('c') }}\n        - ${{ compiler('cxx') }}\n        - cmake\n        - ninja\n      host:\n        - python\n        - pip\n        - scikit-build-core\n        - pybind11\n        - eigen\n        - ${{ pin_subpackage('patchworkpp', exact=True) }}\n      run:\n        - python\n        - numpy >=1.23\n    tests:\n      - python:\n          imports:\n            - pypatchworkpp\n\nabout:\n  homepage: https://github.com/url-kaist/patchwork-plusplus\n  license: BSD-2-Clause\n  license_file: LICENSE\n  summary: Patchwork++ fast and robust ground segmentation for 3D LiDAR point clouds\n  description: Patchwork++ fast and robust ground segmentation for 3D LiDAR point clouds\n  repository: https://github.com/url-kaist/patchwork-plusplus\n\nextra:\n  feedstock-name: patchworkpp\n  recipe-maintainers:\n    - ruben-arts\n",
