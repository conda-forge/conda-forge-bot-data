  "linux_64_meta_yaml": {
    "about": {
      "description": "Habitat is a simple dashboard and monitoring tool for Absurd,\nproviding a web UI to visualize and monitor the state of running\nand executed tasks, queues, and events in an Absurd durable execution system.",
      "dev_url": "https://github.com/earendil-works/absurd",
      "doc_url": "https://github.com/earendil-works/absurd/tree/main/habitat",
      "home": "https://github.com/earendil-works/absurd/tree/main/habitat",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "src/LICENSE",
      "summary": "Dashboard and monitoring tool for Absurd durable execution system"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src/habitat/ui",
        "pnpm install",
        "pnpm build",
        "pnpm-licenses generate-disclaimer --prod --output-file=../../../third-party-licenses.txt",
        "cd ../cmd/habitat",
        "go-licenses save . --save_path ../../../../library_licenses --ignore habitat",
        "go build -v -o $PREFIX/bin/habitat -ldflags=\"-s -w\" ."
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "xhochy"
      ]
    },
