  "linux_64_meta_yaml": {
    "about": {
      "description": "SKEAF (Supercell K-space Extremal Area Finder) calculates extremal\ncross-sectional areas of Fermi surfaces and corresponding quantum\noscillation frequencies.",
      "dev_url": "https://github.com/qiaojunfeng/skeaf",
      "home": "https://github.com/qiaojunfeng/skeaf",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "COPYING.txt",
      "summary": "Supercell K-space Extremal Area Finder"
    },
    "build": {
      "number": "0",
      "script": [
        "$FC $FFLAGS -std=legacy -fopenmp -o skeaf src/skeaf_v1p3p0_r149.F90",
        "$FC $FFLAGS -std=legacy -o ELK_exciting_BXSFconverter src/ELK_exciting_BXSFconverter_v04.F90",
        "$FC $FFLAGS -std=legacy -o memoryestimateskeaf src/memoryestimateskeaf_for_v1p3p0_r149.F90",
        "$FC $FFLAGS -std=legacy -o simbxsf_barrel src/simbxsf_barrel_v02.F90",
        "$FC $FFLAGS -std=legacy -o simbxsf_cylinder src/simbxsf_cylinder_v02.F90",
        "$FC $FFLAGS -std=legacy -o simbxsf_sphere src/simbxsf_sphere_v02.F90",
        "$FC $FFLAGS -std=legacy -o simbxsf_spheroid src/simbxsf_spheroid_v03.F90",
        "mkdir -p \"${PREFIX}/bin\"",
        "install -m 755 skeaf \"${PREFIX}/bin/skeaf\"",
        "install -m 755 ELK_exciting_BXSFconverter \"${PREFIX}/bin/ELK_exciting_BXSFconverter\"",
        "install -m 755 memoryestimateskeaf \"${PREFIX}/bin/memoryestimateskeaf\"",
        "install -m 755 simbxsf_barrel \"${PREFIX}/bin/simbxsf_barrel\"",
        "install -m 755 simbxsf_cylinder \"${PREFIX}/bin/simbxsf_cylinder\"",
        "install -m 755 simbxsf_sphere \"${PREFIX}/bin/simbxsf_sphere\"",
        "install -m 755 simbxsf_spheroid \"${PREFIX}/bin/simbxsf_spheroid\""
      ]
    },
    "extra": {
