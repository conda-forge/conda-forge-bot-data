  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: gds-frameio\n  version: 3.0.1\n  # dependencies\n  gds_base_version: 3.0.0\n  gds_lsmp_version: 3.0.0\n  ldas_tools_al_version: 2.6.4\n  ldas_tools_framecpp_version: 2.5.8,<3.0.0a0\n\nrecipe:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://software.igwn.org/sources/source/${{ name }}-${{ version }}.tar.gz\n  sha256: c04ace68dc36a1823e55329ecec31bc39254f86b9a3d596ab2fa6fcd0fbcb289\n\nbuild:\n  number: 2\n  skip:\n    - win\n\noutputs:\n  - package:\n      name: gds-frameio-base\n    build:\n      dynamic_linking:\n        overdepending_behavior: error\n        overlinking_behavior: error\n      script:\n        file: build-base.sh\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - gnuconfig\n        - make\n        - pkg-config\n      host:\n        - libboost-headers\n        - gds-base >=${{ gds_base_version }}\n        - gds-base-gdstrig >=${{ gds_base_version }}\n        - gds-lsmp >=${{ gds_lsmp_version }}\n        - ldas-tools-al >=${{ ldas_tools_al_version }}\n        - ldas-tools-framecpp >=${{ ldas_tools_framecpp_version }}\n      run_exports:\n        - ${{ pin_subpackage(\"gds-frameio-base\", upper_bound=\"x\") }}\n      ignore_run_exports:\n        by_name:\n          - gds-base-gdstrig\n    tests:\n      - script: test-gds-frameio-base.sh\n    about:\n      summary: GDS package frame I/O libraries\n      description: |\n        GDS frame I/O libraries and utilities based on FrameCPP\n\nabout:\n  summary: GDS package frame I/O libraries\n  description: |\n    GDS frame I/O libraries and utilities based on FrameCPP\n  homepage: https://wiki.ligo.org/Computing/DASWG/DMT\n  repository: https://git.ligo.org/gds/gds.git\n  license: GPL-2.0-only\n  license_file: COPYING\n\nextra:\n  recipe-maintainers:\n    - duncanmmacleod\n    - emaros\n",
