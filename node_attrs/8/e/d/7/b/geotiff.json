  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: 1.7.4\n\npackage:\n  name: geotiff\n  version: ${{ version }}\n\nsource:\n  url: http://download.osgeo.org/geotiff/libgeotiff/libgeotiff-${{ version }}.tar.gz\n  sha256: c598d04fdf2ba25c4352844dafa81dde3f7fd968daa7ad131228cd91e9d3dc47\n\nbuild:\n  number: 6\n\nrequirements:\n  build:\n    - cmake\n    - if: unix\n      then: make\n    - if: unix\n      then: gnuconfig\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib(\"c\") }}\n  host:\n    - proj\n    - zlib\n    - libjpeg-turbo\n    - libtiff\n  run:\n    - proj\n    - zlib\n    - libjpeg-turbo\n    - libtiff\n  run_exports:\n    - ${{ pin_subpackage('geotiff', upper_bound='x.x') }}\n\ntests:\n  - files:\n      recipe:\n        - CMakeLists.txt\n        - test_geotiff.c\n    requirements:\n      run:\n        - if: target_platform == \"win-arm64\"\n          then:\n            - cmake\n            - ${{ compiler('c') }}\n    script:\n      - listgeo -st_test\n      - if: not win\n        then: test -f $PREFIX/lib/libgeotiff${SHLIB_EXT}\n        else:\n          - if not exist %LIBRARY_INC%\\\\geotiff.h exit 1\n          - if not exist %LIBRARY_LIB%\\\\geotiff_i.lib exit 1\n          - if not exist %LIBRARY_BIN%\\\\geotiff.dll exit 1\n          - if not exist %LIBRARY_BIN%\\\\listgeo.exe exit 1\n      - if: target_platform == \"win-arm64\"\n        then:\n          - cmake -S . -B test-build -G \"NMake Makefiles\" -DCMAKE_PREFIX_PATH=\"%LIBRARY_PREFIX%\"\n          - if errorlevel 1 exit 1\n          - cmake --build test-build\n          - if errorlevel 1 exit 1\n          - set \"PATH=%LIBRARY_BIN%;%PATH%\"\n          - test-build\\\\geotiff_consumer.exe\n          - if errorlevel 1 exit 1\n          - dumpbin /headers test-build\\\\geotiff_consumer.exe | findstr /I /C:\"AA64 machine (ARM64)\"\n          - if errorlevel 1 exit 1\n          - dumpbin /headers \"%LIBRARY_BIN%\\\\listgeo.exe\" | findstr /I /C:\"AA64 machine (ARM64)\"\n          - if errorlevel 1 exit 1\n          - dumpbin /headers \"%LIBRARY_BIN%\\\\geotiff.dll\" | findstr /I /C:\"AA64 machine (ARM64)\"\n          - if errorlevel 1 exit 1\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: TIFF based interchange format for georeferenced raster imagery\n  description: |\n    GeoTIFF represents an effort by over 160 different remote sensing,\n    GIS, cartographic, and surveying related companies and organizations\n    to establish a TIFF based interchange format for georeferenced raster imagery.\n\n\n  homepage: https://trac.osgeo.org/geotiff\n\nextra:\n  recipe-maintainers:\n    - akrherz\n    - gillins\n    - ocefpaf\n    - xylar\n    - hobu\n",
