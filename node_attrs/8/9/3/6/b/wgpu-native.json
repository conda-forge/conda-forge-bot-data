  "raw_meta_yaml": "{% set version = \"29.0.1.1\" %}\n{% set gpu_allocator_version = \"0.28.0\" %}\n\npackage:\n  name: wgpu-native\n  version: {{ version }}\n\nsource:\n  - url: https://github.com/gfx-rs/wgpu-native/archive/refs/tags/v{{ version }}.tar.gz\n    sha256: 6008651e1d10022d4ded15b69405b4ba88577be5d623938ba98ad241b2cbf818\n    patches:\n      # Build against the vendored gpu-allocator below rather than crates.io.\n      - patches/0001-use-the-vendored-patched-gpu-allocator.patch\n  # wgpu's vulkan backend has used gpu-allocator since wgpu v28, and its\n  # GpuToCpu path requires HOST_COHERENT, which on Intel's ANV forces every\n  # readback onto uncached memory -- 0.29 GB/s against 25 GB/s for the cached\n  # type on an Arrow Lake iGPU. Vendored here so the fix can be carried until\n  # it lands upstream.\n  - url: https://static.crates.io/crates/gpu-allocator/gpu-allocator-{{ gpu_allocator_version }}.crate\n    # A .crate file is a gzipped tarball, but conda-build dispatches on the\n    # file extension and does not recognise .crate, so name it .tar.gz here.\n    fn: gpu-allocator-{{ gpu_allocator_version }}.tar.gz\n    sha256: 51255ea7cfaadb6c5f1528d43e92a82acb2b96c43365989a28b2d44ee38f8795\n    folder: gpu-allocator\n    patches:\n      - patches/0001-gpu-allocator-prefer-cached-for-readback.patch\n\nbuild:\n  number: 1\n  run_exports:\n    # hmaarrfk: 2025/02/20 -- Too experimental for looser pinnings\n    - {{ pin_subpackage('wgpu-native', max_pin='x.x.x.x') }}\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ stdlib('c') }}\n    - {{ compiler('cxx') }}\n    - {{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - pkg-config\n    - clangdev\n  host:\n    - webgpu-headers 0.0.0.2026.3.19.*\n    - clangdev\n  run_constrained:\n    - {{ pin_compatible('webgpu-headers', max_pin='x.x.x.x.x.x') }}\n\ntest:\n  commands:\n    - test -f ${PREFIX}/lib/libwgpu_native${SHLIB_EXT}   # [unix]\n    - test -f ${PREFIX}/include/wgpu.h                   # [unix]\n    - if not exist %PREFIX%\\\\Library\\\\lib\\\\wgpu_native.lib exit 1  # [win]\n    - if not exist %PREFIX%\\\\Library\\\\bin\\\\wgpu_native.dll exit 1  # [win]\n    - if not exist %PREFIX%\\\\Library\\\\include\\\\wgpu.h exit 1       # [win]\n\nabout:\n  home: https://github.com/gfx-rs/wgpu-native\n  summary: A native WebGPU implementation in Rust, based on wgpu-core.\n  description: |\n    The bindings are based on the WebGPU-native header found at\n    ffi/webgpu-headers/webgpu.h and wgpu-native specific items in ffi/wgpu.h\n  license: MIT OR Apache-2.0\n  license_file:\n    - LICENSE.MIT\n    - LICENSE.APACHE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - hmaarrfk\n",
