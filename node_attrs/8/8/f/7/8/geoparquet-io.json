  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.3.0\"\n  python_min: \"3.11.0\"\n\npackage:\n  name: geoparquet-io\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/geoparquet/geoparquet-io/archive/v${{ version }}.tar.gz\n  sha256: 8622b3a0ebf6c57468f70889bfa717731c66aca5f78afc7cd1bd98d70a8118fa\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - gpio = geoparquet_io:cli\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - click\n    - click-plugins\n    - pyarrow\n    - python-duckdb\n    - duckdb =1.5.1\n    - pandas\n    - fsspec\n    - rich\n    - pystac\n    - jsonschema\n    - psutil\n    - obstore\n    - aiohttp\n    - s3fs\n    - geoarrow-pyarrow\n    - pyproj\n    - mercantile\n    - httpx\n    - owslib\n    - requests\n    - lxml\n    - idna\n    - urllib3\n    # Not in the metadata.\n    - shapely\n\ntests:\n  - python:\n      imports:\n        - geoparquet_io\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      - gpio --help\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n\nabout:\n  summary: Fast I/O and transformation tools for GeoParquet files\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://github.com/geoparquet/geoparquet-io\n\nextra:\n  recipe-maintainers:\n    - hobu\n",
