  "raw_meta_yaml": "package:\n  name: cuda-arch\n  version: ${{ cuda_arch_version }}\n\nsource:\n  url: https://developer.download.nvidia.com/compute/cuda/redist/cuda_documentation/LICENSE.txt\n  sha256: e2c71babfd18a8e69542dd7e9ca018f9caa438094001a58e6bc4d8c999bf0d07\n\nbuild:\n  # Add new versions to conda_build_config.yaml; only update the build number if\n  # dependencies change.\n  number: 1\n  noarch: generic\n  skip:\n    - match(cuda_arch_version, \"<\" ~ cuda_arch_version_min)\n    - match(cuda_arch_version, \">\" ~ cuda_arch_version_max)\n  variant:\n    use_keys:\n      - cuda_compiler_version\n\nrequirements:\n  run_exports:\n    - cuda-arch >=${{ cuda_arch_version }}\n  run:\n    # If your package manager doesn't implement __cuda_arch, you are allowed to install the\n    # oldest arch supported by your CUDA major version.\n    - if: cuda_arch_version == cuda_arch_version_min\n      then:\n        - cuda-version ${{ cuda_compiler_version }}.*\n      else:\n        - __cuda_arch\n  run_constraints:\n    # If your package manager implements __cuda_arch we require this package to match it.\n    - __cuda_arch ${{ cuda_arch_version }}.*\n\ntests:\n  - script:\n      - exit 0\n\nabout:\n  homepage: https://developer.nvidia.com/cuda-toolkit\n  summary: \"A meta-package that pins a minimum supported CUDA architecture\"\n  description: >\n    The cuda-arch package represents a minimum supported target CUDA architecture / compute\n    capability. Depending on this package declares that a CUDA device with at least the\n    declared compute capability is required.\n\n    Similar to how the cuda-version package is constrained by the __cuda virtual package,\n    the cuda-arch package is constrained by the __cuda_arch virtual package. The __cuda_arch\n    virtual package provides the minimum compute capability of the available CUDA devices\n    detected on the system. The cuda-arch package allows packages to express a minimum\n    supported compute capability without depending on __cuda_arch directly.\n  license: LicenseRef-NVIDIA-End-User-License-Agreement\n  license_file: LICENSE.txt\n\nextra:\n  feedstock-name: cuda-arch\n  recipe-maintainers:\n    - conda-forge/cuda\n",
