    "about": {
      "description": "brush (Bourne RUst SHell) is a shell implemented in Rust that aims to be\ncompatible with the POSIX sh specification as well as the bash shell.\nIt can run many common shell scripts and offers an interactive command-line\nexperience.",
      "dev_url": "https://github.com/reubeno/brush",
      "doc_url": "https://brush.sh/",
      "home": "https://brush.sh/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "A bash/POSIX-compatible shell implemented in Rust"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path brush-shell",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
