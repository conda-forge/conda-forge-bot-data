  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"2.9.0\"\n  python_min: \"3.11\"\n\npackage:\n  name: shapash\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/s/shapash/shapash-${{ version }}.tar.gz\n  sha256: 4e299980650b845fd33ea3a7786cc11547baf74811b52f916212ad9c75e5396f\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools\n    - wheel\n    - pip\n  run:\n    - python >=${{ python_min }},<3.15\n    - category_encoders >=2.6.0\n    - dash-bootstrap-components >=1.1.0,<2.0.0 # Note <2.0.0 added for conda-forge resolution\n    # Import Error without dash-bootstrap-components >=1.1.0 ,<2.0.0 - dash-bootstrap-components 2.0.3 has requirement dash>=3.0.4, but you have dash 2.18.2.\n    - dash-core-components >=2.0.0\n    - dash-daq >=0.5.0\n    - dash-html-components >=2.0.0\n    - dash-renderer ==1.8.3\n    - dash-table >=5.0.0\n    - dash >=2.3.1 ,<3.0.0\n    - flask >=1.0.4\n    - matplotlib-base >=3.8.4\n    - nbformat >5.8.0\n    - numba >=0.60.0\n    - numpy >=2.0.0,<2.6.0\n    - pandas >=2.2.2,<4.0.0\n    - plotly >=5.0.0,<6.0.0\n    - scikit-learn >=1.8.0,<1.9.0\n    - scipy >=1.13.0\n    - shap >=0.46.0\n    - shapely >=2.0.0\n  run_constraints:\n    # https://github.com/MAIF/shapash/blob/v2.9.0/pyproject.toml#L54\n    - jinja2 >=3.1.0\n    - jupyter_client >=8.3.0  # Note jupyter-client on pypi is jupyter_client on conda-forge\n    - nbconvert >=7.2.0\n    - notebook >=7.0.0\n    - papermill >=2.5.0\n    - phik >=0.12.4\n    - pyarrow >=17.0.0\n    # https://github.com/MAIF/shapash/blob/v2.9.0/pyproject.toml#L64\n    - xgboost >=2.1.0\n    - catboost >=1.2.8\n    - lightgbm >=4.4.0\n    - lime >=0.2.0.0\n\ntests:\n  - python:\n      imports:\n        - shapash\n\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  summary: Shapash is a Python library which aims to make machine learning interpretable and understandable by everyone.\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://github.com/MAIF/shapash\n\nextra:\n  recipe-maintainers:\n    - rxm7706\n",
