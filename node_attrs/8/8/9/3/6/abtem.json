    "about": {
      "description": "abTEM provides a Python API for running simulations of Transmission\nElectron Microscopy images. It is written entirely in Python, which\nenables easy integration with first-principles codes and analysis tools\naccessible from Python, and allows for a simple and intuitive user\ninterface. The computationally demanding parts are implemented using\njit-compiled Numba code and high-performance libraries, maintaining\nspeed while ensuring portability.",
      "dev_url": "https://github.com/jacobjma/abtem",
      "doc_url": "https://abtem.readthedocs.io/",
      "home": "https://github.com/jacobjma/abtem",
      "license": "GPL-3.0-only",
      "license_family": "GPL-3.0-only",
      "license_file": "LICENSE",
      "summary": "ab initio Transmission Electron Microscopy"
    },
    "build": {
      "noarch": "python",
      "number": "1",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
