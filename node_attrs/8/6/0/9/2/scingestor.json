        "jkotan"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "scingestor",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "setuptools >=61",
            "pip",
            "wheel"
          ],
          "run": [
            "python",
            "numpy",
            "argcomplete",
            "nxstools >=3.56.1",
            "requests",
            "pyyaml",
            "inotify_simple >=2.0.1"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "scingestor",
                "scingestor.beamtimeWatcher",
                "scingestor.configuration",
                "scingestor.datasetIngestor",
                "scingestor.datasetIngest",
                "scingestor.datasetWatcher",
                "scingestor.logger",
                "scingestor.modelIngest",
                "scingestor.pathConverter",
                "scingestor.safeINotifier",
                "scingestor.scanDirWatcher"
              ],
              "python_version": [
                "3.11.*",
                "*"
              ]
            }
          },
          {
            "requirements": {
              "run": [
                "python 3.11.*"
              ]
            },
            "script": [
              "test -x \"$PREFIX/bin/scicat_dataset_ingestor\"",
              "test -x \"$PREFIX/bin/scicat_dataset_ingest\"",
