  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"9.11\"\n\nrecipe:\n  name: coreutils-split\n  version: ${{ version }}\n\nsource:\n  url: http://ftp.gnu.org/gnu/coreutils/coreutils-${{ version }}.tar.xz\n  sha256: 394024eda0a5955217ceda9cd1201e65dc8fa3aa29c2951135a49521d57c3cc3\n\nbuild:\n  number: 0\n  skip: win\n\noutputs:\n  - package:\n      name: coreutils\n    build:\n      script: build_coreutils\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - make\n    tests:\n      - script:\n          - ln --relative --help\n          - wc --version\n          - cat --version\n    about:\n      homepage: https://www.gnu.org/software/coreutils\n      documentation: https://www.gnu.org/software/coreutils/manual/html_node/index.html\n      repository: http://git.savannah.gnu.org/cgit/coreutils.git\n      license: GPL-3.0-or-later\n      license_file: COPYING\n      summary: The GNU Core Utilities are the basic file, shell and text manipulation utilities of the GNU operating system.\n\n  - package:\n      name: gnu-coreutils\n    build:\n      script: build_gnu-coreutils\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - make\n    tests:\n      - script:\n          - gln --relative --help\n          # Confirm that gln is the prefixed GNU binary while ln is the system binary.\n          - if: linux64\n            then:\n              - ln --version\n              - gln --version\n          - gwc --version\n          - gcat --version\n    about:\n      homepage: https://www.gnu.org/software/coreutils\n      documentation: https://www.gnu.org/software/coreutils/manual/html_node/index.html\n      repository: http://git.savannah.gnu.org/cgit/coreutils.git\n      license: GPL-3.0-or-later\n      license_file: COPYING\n      summary: The GNU Core Utilities with program names prefixed by g.\n\nabout:\n  homepage: https://www.gnu.org/software/coreutils\n  documentation: https://www.gnu.org/software/coreutils/manual/html_node/index.html\n  repository: http://git.savannah.gnu.org/cgit/coreutils.git\n  license: GPL-3.0-or-later\n  license_file: COPYING\n  summary: The GNU Core Utilities are the basic file, shell and text manipulation utilities of the GNU operating system.\n\nextra:\n  recipe-maintainers:\n    - ngam\n    - sodre\n    - mbargull\n    - h-vetinari\n  feedstock-name: coreutils\n",
