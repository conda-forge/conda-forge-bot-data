  "raw_meta_yaml": "{% set version = \"9.9\" %}\n\npackage:\n  name: coreutils-split\n  version: \"{{ version }}\"\n\nsource:\n  url: http://ftp.gnu.org/gnu/coreutils/coreutils-{{ version }}.tar.xz\n  sha256: 19bcb6ca867183c57d77155eae946c5eced88183143b45ca51ad7d26c628ca75\n\nbuild:\n  number: 1\n  skip: true  # [win]\n\noutputs:\n  - name: coreutils\n    script: build_coreutils.sh\n\n    requirements:\n      build:\n        - {{ compiler('c') }}\n        - {{ stdlib(\"c\") }}\n        - make\n\n    test:\n      commands:\n        - ln --relative --help\n        - wc --version\n        - cat --version\n\n  - name: gnu-coreutils\n    script: build_gnu-coreutils.sh\n\n\n    requirements:\n      build:\n        - {{ compiler('c') }}\n        - {{ stdlib(\"c\") }}\n        - make\n\n    test:\n      commands:\n        - gln --relative --help\n        # to confirm gln vs ln\n        - ln --version  # [linux64]\n        - gln --version  # [linux64]\n        - gwc --version\n        - gcat --version\n\nabout:\n  home: https://www.gnu.org/software/coreutils\n  license: GPL-3.0-or-later\n  license_family: GPL\n  license_file: COPYING\n  summary: The GNU Core Utilities are the basic file, shell and text manipulation utilities of the GNU operating system.\n\n  doc_url: https://www.gnu.org/software/coreutils/manual/html_node/index.html\n  dev_url: http://git.savannah.gnu.org/cgit/coreutils.git\n\nextra:\n  recipe-maintainers:\n    - ngam\n    - sodre\n    - mbargull\n    - h-vetinari\n  feedstock-name: coreutils\n",
