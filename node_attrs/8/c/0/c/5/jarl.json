  "linux_64_meta_yaml": {
    "about": {
      "description": "Jarl is a fast linter for R: it does static code analysis to search for\nprogramming errors, bugs, and suspicious patterns of code. It supports\nautomatic fixes, 55+ rules, multiple output formats, and integration in\npopular IDEs and editors as well as CI workflows.",
      "dev_url": "https://github.com/etiennebacher/jarl/",
      "home": "https://jarl.etiennebacher.com/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Just Another R Linter"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cd crates/jarl",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins",
          "cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "etiennebacher",
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "jarl",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "jarl --help",
              "jarl --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "jarl"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.5.0"
      }
