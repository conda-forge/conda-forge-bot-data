  "raw_meta_yaml": "context:\n  version: \"0.5.0\"\n\npackage:\n  name: jarl\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/etiennebacher/jarl/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 7b1fd11adc3924fa71f3a4202a2a4a87f1c8d62944160adedba65eb8f01d1cda\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - cd crates/jarl\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n      - if: win\n        then:\n          # work around Windows `MAX_PATH` (260 char) limitation\n          - set \"CARGO_HOME=C:\\.cargo\"\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n\ntests:\n  - script:\n      - jarl --help\n      - jarl --version\n  - package_contents:\n      bin:\n        - jarl\n      strict: true\n\nabout:\n  summary: Just Another R Linter\n  description: |\n    Jarl is a fast linter for R: it does static code analysis to search for\n    programming errors, bugs, and suspicious patterns of code. It supports\n    automatic fixes, 55+ rules, multiple output formats, and integration in\n    popular IDEs and editors as well as CI workflows.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://jarl.etiennebacher.com/\n  repository: https://github.com/etiennebacher/jarl/\n\nextra:\n  recipe-maintainers:\n    - etiennebacher\n    - salim-b\n",
