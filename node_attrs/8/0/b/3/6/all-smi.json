  "linux_64_meta_yaml": {
    "about": {
      "description": "all-smi is a command-line utility for monitoring GPU and NPU hardware\nacross multiple systems. It provides a real-time view of accelerator\nutilization, memory usage, temperature, power consumption, and other\nmetrics, and is designed to be a cross-platform alternative to\nnvidia-smi with support for NVIDIA GPUs, AMD GPUs, NVIDIA Jetson\nplatforms, Apple Silicon GPUs, Intel GPUs, Intel Gaudi NPUs, Google\nCloud TPUs, Tenstorrent NPUs, Rebellions NPUs and Furiosa NPUs.\n\nThe application presents a terminal-based user interface with cluster\noverview and interactive sorting, for both local and remote monitoring,\nand can also export Prometheus metrics via its API mode.",
      "dev_url": "https://github.com/lablup/all-smi",
      "home": "https://github.com/lablup/all-smi",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Command-line utility for monitoring GPU hardware"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bin all-smi --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ]
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
