  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"7.0.1\"\n\npackage:\n  name: yo\n  version: ${{ version }}\n\nsource:\n  url: https://registry.npmjs.org/yo/-/yo-${{ version }}.tgz\n  sha256: 466f653547a99ae4cf0de84beac13b8a882804f56718d81df3a2327343bbf7f4\n\nbuild:\n  number: 0\n  script:\n    - if: unix\n      then:\n        - set -ex\n        - pnpm install --ignore-scripts\n        - npm pack --ignore-scripts\n        - npm install --global \"${SRC_DIR}/yo-${{ version }}.tgz\"\n        - pnpm-licenses generate-disclaimer --prod --output-file=third-party-licenses.txt\n      else:\n        - call pnpm install --ignore-scripts\n        - if %ERRORLEVEL% neq 0 exit 1\n        - call npm pack --ignore-scripts\n        - if %ERRORLEVEL% neq 0 exit 1\n        - call npm install --global %SRC_DIR%/yo-${{ version }}.tgz\n        - if %ERRORLEVEL% neq 0 exit 1\n        - call pnpm-licenses generate-disclaimer --prod --output-file=third-party-licenses.txt\n        - if %ERRORLEVEL% neq 0 exit 1\n\nrequirements:\n  build:\n    - nodejs\n    - pnpm\n    - pnpm-licenses\n  host:\n    - nodejs\n  run:\n    - nodejs\n\ntests:\n  - script:\n      - yo --help\n\nabout:\n  license: BSD-2-Clause\n  license_file:\n    - LICENSE\n    - third-party-licenses.txt\n  summary: CLI tool for running Yeoman generators\n  description: |\n    Yeoman helps you to kickstart new projects, prescribing best practices and tools to help you stay productive.\n  homepage: http://yeoman.io\n  documentation: http://yeoman.io\n  repository: https://github.com/yeoman/yo\n\nextra:\n  recipe-maintainers:\n    - rxm7706\n",
