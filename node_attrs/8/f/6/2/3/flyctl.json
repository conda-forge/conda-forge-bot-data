  "linux_64_meta_yaml": {
    "about": {
      "description": "flyctl is the command-line interface for the fly.io platform for\ndeploying and running applications on scalable hardware-isolated sandboxes.\nUse flyctl to launch apps, manage deployments, scale machines, handle\nsecrets, configure networking, and more.",
      "dev_url": "https://github.com/superfly/flyctl",
      "doc_url": "https://fly.io/docs/flyctl/",
      "home": "https://fly.io/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "CLI for deploying and managing applications on fly.io"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "let build_time = date now | format date \"%Y-%m-%dT%H:%M:%SZ\"",
          "let short_commit_hash = (http get https://api.github.com/repos/superfly/flyctl/commits/v${{ version }}).sha | str substring 0..6",
          "go build -o=($prefix)/bin/ -v -ldflags=$'-s -w -X github.com/superfly/flyctl/internal/buildinfo.buildVersion=${{ version }} -X github.com/superfly/flyctl/internal/buildinfo.buildDate=($build_time) -X github.com/superfly/flyctl/internal/buildinfo.commit=($short_commit_hash)' -trimpath -tags production .",
          "go-licenses save . --save_path=library_licenses --ignore=github.com/in-toto/attestation/go/v1 --ignore=github.com/in-toto/in-toto-golang --ignore=github.com/jmespath/go-jmespath --ignore=github.com/launchdarkly/go-jsonstream/v3 --ignore=github.com/launchdarkly/go-sdk-common/v3",
          "mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions",
          "let bin = ($prefix)/bin/flyctl",
          "^$bin completion bash | save ($prefix)/share/bash-completion/completions/flyctl",
          "^$bin completion fish | save ($prefix)/share/fish/vendor_completions.d/flyctl.fish",
          "^$bin completion zsh  | save ($prefix)/share/zsh/site-functions/_flyctl"
        ],
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "flyctl",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses",
            "nushell"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "flyctl help",
              "flyctl version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "flyctl"
              ],
              "files": [
                "share/bash-completion/completions/flyctl",
                "share/fish/vendor_completions.d/flyctl.fish",
                "share/zsh/site-functions/_flyctl"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.4.101"
      }
    ],
    "package": {
      "name": "flyctl",
      "version": "0.4.101"
    },
    "requirements": {
      "build": [
        "go-nocgo_compiler_stub",
