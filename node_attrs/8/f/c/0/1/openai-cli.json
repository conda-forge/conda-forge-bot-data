  "linux_64_meta_yaml": {
    "about": {
      "description": "openai-cli is the official command line interface for working with the\nOpenAI API.",
      "dev_url": "https://github.com/openai/openai-cli",
      "doc_url": "https://developers.openai.com/api/docs",
      "home": "https://github.com/openai/openai-cli",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "The official CLI for the OpenAI API"
    },
    "build": {
      "number": "0",
      "script": [
        "go-licenses save ./cmd/openai --save_path ./library_licenses --ignore github.com/mattn/go-localereader",
        "go build -v -o $PREFIX/bin/openai -ldflags=\"-s -w\" ./cmd/openai",
        "mkdir -p $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d $PREFIX/share/zsh/site-functions",
        "$PREFIX/bin/openai @completion bash > $PREFIX/share/bash-completion/completions/openai",
        "$PREFIX/bin/openai @completion fish > $PREFIX/share/fish/vendor_completions.d/openai.fish",
        "$PREFIX/bin/openai @completion zsh > $PREFIX/share/zsh/site-functions/_openai"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "moritzwilksch"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "openai-cli",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "openai --help",
              "openai --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "openai"
              ],
              "files": [
                "share/bash-completion/completions/openai",
                "share/fish/vendor_completions.d/openai.fish",
                "share/zsh/site-functions/_openai"
              ],
              "strict": true
            }
          }
        ],
        "version": "1.6.0"
      }
    ],
