st\n        - icub-models\n        - idyntree\n        # Workaround for https://github.com/conda-forge/adam-robotics-feedstock/pull/19#issuecomment-3409763425\n        - xorg-libxxf86vm\n        - git\n        - gitpython\n        - requests\n        # test_visualization.py imports MuJoCo unconditionally.\n        - mujoco\n        # Enables the USD visualization tests instead of skipping them.\n        - openusd\n\n  - name: {{ name|lower }}-all\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python {{ python_min }}\n      run:\n        - {{ pin_subpackage('adam-robotics-casadi', max_pin='x.x.x') }}\n        - {{ pin_subpackage('adam-robotics-jax', max_pin='x.x.x') }}\n        - {{ pin_subpackage('adam-robotics-pytorch', max_pin='x.x.x') }}\n        - {{ pin_subpackage('adam-robotics-visualization', max_pin='x.x.x') }}\n        - python >={{ python_min }}\n    test:\n      commands:\n        - python -c \"import adam.casadi; import adam.jax; import adam.pytorch\"\n        - python -c \"from adam.casadi.inverse_kinematics import InverseKinematics\"\n        - python -c \"from adam.visualization import Visualizer; import viser; import trimesh\"\n      requires:\n        - python {{ python_min }}\n\nabout:\n  home: https://github.com/gbionics/adam\n  summary: ADAM implements a collection of algorithms for calculating rigid-body dynamics in Jax, CasADi, PyTorch, and NumPy.\n  license: BSD-3-Clause\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - traversaro\n    - Giulero\n    - xela-95\n",
