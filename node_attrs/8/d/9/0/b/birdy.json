  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: birdy\n  python_name: birdhouse_birdy\n  python_min: \"3.11\"\n  version: \"0.10.0\"\n\npackage:\n  name: birdy\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/b/birdhouse-birdy/birdhouse_birdy-${{ version }}.tar.gz\n  sha256: 535b64396f1f8b6d1bbdea04f9e591d5bb3e9bcf73a267e1a76ae6ed59cfe1f5\n\nbuild:\n  noarch: python\n  number: 0\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - birdy = birdy.cli.run:cli\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - flit-core >=3.12.0,<4.0\n    - pip >=25.2\n  run:\n    - python >=${{ python_min }}\n    - boltons >=23.0\n    - click >=8.1.0\n    - cryptography >=46.0.5\n    - jinja2 >=3.0.0\n    - lxml >=5.0.0\n    - owslib >=0.19.2\n    - packaging >=23.0\n    - pyopenssl >=26.3.0\n    - python-dateutil >=2.8.1\n    - requests >=2.24.0\n    - urllib3 >=2.6.0\n    - wrapt >=1.14.0\n  run_constraints:\n    - fiona >=1.10.1\n    - gdal >=3.5\n    - geojson >=3.0.0\n    - ipyleaflet >=0.20.0\n    - ipython >8.5.0,!=9.0.0\n    - netCDF4 >=1.6.0\n    - pymetalink >=6.5.3\n    - rioxarray >=0.19.0\n    - xarray >=2023.1.0\n\ntests:\n  - python:\n      imports:\n        - birdy\n      pip_check: true\n      python_version:\n         - ${{ python_min }}.*\n         - \"*\"\n  - requirements:\n      run:\n        - geojson >=3.0.0\n        - pytest >=9.0.2\n        - python ${{ python_min }}.*\n        - rioxarray >=0.19.0\n        - xarray >=2023.1.0\n    files:\n      source: \n        - pyproject.toml\n        - tests\n    script:\n      - pytest -m \"not online\"\n\nabout:\n  homepage: https://github.com/bird-house/birdy\n  license: Apache-2.0\n  license_family: Apache\n  license_file: LICENSE\n  summary: Birdy provides a command-line tool to work with Web Processing Services (WPS).\n  description: |\n    Birdy is a Python command-line tool to work with Web Processing Services (WPS).\n    It is built with the capabilities of OWSLib from the GeoPython project and allows\n    for ease in the development of WPS-enabled services as part of the Bird-house ecosystem.\n  documentation: https://birdy.readthedocs.io/en/stable/\n\nextra:\n  recipe-maintainers:\n    - cehbrecht\n    - Zeitsperre\n",
