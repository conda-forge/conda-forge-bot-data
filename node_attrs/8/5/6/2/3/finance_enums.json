  "raw_meta_yaml": "context:\n  name: finance_enums\n  version: \"0.6.0\"\n  build: 0\n\nrecipe:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name }}-${{ version }}.tar.gz\n  sha256: a819bd197a82e3037d5672f370cf849af1468fa2bca94c6bd3a427e98ab74956\n\nbuild:\n  number: ${{ build }}\n\noutputs:\n  - package:\n      name: finance_enums\n    build:\n      number: ${{ build }}\n      python:\n        version_independent: true\n      script:\n        - if: unix\n          then: export PYO3_PYTHON=\"$PYTHON\"\n          else: set \"PYO3_PYTHON=%PYTHON%\"\n        - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n        - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n      skip: is_abi3 and not is_python_min\n\n    requirements:\n      build:\n        - if: build_platform != target_platform\n          then:\n            - python\n            - cross-python_${{ target_platform }}\n            - crossenv\n        - ${{ compiler('c') }}\n        - ${{ stdlib(\"c\") }}\n        - ${{ compiler('rust') }}\n        - cargo-bundle-licenses\n      host:\n        - python\n        - pip\n        - hatchling\n        - hatch-rs >=0.2.0\n        - if: is_abi3\n          then:\n            - python-abi3\n      run:\n        - python >=${{ python_min }}\n      ignore_run_exports:\n        from_package:\n          - cross-python_${{ target_platform }}\n\n    tests:\n      - python:\n          imports:\n            - finance_enums\n          pip_check: true\n          python_version: ${{ python_min }}.*\n\n  - package:\n      name: finance-enums\n    build:\n      noarch: generic\n      number: ${{ build }}\n      skip:\n        - not target_platform == \"linux-64\"\n    requirements:\n      run:\n        - ${{ pin_subpackage('finance_enums', upper_bound='x.x.x', lower_bound='x.x.x') }}\n    about:\n      license_file: []\n    tests:\n      - python:\n          imports:\n            - finance_enums\n          pip_check: true\n          python_version: ${{ python_min }}.*\n\nabout:\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: Standard Financial Enumerations\n  homepage: https://github.com/prettygoodcapital/finance_enums\n  repository: https://github.com/prettygoodcapital/finance_enums\n\nextra:\n  recipe-maintainers:\n    - pgc-dev\n",
