  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"4.2.9\"\n\npackage:\n  name: jasper\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/jasper-software/jasper/releases/download/version-${{ version }}/jasper-${{ version }}.tar.gz\n  sha256: f71cf643937a5fcaedcfeb30a22ba406912948ad4413148214df280afc425454\n\nbuild:\n  number: 2\n  dynamic_linking:\n    missing_dso_allowlist:\n      - if: osx\n        then: /System/Library/Frameworks/GLUT.framework/Versions/A/GLUT\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - make\n    - if: win\n      then: ninja\n  host:\n    - libjpeg-turbo\n    - if: linux\n      then: libglu\n    - if: linux or win\n      then: freeglut\n    - if: linux\n      then: libgl-devel\n    - if: linux\n      then: expat\n  run:\n    - libjpeg-turbo\n    - if: linux\n      then: ${{ pin_compatible('libglu') }}\n    - if: linux or win\n      then: ${{ pin_compatible('freeglut') }}\n  run_exports:\n    - ${{ pin_subpackage('jasper') }}\n\ntests:\n  - script:\n      - if: win\n        then: if not exist %LIBRARY_BIN%\\\\jasper.dll exit 1\n      - jasper --version\n\nabout:\n  license: JasPer-2.0\n  license_file: LICENSE.txt\n  summary: A reference implementation of the codec specified in the JPEG-2000 Part-1 standard.\n  homepage: http://www.ece.uvic.ca/~frodo/jasper/\n\nextra:\n  recipe-maintainers:\n    - akrherz\n    - jakirkham\n    - jhamman\n    - ocefpaf\n    - seanyen\n",
