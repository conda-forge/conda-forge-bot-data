  "raw_meta_yaml": "context:\n  version: \"0.2.0\"\n\npackage:\n  name: dateme\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/d/dateme/dateme-${{ version }}.tar.gz\n  sha256: 5b6a3e859c806fca7200e758f150fdab8023778aa5906294553bdf4638a97ecd\n\nbuild:\n  number: 0\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    - if: unix\n      then:\n        - export PYO3_PYTHON=\"$PYTHON\"\n        - export RUSTFLAGS=\"\"\n      else:\n        - set \"PYO3_PYTHON=%PYTHON%\"\n        - set \"RUSTFLAGS=\"\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('rust') }}\n    - rust-std-wasm32-unknown-unknown\n    - wasm-bindgen-cli ==0.2.126\n    - cargo-bundle-licenses\n    - if: linux\n      then:\n        - pkg-config\n  host:\n    - python\n    - pip\n    - hatchling\n    - hatch-js\n    - hatch-rs\n    - pnpm\n    - if: is_abi3\n      then:\n        - python-abi3\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - dateme\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/dateme/dateme.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%/dateme/dateme.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: Dates and intervals\n  homepage: https://github.com/1kbgz/dateme\n  repository: https://github.com/1kbgz/dateme\n\nextra:\n  recipe-maintainers:\n    - timkpaine\n",
