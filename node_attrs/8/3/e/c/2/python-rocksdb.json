  "raw_meta_yaml": "{% set name = \"python-rocksdb\" %}\n{% set version = \"0.7.0\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}/{{ name }}-{{ version }}.tar.gz\n  sha256: aa692fbd06d8ed4ad641feee2970062fe01120e87b645a29403c71c628639e4f\n  # Remove when packaging a maintained source release with Cython 3 support.\n  patches:\n    - patches/0001-support-cython-3.patch\n    # The 0.7.0 sdist hard-codes GCC/Clang flags and the Unix bzip2 library\n    # name. Remove when packaging a maintained release with native MSVC support.\n    # https://github.com/twmht/python-rocksdb/issues/66\n    - patches/0002-support-msvc.patch\n\nbuild:\n  number: 22\n  script: \"{{ PYTHON }} -m pip install . -vv\"\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ compiler('cxx') }}\n    - {{ stdlib(\"c\") }}\n\n  host:\n    - python\n    - setuptools >=25\n    # Remove the direct pin when packaging a source compatible with the current\n    # global RocksDB pin; the released bindings still target the RocksDB 6 API.\n    - rocksdb 6\n    - bzip2\n    - cython >=3\n    - lz4-c\n    - snappy\n    - zlib\n    - zstd\n    - pip\n\n  run:\n    - python\n    - setuptools >=25\n\ntest:\n  imports:\n    - rocksdb\n  commands:\n    - python -c \"import tempfile; import rocksdb; db = rocksdb.DB(tempfile.mkdtemp(), rocksdb.Options(create_if_missing=True)); db.put(b'key', b'value'); assert db.get(b'key') == b'value'\"\n\nabout:\n  home: https://github.com/twmht/python-rocksdb\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: LICENSE.txt\n  summary: 'Python bindings for RocksDB'\n  doc_url: https://python-rocksdb.readthedocs.io\n\nextra:\n  recipe-maintainers:\n    - jeongseok-meta\n    - maxibor\n",
