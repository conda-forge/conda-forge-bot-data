  "linux_64_meta_yaml": {
    "about": {
      "description": "Aube installs automatically when you run a script. It has the tightest\nsecurity defaults of any Node.js package manager and is the only one\nwith a lifecycle-script jail. Aube drops into existing projects using\ntheir existing lockfiles (`pnpm-lock.yaml`, `package-lock.json`,\n`npm-shrinkwrap.json`, `yarn.lock` and `bun.lock`).",
      "dev_url": "https://github.com/jdx/aube",
      "home": "https://aube.jdx.dev/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Aube — a fast Node.js package manager"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cd crates/aube",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins",
          "mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions",
          "\"$PREFIX\"/bin/aube completion bash > \"$PREFIX\"/share/bash-completion/completions/aube",
          "\"$PREFIX\"/bin/aube completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/aube.fish",
          "\"$PREFIX\"/bin/aube completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_aube",
          "cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "aube",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "clang",
            "cmake",
            "libclang",
            "make",
            "ninja",
            "pkg-config"
          ],
          "host": [
            "usage"
          ],
