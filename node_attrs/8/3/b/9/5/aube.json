  "raw_meta_yaml": "context:\n  version: \"1.26.0\"\n\npackage:\n  name: aube\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/jdx/aube/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 114154f539e6e24e2d08102d9e37885b57d66130f3bc3085b1d095539ad4ea83\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - cd crates/aube\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n          - mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n          - '\"$PREFIX\"/bin/aube completion bash > \"$PREFIX\"/share/bash-completion/completions/aube'\n          - '\"$PREFIX\"/bin/aube completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/aube.fish'\n          - '\"$PREFIX\"/bin/aube completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_aube'\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n          - if not exist \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n          - if not exist \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d   mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n          - if not exist \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions          mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n          - '\"%LIBRARY_BIN%\"\\aube.exe completion bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\aube'\n          - '\"%LIBRARY_BIN%\"\\aube.exe completion fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\aube.fish'\n          - '\"%LIBRARY_BIN%\"\\aube.exe completion zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_aube'\n      - cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - clang\n    - cmake\n    - libclang\n    - make\n    - ninja\n    - pkg-config\n  host:\n    - usage\n\ntests:\n  - script:\n      - aube --help\n      - aube --version\n      - aubr --help\n      - aubr --version\n      - aubx --help\n      - aubx --version\n  - package_contents:\n      bin:\n        - aube\n        - aubr\n        - aubx\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/aube\n            - share/fish/vendor_completions.d/aube.fish\n            - share/zsh/site-functions/_aube\n        - if: win\n          then:\n            - Library/share/bash-completion/completions/aube\n            - Library/share/fish/vendor_completions.d/aube.fish\n            - Library/share/zsh/site-functions/_aube\n      strict: true\n\nabout:\n  summary: Aube — a fast Node.js package manager\n  description: |\n    Aube installs automatically when you run a script. It has the tightest\n    security defaults of any Node.js package manager and is the only one\n    with a lifecycle-script jail. Aube drops into existing projects using\n    their existing lockfiles (`pnpm-lock.yaml`, `package-lock.json`,\n    `npm-shrinkwrap.json`, `yarn.lock` and `bun.lock`).\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://aube.jdx.dev\n  repository: https://github.com/jdx/aube\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
