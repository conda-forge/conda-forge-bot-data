  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"9.1\"\n\nrecipe:\n  name: tango-starter-split\n  version: ${{ version }}\n\nsource:\n  url: https://gitlab.com/tango-controls/starter/-/releases/Starter-${{ version }}/downloads/starter-with-submodules-Starter-${{ version }}.tar.gz\n  sha256: d60126d57df0c6007f21f5032bdf63065f38caca8958f682c6acb00f27c5295c\n  patches:\n    - if: win\n      then: find-zmq-435.patch\n\nbuild:\n  number: 0\n\noutputs:\n  - staging:\n      name: tango-starter-build\n    requirements:\n      build:\n        - cmake\n        - ninja\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib(\"c\") }}\n        - if: unix\n          then:\n            - pkg-config\n      host:\n        - cppzmq\n        - cpptango\n        - omniorb-libs\n    build:\n      script:\n        file: build\n\n  - package:\n      name: tango-starter\n    inherit: tango-starter-build\n    build:\n      files:\n        - if: unix\n          then:\n            - bin/Starter\n          else:\n            - Library/bin/Starter.exe\n    tests:\n      - script:\n          - if: unix\n            then:\n              # Starter --help returns 255, so grep the stderr for test\n              - Starter --help 2>&1 | grep -i usage\n            else:\n              - Starter.exe --help 2>&1 | findstr /i usage\n\n  - package:\n      name: tango-starter-dbg\n    inherit:\n      from: tango-starter-build\n      run_exports: false\n    build:\n      skip:\n        - not linux\n      dynamic_linking:\n        # Prevent dbg file to be modified\n        # Will raise CRC mismatch otherwise!\n        binary_relocation: false\n      files:\n        - lib/debug/Starter.dbg\n    requirements:\n      run:\n        - ${{ pin_subpackage('tango-starter', exact=True) }}\n    tests:\n      - package_contents:\n          files:\n            - lib/debug/Starter.dbg\n\nabout:\n  license: GPL-3.0-or-later\n  license_file: LICENSE\n  summary: Device server to control Tango components\n  description: |\n    Tango-Controls is a software toolkit for building control systems.\n    This device server is able to control Tango components (database, device servers, clients...).\n    It is able to start or stop and to report the status of these components.\n  homepage: https://www.tango-controls.org\n  repository: https://gitlab.com/tango-controls/starter\n\nextra:\n  feedstock-name: tango-starter\n  recipe-maintainers:\n    - beenje\n",
