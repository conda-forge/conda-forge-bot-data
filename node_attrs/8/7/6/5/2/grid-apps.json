    "about": {
      "description": "The grid-apps package offers tools for the creation and manipulation of grid objects\n(Octree, BlockModel, Grid2D, DrapeModel) using various Python libraries\nand `geoh5py <https://mirageoscience-geoh5py.readthedocs-hosted.com/>`_.",
      "dev_url": "https://github.com/MiraGeoscience/grid-apps",
      "home": "https://www.mirageoscience.com/mining-industry-software/python-integration/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Grid creation and manipulation using GEOH5 format."
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": {
        "content": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation",
        "env": {
          "POETRY_DYNAMIC_VERSIONING_BYPASS": "0.1.0"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "conda-forge/geoh5py"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "grid-apps",
        "requirements": {
          "build": [],
          "host": [
            "python 3.10.*",
            "poetry-core >=1.8.0",
            "poetry-dynamic-versioning >=1.9,1.*",
            "setuptools",
            "pip"
          ],
          "run": [
            "python >=3.10",
            "geoh5py 0.12.*",
            "geoapps-utils 0.6.*",
            "discretize 0.11.*",
            "numpy 1.26.*",
            "pydantic >=2.5.2,2.*",
            "scipy 1.14.*"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "grid_apps",
                "grid_apps._version"
              ],
              "python_version": "3.10.*"
            }
          },
          {
            "files": {
              "source": [
                "tests/"
              ]
            },
            "requirements": {
