      "dev_url": "https://github.com/UDST/orca",
      "doc_url": "https://udst.github.io/orca/",
      "home": "https://github.com/UDST/orca",
      "license": "BSD-3-Clause",
      "license_family": "BSD",
      "license_file": "LICENSE.txt",
      "summary": "Python library for task orchestration"
    },
    "build": {
