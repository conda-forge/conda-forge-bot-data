  "linux_64_meta_yaml": {
    "about": {
      "description": "This is a feature complete XML library containing a validating parser as well as a modern C++ API for the data structures.\nIt also supports serializing custom data structures.\n\nThe core of this library is a validating XML parser with DTD processing and all.\nOn top of this are implemented an API for manipulating XML data in a DOM like fashion and a serialization API.\nAs a bonus there’s also an XPath implementation, albeit this is limited to XPath 1.0.\n\nThis XML library was extracted from [libzeep](https://github.com/mhekkel/libzeep) since having a separate and simple XML library is more convenient.\nThe API is unfortunately no longer compatible since the goal was to be more standards compliant.\nE.g., zeem::element should now be a complete [Sequence Container](https://en.cppreference.com/w/cpp/named_req/SequenceContainer).",
      "dev_url": "https://forge.hekkelman.net/maarten/zeem",
      "doc_url": "https://www.hekkelman.net/docs/libzeem/",
      "home": "https://www.hekkelman.net/docs/libzeem/",
      "license": "BSD-2-Clause",
      "license_family": "BSD-2-Clause",
      "license_file": "LICENSE",
      "summary": "A C++ Module Library offering a full XML library with validating parser, DOM tree, XPaths and serialization"
    },
