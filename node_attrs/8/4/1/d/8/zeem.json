  "raw_meta_yaml": "context:\n  version: \"2.3.2\"\n\nrecipe:\n  name: libzeem\n  version: ${{ version }}\n\nsource:\n  url: https://forge.hekkelman.net/maarten/zeem/archive/v${{ version }}.tar.gz\n  sha256: e7bdf4dd9d8728de9975d8e89989d31bf5b1ad5beb634c632eeeccda12be4c1b\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: libzeem\n    build:\n      script: build\n    requirements:\n      build:\n        - ${{ compiler(\"cxx\") }}\n        - ${{ stdlib(\"c\") }}\n        - cmake\n        - ninja\n        - pkg-config\n        - if: osx\n          then:\n            - clang-tools\n        - if: win\n          then:\n            - m2-sed\n      host:\n        - catch2\n        - fast_float\n        - howardhinnant_date\n        - libmcfp\n      run_exports:\n        # Patch version update may be breakable\n        - ${{ pin_subpackage(\"libzeem\", upper_bound=\"x.x.x\") }}\n      ignore_run_exports:\n        from_package:\n          - catch2\n    tests:\n      - package_contents:\n          include:\n            - zeem/*\n          lib:\n            - zeem\n        strict: true\n\n  - package:\n      name: zeem\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"libzeem\", upper_bound=\"x.x.x\") }}\n      run_exports:\n        # Patch version update may be breakable\n        - ${{ pin_subpackage(\"zeem\", upper_bound=\"x.x.x\") }}\n    tests:\n      - script:\n          interpreter: brush\n          content:\n            - if: linux\n              then:\n                - test -d \"${PREFIX}/include/zeem\"\n                - test -f \"${PREFIX}/lib/libzeem.so\"\n            - if: osx\n              then:\n                - test -d \"${PREFIX}/include/zeem\"\n                - test -f \"${PREFIX}/lib/libzeem.dylib\"\n            - if: win\n              then:\n                - test -d \"${LIBRARY_PREFIX}/include/zeem\"\n                - test -f \"${LIBRARY_PREFIX}/lib/zeem.lib\"\n        requirements:\n          run:\n            - brush\n\nabout:\n  homepage: https://www.hekkelman.net/docs/libzeem/\n  repository: https://forge.hekkelman.net/maarten/zeem\n  documentation: https://www.hekkelman.net/docs/libzeem/\n  license: BSD-2-Clause\n  license_file: LICENSE\n  summary: \"A C++ Module Library offering a full XML library with validating parser, DOM tree, XPaths and serialization\"\n  description: |\n    This is a feature complete XML library containing a validating parser as well as a modern C++ API for the data structures.\n    It also supports serializing custom data structures.\n\n    The core of this library is a validating XML parser with DTD processing and all.\n    On top of this are implemented an API for manipulating XML data in a DOM like fashion and a serialization API.\n    As a bonus there’s also an XPath implementation, albeit this is limited to XPath 1.0.\n\n    This XML library was extracted from [libzeep](https://github.com/mhekkel/libzeep) since having a separate and simple XML library is more convenient.\n    The API is unfortunately no longer compatible since the goal was to be more standards compliant.\n    E.g., zeem::element should now be a complete [Sequence Container](https://en.cppreference.com/w/cpp/named_req/SequenceContainer).\n\nextra:\n  recipe-maintainers:\n    - eunos-1128\n",
